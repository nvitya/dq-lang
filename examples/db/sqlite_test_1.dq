func *Main() -> int:
    PrintLn('SQLite test')

    // delete the previous database
    if FileExists(DB_NAME):
        FileRemove(DB_NAME)
    endif

    var db <- OSqlite3Db()
    db.Open(DB_NAME.pchar)

    // Create the schema and populate it in one transaction.
    db.Execute(CAPITALS_STRUCT.pchar)
    db.Begin()
    db.Execute(CAPITALS_DATA.pchar)
    db.Commit()
    PrintLn('Inserted rows = {}', [db.changes])

    // Query the data through a prepared statement.
    var query <- OSqlite3Stmt()
    query.Prepare(db,
    """
    select
        CITY, COUNTRY
    from
        capitals
    where
        CONTINENT = 'Europe'
    order by
        CITY limit 50
    """)
    while query.Step():
        PrintLn('{} - {}', [query.ColumnText(0), query.ColumnText(1)])
    endwhile
    return 0
endfunc
