func extpick(msg : ^char) -> int [[overload]] [[external("puts")]]
func extpick(fmt : ^char, value : int = 77, ...) -> int [[overload]] [[external("printf")]]

type CB1 = func(a : int) -> int
type CBBad = func(a : float) -> int

func use_cb(cb : CB1) -> int:
    return cb(1)
endfunc

var good_cb : CB1 = oltest_int
var bad_cb : CBBad = oltest_int  //?error(OverloadNoMatch)
func *Main() -> int:
    oltest_int(2)
    oldefault(2)
    oconv(2)
    use_cb(oltest_int)
    extpick("extpick %d")

    oltest_int(true)  //?error(OverloadNoMatch)
    oambig(1)  //?error(OverloadAmbiguous)

    var x : int
    orescue(x)  //?error(OverloadNoMatch)

    return 0
endfunc

#else

func printf(fmt : ^char, ...) -> int [[external]]
func extpick(msg : ^char) -> int [[overload]] [[external("puts")]]
func extpick(fmt : ^char, value : int = 77, ...) -> int [[overload]] [[external("printf")]]

type TIntAlias = int
type CB1 = func(a : int) -> int

func oltest_int(a : int) -> int [[overload]]:
    return a
endfunc

func oltest_int(a : int, b : int) -> int [[overload]]:
    return a * b
endfunc

func olalias(a : int) -> int [[overload]]:
    return a
endfunc

func olalias(a : float) -> TIntAlias [[overload]]:
    return 1
endfunc

func oldefault(a : int) -> int [[overload]]:
    return a
endfunc

func oldefault(a : int, b : int = 1) -> int [[overload]]:
    return a + b + 100
endfunc

func oconv(a : int) -> int [[overload]]:
    return a + 100
endfunc

func oconv(a : float) -> int [[overload]]:
    return 200 + Round(a)
endfunc

func use_cb(cb : CB1, v : int) -> int:
    return cb(v)
endfunc
func *Main() -> int:
    printf("Overload collection test\n")  //?ignore('Overload collection test')

    var cb : CB1 = oltest_int

    printf("oltest_int(2) = %d\n", oltest_int(2))  //?check('oltest_int(2)', 2)
    printf("oltest_int(2, 3) = %d\n", oltest_int(2, 3))  //?check('oltest_int(2, 3)', 6)
    printf("cb(4) = %d\n", cb(4))  //?check('cb(4)', 4)
    printf("use_cb(oltest_int, 5) = %d\n", use_cb(oltest_int, 5))  //?check('use_cb(oltest_int, 5)', 5)
    printf("olalias(2.5) = %d\n", olalias(2.5))  //?check('olalias(2.5)', 1)
    printf("oldefault(7) = %d\n", oldefault(7))  //?check('oldefault(7)', 7)
    printf("oldefault(7, 2) = %d\n", oldefault(7, 2))  //?check('oldefault(7, 2)', 109)
    printf("oconv(2) = %d\n", oconv(2))  //?check('oconv(2)', 102)
    printf("oconv(2.5) = %d\n", oconv(2.5))  //?check('oconv(2.5)', 203)

    extpick("extpick = fixed %d")  //?check('extpick', 'fixed %d')

    return 0
endfunc

#endif
