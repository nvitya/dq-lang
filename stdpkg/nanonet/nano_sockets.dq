use socket

enum NSocketType = (stTcp4, stUdp4)

object ONanoServer    ..
object OSocketWatcher ..
object OMultiClientManager ..
object ONanoUdpServer ..

object ENanoNet(Exception):
endobject

type FInEventHandler  = func(aobj : Object) of object
type FOutEventHandler = func(aobj : Object) of object

object ONanoSocket:
protected
    m_socket : TSocket

    func SetSockBufSizes() ..
    func SetSockParams() ..

public
    stype : NSocketType

    local_addr  : TSockAddr
    remote_addr : TSockAddr

    sendbuf_size : int = 16384
    recvbuf_size : int = 16384

    connect_timeout  : int = 1000  // [ms]
    response_timeout : int = 1000  // [ms]

    in_event_handler  : FInEventHandler
    out_event_handler : FOutEventHandler
    obj_link          : Object

    func *Create(atype : NSocketType) ..
    func *Destroy() ..

    func Disconnect() ..
    func Connected() -> bool ..

    func InitListener(aport : uint16) ..
    func AcceptConnection(asvrsocket : TSocket) -> bool ..

    func Send(pdata : pointer, srclen : uint) -> int ..
    func Recv(pdata : pointer, maxlen : uint) -> int ..

    func Connect(aaddr : rostr, aport : uint16) -> bool ..

    func SetNonBlocking() ..
    func SetTcpNoDelay(anodelay : bool) ..

public
    property socket : TSocket  read m_socket
endobject

object OSocketWatcher:
    #ifdef WINDOWS
    #else
        fd_epoll : int
        revents  : [*]SEpollEvent
    #endif

    maxfds    : int
    maxevents : int = 32

    func *Create(amaxfds : int) ..
    func *Destroy() ..

    func AddSocket(asock : ONanoSocket, aobj_link : Object, ainev : FInEventHandler, outev : FOutEventHandler) ..
    func ModifySocket(asock : ONanoSocket) ..
    func RemoveSocket(asock : ONanoSocket) ..
    func SetOutHandler(asock : ONanoSocket, aoutev : FOutEventHandler) ..
    func SetInHandler(asock : ONanoSocket, ainev : FInEventHandler) ..

    func WaitForEvents(atimeout_ms : int) -> bool ..

endobject

//-----------------------------------------------------------------
// Nano-Server (TCP/IP)
//-----------------------------------------------------------------

object OSConnection:  // Servers connection to client
    sock   <- ONanoSocket(stTcp4)
    server :  ONanoServer

    func *Create(aserver : ONanoServer):
        server = aserver
    endfunc

    func Close() ..
    func AcceptConnection(svrsock : ONanoSocket) -> bool [[virtual]] ..

    func HandleInput(aobj : Object) [[virtual]] ..
    func HandleOutput(aobj : Object) [[virtual]] ..

    func SetOutHandler(aoutev : FOutEventHandler) ..
endobject

type TSConnectionType = type of OSConnection

object ONanoServer:
public
    sconn_type   : TSConnectionType
    listen_port  : uint16

    connections  : [*]OSConnection
    closed_conns : [*]OSConnection

    sock_listen  <- ONanoSocket(stTcp4)
    swatcher     :  autofree OSocketWatcher

    func *Create(asconn_type : TSConnectionType, alisten_port : uint16):
        sconn_type  = asconn_type
        listen_port = alisten_port
        swatcher    = new OSocketWatcher(64)
    endfunc

    func *Destroy():
        while connections.length > 0:
            delete connections.Pop()
        endwhile
        while closed_conns.length > 0:
            delete closed_conns.Pop()
        endwhile
    endfunc

    func InitListener() ..
    func WaitForEvents(timeout_ms : int) -> bool ..

    func HandleListener(aobj : Object) ..

    func CreateSConnection() -> OSConnection ..
    func CloseConnection(aconn : OSConnection) ..
endobject

//-----------------------------------------------------------------------------
// Multi-client connections
//-----------------------------------------------------------------------------

object OCConnection:  // Client connection to server
    server_port : uint16 = 80
    server_addr : embstr(128) = '127.0.0.1'

    sock    <- ONanoSocket(stTcp4)

    manager :  OMultiClientManager

    func *Create(amanager : OMultiClientManager) ..

    func Connect() [[virtual]] ..
    func Disconnect() [[virtual]] ..
    func HandleOutputForConnect(aobj : Object) [[virtual]] ..
    func HandleInput(aobj : Object) [[virtual]] ..
    func HandleOutput(aobj : Object) [[virtual]] ..
    func HandleConnectError(aerror : int) [[virtual]] ..

    func SetOutHandler(aoutev : FOutEventHandler) ..
endobject

object OMultiClientManager:
    swatcher    : autofree OSocketWatcher
    connections : [*]OCConnection

    func *Create():
        swatcher = new OSocketWatcher(64)
    endfunc

    func *Destroy():
        while connections.length > 0:
            delete connections.Pop()
        endwhile
    endfunc

    func AddConnection(aconn : OCConnection) ..
    func CloseConnection(aconn : OCConnection) ..
    func WaitForEvents(timeout_ms : int) -> bool ..
endobject

//-----------------------------------------------------------------------------
// UDP / datagram handling
//-----------------------------------------------------------------------------

const NANODG_MAX_LEN : uint = 1472  // maximal UDP payload size

object ONanoDatagram:
    remote_addr     : TSockAddr
    remote_addr_len : TSockLen

    server          : ONanoUdpServer
    keep_in_memory  : bool = false // false: released after processing

    rawdata_len     : int
    rawdata         : [NANODG_MAX_LEN + 1] byte

    func *Create(aserver : ONanoUdpServer) ..

    func RecvRawData() -> int ..
    func SendRawData() -> int ..
    func ProcessInData() [[virtual]] ..

    func SetRemoteAddr(aaddr : rostr, aport : uint16) ..
    func GetRemoteAddrStr() -> str ..
endobject

type TNanoDatagramType = type of ONanoDatagram

object ONanoUdpServer:
    dg_type     : TNanoDatagramType
    listen_port : uint16

    sock_listen <- ONanoSocket(stUdp4)
    swatcher    :  autofree OSocketWatcher

    func *Create(adg_type : TNanoDatagramType, alisten_port : uint16):
        dg_type = adg_type
        listen_port = alisten_port
        swatcher = new OSocketWatcher(64)
    endfunc

    func InitListener() ..
    func WaitForEvents(timeout_ms : int) -> bool ..
    func HandleListener(aobj : Object) ..
    func CreateDatagram() -> ONanoDatagram ..
endobject

implementation

use print, strutils

func ONanoSocket.*Create(atype : NSocketType):
    stype    = atype
    m_socket = @socket.INVALID_SOCKET
endfunc

func ONanoSocket.*Destroy():
    Disconnect()
endfunc

func ONanoSocket.Disconnect():
    if Connected():
        use socket
        libc_close(m_socket)
        m_socket = INVALID_SOCKET
    endif
endfunc

func ONanoSocket.Connected() -> bool:
    return m_socket <> @socket.INVALID_SOCKET
endfunc

func ONanoSocket.InitListener(aport : uint16):
    use socket, sys
    Disconnect()

    if stype == stUdp4:
        m_socket = libc_socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP)
    else:
        m_socket = libc_socket(AF_INET, SOCK_STREAM, 0)
    endif

    if m_socket == INVALID_SOCKET:
        raise ENanoNet('InitListener: Error creating the listener socket')
    endif

    SetSockParams()

    var arg : int = 1
    libc_setsockopt(m_socket, SOL_SOCKET, SO_REUSEADDR, %arg, SizeOf(arg))

    MemSet(%local_addr, 0, SizeOf(local_addr))
    local_addr.sin_family = AF_INET
    local_addr.sin_addr.s_addr = INADDR_ANY
    local_addr.sin_port = libc_htons(aport)

    if libc_bind(m_socket, %local_addr, SizeOf(local_addr)) <> 0:
        Disconnect()
        raise ENanoNet('InitListener: Error binding listener socket')
    endif

    if stype <> stUdp4:
        if libc_listen(m_socket, 64) <> 0:
            Disconnect()
            raise ENanoNet('InitListener: Listen error')
        endif
    endif
endfunc

func ONanoSocket.AcceptConnection(asvrsocket : TSocket) -> bool:
    use socket, sys
    Disconnect()

    MemSet(%remote_addr, 0, SizeOf(remote_addr))
    var sl : TSockLen = SizeOf(remote_addr)
    m_socket = libc_accept(asvrsocket, %remote_addr, %sl)

    if m_socket == INVALID_SOCKET:
        return false
    endif

    SetSockParams()
    return true
endfunc

func ONanoSocket.Send(pdata : pointer, srclen : uint) -> int:
    use socket
    result = libc_send(m_socket, pdata, srclen, #{ifndef WINDOWS} MSG_NOSIGNAL #{else} 0 #{endif})
    if result < 0:
        result = -SocketError()
    endif
endfunc

func ONanoSocket.Recv(pdata : pointer, maxlen : uint) -> int:
    use socket
    result = libc_recv(m_socket, pdata, maxlen, 0)
    if result < 0:
        result = -SocketError()
    endif
endfunc

func ONanoSocket.Connect(aaddr : rostr, aport : uint16) -> bool:
    use socket, sys
    Disconnect()

    MemSet(%remote_addr, 0, SizeOf(remote_addr))
    remote_addr.sin_family = AF_INET
    remote_addr.sin_port = libc_htons(aport)

    if libc_inet_pton(AF_INET, aaddr, %remote_addr.sin_addr) <> 1:
        raise ENanoNet('Invalid Host IP address: {}', [aaddr])
    endif

    m_socket = libc_socket(AF_INET, SOCK_STREAM, 0)
    if m_socket == INVALID_SOCKET:
        return false
    endif

    SetSockParams()

    var r : int = libc_connect(m_socket, %remote_addr, SizeOf(remote_addr))
    if r < 0:
        var err : int = SocketError()
        if err <> EWOULDBLOCK  and  err <> EINPROGRESS:
            Disconnect()
            return false
        endif
    endif

    return true
endfunc

func ONanoSocket.SetNonBlocking():
    if Connected():
        @socket.SetSocketNonBlocking(m_socket)
    endif
endfunc

func ONanoSocket.SetTcpNoDelay(anodelay : bool):
    var i : int
    if anodelay:
        i = 1
    else:
        i = 0
    endif

    use socket
    libc_setsockopt(m_socket, IPPROTO_TCP, TCP_NODELAY, %i, SizeOf(i))
endfunc

func ONanoSocket.SetSockBufSizes():
    // The Pascal version intentionally leaves these disabled: forcing them can
    // make large transfers slower on some systems.
    // use socket
    // libc_setsockopt(m_socket, SOL_SOCKET, SO_SNDBUF, %sendbuf_size, SizeOf(sendbuf_size))
    // libc_setsockopt(m_socket, SOL_SOCKET, SO_RCVBUF, %recvbuf_size, SizeOf(recvbuf_size))
endfunc

func ONanoSocket.SetSockParams():
    SetNonBlocking()
    if stype <> stUdp4:
        SetTcpNoDelay(true)
    endif
    SetSockBufSizes()
endfunc

//-----------------------------------------------------------------------------

func OSocketWatcher.*Create(amaxfds : int):
    maxfds = amaxfds
    fd_epoll = @socket.libc_epoll_create(amaxfds)
    revents.SetLength(maxevents)
endfunc

func OSocketWatcher.*Destroy():
    @socket.libc_close(fd_epoll)
    revents = []
endfunc

func OSocketWatcher.AddSocket(asock : ONanoSocket, aobj_link : Object, ainev : FInEventHandler, outev : FOutEventHandler):
    use socket
    if asock.socket == INVALID_SOCKET:
        raise ENanoNet('SocketWatcher.AddSocket: invalid socket handle.')
    endif

    asock.obj_link = aobj_link
    asock.in_event_handler = ainev
    asock.out_event_handler = outev

    var ev : SEpollEvent
    ev.events = 0
    if asock.in_event_handler <> nil:
        ev.events |= EPOLLIN
    endif
    if asock.out_event_handler <> nil:
        ev.events |= EPOLLOUT
    endif
    ev.data = pointer(asock)

    var r : int = libc_epoll_ctl(fd_epoll, EPOLL_CTL_ADD, asock.socket, %ev)
    if r < 0:
        if SocketError() == EEXIST:
            r = libc_epoll_ctl(fd_epoll, EPOLL_CTL_MOD, asock.socket, %ev)
        endif
        if r < 0:
            raise ENanoNet('SocketWatcher.AddSocket: Error adding socket to epoll.')
        endif
    endif
endfunc

func OSocketWatcher.ModifySocket(asock : ONanoSocket):
    use socket
    if asock.socket == INVALID_SOCKET:
        raise ENanoNet('SocketWatcher.ModifySocket: invalid socket handle.')
    endif

    var ev : SEpollEvent
    ev.events = 0
    if asock.in_event_handler <> nil:
        ev.events |= EPOLLIN
    endif
    if asock.out_event_handler <> nil:
        ev.events |= EPOLLOUT
    endif
    ev.data = pointer(asock)

    if libc_epoll_ctl(fd_epoll, EPOLL_CTL_MOD, asock.socket, %ev) < 0:
        raise ENanoNet('SocketWatcher.ModifySocket: Error changing socket in epoll.')
    endif
endfunc

func OSocketWatcher.RemoveSocket(asock : ONanoSocket):
    use socket
    if asock.socket <> INVALID_SOCKET:
        var ev : SEpollEvent
        ev.events = 0
        ev.data = nil
        libc_epoll_ctl(fd_epoll, EPOLL_CTL_DEL, asock.socket, %ev)
    endif
endfunc

func OSocketWatcher.SetOutHandler(asock : ONanoSocket, aoutev : FOutEventHandler):
    asock.out_event_handler = aoutev
    ModifySocket(asock)
endfunc

func OSocketWatcher.SetInHandler(asock : ONanoSocket, ainev : FInEventHandler):
    asock.in_event_handler = ainev
    ModifySocket(asock)
endfunc

func OSocketWatcher.WaitForEvents(atimeout_ms : int) -> bool:
    use socket
    result = false
    var evcnt : int = libc_epoll_wait(fd_epoll, %revents[0], maxevents, atimeout_ms)
    if evcnt <= 0:
        return false
    endif

    for i : int = 0  count evcnt:
        var pev : ^SEpollEvent = %revents[i]
        var sock : ONanoSocket = ONanoSocket(pev^.data)

        if (pev^.events & EPOLLOUT) <> 0:
            if sock.out_event_handler == nil:
                raise ENanoNet('Socket has no output event handler!')
            endif
            sock.out_event_handler(sock.obj_link)
            result = true
        endif

        if (pev^.events & EPOLLIN) <> 0:
            if sock.in_event_handler == nil:
                raise ENanoNet('Socket has no input event handler!')
            endif
            sock.in_event_handler(sock.obj_link)
            result = true
        endif
    endfor
endfunc

//-----------------------------------------------------------------------------

func OSConnection.Close():
    if server <> nil:
        server.CloseConnection(self)
    endif
endfunc

func OSConnection.AcceptConnection(svrsock : ONanoSocket) -> bool [[virtual]]:
    return sock.AcceptConnection(svrsock.socket)
endfunc

func OSConnection.HandleInput(aobj : Object) [[virtual]]:
    var buf : [256]byte
    sock.Recv(%buf[0], SizeOf(buf))
endfunc

func OSConnection.HandleOutput(aobj : Object) [[virtual]]:
endfunc

func OSConnection.SetOutHandler(aoutev : FOutEventHandler):
    server.swatcher.SetOutHandler(sock, aoutev)
endfunc

//-----------------------------------------------------------------------------

func ONanoServer.InitListener():
    sock_listen.InitListener(listen_port)
    swatcher.AddSocket(sock_listen, self, self.HandleListener, nil)
endfunc

func ONanoServer.WaitForEvents(timeout_ms : int) -> bool:
    // Wait for socket events and call the event handlers when necessary:
    result = swatcher.WaitForEvents(timeout_ms)

    // delete closed connections, here is safe to delete them
    while closed_conns.length > 0:
        delete closed_conns.Pop()
    endwhile
endfunc

func ONanoServer.HandleListener(aobj : Object):
    var conn : OSConnection = CreateSConnection()
    if not conn.AcceptConnection(sock_listen):
        delete conn
        return
    endif

    connections.Append(conn)
    swatcher.AddSocket(conn.sock, conn, conn.HandleInput, nil)
endfunc

func ONanoServer.CreateSConnection() -> OSConnection:
    return new sconn_type(self)
endfunc

func ONanoServer.CloseConnection(aconn : OSConnection):
    if aconn == nil:
        return
    endif

    swatcher.RemoveSocket(aconn.sock)
    aconn.sock.Disconnect()

    var idx : int = connections.IndexOf(aconn)
    if idx >= 0:
        // schedule the socket object for later deletion,
        // the current calling context might be sensible to instant-free (like self.Close())
        connections.Delete(idx)
        closed_conns.Append(aconn)
    endif
endfunc

//-----------------------------------------------------------------------------

func OCConnection.*Create(amanager : OMultiClientManager):
    manager = amanager
    manager.AddConnection(self)
endfunc

func OCConnection.Connect() [[virtual]]:
    if not sock.Connect(server_addr, server_port):
        raise ENanoNet('OCConnection.Connect: error initiating a connection')
    endif

    manager.swatcher.AddSocket(sock, self, nil, self.HandleOutputForConnect)
endfunc

func OCConnection.Disconnect() [[virtual]]:
    manager.CloseConnection(self)
endfunc

func OCConnection.HandleOutputForConnect(aobj : Object) [[virtual]]:
    use socket
    var err : int = 0
    var len : TSockLen = SizeOf(err)
    if libc_getsockopt(sock.socket, SOL_SOCKET, SO_ERROR, %err, %len) <> 0:
        err = SocketError()
    endif

    if err <> 0:
        HandleConnectError(err)
    else:
        // Connection completed: switch to the regular input/output handlers.
        sock.in_event_handler = self.HandleInput
        sock.out_event_handler = self.HandleOutput
        manager.swatcher.ModifySocket(sock)
        HandleOutput(sock.obj_link)
    endif
endfunc

func OCConnection.HandleInput(aobj : Object) [[virtual]]:
endfunc

func OCConnection.HandleOutput(aobj : Object) [[virtual]]:
endfunc

func OCConnection.HandleConnectError(aerror : int) [[virtual]]:
    use print
    PrintLn('connect error: {}', [aerror])
    manager.CloseConnection(self)
endfunc

func OCConnection.SetOutHandler(aoutev : FOutEventHandler):
    manager.swatcher.SetOutHandler(sock, aoutev)
endfunc

//-----------------------------------------------------------------------------

func OMultiClientManager.AddConnection(aconn : OCConnection):
    connections.Append(aconn)
endfunc

func OMultiClientManager.CloseConnection(aconn : OCConnection):
    // Keep the connection object for reuse; the manager owns it until destruction.
    swatcher.RemoveSocket(aconn.sock)
    aconn.sock.Disconnect()
endfunc

func OMultiClientManager.WaitForEvents(timeout_ms : int) -> bool:
    return swatcher.WaitForEvents(timeout_ms)
endfunc

//-----------------------------------------------------------------------------

func ONanoDatagram.*Create(aserver : ONanoUdpServer):
    server = aserver
    @sys.MemSet(%remote_addr, 0, SizeOf(remote_addr))
    remote_addr_len = SizeOf(remote_addr)
endfunc

func ONanoDatagram.RecvRawData() -> int:
    remote_addr_len = SizeOf(remote_addr)
    result = @socket.libc_recvfrom(server.sock_listen.socket, %rawdata[0], rawdata.length, 0, %remote_addr, %remote_addr_len)
    if result > 0:
        rawdata_len = result
    else:
        rawdata_len = 0
    endif
endfunc

func ONanoDatagram.SendRawData() -> int:
    return @socket.libc_sendto(server.sock_listen.socket, %rawdata[0], rawdata_len, 0, %remote_addr, remote_addr_len)
endfunc

func ONanoDatagram.ProcessInData() [[virtual]]:
    // Override to process the received datagram.
endfunc

func ONanoDatagram.SetRemoteAddr(aaddr : rostr, aport : uint16):
    use socket, sys
    MemSet(%remote_addr, 0, SizeOf(remote_addr))
    remote_addr_len = SizeOf(remote_addr)
    remote_addr.sin_family = AF_INET
    remote_addr.sin_port = libc_htons(aport)

    if libc_inet_pton(AF_INET, aaddr, %remote_addr.sin_addr) <> 1:
        raise ENanoNet('Invalid Host IP address: {}', [aaddr])
    endif
endfunc

func ONanoDatagram.GetRemoteAddrStr() -> str:
    use socket, strutils
    var buf : [INET_ADDRSTRLEN]char
    var addr : ^char = libc_inet_ntop(AF_INET, %remote_addr.sin_addr, %buf[0], SizeOf(buf))
    if addr == nil:
        raise ENanoNet('GetRemoteAddrStr: Error formatting remote address')
    endif
    return Format('{}:{}', [addr, libc_ntohs(remote_addr.sin_port)])
endfunc

//-----------------------------------------------------------------------------

func ONanoUdpServer.InitListener():
    sock_listen.InitListener(listen_port)
    swatcher.AddSocket(sock_listen, self, self.HandleListener, nil)
endfunc

func ONanoUdpServer.WaitForEvents(timeout_ms : int) -> bool:
    return swatcher.WaitForEvents(timeout_ms)
endfunc

func ONanoUdpServer.HandleListener(aobj : Object):
    var dg : ONanoDatagram = CreateDatagram()
    if dg.RecvRawData() > 0:
        dg.ProcessInData()
    endif
    if not dg.keep_in_memory:
        delete dg
    endif
endfunc

func ONanoUdpServer.CreateDatagram() -> ONanoDatagram:
    return new dg_type(self)
endfunc
