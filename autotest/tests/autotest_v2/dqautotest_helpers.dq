//?exitcode(0)

use dqautotest
use file

var run <- OTestRun()

func *Main() -> int:
    run.RunTool(['/bin/sh', '-c', 'printf out; printf err >&2; exit 3'])
    run.ExpectExitCode(3)
    ExpectContains(run.stdout, 'out')
    ExpectContains(run.stderr, 'err')
    ExpectNotContains(run.stdout, 'err')

    run.RunTool(['/dq-autotest-missing-tool'])
    run.ExpectExitCode(127)
    ExpectContains(run.stderr, 'dq-autotest-missing-tool')

    run.RunCompiler(['--version'])
    run.ExpectExitCode(0)
    ExpectContains(run.output, '.')
    var temp : str = TempPath('.txt')
    FileWriteText(temp, 'temporary artifact')
    ExpectFileContains(temp, 'artifact')
    RemoveTemp(temp)
    return TestResult()
endfunc
