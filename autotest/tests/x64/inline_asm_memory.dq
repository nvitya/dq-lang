use libc/stdio

func Load32(address : ^int32) -> int32 [[inline, asm]]:
    mov     $result, $address
    [[memread(address)]]
endfunc

func Store32(address : ^int32, value : int32) [[inline, asm]]:
    mov     $address, $value
    [[memwrite(address)]]
endfunc

// Declaration order differs from canonical LLVM operand order here.
func StoreValueFirst(value : int32, address : ^int32) [[inline, asm]]:
    mov     $address, $value
    [[memwrite(address)]]
endfunc

func AddTo32(address : ^int32, value : int32) [[inline, asm]]:
    add     $address, $value
    [[memreadwrite(address), clobber(flags)]]
endfunc

func Inc32(address : ^int32) [[inline, asm]]:
    inc     dword ptr $address
    [[memreadwrite(address), clobber(flags)]]
endfunc

func CompilerBarrier() [[inline, asm]]:
    [[clobber(memory)]]
endfunc

func LoadRef32(address : refin int32) -> int32 [[inline, asm]]:
    mov     $result, $address
    [[memread(address)]]
endfunc

func StoreRef32(address : refout int32, value : int32) [[inline, asm]]:
    mov     $address, $value
    [[memwrite(address)]]
endfunc

func AddRef32(address : ref int32, value : int32) [[inline, asm]]:
    add     $address, $value
    [[memreadwrite(address), clobber(flags)]]
endfunc

func *Main() -> int:
    var source : int32 = 123456789
    printf("inline_asm.memory.load = %li\n", int(Load32(%source)))
    //?check("inline_asm.memory.load", 123456789)

    var destination : int32 = 0
    Store32(%destination, -1234)
    printf("inline_asm.memory.store = %li\n", int(destination))
    //?check("inline_asm.memory.store", -1234)

    StoreValueFirst(31415, %destination)
    printf("inline_asm.memory.canonical = %li\n", int(destination))
    //?check("inline_asm.memory.canonical", 31415)

    var accumulator : int32 = 37
    AddTo32(%accumulator, 4)
    Inc32(%accumulator)
    printf("inline_asm.memory.readwrite = %li\n", int(accumulator))
    //?check("inline_asm.memory.readwrite", 42)

    CompilerBarrier()
    printf("inline_asm.memory.barrier = ok\n")
    //?check("inline_asm.memory.barrier", ok)

    var ref_source : int32 = 41
    printf("inline_asm.memory.refread = %li\n", int(LoadRef32(ref_source)))
    //?check("inline_asm.memory.refread", 41)

    var ref_destination : int32
    StoreRef32(ref_destination, 40)
    AddRef32(ref_destination, 2)
    printf("inline_asm.memory.refwrite = %li\n", int(ref_destination))
    //?check("inline_asm.memory.refwrite", 42)

    return 0
endfunc
