//?notest

const NESTED_REEXPORT_FLAG : bool = true

struct SHiddenPayload:
    value : int
endstruct

struct SSharedPayload:
    value : int
endstruct

func printf(fmt : ^char, ...) -> int [[external]]

func MakeHidden(value : int) -> SHiddenPayload:
    result.value = value
endfunc

func HiddenValue(payload : SHiddenPayload) -> int:
    result = payload.value
endfunc

func MakeShared(value : int) -> SSharedPayload:
    result.value = value
endfunc
