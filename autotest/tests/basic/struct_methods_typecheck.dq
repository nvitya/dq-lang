// struct method and managed member type checking

object OManaged:
endobject

struct SBadString:
    text : str //?error(NotSupported)
endstruct //?error(ModStatementUnknown)

struct SBadDynArray:
    items : [*]int //?error(NotSupported)
endstruct //?error(ModStatementUnknown)

struct SBadObject:
    item : OManaged //?error(NotSupported)
endstruct //?error(ModStatementUnknown)

struct SBadFixedArray:
    items : [2]str //?error(NotSupported)
endstruct //?error(ModStatementUnknown)

struct SNoLifecycle:
    func *Create(): //?error(ObjSpecFuncInvalid)
    endfunc
endstruct

struct SNoVirtual:
    func Bad() [[virtual]]: //?error(ObjFuncOverride)
    endfunc
endstruct

func *Main() -> int:
    return 0
endfunc
