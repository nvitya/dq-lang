func Print(fmt : strview) [[overload]]
func Print(fmt : strview, args : []anyvalue) [[overload]]
func PrintLn() [[overload]]
func PrintLn(fmt : strview) [[overload]]
func PrintLn(fmt : strview, args : []anyvalue) [[overload]]
func PrintFlush()

implementation

use rtl/textformat
use libc/stdio

func libc_fwrite(ptr : pointer, size : uint, count : uint, stream : pointer) -> uint  [[external('fwrite')]]
func libc_fputc(ch : int, stream : pointer) -> int  [[external("fputc")]]
func libc_fflush(stream : pointer) -> int  [[external('fflush')]]

var std_out_sink      : OTextSinkStdOut = nil
var std_out_formatter : OTextFormatter = nil

func StdOutFmtSetup():
    if std_out_sink == nil:
        std_out_sink = new OTextSinkStdOut()
    endif
    if std_out_formatter == nil:
        std_out_formatter = new OTextFormatter(std_out_sink)
    endif
endfunc

func Print(fmt : strview) [[overload]]:
    if std_out_sink == nil:
        StdOutFmtSetup()
    endif
    std_out_sink.Write(fmt)
endfunc

func Print(fmt : strview, args : []anyvalue) [[overload]]:
    if std_out_formatter == nil:
        StdOutFmtSetup()
    endif
    std_out_formatter.Format(fmt, args)
endfunc

func PrintLn() [[overload]]:
    if std_out_sink == nil:
        StdOutFmtSetup()
    endif
    std_out_sink.WriteChar('\n')
endfunc

func PrintLn(fmt : strview) [[overload]]:
    if std_out_sink == nil:
        StdOutFmtSetup()
    endif
    std_out_sink.Write(fmt)
    std_out_sink.WriteChar('\n')
endfunc

func PrintLn(fmt : strview, args : []anyvalue) [[overload]]:
    if std_out_formatter == nil:
        StdOutFmtSetup()
    endif
    std_out_formatter.Format(fmt, args)
    std_out_sink.WriteChar('\n')
endfunc

func PrintFlush():
    libc_fflush(@stdio.DqLibcStdout())
endfunc
