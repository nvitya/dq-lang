// object type variable type checking tests (ERROR test)

object OFactoryBase:
public
    v : int

    func *Create(av : int) [[overload]]:
        v = av
    endfunc

    func *Create(aname : cstring) [[overload]]:
        v = 1
    endfunc
endobject

object OPartialFactory(OFactoryBase):
public
    func *Create(av : int):
        inherited Create(av)
    endfunc
endobject

object OUnrelated:
public
    func *Create(av : int):
    endfunc
endobject

object OAbstract:
public
    func Read() -> int [[virtual, abstract]]
endobject

object OTrivialBase:
public
    value : int
endobject

object ONoDefault(OTrivialBase):
public
    func *Create(avalue : int):
        value = avalue
    endfunc
endobject

func *Main() -> int:
    var ft : type of OFactoryBase
    ft = OPartialFactory //?error(TypeMismatchAssign)
    ft = OUnrelated      //?error(TypeMismatchAssign)

    var at : type of OAbstract
    at = OAbstract       //?error(TypeMismatchAssign)

    var tt : type of OTrivialBase
    tt = ONoDefault      //?error(TypeMismatchAssign)

    var x : int = 0
    var ob : OFactoryBase = new x(1) //?error(TypeExpected)

    return 0
endfunc
