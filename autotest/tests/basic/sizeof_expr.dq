use libc/stdio

struct SSizeEntry:
    value : uint32
endstruct

var buffer : [7]byte
var index_calls : int = 0

func NextIndex() -> int:
    index_calls += 1
    return 0
endfunc

object OSizeProbe:
    entries : [3]SSizeEntry

    func Check():
        use *
        const ENTRY_SIZE : int = SizeOf(entries[NextIndex()])
        printf("method sizes = %li %li %li\n", SizeOf(buffer), ENTRY_SIZE, SizeOf(entries[0].value)) //?check("method sizes", "7 4 4")
    endfunc
endobject

func *Main():
    var probe <- OSizeProbe()
    probe.Check()

    var p : ^uint16
    printf("expression sizes = %li %li %li %i\n", SizeOf(p^), SizeOf(uint32(NextIndex())), SizeOf([uint16(1), uint16(2)]), SizeOf(1 + 2) == SizeOf(int)) //?check("expression sizes", "2 4 4 1")
    printf("type sizes = %li %li %i\n", SizeOf([3]uint16), SizeOf(embstr(12)), SizeOf(^uint16) == SizeOf(pointer)) //?check("type sizes", "6 12 1")
    printf("index calls = %li\n", index_calls) //?check("index calls", 0)
endfunc
