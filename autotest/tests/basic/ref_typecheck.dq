// reference type checking test (ERROR test)

func bad_default(a : ref int = 1):  //?error(FuncParDefaultRef)
endfunc

func old_param_mode_syntax(ref a : int):  //?error(FuncParNameInvalid)
endfunc

func takes_ref(a : ref int):
endfunc

func takes_refout(a : refout int):
    a = 1
endfunc

func takes_refnull(a : refnull int):
    if %a == nil:
        return
    endif
endfunc

func bad_refin(a : refin int):
    a = 1  //?error(RefReadonly)
endfunc

func bad_refout_read(a : refout int) -> int:
    result = a  //?error(RefOutRead)
endfunc
func *Main() -> int:
    var x : int = 1
    var y : int

    takes_ref(1)  //?error(FuncArgRefBind)
    takes_ref(y)  //?error(FuncArgRefInit)
    takes_ref(nil)  //?error(FuncArgRefNull)
    takes_refout(1)  //?error(FuncArgRefBind)
    takes_refnull(nil)

    ref bad : int  //?error(RefLocalInit)
    ref infer = 1  //?error(RefLocalBind)
    ref mismatch : bool = x  //?error(RefLocalType)
    refnull badnull : int  //?error(RefLocalMode)
    return 0
endfunc
