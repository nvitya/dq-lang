// A raw pointer borrowed as rostr must not inherit SDqTextInfo's 24-bit scan limit.
use libc/stdio
use rtl/rtlint
use rtl/strfunc

func *Main():
    var source : str
    source.SetLength(0x1000002, 'x')
    var raw : ^char = source.pchar
    var borrowed : rostr = raw
    var view : strslice = borrowed
    var desc : ^SDqRoStrInfo = ^SDqRoStrInfo(%borrowed)
    printf("large = %li:%li:%i:%i\n", source.length, view.length, desc.charlen, borrowed[$last] == 'x') //?check("large", "16777218:16777218:16777218:1")
    var direct : strslice = raw
    var direct_desc : ^SDqRoStrInfo = ^SDqRoStrInfo(%direct)
    printf("large_slice = %i:%i\n", direct_desc.charlen, direct[$last] == 'x') //?check("large_slice", "16777218:1")
    var known : rostr = source
    printf("large_known = %li\n", known.length) //?check("large_known", 16777218)
endfunc
