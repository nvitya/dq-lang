func DynStrAddLength(length : uint32, acount : int32) -> uint32:
    if acount < 1:
        return length
    endif

    var add_count : uint32 = acount
    result = length + add_count
    if result < length:
        DynStrRuntimeError('DynStr length overflow')
        return length
    endif
endfunc

func DynStrGrowCapacity(current_capacity : uint32, min_capacity : uint32) -> uint32:
    result = current_capacity
    if result < 1:
        result = 1
    endif

    while result < min_capacity:
        var doubled : uint32 = result * 2
        if doubled <= result:
            result = min_capacity
            return
        endif
        result = doubled
    endwhile
endfunc

func DynStrClampIndex(index : int, length : uint32) -> uint32:
    if index <= 0:
        return 0
    elif index >= length:
        return length
    else:
        return index
    endif
endfunc

func DynStrOwnDataPtrOffset(dataptr : ^char, src : ^char, length : uint32) -> int:
    if dataptr == nil  or  src == nil  or  length == 0:
        return -1
    endif

    var baseaddr : uint = uint(dataptr)
    var srcaddr  : uint = uint(src)
    if srcaddr < baseaddr  or  srcaddr >= baseaddr + uint(length):
        return -1
    endif

    result = srcaddr - baseaddr
endfunc

func DynStrSourceCount(asrc : ref SDqTextInfo, acount : int32) -> uint32:
    var srclen : uint32 = TextInfoCharLen(asrc)
    if acount < 0:
        return srclen
    endif

    result = uint32(acount)
    if result > srclen:
        result = srclen
    endif
endfunc

func DynStrCopyToCStr(adst : ref SDqTextInfo, srcptr : ^char, srclen : uint32) -> uint32:
    CStrClear(adst)
    if srcptr == nil  or  srclen == 0:
        return 0
    endif

    result = srclen
    var maxlen : uint32 = CStrMaxLen(adst)
    if result > maxlen:
        result = maxlen
    endif
    if result > 0:
        MemCopy(adst.dataptr, srcptr, uint(result))
    endif
    adst.charlen = result
    adst.info = adst.info | DQTIF_CHARLEN_VALID
    if adst.dataptr <> nil:
        adst.dataptr[result]^ = char(0)
    endif
endfunc

func DynStrEnsureUnique(astr : ref ODynStrMgr) -> bool:
    if astr == nil:
        return true
    endif
    if astr.refcount <= 1:
        return true
    endif

    var oldstr : ODynStrMgr = astr
    var newstr : ODynStrMgr = nil
    DynStrCreate(newstr)
    newstr.SetCapacity(oldstr.length)
    if newstr.capacity < oldstr.length:
        delete newstr = nil
        return false
    endif

    if oldstr.length > 0:
        MemCopy(newstr.dataptr, oldstr.dataptr, uint(oldstr.length))
    endif
    newstr.length = oldstr.length
    newstr.WriteTerminator()

    DynStrDecRef(astr)
    astr = newstr
    return true
endfunc


//----------------------------------------------------------------------------------------------

func ODynStrMgr.*Create():
    refcount = 0
    length = 0
    capacity = 0
    dataptr = nil
endfunc

func ODynStrMgr.*Destroy():
    if dataptr <> nil:
        @mem.MemFree(dataptr)
        dataptr = nil
    endif
    length = 0
    capacity = 0
endfunc

func ODynStrMgr.WriteTerminator():
    if dataptr <> nil:
        dataptr[length]^ = char(0)
    endif
endfunc

func ODynStrMgr.SetCapacity(new_capacity : uint32):
    use ., mem
    if new_capacity == capacity:
        return
    endif

    if new_capacity == 0:
        if dataptr <> nil:
            MemFree(dataptr)
            dataptr = nil
        endif
        capacity = 0
        length = 0
        return
    endif

    var new_bytes : uint = new_capacity + 1
    if new_bytes == 0:
        return
    endif

    var new_dataptr : ^char = nil
    if dataptr == nil:
        new_dataptr = ^char(MemAlloc(new_bytes))
    else:
        new_dataptr = ^char(MemRealloc(dataptr, new_bytes))
    endif

    if new_dataptr == nil:
        DynStrRuntimeError('DynStr allocation failed')
        return
    endif

    dataptr = new_dataptr
    capacity = new_capacity
    if length > new_capacity:
        length = new_capacity
    endif
    WriteTerminator()
endfunc

func ODynStrMgr.Reserve(min_capacity : uint32):
    if min_capacity <= capacity:
        return
    endif
    SetCapacity(@..DynStrGrowCapacity(capacity, min_capacity))
endfunc

func ODynStrMgr.SetLength(new_length : uint32):
    use ., mem
    if new_length < length:
        length = new_length
        WriteTerminator()
        return
    endif

    if new_length == length:
        return
    endif

    var old_length : uint32 = length
    Reserve(new_length)
    if capacity < new_length:
        return
    endif

    var zero_count : uint32 = new_length - old_length
    if zero_count == 0:
        return
    endif

    MemSet(dataptr[old_length], 0, zero_count)
    length = new_length
    WriteTerminator()
endfunc

func ODynStrMgr.Compact():
    if capacity > length:
        SetCapacity(length)
    endif
endfunc

func ODynStrMgr.Clear(free_storage : bool = false):
    length = 0
    if free_storage:
        SetCapacity(0)
    else:
        WriteTerminator()
    endif
endfunc

func ODynStrMgr.Append(asrc : ref SDqTextInfo, acount : int32):
    use ., mem
    var add_count : uint32 = DynStrSourceCount(asrc, acount)
    if add_count < 1:
        return
    endif

    var old_length : uint32 = length
    var new_length : uint32 = DynStrAddLength(length, add_count)
    if new_length <= length:
        return
    endif

    var owndata_src_index : int = DynStrOwnDataPtrOffset(dataptr, asrc.dataptr, old_length)
    if new_length > capacity:
        Reserve(new_length)
        if capacity < new_length:
            return
        endif
    endif

    var srcptr : ^char = asrc.dataptr
    if owndata_src_index >= 0:
        srcptr = dataptr[uint32(owndata_src_index)]
    endif

    MemCopy(dataptr[old_length],
            srcptr,
            uint(add_count))
    length = new_length
    WriteTerminator()
endfunc

func ODynStrMgr.Insert(index : int, asrc : ref SDqTextInfo, acount : int32):
    use ., mem
    var add_count : uint32 = DynStrSourceCount(asrc, acount)
    if add_count < 1:
        return
    endif

    var old_length : uint32 = length
    var insertpos : uint32 = DynStrClampIndex(index, old_length)
    var new_length : uint32 = DynStrAddLength(old_length, add_count)
    if new_length <= old_length:
        return
    endif

    var owndata_src_index : int = DynStrOwnDataPtrOffset(dataptr, asrc.dataptr, old_length)

    if new_length > capacity:
        Reserve(new_length)
        if capacity < new_length:
            return
        endif
    endif

    var tail_count : uint32 = old_length - insertpos
    if tail_count > 0:
        MemCopy(dataptr[insertpos + add_count],
                dataptr[insertpos],
                uint(tail_count))
    endif

    var dstptr : ^char = dataptr[insertpos]
    var copy_bytes : uint = uint(add_count)

    if owndata_src_index < 0:
        MemCopy(dstptr, asrc.dataptr, copy_bytes)
    else:
        var sidx : uint32 = uint32(owndata_src_index)
        if sidx + add_count <= insertpos:
            MemCopy(dstptr, dataptr[sidx], copy_bytes)
        elif sidx >= insertpos:
            MemCopy(dstptr, dataptr[sidx + add_count], copy_bytes)
        else:
            var left_count : uint32 = insertpos - sidx
            var right_count : uint32 = add_count - left_count
            MemCopy(dstptr,
                         dataptr[sidx],
                         uint(left_count))
            MemCopy(dstptr[left_count],
                         dataptr[insertpos + add_count],
                         uint(right_count))
        endif
    endif

    length = new_length
    WriteTerminator()
endfunc

func ODynStrMgr.Prepend(asrc : ref SDqTextInfo, acount : int32):
    Insert(0, asrc, acount)
endfunc

func ODynStrMgr.Delete(index : int, acount : int32):
    use ., mem
    if acount < 1  or  length == 0:
        return
    endif

    var deletepos : uint32 = DynStrClampIndex(index, length)
    if deletepos >= length:
        return
    endif

    var delcount : uint32 = acount
    if delcount > length - deletepos:
        delcount = length - deletepos
    endif

    var movecount : uint32 = length - deletepos - delcount
    if movecount > 0:
        MemCopy(dataptr[deletepos],
                dataptr[deletepos + delcount],
                uint(movecount))
    endif

    length -= delcount
    WriteTerminator()
endfunc

func ODynStrMgr.Pop(acount : int32, adst : ref SDqTextInfo):
    use .
    if acount < 1  or  length == 0:
        CStrClear(adst)
        return
    endif

    var popcount : uint32 = acount
    if popcount > length:
        popcount = length
    endif

    var startpos : uint32 = length - popcount
    popcount = DynStrCopyToCStr(adst, dataptr[startpos], popcount)
    length -= popcount
    WriteTerminator()
endfunc

func ODynStrMgr.PopFirst(acount : int32, adst : ref SDqTextInfo):
    if acount < 1  or  length == 0:
        @.CStrClear(adst)
        return
    endif

    var popcount : uint32 = acount
    if popcount > length:
        popcount = length
    endif

    popcount = @..DynStrCopyToCStr(adst, dataptr, popcount)
    Delete(0, int32(popcount))
endfunc

//----------------------------------------------------------------------------------------------

// DQ RTL DynStr Handler Functions

func DynStrCreate(astr : ref ODynStrMgr):
    astr = new ODynStrMgr()
    astr.refcount = 1
endfunc

func DynStrIncRef(astr : ref ODynStrMgr):
    if astr == nil:
        return
    endif

    // TODO: add thread safety
    astr.refcount += 1
endfunc

func DynStrDecRef(astr : ref ODynStrMgr):
    if astr == nil:
        return
    endif

    // TODO: add thread safety
    astr.refcount -= 1
    if astr.refcount <= 0:
        delete astr = nil
    endif
endfunc

func DynStrAssignOther(astr : ref ODynStrMgr, asrc : ODynStrMgr):
    if asrc <> nil:
        DynStrIncRef(asrc)
    endif
    DynStrDecRef(astr)
    astr = asrc
endfunc

func DynStrAssignData(astr : ref ODynStrMgr, ati : ref SDqTextInfo):
    var srclen : uint32 = TextInfoCharLen(ati)
    if srclen < 1:
        DynStrDecRef(astr)
        astr = nil
        return
    endif

    var newstr : ODynStrMgr = nil
    DynStrCreate(newstr)
    newstr.SetCapacity(srclen)
    if newstr.capacity < srclen:  // on storage allocation error
        delete newstr = nil
        return
    endif
    newstr.Append(ati, int32(srclen))

    DynStrDecRef(astr)
    astr = newstr
endfunc

//func DynStrGetElemPtr(astr : ref ODynStrMgr, index : int) -> ^char
func DynStrGetLength(astr : ref ODynStrMgr) -> uint32:
    if astr == nil:
        return 0
    endif
    return astr.length
endfunc

func DynStrGetCapacity(astr : ref ODynStrMgr) -> uint32:
    if astr == nil:
        return 0
    endif
    return astr.capacity
endfunc

func DynStrGetRefCount(astr : ref ODynStrMgr) -> int:
    if astr == nil:
        return 0
    endif
    return astr.refcount
endfunc

func DynStrPChar(astr : ref ODynStrMgr) -> ^char:
    // this must be checked separately, with a combined check the -O1 optimizer might make an error
    if astr == nil:
        return ''
    endif
    if astr.dataptr == nil:
        return ''
    endif
    return astr.dataptr
endfunc

func DynStrGetChar(astr : ref ODynStrMgr, index : int) -> char:
    if astr == nil:
        DynStrRuntimeError('DynStr index out of bounds')
        return char(0)
    endif
    DynStrCheckIndex(index, astr.length)
    result = astr.dataptr[index]^
endfunc

func DynStrSetChar(astr : ref ODynStrMgr, index : int, ch : char):
    if astr == nil:
        DynStrRuntimeError('DynStr index out of bounds')
        return
    endif
    DynStrCheckIndex(index, astr.length)
    var bch : char = DynStrCharToByte(ch)
    if not DynStrEnsureUnique(astr):
        return
    endif
    astr.dataptr[index]^ = bch
endfunc

func DynStrReserve(astr : ref ODynStrMgr, min_capacity : uint32):
    if min_capacity == 0:
        return
    endif
    if astr == nil:
        DynStrCreate(astr)
    endif
    if not DynStrEnsureUnique(astr):
        return
    endif
    astr.Reserve(min_capacity)
endfunc

func DynStrSetCapacity(astr : ref ODynStrMgr, new_capacity : uint32):
    if new_capacity == 0:
        DynStrDecRef(astr)
        astr = nil
    else:
        if astr == nil:
            DynStrCreate(astr)
        endif
        if not DynStrEnsureUnique(astr):
            return
        endif
        astr.SetCapacity(new_capacity)
    endif
endfunc

func DynStrSetLength(astr : ref ODynStrMgr, new_length : uint32):
    if new_length == 0:
        if astr <> nil:
            if not DynStrEnsureUnique(astr):
                return
            endif
            astr.length = 0
            astr.WriteTerminator()
        endif
    else:
        if astr == nil:
            DynStrCreate(astr)
        endif
        if not DynStrEnsureUnique(astr):
            return
        endif
        astr.SetLength(new_length)
    endif
endfunc

func DynStrSetLengthFill(astr : ref ODynStrMgr, new_length : uint32, fillchar : char):
    var bch : char = DynStrCharToByte(fillchar)
    var old_length : uint32 = DynStrGetLength(astr)
    DynStrSetLength(astr, new_length)
    if astr == nil  or  new_length <= old_length:
        return
    endif
    var i : uint32 = old_length
    while i < new_length:
        astr.dataptr[i]^ = bch
        i += 1
    endwhile
endfunc

func DynStrTruncate(astr : ref ODynStrMgr, new_length : uint32):
    if astr == nil:
        return
    endif
    if new_length >= astr.length:
        return
    endif
    if not DynStrEnsureUnique(astr):
        return
    endif
    astr.length = new_length
    astr.WriteTerminator()
endfunc

func DynStrCompact(astr : ref ODynStrMgr):
    if astr <> nil:
        astr.Compact()
    endif
endfunc

func DynStrClear(astr : ref ODynStrMgr, free_storage : bool = false):
    if astr <> nil:
        if free_storage:
            DynStrDecRef(astr)
            astr = nil
            return
        endif
        if not DynStrEnsureUnique(astr):
            return
        endif
        astr.Clear(free_storage)
    endif
endfunc

func DynStrAppend(astr : ref ODynStrMgr, asrc : ref SDqTextInfo, acount : int32):
    var add_count : uint32 = DynStrSourceCount(asrc, acount)
    if add_count < 1:
        return
    endif
    if astr == nil:
        DynStrCreate(astr)
    endif
    if not DynStrEnsureUnique(astr):
        return
    endif
    astr.Append(asrc, int32(add_count))
endfunc

func DynStrInsert(astr : ref ODynStrMgr, index : int, asrc : ref SDqTextInfo, acount : int32):
    var add_count : uint32 = DynStrSourceCount(asrc, acount)
    if add_count < 1:
        return
    endif
    if astr == nil:
        DynStrCreate(astr)
    endif
    if not DynStrEnsureUnique(astr):
        return
    endif
    astr.Insert(index, asrc, int32(add_count))
endfunc

func DynStrDelete(astr : ref ODynStrMgr, index : int, acount : int32 = 1):
    if astr <> nil:
        if not DynStrEnsureUnique(astr):
            return
        endif
        astr.Delete(index, acount)
    endif
endfunc

func DynStrGetFullView(astr : ref ODynStrMgr, rti : refout SDqTextInfo):
    if astr == nil:
        DynStrSetTextInfo(rti, nil, 0)
    else:
        DynStrSetTextInfo(rti, astr.dataptr, astr.length)
    endif
endfunc

func DynStrGetView(astr : ref ODynStrMgr, rti : refout SDqTextInfo, startpos : int, endposex : int):
    if astr == nil:
        DynStrSetTextInfo(rti, nil, 0)
        return
    endif

    var slen : uint32 = astr.length

    var b : int = startpos
    if b < 0:
        b = 0
    elif b >= slen:
        b = slen
    endif

    var e : int = endposex
    if e < 0:
        e = 0
    elif e >= slen:
        e = slen
    endif
    if e < b:
        e = b
    endif

    var viewlen : uint32 = e - b
    if viewlen == 0:
        DynStrSetTextInfo(rti, nil, 0)
    else:
        DynStrSetTextInfo(rti, astr.dataptr[b], viewlen)
    endif
endfunc

func DynStrClone(astr : ref ODynStrMgr, adst : ref ODynStrMgr):
    DynStrDecRef(adst)
    adst = nil

    if astr == nil:
        return
    endif
    if astr.length == 0:
        return
    endif

    DynStrCreate(adst)
    adst.SetCapacity(astr.length)
    if adst.capacity < astr.length:
        delete adst = nil
        return
    endif
    @mem.MemCopy(adst.dataptr, astr.dataptr, uint(astr.length))
    adst.length = astr.length
    adst.WriteTerminator()
endfunc

func DynStrCloneToCStr(astr : ref ODynStrMgr, adst : ref SDqTextInfo):
    if astr == nil:
        CStrClear(adst)
        return
    endif
    DynStrCopyToCStr(adst, astr.dataptr, astr.length)
endfunc

func DynStrPop(astr : ref ODynStrMgr, acount : int32, adst : ref ODynStrMgr):
    DynStrDecRef(adst)
    adst = nil

    if astr == nil:
        return
    endif
    if acount < 1:
        return
    endif
    if astr.length == 0:
        return
    endif
    if not DynStrEnsureUnique(astr):
        return
    endif

    var popcount : uint32 = acount
    if popcount > astr.length:
        popcount = astr.length
    endif

    DynStrCreate(adst)
    adst.SetCapacity(popcount)
    if adst.capacity < popcount:
        delete adst = nil
        return
    endif

    var startpos : uint32 = astr.length - popcount
    @mem.MemCopy(adst.dataptr,
                 astr.dataptr[startpos],
                 uint(popcount))
    adst.length = popcount
    adst.WriteTerminator()
    astr.Delete(int(startpos), int32(popcount))
endfunc

func DynStrPopToCStr(astr : ref ODynStrMgr, acount : int32, adst : ref SDqTextInfo):
    if astr == nil:
        CStrClear(adst)
        return
    endif
    astr.Pop(acount, adst)
endfunc

func DynStrPopFirst(astr : ref ODynStrMgr, acount : int32, adst : ref ODynStrMgr):
    DynStrDecRef(adst)
    adst = nil

    if astr == nil:
        return
    endif
    if acount < 1:
        return
    endif
    if astr.length == 0:
        return
    endif
    if not DynStrEnsureUnique(astr):
        return
    endif

    var popcount : uint32 = acount
    if popcount > astr.length:
        popcount = astr.length
    endif

    DynStrCreate(adst)
    adst.SetCapacity(popcount)
    if adst.capacity < popcount:
        delete adst = nil
        return
    endif

    @mem.MemCopy(adst.dataptr, astr.dataptr, popcount)
    adst.length = popcount
    adst.WriteTerminator()
    astr.Delete(0, int32(popcount))
endfunc

func DynStrPopFirstToCStr(astr : ref ODynStrMgr, acount : int32, adst : ref SDqTextInfo):
    if astr == nil:
        CStrClear(adst)
        return
    endif
    astr.PopFirst(acount, adst)
endfunc

func DynStrPopChar(astr : ref ODynStrMgr) -> char:
    if astr == nil:
        DynStrRuntimeError('DynStr pop from empty string')
        return char(0)
    endif
    if astr.length == 0:
        DynStrRuntimeError('DynStr pop from empty string')
        return char(0)
    endif
    result = DynStrGetChar(astr, int(astr.length - 1))
    DynStrDelete(astr, int(astr.length - 1), 1)
endfunc

func DynStrPopFirstChar(astr : ref ODynStrMgr) -> char:
    if astr == nil:
        DynStrRuntimeError('DynStr pop from empty string')
        return char(0)
    endif
    if astr.length == 0:
        DynStrRuntimeError('DynStr pop from empty string')
        return char(0)
    endif
    result = DynStrGetChar(astr, 0)
    DynStrDelete(astr, 0, 1)
endfunc
