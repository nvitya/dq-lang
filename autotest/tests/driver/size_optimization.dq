//?exitcode(0)

use dqautotest

var run <- OTestRun()

function CheckOptimization(option : strview, expect_minsize : bool):
    var output : str = TempPath('.o')
    var opt : str = option
    run.RunCompiler([
        '--target=arm_m7f-bare', '--no-use-sys', opt, '-ir', '-c',
        '-o', output, SourcePath('../../target/arm_m7f_pointer_const.dq')
    ])
    run.ExpectExitCode(0)
    run.ExpectOutputContains('optsize')
    if expect_minsize:
        run.ExpectOutputContains('minsize')
    endif
    RemoveTemp(output)
endfunc

function *Main() -> int:
    CheckOptimization('-Os', false)
    CheckOptimization('-Oz', true)
    return TestResult()
endfunc
