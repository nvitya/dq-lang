func Print(fmt : strslice) [[overload]] ..
func Print(fmt : rostr, args : []anyvalue) [[overload]] ..
func PrintLn() [[overload]] ..
func PrintLn(fmt : strslice) [[overload]] ..
func PrintLn(fmt : rostr, args : []anyvalue) [[overload]] ..
func PrintFlush() ..

func PrintSetUnbuffered() ..

implementation

use rtl/textformat
use libc/stdio

func libc_fwrite(ptr : pointer, size : uint, count : uint, stream : pointer) -> uint  [[external('fwrite')]] ..
func libc_fputc(ch : int, stream : pointer) -> int  [[external("fputc")]] ..
func libc_fflush(stream : pointer) -> int  [[external('fflush')]] ..

var std_out_sink      <- OTextSinkStdOut()
var std_out_formatter <- OTextFormatter(std_out_sink)

func Print(fmt : strslice) [[overload]]:
    std_out_sink.Write(fmt)
endfunc

func Print(fmt : rostr, args : []anyvalue) [[overload]]:
    std_out_formatter.Format(fmt, args)
endfunc

func PrintLn() [[overload]]:
    std_out_sink.WriteChar('\n')
endfunc

func PrintLn(fmt : strslice) [[overload]]:
    std_out_sink.Write(fmt)
    std_out_sink.WriteChar('\n')
endfunc

func PrintLn(fmt : rostr, args : []anyvalue) [[overload]]:
    std_out_formatter.Format(fmt, args)
    std_out_sink.WriteChar('\n')
endfunc

func PrintFlush():
    libc_fflush(@stdio.StdOut())
endfunc

func PrintSetUnbuffered():
    @stdio.SetStdOutUnbuffered()
endfunc
