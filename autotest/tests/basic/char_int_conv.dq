// Character/integer conversion behavior from doc/dq-char-int-conv.md.

use libc/stdio
use rtl/strfunc

func GetValue(v : int) -> int:
    return v
endfunc

func Flag(v : bool) -> int:
    if v:
        return 1
    endif
    return 0
endfunc

func *Main():
    var c : char = 'A'
    var cmax : char = char(255)
    var wc_ascii : wchar = 'A'
    var wc_euro : wchar = '€'
    var wc_smile : wchar = wchar(0x1F600)
    var c16 : char16 = char16(0xD800)

    printf("char_int.ord = %li %li %li %li\n", Ord(c), Ord(wc_ascii), Ord(wc_euro), Ord(c16))
    //?check("char_int.ord", "65 65 8364 55296")

    printf("char_int.member_ord = %li %li %li %li\n", c.ord, wc_ascii.ord, wc_euro.ord, c16.ord)
    //?check("char_int.member_ord", "65 65 8364 55296")

    printf("char_int.member_ord_types = %s %s %s\n", TypeName(c.ord), TypeName(c16.ord), TypeName(wc_euro.ord))
    //?check("char_int.member_ord_types", "int int int")

    printf("char_int.member_ord_constants = %li %li %li %li\n",
           char(0).ord, char(255).ord, char16(0xFFFF).ord, '€'.ord)
    //?check("char_int.member_ord_constants", "0 255 65535 8364")

    printf("char_int.member_ord_runtime = %li %li %li\n",
           char(GetValue(255)).ord, char16(GetValue(0xFFFF)).ord, wchar(GetValue(0x10FFFF)).ord)
    //?check("char_int.member_ord_runtime", "255 65535 1114111")

    var text : str = "Az"
    printf("char_int.member_ord_index = %li %li\n", text[0].ord, text.wchar[1].ord)
    //?check("char_int.member_ord_index", "65 122")

    printf("char_int.casts = %li %li %li %li %li\n",
           Ord(char(65)), Ord(cmax), Ord(char16(0xFFFF)), Ord(wchar(0xFD00)), Ord(wc_smile))
    //?check("char_int.casts", "65 255 65535 64768 128512")

    var rv : int = GetValue(300)
    printf("char_int.runtime = %li %li %li\n", Ord(char(rv)), Ord(wchar(rv)), Ord(char16(rv)))
    //?check("char_int.runtime", "44 300 300")

    printf("char_int.checked = %li %li %li %li\n",
           Ord(IntToChar(65)), Ord(IntToChar(255)), Ord(IntToChar(-1, '?')), Ord(IntToWchar(0x110000, '?')))
    //?check("char_int.checked", "65 255 63 63")

    var caught_char : bool = false
    try:
        var bad_char : char = IntToChar(-1)
    except Exception:
        caught_char = true
    endtry

    var caught_wchar : bool = false
    try:
        var bad_wchar : wchar = IntToWchar(0xD800)
    except Exception:
        caught_wchar = true
    endtry
    printf("char_int.checked_raise = %li %li\n", Flag(caught_char), Flag(caught_wchar))
    //?check("char_int.checked_raise", "1 1")

endfunc
