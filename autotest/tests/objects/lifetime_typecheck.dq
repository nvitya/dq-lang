// object storage and lifetime type checking tests (ERROR test)

object OTest:
    value : int

    func *Create():
    endfunc

    func *Destroy(a : int): //?error(SpecialFuncSignature)
    endfunc
endobject

object OMissing:
    child <- OTest

    func *Create():
    endfunc //?error(SpecialFuncInvalid)
endobject

object ODouble:
    child <- OTest()

    func *Create():
        child.Create() //?error(SpecialFuncInvalid)
    endfunc
endobject

object OPrivate:
private
    secret : int
public
    func Get() -> int:
        result = secret
    endfunc
endobject

func *Main() -> int:
    result = 0

    var fixed <- OTest()
    var ref : OTest = nil
    var priv <- OPrivate

    result = priv.secret //?error(MemberUnknown)
    fixed = ref          //?error(RefReadonly)
    var bad : OTest = {} //?error(NotSupported)

endfunc
