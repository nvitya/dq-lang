use print
use shell

var osh <- OShellRunner()

func *Main() -> int:
    PrintLn('Shell util test')

    // execute the dq-comp, provide empty input str, collect the output str

    PrintLn('dq-comp version:')
    osh.Run('dq-comp --version')
    PrintLn(osh.output)

    PrintLn('dq-comp help:')
    //osh.Run(['dq-comp'])
    osh.Run(['dq-comp'], false) // false: do not cause an exeption when the result code is not 0
    PrintLn(osh.output)
    PrintLn('result code: {}', [osh.exitcode])

    osh.Run('ls -l')
    PrintLn(osh.output)

    osh.RunWithInput('cat', 'qqcs')
    PrintLn('shellinout result: "{}"', [osh.output])

    var s : str
    s = GetEnv('HOME', '?')
    PrintLn('HOME={}', [s])

    s = GetEnv('QQRIQ', '?')
    PrintLn('QQRIQ={}', [s])

    SetEnv('QQRIQ', '123')

    s = GetEnv('QQRIQ', '?')
    PrintLn('QQRIQ={}', [s])

    return 0
endfunc