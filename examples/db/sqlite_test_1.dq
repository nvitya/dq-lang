// testing sqlite database handling

use ./sqlite3
use print
use file

const DB_NAME : cstring = 'capitals.db'

const CAPITALS_STRUCT : cstring =
"""
create table capitals
(
    ID         integer PRIMARY KEY AUTOINCREMENT,
    CITY       varchar(80),
    COUNTRY    varchar(80),
    CONTINENT  varchar(40)
);
"""

