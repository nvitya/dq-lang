func main(argc : int, argv : ^^char) -> int  [[cexport]] ..

implementation

use rtl/rtlint
#ifdef EXCEPTIONS
use rtl/exception
use rtl/backtrace
#endif
use rtl/prgargs
use rtl/mem
use libc/stdio

// These functions are created by the DQ compiler:
func dq_main()         [[external('dq_main')]] ..
func dq_module_init()  [[external('dq_module_init')]] ..

#ifdef EXCEPTIONS

// Windows structured exception handling, converting page faults to Exception

object ESegFault(Exception):
endobject

const DQ_WIN_FAULT_BACKTRACE_MAX : int = 32

struct SDqWinExceptionRecord:
    ExceptionCode    : uint32
    ExceptionFlags   : uint32
    ExceptionRecord  : pointer
    ExceptionAddress : pointer
endstruct

struct SDqWinExceptionPointers:
    ExceptionRecord : ^SDqWinExceptionRecord
    ContextRecord   : pointer
endstruct

struct SDqWinDispatcherContext:
    ControlPc : uint64
endstruct

type FWinExceptionFilter = func(exception_info : pointer) -> int32

func win_AddVectoredExceptionHandler(first : uint32, handler : FWinExceptionFilter) -> pointer [[external('AddVectoredExceptionHandler')]] ..
func win_GxxPersonality(record : ^SDqWinExceptionRecord, frame : pointer, context : pointer,
                       dispatch : ^SDqWinDispatcherContext) -> int32 [[external('__gxx_personality_seh0')]] ..

const EXCEPTION_ACCESS_VIOLATION : uint32 = 0xC0000005
const EXCEPTION_CONTINUE_SEARCH  : int32 = 0
const STATUS_GCC_THROW           : uint32 = 0x20474343
const STATUS_GCC_UNWIND          : uint32 = 0x21474343

var dq_win_fault_backtrace : [DQ_WIN_FAULT_BACKTRACE_MAX] pointer

var dq_win_fault_handling : int = 0
var dq_win_fault_backtrace_count : int = 0
var dq_win_fault_pc : uint64 = 0

func DqWinPersonality(record : ^SDqWinExceptionRecord, frame : pointer, context : pointer,
                     dispatch : ^SDqWinDispatcherContext) -> int32 [[cexport]]:
    var pc : uint64 = dispatch.ControlPc
    // MinGW looks up ControlPc - 1, as for a call's return address. The
    // dispatcher's machine frame supplies the faulting PC instead. Correct
    // that lookup on the exception path, including a range's first instruction.
    if record.ExceptionCode == STATUS_GCC_THROW and pc == dq_win_fault_pc:
        dispatch.ControlPc = pc + 1
    elif record.ExceptionCode == STATUS_GCC_UNWIND:
        // The collided unwind is entering a cleanup or catch landing pad;
        // subsequent propagation uses ordinary return addresses again.
        dq_win_fault_pc = 0
    endif
    result = win_GxxPersonality(record, frame, context, dispatch)
    dispatch.ControlPc = pc
endfunc

func OsRtErrorHandler(emsg : ^char):
    DqExcRaise(new Exception(emsg), true)
endfunc

func DqWinFaultIsAccessViolation(exception_info : pointer) -> bool:
    if exception_info == nil:
        return false
    endif

    var info : ^SDqWinExceptionPointers = ^SDqWinExceptionPointers(exception_info)
    if info.ExceptionRecord == nil:
        return false
    endif

    return info.ExceptionRecord.ExceptionCode == EXCEPTION_ACCESS_VIOLATION
endfunc

func PrintException(e : Exception) -> int:
    printf("\nUNCAUGHT EXCEPTION: ")
    printf("%s", TypeName(e))
    printf(": ")
    e.PrintMessage()
    printf("\n")
    e.PrintBacktrace()
    return -1
endfunc

func PrintUncaughtException() -> int:
    result = PrintException(DqExcCurrent())
    DqExcClear()
endfunc

func DqWinFaultHandler(exception_info : pointer) -> int32:
    if dq_win_fault_handling <> 0  or  not DqWinFaultIsAccessViolation(exception_info):
        return EXCEPTION_CONTINUE_SEARCH
    endif

    dq_win_fault_handling = 1
    dq_win_fault_backtrace_count = DqCaptureBacktrace(%dq_win_fault_backtrace, DQ_WIN_FAULT_BACKTRACE_MAX)
    var info : ^SDqWinExceptionPointers = ^SDqWinExceptionPointers(exception_info)
    dq_win_fault_pc = uint64(info.ExceptionRecord.ExceptionAddress)
    var e = new ESegFault("Segmentation fault")
    // Native SEH unwinding reaches the faulting scopes and their cleanups.
    // Reset the recursion guard before throwing so later faults are catchable.
    dq_win_fault_handling = 0
    DqExcRaiseWithBacktrace(e, true,
                           %dq_win_fault_backtrace, dq_win_fault_backtrace_count)

    return EXCEPTION_CONTINUE_SEARCH
endfunc

//-----------------------------------------------------------------------------

func RunHostedMain() -> int:
    result = 0
    try:
        dq_module_init()
    except Exception as e:
        return PrintException(e)
    endtry

    if DqExcActive():
        return PrintUncaughtException()
    endif

    try:
        dq_main()
        result = exit_code
    except Exception as e:
        result = PrintException(e)
    endtry

    if DqExcActive():
        result = PrintUncaughtException()
    endif
endfunc

// libc entry point 'main()'

func main(argc : int, argv : ^^char) -> int  [[cexport]]:

    rterror_handler = OsRtErrorHandler
    DqPrepareBacktrace()
    win_AddVectoredExceptionHandler(1, DqWinFaultHandler)

    @prgargs.__sys_init_params(argc, argv)

    result = RunHostedMain()

    // no finalize for modules

endfunc

#else

func win_ExitProcess(exit_code : uint32) [[external('ExitProcess')]] ..

func OsRtErrorHandler(emsg : ^char):
    printf("RUNTIME ERROR: %s\n", emsg)
    win_ExitProcess(255)
endfunc

func main(argc : int, argv : ^^char) -> int  [[cexport]]:
    rterror_handler = OsRtErrorHandler
    @prgargs.__sys_init_params(argc, argv)
    dq_module_init()
    dq_main()
    result = exit_code
endfunc

#endif
