// Exception propagation across a func call.

func printf(fmt : ^char, ...) -> int [[external]]

var reached : int = 0

func Thrower():
    raise Exception("from thrower")
    reached = 1
endfunc

func *Main() -> int:
    try:
        Thrower()
        reached = 2
    except Exception as e:
        printf("exception.propagate = caught ")
        e.PrintMessage()
        printf(" reached=%d\n", reached)
        //?check("exception.propagate", "caught from thrower reached=0")
    endtry

    return 0
endfunc
