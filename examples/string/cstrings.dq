
use print

// Test1

func CsProcess(cs : cstring):
    cs.Append(' five')
endfunc

func Test1():
    var cs1 : cstring(31) = 'One two three'  // 32 byte storage

    cs1.Append(' four')
    CsProcess(cs1)

    PrintLn('Test1: "{}"', [cs1])
endfunc

// Test2

struct STestRec:
    id   : int32
    name : cstring(31)
endstruct

func ProcessName(tr : ref STestRec):
    tr.name.Append(" two")
endfunc

func Test2():
    var tr : STestRec
    tr.name = "one"
    ProcessName(tr)
    PrintLn('Test2: "{}"', [tr.name])
endfunc

func *Main():
    PrintLn('DQ cstring test')
    Test1()
    Test2()
endfunc