//required: "use time"

// Thread notification. Snapshot before testing the shared predicate;
// WaitUntilNanos then sleeps only if no notification occurred in the meantime.
#ifdef WINDOWS
#linklib('synchronization')

func win_WaitOnAddress(address : ^uint32, compare : ^uint32, size : uint,
                        milliseconds : uint32) -> int32 [[external('WaitOnAddress')]] ..
func win_WakeByAddressSingle(address : ^uint32) [[external('WakeByAddressSingle')]] ..
func win_GetLastError() -> uint32 [[external('GetLastError')]] ..

const WIN_ERROR_TIMEOUT : uint32 = 1460

#else

struct SFutexTime:
    tv_sec  : int64
    tv_nsec : int64
endstruct

// 32-bit Linux uses futex_time64 to keep the same timespec layout.
#ifdef X64
    const SYS_FUTEX : int = 202
#elifdef X86
    const SYS_FUTEX : int = 422
#elifdef ARM
    const SYS_FUTEX : int = 422
#else // ARM64 and RISCV64 use the generic syscall table.
    const SYS_FUTEX : int = 98
#endif

const FUTEX_WAIT_BITSET_PRIVATE : int32  = 137
const FUTEX_WAKE_PRIVATE        : int32  = 129
const FUTEX_BITSET_MATCH_ANY    : uint32 = 0xFFFFFFFF

func futex(number : int, address : ^uint32, operation : int32, value : uint32,
           timeout : ^SFutexTime, address2 : pointer, bitset : uint32) -> int [[external('syscall')]] ..

const EINTR  : int32 =  4
const EAGAIN : int32 = 11

#endif

//-----------------------------------------------------------------------------

func OThreadEvent.Snapshot() -> uint32 [[inline]]:
    use .
    return m_sequence.Load()
endfunc

func OThreadEvent.Signal():
    use .
    m_sequence.Add(1)
    // The sequence change and waiter registration are totally ordered: either
    // we wake a registered waiter, or its kernel comparison sees the change.
    if m_waiters.Load() <> 0:
        #ifdef WINDOWS
            win_WakeByAddressSingle(m_sequence.Address())
        #else
            futex(SYS_FUTEX, m_sequence.Address(), FUTEX_WAKE_PRIVATE, 1, nil, nil, 0)
        #endif
    endif
endfunc

func OThreadEvent.WaitUntilNanos(asequence : uint32, adeadline : int64) -> bool:
    use .
    #ifdef WINDOWS
        // Windows takes a relative millisecond timeout. Round up and cap finite
        // chunks below INFINITE, rechecking the original monotonic deadline.
        while true:
            var milliseconds : uint32 = 0xFFFFFFFF
            if adeadline >= 0:
                var now : int64 = @time.NanoTime()
                if now >= adeadline:
                    return false
                endif
                var remaining_ms : int64 = (adeadline - now - 1) div 1000000 + 1
                milliseconds = 0xFFFFFFFE
                if remaining_ms < milliseconds:
                    milliseconds = remaining_ms
                endif
            endif
            m_waiters.Add(1)
            var rc : int32 = win_WaitOnAddress(m_sequence.Address(), %asequence, 4, milliseconds)
            var error : uint32 = win_GetLastError()
            m_waiters.Add(0xFFFFFFFF)
            if rc <> 0:
                return true
            endif
            if error <> WIN_ERROR_TIMEOUT or adeadline < 0:
                return false
            endif
        endwhile
        return false
    #else
        var timeout     : SFutexTime
        var timeout_ptr : ^SFutexTime = nil
        if adeadline >= 0:
            if @time.NanoTime() >= adeadline:
                return false
            endif
            timeout.tv_sec  = adeadline div 1000000000
            timeout.tv_nsec = adeadline rem 1000000000
            timeout_ptr = %timeout
        endif

        m_waiters.Add(1)
        var rc : int = futex(SYS_FUTEX, m_sequence.Address(), FUTEX_WAIT_BITSET_PRIVATE,
                              asequence, timeout_ptr, nil, FUTEX_BITSET_MATCH_ANY)
        var error : int32 = @sys.Errno()
        m_waiters.Add(0xFFFFFFFF) // unregister, including on timeout
        return rc == 0 or error == EAGAIN or error == EINTR
    #endif
endfunc
