// Shell command runner with separately captured stdout and stderr.

use threads
use time

object EShellStart(Exception):
endobject

object EShellResult(Exception):
    code : int
    func *Create(acode : int, amsg : rostr)                        [[overload]] ..
    func *Create(acode : int, afmt : strslice, avalues : []anyvalue)  [[overload]] ..
endobject

#ifdef WINDOWS
#include "./shell_windows.dqh"
#endif

object OShellRunner(OThread):
    exitcode : int = 0
    finished : bool = true

    out    : str = ''
    err    : str = ''
    output : str = ''  // stdout and stderr merged in pipe-read order

    func Run(acmd : rostr, exitcerr : bool = true) -> int [[overload]] ..
    func Run(args : []rostr, exitcerr : bool = true) -> int [[overload]] ..
    func RunWithInput(acmd : rostr, ainput : strslice, exitcerr : bool = true) -> int [[overload]] ..
    func RunWithInput(args : []rostr, ainput : strslice, exitcerr : bool = true) -> int [[overload]] ..
    func StartBg(acmd : rostr) -> int [[overload]] ..
    func StartBg(args : []rostr) -> int [[overload]] ..
    func StartBgWithInput(acmd : rostr, ainput : strslice) -> int [[overload]] ..
    func StartBgWithInput(args : []rostr, ainput : strslice) -> int [[overload]] ..

    func Finished() -> bool ..
    func WaitFinishMs(ams : int) -> bool ..
    func Kill() ..

#ifdef WINDOWS
    func *Destroy() ..
#endif

protected
    provide_stdin : bool = false
    shell_command : bool = false
    in_buffer : str = ''
    in_buffer_pos : int = 0

#ifdef WINDOWS
    process_handle : uint = 0
    job_handle : uint = 0
    in_pipe : SShellPipe = {}
    out_pipe : SShellPipe = {}
    err_pipe : SShellPipe = {}

    func CloseProcessHandles() ..
    func WindowsCommandLine(args : []rostr) -> str ..
    func WriteInput(aarg : pointer) -> pointer ..
#else
    pid : int32 = 0
    in_fd  : int32 = -1
    out_fd : int32 = -1
    err_fd : int32 = -1
#endif

    func ExecuteCommand(acmd : rostr, ainput : strslice, with_input : bool,
                        background : bool, exitcerr : bool) -> int ..
    func Execute(args : []rostr, ainput : strslice, with_input : bool,
                 background : bool, exitcerr : bool, use_shell : bool = false) -> int ..
    func StartProcess(args : []rostr) -> int ..
    func MonitorProcess() ..
    func MonitorThread(aarg : pointer) -> pointer ..
    func TerminateChild() ..
endobject

func GetEnv(name : rostr, default_value : rostr) -> str ..
func SetEnv(name : rostr, value : rostr) ..

#ifdef WINDOWS
#srcdep "./shell_windows.dqi"
#else
#srcdep "./shell_posix.dqi"
#endif

implementation

func EShellResult.*Create(acode : int, amsg : rostr) [[overload]]:
    inherited Create(amsg)
    code = acode
endfunc

func EShellResult.*Create(acode : int, afmt : strslice,
                              avalues : []anyvalue) [[overload]]:
    inherited Create(afmt, avalues)
    code = acode
endfunc

//-----------------------------------------------------------------------------

#ifdef WINDOWS
#include "./shell_windows.dqi"
#else
#include "./shell_posix.dqi"
#endif

func OShellRunner.ExecuteCommand(acmd : rostr, ainput : strslice, with_input : bool,
                                 background : bool, exitcerr : bool) -> int:
    if acmd.length == 0:
        raise EShellStart('Empty command')
    endif
    var command : str = acmd
#ifdef WINDOWS
    var interpreter : str = @.GetEnv('COMSPEC', 'cmd.exe')
    return Execute([interpreter, '/d', '/s', '/c', command], ainput,
                   with_input, background, exitcerr, true)
#else
    return Execute(['/bin/sh', '-c', command], ainput,
                   with_input, background, exitcerr, true)
#endif
endfunc

func OShellRunner.Execute(args : []rostr, ainput : strslice, with_input : bool,
                          background : bool, exitcerr : bool, use_shell : bool = false) -> int:
    if args.length == 0 or args[0].length == 0:
        raise EShellStart('Empty argument list or executable')
    endif
    // Reap the previous monitor before replacing any of its state.
    if IsRunning() or not finished:
        return -1
    endif

    out = ''
    err = ''
    output = ''
    exitcode = -1
    finished = false
    provide_stdin = with_input
    shell_command = use_shell
    in_buffer = ainput
    in_buffer_pos = 0

    try:
        StartProcess(args)
    except Exception:
        finished = true
        raise
    endtry

    if background:
        if not StartMethod(self.MonitorThread, nil):
            TerminateChild()
            MonitorProcess()
            finished = true
            return -1
        endif
        return 0
    endif

    MonitorProcess()
    finished = true
    if exitcerr and exitcode <> 0:
        raise EShellResult(exitcode, 'Process exited with code {}', [exitcode])
    endif
    return exitcode
endfunc

func OShellRunner.Run(acmd : rostr, exitcerr : bool = true) -> int [[overload]]:
    return ExecuteCommand(acmd, '', false, false, exitcerr)
endfunc

func OShellRunner.Run(args : []rostr, exitcerr : bool = true) -> int [[overload]]:
    return Execute(args, '', false, false, exitcerr)
endfunc

func OShellRunner.RunWithInput(acmd : rostr, ainput : strslice, exitcerr : bool = true) -> int [[overload]]:
    return ExecuteCommand(acmd, ainput, true, false, exitcerr)
endfunc

func OShellRunner.RunWithInput(args : []rostr, ainput : strslice, exitcerr : bool = true) -> int [[overload]]:
    return Execute(args, ainput, true, false, exitcerr)
endfunc

func OShellRunner.StartBg(acmd : rostr) -> int [[overload]]:
    return ExecuteCommand(acmd, '', false, true, false)
endfunc

func OShellRunner.StartBg(args : []rostr) -> int [[overload]]:
    return Execute(args, '', false, true, false)
endfunc

func OShellRunner.StartBgWithInput(acmd : rostr, ainput : strslice) -> int [[overload]]:
    return ExecuteCommand(acmd, ainput, true, true, false)
endfunc

func OShellRunner.StartBgWithInput(args : []rostr, ainput : strslice) -> int [[overload]]:
    return Execute(args, ainput, true, true, false)
endfunc

func OShellRunner.MonitorThread(aarg : pointer) -> pointer:
    MonitorProcess()
    finished = true
    return nil
endfunc

func OShellRunner.Finished() -> bool:
    IsRunning()
    return finished
endfunc

func OShellRunner.WaitFinishMs(ams : int) -> bool:
    var deadline : int64 = @.MilliTime() + ams
    while not Finished():
        if @.MilliTime() >= deadline:
            return false
        endif
        @.SleepMillis(10)
    endwhile
    return true
endfunc

func OShellRunner.Kill():
    if not finished:
        TerminateChild()
        WaitFinishMs(2000)
    endif
endfunc
