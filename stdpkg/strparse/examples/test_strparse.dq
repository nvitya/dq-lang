use print
use strparse
use file

const test_str : rostr =
"""
{
  "strnode":"hello",
  "numnode":3.14,
  "boolnode":true,
  "objnode":{
    "substr":"abc",
    "subnum":46,
    "subbool":false,
    "subnull":null
  },
  "arrnode":[
    1,
    2,
    3
  ],
  "first":{
    "second":{
      "third":"deepvalue"
    }
  }
}
"""

func ParseText(atxt : strslice):
    PrintLn('--------------------------------')
    var sp <- OStrParse(atxt)
    sp.SkipSpaces()
    if not sp.CheckSymbol('{'):
        raise Exception('object start not found.')
    endif
    sp.SkipSpaces()
    if not sp.CheckSymbol('"strnode"'):
        raise Exception('strnode not found.')
    endif
    sp.SkipSpaces()
    if not sp.CheckSymbol(':'):
        raise Exception('":" expected')
    endif

    if not sp.CheckSymbol('"'):
        raise Exception('" expected')
    endif

    if not sp.ReadTo('"\n\r'):
        raise Exception(' string end not found')
    endif

    var sv : str = sp.PrevStr()

    PrintLn('String value = "{}"', [sv])

    PrintLn('parsing finished.')
endfunc

func *Main():
    PrintLn('Testing OStrParse')

    PrintLn('Test data:\n{}', [test_str])
    ParseText(test_str)
endfunc
