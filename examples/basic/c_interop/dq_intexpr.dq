// single integer expression tests

//const GVINT    : int = 99;

var g_cnt : int = 0
var g_var : int = 100 //GVINT + 1;

func dq_add(a : int, b : int) -> int:
    result = a + b
endfunc

func dq_mul(a : int, b : int) -> int:
    result = a * b
endfunc

func dq_voidfunc(a : int):
    g_cnt += a
endfunc

func dq_call(a : int) -> int:
    var i : int
    i = dq_add(3, a)
    //dq_voidfunc(1);
    result = i * a
endfunc

func dq_testfunc(a : int, b : int) -> int:
    var i : int = 0
    result = 0
    while i < b:
        result += i
        i += 1
    endwhile
endfunc

func dq_testfunc2(a : int, b : int) -> int
{
    var i : int = 0
    result = 0
    while i < b
    {
        result += i
        i += 1
    }
}

func dq_ilogiops(a : int, b : int) -> int:
    if a & 1 << 5 <> 0:
        result = b | a
    else:
        result = ~ b xor 1
    endif
endfunc

func dq_ifcheck(a : int, b : int) -> int:
    if a < b:
        return -1
    elif a > b:
        return 1
    else:
        return 0
    endif
endfunc
