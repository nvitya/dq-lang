//?notest

const NESTED_REEXPORT_FLAG : bool = true

struct SHiddenPayload:
    value : int
endstruct

struct SSharedPayload:
    value : int
endstruct

function printf(fmt : ^char, ...) -> int [[external]]

function MakeHidden(value : int) -> SHiddenPayload:
    result.value = value
endfunc

function HiddenValue(payload : SHiddenPayload) -> int:
    result = payload.value
endfunc

function MakeShared(value : int) -> SSharedPayload:
    result.value = value
endfunc
