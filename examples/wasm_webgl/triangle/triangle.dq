// A wasm32-bare WebGL equivalent of the moving OpenGL triangle example.
// Build with: build/dq-comp examples/wasm_webgl/triangle/triangle.dqproj

use ./webgl

var vertices : [15]float32 = [
     0.00,  0.58, 1.00, 0.25, 0.20,
    -0.42, -0.34, 0.20, 0.90, 0.35,
     0.42, -0.34, 0.25, 0.50, 1.00
]

// Position and UV pairs for a wide, screen-space text overlay.
var overlay_vertices : [24]float32 = [
    -0.80,  0.12, 0.0, 1.0,
    -0.80, -0.12, 0.0, 0.0,
     0.80, -0.12, 1.0, 0.0,
    -0.80,  0.12, 0.0, 1.0,
     0.80, -0.12, 1.0, 0.0,
     0.80,  0.12, 1.0, 1.0
]

var vertex_buffer  : uint32
var program        : uint32
var offset_uniform : uint32
var overlay_buffer : uint32
var overlay_program : uint32
var overlay_texture : uint32
var overlay_sampler_uniform : uint32
var frame_counter : uint32 = 0
var frame_counter_text : cstring(31)
var direction      : float32 = 1.0
var offset         : float32 = 0.0

// Keep text construction in DQ so the browser-side API remains useful for any
// future text, rather than knowing about this example's frame counter.
func UpdateFrameCounterText():
    frame_counter_text = 'FrameCounter = '
    var divisor : uint32 = 1
    var remaining : uint32 = frame_counter
    while remaining >= 10:
        divisor *= 10
        remaining =div= 10
    endwhile
    while divisor > 0:
        var digit : uint32 = (frame_counter div divisor) rem 10
        frame_counter_text.Append(char(Ord('0') + digit))
        divisor =div= 10
    endwhile
endfunc

func Init() [[cexport]]:
    vertex_buffer = GlCreateBuffer(SizeOf(vertices), GL_STATIC_DRAW)
    GlWriteBuffer(vertex_buffer, %vertices[0], SizeOf(vertices))

    const vertex_shader_source : cstring = """
        #version 300 es
        layout(location = 0) in vec2 position;
        layout(location = 1) in vec3 color;
        uniform vec2 offset;
        out vec3 vertex_color;

        void main() {
            gl_Position = vec4(position + offset, 0.0, 1.0);
            vertex_color = color;
        }
        """
    const fragment_shader_source : cstring = """
        #version 300 es
        precision mediump float;
        in vec3 vertex_color;
        out vec4 fragment_color;

        void main() {
            fragment_color = vec4(vertex_color, 1.0);
        }
        """
    var vertex_shader : uint32 = GlCreateShader(GL_VERTEX_SHADER, vertex_shader_source.pchar, vertex_shader_source.length)
    var fragment_shader : uint32 = GlCreateShader(GL_FRAGMENT_SHADER, fragment_shader_source.pchar, fragment_shader_source.length)
    program = GlCreateProgram(vertex_shader, fragment_shader)

    var offset_name : cstring(15) = 'offset'
    offset_uniform = GlGetUniformLocation(program, offset_name.pchar, offset_name.length)

    overlay_buffer = GlCreateBuffer(SizeOf(overlay_vertices), GL_STATIC_DRAW)
    GlWriteBuffer(overlay_buffer, %overlay_vertices[0], SizeOf(overlay_vertices))

    var overlay_vertex_shader_source : cstring(1023) = """
        #version 300 es
        layout(location = 0) in vec2 position;
        layout(location = 1) in vec2 uv;
        out vec2 texture_uv;

        void main() {
            gl_Position = vec4(position, 0.0, 1.0);
            texture_uv = uv;
        }
        """
    var overlay_fragment_shader_source : cstring(1023) = """
        #version 300 es
        precision mediump float;
        in vec2 texture_uv;
        uniform sampler2D text_texture;
        out vec4 fragment_color;

        void main() {
            fragment_color = texture(text_texture, texture_uv);
        }
        """
    var overlay_vertex_shader : uint32 = GlCreateShader(GL_VERTEX_SHADER, overlay_vertex_shader_source.pchar, overlay_vertex_shader_source.length)
    var overlay_fragment_shader : uint32 = GlCreateShader(GL_FRAGMENT_SHADER, overlay_fragment_shader_source.pchar, overlay_fragment_shader_source.length)
    overlay_program = GlCreateProgram(overlay_vertex_shader, overlay_fragment_shader)

    var overlay_sampler_name : cstring(15) = 'text_texture'
    overlay_sampler_uniform = GlGetUniformLocation(overlay_program, overlay_sampler_name.pchar, overlay_sampler_name.length)
    UpdateFrameCounterText()
    overlay_texture = GlCreateTextTexture(frame_counter_text.pchar, frame_counter_text.length)
endfunc

// Called by requestAnimationFrame. The host supplies elapsed seconds since the
// page loaded; DQ advances the animation and sends every drawing command.
func Render(seconds : float32) [[cexport]]:
    frame_counter += 1
    offset += direction * seconds * 0.25
    if offset >= 0.45:
        offset = 0.45
        direction = -1.0
    elif offset <= -0.45:
        offset = -0.45
        direction = 1.0
    endif

    GlBeginFrame(0.06, 0.08, 0.14, 1.0)
    GlSetProgram(program)
    GlSetVertexBuffer(vertex_buffer)
    GlVertexAttribPointer(0, 2, 20, 0)
    GlVertexAttribPointer(1, 3, 20, 8)
    GlSetUniform2f(offset_uniform, offset, 0.0)
    GlDraw(3)

    GlSetProgram(overlay_program)
    GlSetVertexBuffer(overlay_buffer)
    GlVertexAttribPointer(0, 2, 16, 0)
    GlVertexAttribPointer(1, 2, 16, 8)
    UpdateFrameCounterText()
    GlUpdateTextTexture(overlay_texture, frame_counter_text.pchar, frame_counter_text.length)
    GlSetTexture(overlay_texture)
    GlSetUniform1i(overlay_sampler_uniform, 0)
    GlEnableAlphaBlending()
    GlDraw(6)
    GlEndFrame()
endfunc
