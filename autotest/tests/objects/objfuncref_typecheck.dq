// object func reference type checking tests (ERROR test)

type FObjText = func(msg : cstring) of object
type FObjInt = func(v : int) of object
type FObjFloat = func(v : float) of object
type FPlainText = func(msg : cstring)

func plain(msg : cstring):
endfunc

object OCallback:
    func *Create():
    endfunc

    func Print(msg : cstring):
    endfunc

    func Pick(msg : cstring) [[overload]]:
    endfunc

    func Pick(v : int) [[overload]]:
    endfunc
endobject

func *Main() -> int:
    var obj <- OCallback()
    var obj_text : FObjText = nil
    var obj_int : FObjInt = nil
    var obj_float : FObjFloat = nil
    var plain_text : FPlainText = plain

    obj_text = plain      //?error(FuncSigType)
    plain_text = obj.Print //?error(FuncSigType)
    obj_int = obj.Print   //?error(FuncSigType)
    obj_text = obj.Pick
    obj_int = obj.Pick
    obj_float = obj.Pick  //?error(OverloadNoMatch)

    return 0
endfunc
