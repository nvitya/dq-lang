use math
use ./openglutils

struct SDdMatrix:         // A 2D affine matrix: xx, xy, yx, yy, tx, ty.
    values : [6]float32

    func SetIdentity():
        values[0] = 1
        values[1] = 0
        values[2] = 0
        values[3] = 1
        values[4] = 0
        values[5] = 0
    endfunc
endstruct

struct SDdVertex:
    x : float32
    y : float32
endstruct

struct SDdColor:  // use struct literal to set this. e.g: {1.0, 0.5, 0.5, 1.0}
    r  : float32
    g  : float32
    b  : float32
    a  : float32
endstruct

func DdMatIdentity() -> SDdMatrix;
func DdMatMultiply(first : SDdMatrix, second : SDdMatrix) -> SDdMatrix;
func DdMatTransformPoint(matrix : SDdMatrix, point : SDdVertex) -> SDdVertex;
func DdMatProjection(width : int, height : int) -> SDdMatrix;

//-----------------------------------------------------------------------------

object ODrawable:
    parent   : ODrawable = nil
    x        : float32 = 0.0
    y        : float32 = 0.0
    scalex   : float32 = 1.0
    scaley   : float32 = 1.0
    rotation : float32 = 0.0 // degrees
    alpha    : float32 = 1.0
    visible  : bool = true

    func *Create(parent : ODrawable)
    func *Destroy()
    func Matrix() -> SDdMatrix
    func Draw(parent_matrix : SDdMatrix, parent_alpha : float32) [[virtual]]
endobject

object OPrimitive:
    mode     : uint32 = GL_TRIANGLES
    vertices : [*]SDdVertex
    vao      : uint32 = 0
    vbo      : uint32 = 0

    buffer_ready : bool = false

    func *Create(mode : uint32, vertices : []SDdVertex)
    func *Destroy()
    func Draw()
endobject

object OShape(ODrawable):
    color      : SDdColor = {1.0, 1.0, 1.0, 1.0}
    line_width : float32 = 1.0
    primitives : [*]OPrimitive

    func *Create(parent : ODrawable)
    func *Destroy()
    func AddPrimitive(mode : uint32, vertices : []SDdVertex) -> OPrimitive
    func Clear()
    func Draw(parent_matrix : SDdMatrix, parent_alpha : float32) [[override]]
endobject

object OClonedShape(ODrawable):
    original : OShape = nil
    color    : SDdColor = {1.0, 1.0, 1.0, 1.0}

    func *Create(parent : ODrawable, original : OShape)
    func Draw(parent_matrix : SDdMatrix, parent_alpha : float32) [[override]]
endobject

object OPixmap(ODrawable):
    width       : int = 0
    height      : int = 0
    data        : [*]uint32
    texture     : uint32 = 0

    vao          : uint32 = 0
    position_vbo : uint32 = 0
    texcoord_vbo : uint32 = 0

    needs_update   : bool = true
    geometry_ready : bool = false

    func *Create(parent : ODrawable, width : int, height : int)
    func *Destroy()
    func Clear(color : uint32)
    func UpdateGeometry()
    func UpdateTexture()
    func Draw(parent_matrix : SDdMatrix, parent_alpha : float32) [[override]]
endobject

object OAlphaMap(ODrawable):
    width   : int = 0
    height  : int = 0
    data    : [*]uint8
    color   : SDdColor = {1.0, 1.0, 1.0, 1.0}

    texture        : uint32 = 0
    vao            : uint32 = 0
    position_vbo   : uint32 = 0
    texcoord_vbo   : uint32 = 0

    needs_update   : bool   = true
    geometry_ready : bool   = false

    func *Create(parent : ODrawable, width : int, height : int)
    func *Destroy()
    func Clear(value : uint8)
    func SetSize(width : int, height : int)
    func UpdateGeometry()
    func UpdateTexture()
    func Draw(parent_matrix : SDdMatrix, parent_alpha : float32) [[override]]
endobject

object OClonedGroup(ODrawable):
    // Keeping this as the base type breaks the otherwise circular DQ type
    // declaration between a group and a clone of a group.
    original : ODrawable = nil

    func *Create(parent : ODrawable, original : ODrawable)
    func Draw(parent_matrix : SDdMatrix, parent_alpha : float32) [[override]]
endobject

object ODrawGroup(ODrawable):
    children : [*]ODrawable

    func *Create(parent : ODrawable)
    func *Destroy()
    func AddChild(child : ODrawable)
    func RemoveChild(child : ODrawable)
    func NewGroup() -> ODrawGroup
    func NewShape() -> OShape
    func NewPixmap(width : int, height : int) -> OPixmap
    func NewAlphaMap(width : int, height : int) -> OAlphaMap
    func CloneShape(original : OShape) -> OClonedShape
    func CloneGroup(original : ODrawGroup) -> OClonedGroup
    func Draw(parent_matrix : SDdMatrix, parent_alpha : float32) [[override]]
endobject

// The shaders apply the scene matrix on the GPU.  Vertex data stays in local
// object coordinates, so changing an object's transform does not re-upload it.
object OColorProgram:
    program         : uint32 = 0
    vertex_shader   : uint32 = 0
    fragment_shader : uint32 = 0
    matrix_location : int32 = -1
    color_location  : int32 = -1

    func *Create()
    func *Destroy()
    func Activate()
    func SetMatrix(matrix : SDdMatrix)
    func SetColor(color : SDdColor, alpha : float32)
endobject

object OTextureProgram:
    program           : uint32 = 0
    vertex_shader     : uint32 = 0
    fragment_shader   : uint32 = 0
    matrix_location   : int32 = -1
    color_location    : int32 = -1
    texture_location  : int32 = -1
    alphamap_location : int32 = -1

    func *Create()
    func *Destroy()
    func Activate()
    func SetMatrix(matrix : SDdMatrix)
    func SetColor(color : SDdColor, alpha : float32)
    func SetAlphaMap(value : int32)
endobject

object ODdScene:
    window     : pointer = nil
    root       : ODrawGroup = nil
    background : SDdColor = {0.0, 0.0, 0.0, 1.0}
    projection : SDdMatrix

    func *Create(window : pointer)
    func *Destroy()
    func BeginFrame(width : int, height : int)
    func EndFrame()
endobject

var g_colorProgram   : OColorProgram   = nil
var g_textureProgram : OTextureProgram = nil

implementation

func DdMatIdentity() -> SDdMatrix:
    result.values[0] = 1
    result.values[1] = 0
    result.values[2] = 0
    result.values[3] = 1
    result.values[4] = 0
    result.values[5] = 0
endfunc

func DdMatMultiply(first : SDdMatrix, second : SDdMatrix) -> SDdMatrix:
    result.values[0] = first.values[0] * second.values[0] + first.values[1] * second.values[2]
    result.values[1] = first.values[0] * second.values[1] + first.values[1] * second.values[3]
    result.values[2] = first.values[2] * second.values[0] + first.values[3] * second.values[2]
    result.values[3] = first.values[2] * second.values[1] + first.values[3] * second.values[3]
    result.values[4] = first.values[4] * second.values[0] + first.values[5] * second.values[2] + second.values[4]
    result.values[5] = first.values[4] * second.values[1] + first.values[5] * second.values[3] + second.values[5]
endfunc

func DdMatTransformPoint(matrix : SDdMatrix, point : SDdVertex) -> SDdVertex:
    result.x = point.x * matrix.values[0] + point.y * matrix.values[2] + matrix.values[4]
    result.y = point.x * matrix.values[1] + point.y * matrix.values[3] + matrix.values[5]
endfunc

func DdMatProjection(width : int, height : int) -> SDdMatrix:
    result.values[0] =  2.0 / width
    result.values[1] = 0
    result.values[2] = 0
    result.values[3] = -2.0 / height
    result.values[4] = -1.0 + 0.5 / width
    result.values[5] =  1.0 - 0.5 / height
endfunc


func DdCompileShader(shader_type : uint32, source : strview) -> uint32:
    result = GlCreateShader(shader_type)
    var shader_source  : str = source
    var source_pointer : ^char = shader_source.pchar
    var source_length  : int32 = shader_source.length
    GlShaderSource(result, 1, %source_pointer, %source_length)
    GlCompileShader(result)

    var status : int32 = 0
    GlGetShaderiv(result, GL_COMPILE_STATUS, %status)
    if status == 0:
        GlDeleteShader(result)
        result = 0
    endif
endfunc

//-----------------------------------------------------------------------------

func OColorProgram.*Create():
    use *
    vertex_shader = DdCompileShader(GL_VERTEX_SHADER,
        """
        uniform mat3 u_MVPMatrix;
        attribute vec2 a_Position;
        void main() {
            vec3 point = u_MVPMatrix * vec3(a_Position, 1.0);
            gl_Position = vec4(point.xy, 0.0, 1.0);
        }
        """
    )
    fragment_shader = DdCompileShader(GL_FRAGMENT_SHADER,
        """
        uniform vec4 u_Color;
        void main() {
            gl_FragColor = u_Color;
        }
        """
    )
    if vertex_shader == 0 or fragment_shader == 0:
        return
    endif

    program = GlCreateProgram()
    var position_name : str = 'a_Position'
    GlAttachShader(program, vertex_shader)
    GlAttachShader(program, fragment_shader)
    GlBindAttribLocation(program, 0, position_name.pchar)
    GlLinkProgram(program)

    var status : int32 = 0
    GlGetProgramiv(program, GL_LINK_STATUS, %status)
    if status == 0:
        GlDeleteProgram(program)
        program = 0
        return
    endif

    matrix_location = GlGetUniformLocation(program, 'u_MVPMatrix')
    color_location = GlGetUniformLocation(program, 'u_Color')
endfunc

func OColorProgram.*Destroy():
    use *
    if program <> 0:
        GlDeleteProgram(program)
    endif
    if vertex_shader <> 0:
        GlDeleteShader(vertex_shader)
    endif
    if fragment_shader <> 0:
        GlDeleteShader(fragment_shader)
    endif
endfunc

func OColorProgram.Activate():
    use *
    GlUseProgram(program)
endfunc

func OColorProgram.SetMatrix(matrix : SDdMatrix):
    use *
    var values : [9]float32
    values[0] = matrix.values[0]
    values[1] = matrix.values[1]
    values[2] = 0
    values[3] = matrix.values[2]
    values[4] = matrix.values[3]
    values[5] = 0
    values[6] = matrix.values[4]
    values[7] = matrix.values[5]
    values[8] = 1
    GlUniformMatrix3fv(matrix_location, 1, 0, %values[0])
endfunc

func OColorProgram.SetColor(color : SDdColor, alpha : float32):
    use *
    GlUniform4f(color_location, color.r, color.g, color.b, color.a * alpha)
endfunc

//-----------------------------------------------------------------------------

func OTextureProgram.*Create():
    use *
    vertex_shader = DdCompileShader(GL_VERTEX_SHADER,
        """
        uniform mat3 u_MVPMatrix;
        attribute vec2 a_Position;
        attribute vec2 a_TexCoordinate;
        varying vec2 v_TexCoordinate;
        void main() {
            vec3 point = u_MVPMatrix * vec3(a_Position, 1.0);
            gl_Position = vec4(point.xy, 0.0, 1.0);
            v_TexCoordinate = a_TexCoordinate;
        }
        """
    )
    fragment_shader = DdCompileShader(GL_FRAGMENT_SHADER,
        """
        uniform sampler2D u_Texture;
        uniform vec4 u_Color;
        varying vec2 v_TexCoordinate;
        uniform int u_AlphaMap;
        void main() {
            vec4 sample = texture2D(u_Texture, v_TexCoordinate);
            if (u_AlphaMap != 0) gl_FragColor = vec4(u_Color.rgb, u_Color.a * sample.a);
            else gl_FragColor = sample * u_Color;
        }
        """
    )
    if vertex_shader == 0 or fragment_shader == 0:
        return
    endif

    program = GlCreateProgram()
    GlAttachShader(program, vertex_shader)
    GlAttachShader(program, fragment_shader)
    GlBindAttribLocation(program, 0, 'a_Position')
    GlBindAttribLocation(program, 1, 'a_TexCoordinate')
    GlLinkProgram(program)

    var status : int32 = 0
    GlGetProgramiv(program, GL_LINK_STATUS, %status)
    if status == 0:
        GlDeleteProgram(program)
        program = 0
        return
    endif

    matrix_location = GlGetUniformLocation(program, 'u_MVPMatrix')
    color_location = GlGetUniformLocation(program, 'u_Color')
    texture_location = GlGetUniformLocation(program, 'u_Texture')
    alphamap_location = GlGetUniformLocation(program, 'u_AlphaMap')
endfunc

func OTextureProgram.*Destroy():
    use *
    if program <> 0:
        GlDeleteProgram(program)
    endif
    if vertex_shader <> 0:
        GlDeleteShader(vertex_shader)
    endif
    if fragment_shader <> 0:
        GlDeleteShader(fragment_shader)
    endif
endfunc

func OTextureProgram.Activate():
    use *
    GlUseProgram(program)
    GlUniform1i(texture_location, 0)
endfunc

func OTextureProgram.SetMatrix(matrix : SDdMatrix):
    use *
    var values : [9]float32
    values[0] = matrix.values[0]
    values[1] = matrix.values[1]
    values[2] = 0
    values[3] = matrix.values[2]
    values[4] = matrix.values[3]
    values[5] = 0
    values[6] = matrix.values[4]
    values[7] = matrix.values[5]
    values[8] = 1
    GlUniformMatrix3fv(matrix_location, 1, 0, %values[0])
endfunc

func OTextureProgram.SetColor(color : SDdColor, alpha : float32):
    use *
    GlUniform4f(color_location, color.r, color.g, color.b, color.a * alpha)
endfunc

func OTextureProgram.SetAlphaMap(value : int32):
    use *
    GlUniform1i(alphamap_location, value)
endfunc

//-----------------------------------------------------------------------------

func ODrawable.*Create(parent : ODrawable):
    self.parent = parent
    if parent is ODrawGroup:
        var group : ODrawGroup tryfrom parent
        group.AddChild(self)
    endif
endfunc

func ODrawable.*Destroy():
    if parent is ODrawGroup:
        var group : ODrawGroup tryfrom parent
        group.RemoveChild(self)
    endif
endfunc

func ODrawable.Matrix() -> SDdMatrix:
    var radians : float64 = rotation * 3.141592653589793 / 180.0
    var cosine : float32  = @math.Cos(radians)
    var sine : float32    = @math.Sin(radians)

    result.values[0] = scalex * cosine
    result.values[1] = -scaley * sine
    result.values[2] = scalex * sine
    result.values[3] = scaley * cosine
    result.values[4] = x
    result.values[5] = y
endfunc

func ODrawable.Draw(parent_matrix : SDdMatrix, parent_alpha : float32):
endfunc

//-----------------------------------------------------------------------------

func OPrimitive.*Create(mode : uint32, vertices : []SDdVertex):
    self.mode = mode
    var index : int = 0
    while index < vertices.length:
        self.vertices.Append(vertices[index])
        index += 1
    endwhile
endfunc

func OPrimitive.*Destroy():
    use *
    if vao <> 0:
        GlDeleteVertexArrays(1, %vao)
    endif
    if vbo <> 0:
        GlDeleteBuffers(1, %vbo)
    endif
endfunc

func OPrimitive.Draw():
    use *
    if not buffer_ready:
        if vertices.length == 0:
            return
        endif
        GlGenVertexArrays(1, %vao)
        GlGenBuffers(1, %vbo)
        GlBindVertexArray(vao)
        GlBindBuffer(GL_ARRAY_BUFFER, vbo)
        GlBufferData(GL_ARRAY_BUFFER, uint(vertices.length * SizeOf(SDdVertex)), %vertices[0], GL_STATIC_DRAW)
        GlEnableVertexAttribArray(0)
        GlVertexAttribPointer(0, 2, GL_FLOAT, 0, SizeOf(SDdVertex), nil)
        buffer_ready = true
    endif
    GlBindVertexArray(vao)
    GlDrawArrays(mode, 0, vertices.length)
endfunc

//-----------------------------------------------------------------------------

func OShape.*Create(parent : ODrawable):
    inherited Create(parent)
endfunc

func OShape.*Destroy():
    Clear()
    inherited Destroy()
endfunc

func OShape.AddPrimitive(mode : uint32, vertices : []SDdVertex) -> OPrimitive:
    result = new OPrimitive(mode, vertices)
    primitives.Append(result)
endfunc

func OShape.Clear():
    while primitives.length > 0:
        delete primitives.PopFirst()
    endwhile
endfunc

func OShape.Draw(parent_matrix : SDdMatrix, parent_alpha : float32) [[override]]:
    use *
    var matrix : SDdMatrix = DdMatMultiply(Matrix(), parent_matrix)
    g_colorProgram.Activate()
    g_colorProgram.SetMatrix(matrix)
    g_colorProgram.SetColor(color, parent_alpha * alpha)
    GlLineWidth(line_width)

    for index : int = 0 count primitives.length:
        primitives[index].Draw()
    endfor
endfunc

//-----------------------------------------------------------------------------

func OClonedShape.*Create(parent : ODrawable, original : OShape):
    inherited Create(parent)
    self.original = original
    if original <> nil:
        color = original.color
        x = original.x
        y = original.y
        scalex = original.scalex
        scaley = original.scaley
        rotation = original.rotation
        alpha = original.alpha
        visible = original.visible
    endif
endfunc

func OClonedShape.Draw(parent_matrix : SDdMatrix, parent_alpha : float32) [[override]]:
    if original == nil:
        return
    endif

    use *

    var matrix : SDdMatrix = DdMatMultiply(Matrix(), parent_matrix)
    g_colorProgram.Activate()
    g_colorProgram.SetMatrix(matrix)
    g_colorProgram.SetColor(color, parent_alpha * alpha)
    GlLineWidth(original.line_width)

    for index : int = 0 count original.primitives.length:
        original.primitives[index].Draw()
    endfor
endfunc

//-----------------------------------------------------------------------------

func OPixmap.*Create(parent : ODrawable, width : int, height : int):
    inherited Create(parent)
    self.width = width
    self.height = height
    if width > 0 and height > 0:
        data.SetLength(width * height)
    endif
endfunc

func OPixmap.*Destroy():
    use *
    if texture <> 0:
        GlDeleteTextures(1, %texture)
    endif
    if vao <> 0:
        GlDeleteVertexArrays(1, %vao)
    endif
    if position_vbo <> 0:
        GlDeleteBuffers(1, %position_vbo)
    endif
    if texcoord_vbo <> 0:
        GlDeleteBuffers(1, %texcoord_vbo)
    endif
    inherited Destroy()
endfunc

func OPixmap.Clear(color : uint32):
    for index : int = 0 count data.length:
        data[index] = color
    endfor
    needs_update = true
endfunc

func OPixmap.UpdateGeometry():
    use *
    if geometry_ready:
        return
    endif
    if width <= 0 or height <= 0:
        return
    endif

    var positions : [4]SDdVertex
    positions[1].x = width
    positions[2].x = width
    positions[2].y = height
    positions[3].y = height
    var texcoords : [4]SDdVertex
    texcoords[1].x = 1
    texcoords[2].x = 1
    texcoords[2].y = 1
    texcoords[3].y = 1

    if vao == 0:
        GlGenVertexArrays(1, %vao)
        GlGenBuffers(1, %position_vbo)
        GlGenBuffers(1, %texcoord_vbo)
    endif
    GlBindVertexArray(vao)
    GlBindBuffer(GL_ARRAY_BUFFER, position_vbo)
    GlBufferData(GL_ARRAY_BUFFER, uint(SizeOf(positions)), %positions[0], GL_STATIC_DRAW)
    GlEnableVertexAttribArray(0)
    GlVertexAttribPointer(0, 2, GL_FLOAT, 0, SizeOf(SDdVertex), nil)
    GlBindBuffer(GL_ARRAY_BUFFER, texcoord_vbo)
    GlBufferData(GL_ARRAY_BUFFER, uint(SizeOf(texcoords)), %texcoords[0], GL_STATIC_DRAW)
    GlEnableVertexAttribArray(1)
    GlVertexAttribPointer(1, 2, GL_FLOAT, 0, SizeOf(SDdVertex), nil)
    geometry_ready = true
endfunc

func OPixmap.UpdateTexture():
    use *
    if texture == 0:
        GlGenTextures(1, %texture)
        GlBindTexture(GL_TEXTURE_2D, texture)
        GlTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR)
        GlTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR)
    else:
        GlBindTexture(GL_TEXTURE_2D, texture)
    endif

    if data.length > 0:
        GlTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, width, height, 0,
                     GL_RGBA, GL_UNSIGNED_BYTE, %data[0])
    endif
    needs_update = false
endfunc

func OPixmap.Draw(parent_matrix : SDdMatrix, parent_alpha : float32) [[override]]:
    use *
    if needs_update:
        UpdateTexture()
    endif
    UpdateGeometry()
    if texture == 0:
        return
    endif

    g_textureProgram.Activate()
    g_textureProgram.SetMatrix(DdMatMultiply(Matrix(), parent_matrix))
    g_textureProgram.SetColor({1.0, 1.0, 1.0, 1.0}, parent_alpha * alpha)
    g_textureProgram.SetAlphaMap(0)
    GlActiveTexture(GL_TEXTURE0)
    GlBindTexture(GL_TEXTURE_2D, texture)
    GlBindVertexArray(vao)
    GlDrawArrays(GL_TRIANGLE_FAN, 0, 4)
endfunc

//-----------------------------------------------------------------------------

func OAlphaMap.*Create(parent : ODrawable, width : int, height : int):
    inherited Create(parent)
    SetSize(width, height)
endfunc

func OAlphaMap.*Destroy():
    use *
    if texture <> 0:
        GlDeleteTextures(1, %texture)
    endif
    if vao <> 0:
        GlDeleteVertexArrays(1, %vao)
    endif
    if position_vbo <> 0:
        GlDeleteBuffers(1, %position_vbo)
    endif
    if texcoord_vbo <> 0:
        GlDeleteBuffers(1, %texcoord_vbo)
    endif
    inherited Destroy()
endfunc

func OAlphaMap.Clear(value : uint8):
    for index : int = 0 count data.length:
        data[index] = value
    endfor
    needs_update = true
endfunc

func OAlphaMap.SetSize(width : int, height : int):
    self.width = width
    self.height = height
    data.SetLength(width * height)
    needs_update = true
    geometry_ready = false
endfunc

func OAlphaMap.UpdateGeometry():
    use *
    if geometry_ready:
        return
    endif
    if width <= 0 or height <= 0:
        return
    endif

    var positions : [4]SDdVertex
    positions[1].x = width
    positions[2].x = width
    positions[2].y = height
    positions[3].y = height
    var texcoords : [4]SDdVertex
    texcoords[1].x = 1
    texcoords[2].x = 1
    texcoords[2].y = 1
    texcoords[3].y = 1

    if vao == 0:
        GlGenVertexArrays(1, %vao)
        GlGenBuffers(1, %position_vbo)
        GlGenBuffers(1, %texcoord_vbo)
    endif
    GlBindVertexArray(vao)
    GlBindBuffer(GL_ARRAY_BUFFER, position_vbo)
    GlBufferData(GL_ARRAY_BUFFER, uint(SizeOf(positions)), %positions[0], GL_STATIC_DRAW)
    GlEnableVertexAttribArray(0)
    GlVertexAttribPointer(0, 2, GL_FLOAT, 0, SizeOf(SDdVertex), nil)
    GlBindBuffer(GL_ARRAY_BUFFER, texcoord_vbo)
    GlBufferData(GL_ARRAY_BUFFER, uint(SizeOf(texcoords)), %texcoords[0], GL_STATIC_DRAW)
    GlEnableVertexAttribArray(1)
    GlVertexAttribPointer(1, 2, GL_FLOAT, 0, SizeOf(SDdVertex), nil)
    geometry_ready = true
endfunc

func OAlphaMap.UpdateTexture():
    use *
    if texture == 0:
        GlGenTextures(1, %texture)
        GlBindTexture(GL_TEXTURE_2D, texture)
        GlTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR)
        GlTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR)
    else:
        GlBindTexture(GL_TEXTURE_2D, texture)
    endif

    if data.length > 0:
        GlPixelStorei(GL_UNPACK_ALIGNMENT, 1)
        GlTexImage2D(GL_TEXTURE_2D, 0, GL_ALPHA, width, height, 0,
                     GL_ALPHA, GL_UNSIGNED_BYTE, %data[0])
    endif
    needs_update = false
endfunc

func OAlphaMap.Draw(parent_matrix : SDdMatrix, parent_alpha : float32) [[override]]:
    use *
    if needs_update:
        UpdateTexture()
    endif
    UpdateGeometry()
    if texture == 0:
        return
    endif

    g_textureProgram.Activate()
    g_textureProgram.SetMatrix(DdMatMultiply(Matrix(), parent_matrix))
    g_textureProgram.SetColor(color, parent_alpha * alpha)
    g_textureProgram.SetAlphaMap(1)
    GlActiveTexture(GL_TEXTURE0)
    GlBindTexture(GL_TEXTURE_2D, texture)
    GlBindVertexArray(vao)
    GlDrawArrays(GL_TRIANGLE_FAN, 0, 4)
endfunc

//-----------------------------------------------------------------------------

func ODrawGroup.*Create(parent : ODrawable):
    inherited Create(parent)
endfunc

func ODrawGroup.*Destroy():
    while children.length > 0:
        delete children.PopFirst()
    endwhile
    inherited Destroy()
endfunc

func ODrawGroup.AddChild(child : ODrawable):
    children.Append(child)
    child.parent = self
endfunc

func ODrawGroup.RemoveChild(child : ODrawable):
    for index : int = 0 count children.length:
        if children[index] == child:
            children.Delete(index)
            child.parent = nil
            return
        endif
    endfor
endfunc

func ODrawGroup.NewGroup() -> ODrawGroup:
    return new ODrawGroup(self)
endfunc

func ODrawGroup.NewShape() -> OShape:
    return new OShape(self)
endfunc

func ODrawGroup.NewPixmap(width : int, height : int) -> OPixmap:
    return new OPixmap(self, width, height)
endfunc

func ODrawGroup.NewAlphaMap(width : int, height : int) -> OAlphaMap:
    return new OAlphaMap(self, width, height)
endfunc

func ODrawGroup.CloneShape(original : OShape) -> OClonedShape:
    return new OClonedShape(self, original)
endfunc

func ODrawGroup.CloneGroup(original : ODrawGroup) -> OClonedGroup:
    return new OClonedGroup(self, original)
endfunc

func ODrawGroup.Draw(parent_matrix : SDdMatrix, parent_alpha : float32) [[override]]:
    var matrix : SDdMatrix = @.DdMatMultiply(Matrix(), parent_matrix)
    var child_alpha : float32 = parent_alpha * alpha
    for index : int = 0 count children.length:
        if children[index].visible:
            children[index].Draw(matrix, child_alpha)
        endif
    endfor
endfunc

//-----------------------------------------------------------------------------

func OClonedGroup.*Create(parent : ODrawable, original : ODrawable):
    inherited Create(parent)
    self.original = original
    if original <> nil:
        x = original.x
        y = original.y
        scalex = original.scalex
        scaley = original.scaley
        rotation = original.rotation
        alpha = original.alpha
        visible = original.visible
    endif
endfunc

func OClonedGroup.Draw(parent_matrix : SDdMatrix, parent_alpha : float32) [[override]]:
    var group : ODrawGroup tryfrom original
    if group == nil:
        return
    endif

    var matrix : SDdMatrix = @.DdMatMultiply(Matrix(), parent_matrix)
    var child_alpha : float32 = parent_alpha * alpha
    for index : int = 0 count group.children.length:
        if group.children[index].visible:
            group.children[index].Draw(matrix, child_alpha)
        endif
    endfor
endfunc

//-----------------------------------------------------------------------------

func ODdScene.*Create(window : pointer):
    use *
    self.window = window
    root = new ODrawGroup(nil)
    projection = DdMatIdentity()
    g_colorProgram = new OColorProgram()
    g_textureProgram = new OTextureProgram()
    GlEnable(GL_BLEND)
    GlBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA)
endfunc

func ODdScene.*Destroy():
    delete root
    use .
    delete g_textureProgram = nil
    delete g_colorProgram = nil
endfunc

func ODdScene.BeginFrame(width : int, height : int):
    use *
    GlViewport(0, 0, width, height)
    projection = DdMatProjection(width, height)
    GlClearColor(background.r, background.g, background.b, background.a)
    GlClear(GL_COLOR_BUFFER_BIT)
    root.Draw(projection, 1.0)
endfunc

func ODdScene.EndFrame():
    use *
    GlfwSwapBuffers(window)
endfunc
