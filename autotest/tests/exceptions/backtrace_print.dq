// Backtrace capture/printing smoke test.

func printf(fmt : ^char, ...) -> int [[external]]

func BacktraceLeaf():
    raise Exception("trace")
endfunc

func BacktraceMiddle():
    BacktraceLeaf()
endfunc

func *Main() -> int:
    try:
        BacktraceMiddle()
    except Exception as e:
        printf("exception.backtrace.message = ")  //?check("exception.backtrace.message", "trace")
        e.PrintMessage()
        printf("\n")
        e.PrintBacktrace()  //?check("Backtrace", "")
                            //?ignore("#")
    endtry

    return 0
endfunc
