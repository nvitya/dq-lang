func OFieldPair.GetFieldValueText(qfunc : FSqlQuoteStr) -> str:
    if value.IsText():
        var text : strslice = value.AsText('')
        if direct:
            result = text
        else:
            result = qfunc(text)
        endif
    elif value.IsInt():
        result = @.Format("{}", value.AsInt(0))
    elif value.IsFloat():
        result = @.Format("{}", value.AsFloat(0))
    elif value.IsBool():
        result = iif(value.AsBool(false), 'true', 'false')
    elif value.IsChar():
        result = @.Format("{}", value.AsChar('?'))
    elif value.IsWChar():
        result = @.Format("{}", value.AsWChar('?'))
    elif value.IsPointer():
        result = @.Format("{}", value.AsPointer(nil))
    else:
        result = "null"
    endif
endfunc

func OSqlUis.*Create(atable : rostr):
    Init(atable)
endfunc

func OSqlUis.Clear():
    field_pairs = []
endfunc

func OSqlUis.Init(atable : rostr):
    table_name = atable
    Clear()
endfunc

func OSqlUis.GetField(afname : rostr) -> OFieldPair:
    for i : int = 0 count field_pairs.length:
        if field_pairs[i].name == afname:
            return field_pairs[i]
        endif
    endfor
    // allocate new
    result = new OFieldPair(afname)
    field_pairs.Append(result)
endfunc

func OSqlUis.Field(afname : rostr, avalue : anyvalue):
    var fp : OFieldPair = GetField(afname)
    fp.value = avalue
endfunc

func OSqlUis.FieldStr(afname : rostr, avalue : strslice):
    var fp : OFieldPair = GetField(afname)
    var s : str = avalue
    fp.value = s
    fp.direct = false  // will be quoted
endfunc

func OSqlUis.FieldInt(afname : rostr, avalue : int):
    var fp : OFieldPair = GetField(afname)
    fp.value = avalue
endfunc

func OSqlUis.FieldFloat(afname : rostr, avalue : float):
    var fp : OFieldPair = GetField(afname)
    fp.value = avalue
endfunc

func OSqlUis.FieldNull(afname : rostr):
    var fp : OFieldPair = GetField(afname)
    fp.value.SetNull()
endfunc

func OSqlUis.FieldSpec(afname : rostr, avalue : rostr):
    var fp : OFieldPair = GetField(afname)
    fp.value = avalue
    fp.direct = true
endfunc


func OSqlUis.InsertStatement(adb : ODbConnection) -> str:
    var fs : str = ""
    var vs : str = ""
    for i : int = 0 count field_pairs.length:
        ref fp = field_pairs[i]
        if i > 0:
            fs.Add(", ")
            vs.Add(", ")
        endif
        fs.Add(fp.name)
        vs.Add(fp.GetFieldValueText(adb.quote_str_func))
    endfor
    result = @.Format(
    """
    insert into {}
        ({})
    values
        ({})
    """
    , [table_name, fs, vs]
    )
endfunc

func OSqlUis.UpdateStatement(adb : ODbConnection, where : rostr) -> str:
    var list : str = ''
    for i : int = 0 count field_pairs.length:
        ref fp = field_pairs[i]
        if i > 0:
            list.Add(", ")
        endif
        list.Add(fp.name)
        list.Add('=')
        list.Add(fp.GetFieldValueText(adb.quote_str_func))
    endfor
    result = @.Format(
    """
    update
        {}
    set
        {}
    where
        {}
    """
    , [table_name, list, where]
    )
endfunc

func OSqlUis.ExecInsert(adb : ODbConnection):
    adb.Execute(InsertStatement(adb))
endfunc

func OSqlUis.ExecUpdate(adb : ODbConnection, where : rostr):
    adb.Execute(UpdateStatement(adb, where))
endfunc
