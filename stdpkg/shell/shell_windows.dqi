#linklib('kernel32')

const INVALID_HANDLE_VALUE : uint = -1

struct SSecurityAttributes:
    length : uint32
    descriptor : pointer
    inherit_handle : int32
endstruct

struct SStartupInfo:
    cb : uint32
    reserved : pointer
    desktop : pointer
    title : pointer
    x : uint32
    y : uint32
    x_size : uint32
    y_size : uint32
    x_chars : uint32
    y_chars : uint32
    fill_attribute : uint32
    flags : uint32
    show_window : uint16
    reserved_size : uint16
    reserved_bytes : pointer
    stdin_handle : uint
    stdout_handle : uint
    stderr_handle : uint
endstruct

struct SStartupInfoEx:
    startup : SStartupInfo
    attributes : pointer
endstruct

struct SProcessInfo:
    process_handle : uint
    thread_handle : uint
    process_id : uint32
    thread_id : uint32
endstruct

func win_CreatePipe(read_handle : ^uint, write_handle : ^uint, attributes : ^SSecurityAttributes, size : uint32) -> int32 [[external('CreatePipe')]] ..
func win_SetHandleInformation(handle : uint, mask : uint32, flags : uint32) -> int32 [[external('SetHandleInformation')]] ..
func win_CloseHandle(handle : uint) -> int32 [[external('CloseHandle')]] ..
func win_GetLastError() -> uint32 [[external('GetLastError')]] ..
func win_SetLastError(error : uint32) [[external('SetLastError')]] ..
func win_GetStdHandle(kind : uint32) -> uint [[external('GetStdHandle')]] ..
func win_GetCurrentProcess() -> uint [[external('GetCurrentProcess')]] ..
func win_DuplicateHandle(source_process : uint, source : uint, target_process : uint, target : ^uint, access : uint32, inherit_handle : int32, options : uint32) -> int32 [[external('DuplicateHandle')]] ..
func win_CreateFileW(name : ^char16, access : uint32, share : uint32, attributes : ^SSecurityAttributes, creation : uint32, flags : uint32, template_handle : uint) -> uint [[external('CreateFileW')]] ..
func win_InitializeProcThreadAttributeList(attributes : pointer, count : uint32, flags : uint32, size : ^uint) -> int32 [[external('InitializeProcThreadAttributeList')]] ..
func win_UpdateProcThreadAttribute(attributes : pointer, flags : uint32, attribute : uint, value : pointer, size : uint, previous : pointer, returned_size : ^uint) -> int32 [[external('UpdateProcThreadAttribute')]] ..
func win_DeleteProcThreadAttributeList(attributes : pointer) [[external('DeleteProcThreadAttributeList')]] ..
func win_CreateProcessW(application : ^char16, command : ^char16, process_attributes : pointer, thread_attributes : pointer, inherit_handles : int32, flags : uint32, environment : pointer, directory : ^char16, startup : ^SStartupInfoEx, info : ^SProcessInfo) -> int32 [[external('CreateProcessW')]] ..
func win_CreateJobObjectW(attributes : pointer, name : ^char16) -> uint [[external('CreateJobObjectW')]] ..
func win_AssignProcessToJobObject(job : uint, process_handle : uint) -> int32 [[external('AssignProcessToJobObject')]] ..
func win_TerminateJobObject(job : uint, code : uint32) -> int32 [[external('TerminateJobObject')]] ..
func win_TerminateProcess(process_handle : uint, code : uint32) -> int32 [[external('TerminateProcess')]] ..
func win_ResumeThread(thread_handle : uint) -> uint32 [[external('ResumeThread')]] ..
