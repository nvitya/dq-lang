// built-in Object reference compatibility

use libc/stdio

object OBase:
public
    value : int = 0

    func *Create(v : int):
        value = v
    endfunc
endobject

object OChild(OBase):
public
    func *Create(v : int):
        inherited Create(v + 10)
    endfunc
endobject

func IsObjectSet(o : Object) -> int:
    if o == nil:
        return 0
    endif
    return 1
endfunc

func ObjectFromBase(o : OBase) -> Object:
    return o
endfunc

func *Main() -> int:
    var any : Object = nil
    printf("object.nil = %li\n", IsObjectSet(any)) //?check("object.nil", 0)

    var base : OBase = new OBase(1)
    any = base
    printf("object.base = %li\n", IsObjectSet(any)) //?check("object.base", 1)

    var child : OChild = new OChild(2)
    any = child
    printf("object.child = %li\n", IsObjectSet(any)) //?check("object.child", 1)

    var fixed <- OChild(3)
    any = fixed
    printf("object.fixed = %li\n", IsObjectSet(any)) //?check("object.fixed", 1)

    any = ObjectFromBase(base)
    printf("object.return = %li\n", IsObjectSet(any)) //?check("object.return", 1)

    delete base
    delete child
    return 0
endfunc
