// WASI libc's command startup calls this ABI-level name. Clang normally
// rewrites a C source-level main() to the same symbol.
function main(argc : int, argv : ^^char) -> int  [[export('__main_argc_argv')]]

implementation

use rtl/rtlint
use rtl/mem
use rtl/prgargs
use libc/stdio

// These functions are created by the DQ compiler:
function dq_main() -> int  [[external('dq_main')]]
function dq_module_init()  [[external('dq_module_init')]]
function libc_exit(status : int) [[external('exit')]]

function OsRtErrorHandler(emsg : ^char):
    printf("RUNTIME ERROR: %s\n", emsg)
    libc_exit(-1)
endfunc

function main(argc : int, argv : ^^char) -> int  [[export('__main_argc_argv')]]:
    rterror_handler = OsRtErrorHandler
    @prgargs.__sys_init_params(argc, argv)
    dq_module_init()
    result = dq_main()
endfunc
