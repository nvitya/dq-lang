use libc/stdio

func RetU8() -> uint8:
    return 1
endfunc

func RetI8() -> int8:
    return -2
endfunc

func RetChar() -> char:
    return 'A'
endfunc

func *Main() -> int:
    printf("return_smallint = u8:%li i8:%li char:%c\n",
           int(RetU8()), int(RetI8()), Ord(RetChar())) //?check("return_smallint", "u8:1 i8:-2 char:A")
    return 0
endfunc
