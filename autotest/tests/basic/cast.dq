// explicit cast tests

func printf(fmt : ^char, ...) -> int  [[external]]

object OCastBox:
    value : int

    func *Create(a : int):
        value = a
    endfunc
endobject

type FRawAddress = func()

var cast_address_anchor : int = 0
const cast_address_table : [1] FRawAddress = [FRawAddress(%cast_address_anchor)]
const cast_address_pointer : ^byte = ^byte(0x7F001000)

func dq_cast_bool_to_int() -> int:
    var btrue : bool = true
    var bfalse : bool = false
    result = int(btrue) * 10 + int(bfalse)
endfunc

func dq_cast_pointer_roundtrip() -> int:
    var value : uint32 = 0
    var pbyte : ^byte = ^byte(%value)
    ^uint32(pbyte)^ = 0x12345678
    result = int(value)
endfunc

func dq_cast_opaque_pointer() -> int:
    var value : uint32 = 55
    var p : pointer = %value
    var pv : ^uint32 = ^uint32(p)
    result = int(pv^)
endfunc

func dq_cast_multi_source_pointer() -> int:
    var iv : int = 7
    var bv : bool = true
    var p : pointer = %iv
    p = %bv
    result = int(^bool(p)^)
endfunc

func dq_cast_address_constant() -> uint:
    var p : ^byte = ^byte(0x7F001000)
    result = uint(p)
endfunc

func dq_pointer_address_constant() -> uint:
    result = uint(cast_address_pointer)
endfunc

func dq_cast_object_pointer_roundtrip() -> int:
    var box : OCastBox = new OCastBox(77)
    var raw : pointer = pointer(box)
    var restored : OCastBox = OCastBox(raw)
    result = restored.value
    delete box
endfunc

func dq_cast_pointer_to_func_ref() -> int:
    var value : int = 0
    var raw : pointer = %value
    var callback : FRawAddress = FRawAddress(raw)
    result = int((callback <> nil) and (cast_address_table[0] <> nil))
endfunc

func *Main() -> int:
    printf("Testing DQ explicit casts:\n")  //?ignore('Testing DQ explicit casts:')

    printf("dq_cast_bool_to_int() = %li\n", dq_cast_bool_to_int())  //?check('dq_cast_bool_to_int()', 10)
    printf("dq_cast_pointer_roundtrip() = 0x%08X\n", dq_cast_pointer_roundtrip())  //?check('dq_cast_pointer_roundtrip()', 0x12345678)
    printf("dq_cast_opaque_pointer() = %li\n", dq_cast_opaque_pointer())  //?check('dq_cast_opaque_pointer()', 55)
    printf("dq_cast_multi_source_pointer() = %li\n", dq_cast_multi_source_pointer())  //?check('dq_cast_multi_source_pointer()', 1)
    printf("dq_cast_address_constant() = 0x%lX\n", dq_cast_address_constant())  //?check('dq_cast_address_constant()', 0x7F001000)
    printf("dq_pointer_address_constant() = 0x%lX\n", dq_pointer_address_constant())  //?check('dq_pointer_address_constant()', 0x7F001000)
    printf("dq_cast_object_pointer_roundtrip() = %li\n", dq_cast_object_pointer_roundtrip())  //?check('dq_cast_object_pointer_roundtrip()', 77)
    printf("dq_cast_pointer_to_func_ref() = %li\n", dq_cast_pointer_to_func_ref())  //?check('dq_cast_pointer_to_func_ref()', 1)
    return 0
endfunc
