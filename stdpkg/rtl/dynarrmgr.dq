use rtl/rtlint

object ODynArrMgr:
public
    refcount : int
    dataptr  : pointer
    length   : uint
    capacity : uint

    elemsize : uint        // cached from type info
    flags    : uint        // cached element handling flags
    typekind : uint8
    subtype  : uint8
    typeinfo : ^SDqTypeInfo

    func *Create(atypeinfo : ^SDqTypeInfo)
    func *Destroy()

    func Reserve(min_capacity : uint)
    func SetCapacity(new_capacity : uint)  // truncates the length if necessary
    func SetLength(new_length : uint)
    func Compact()  // sets the capacity to the actual length
    func Clear(free_storage : bool = false)

    func Append(asrc : pointer, acount : int)
    func Insert(index : int, src : pointer, acount : int)
    func Prepend(src : pointer, acount : int)
    func Delete(index : int, acount : int = 1)
    func Pop(outptr : pointer)
    func PopFirst(outptr : pointer)
endobject

func DynArrCreate(arr : ref ODynArrMgr, ati : ^SDqTypeInfo)
func DynArrIncRef(arr : ref ODynArrMgr)
func DynArrDecRef(arr : ref ODynArrMgr)
func DynArrAssignOther(arr : ref ODynArrMgr, srcarr : ODynArrMgr)
func DynArrAssignData(arr : ref ODynArrMgr, ati : ^SDqTypeInfo, asrc : pointer, acount : int)

func DynArrGetElemPtr(arr : ref ODynArrMgr, index : int) -> pointer
func DynArrGetLength(arr : ref ODynArrMgr) -> uint
func DynArrGetCapacity(arr : ref ODynArrMgr) -> uint
func DynArrGetRefCount(arr : ref ODynArrMgr) -> int

func DynArrReserve(arr : ref ODynArrMgr, ati : ^SDqTypeInfo, min_capacity : uint)
func DynArrSetLength(arr : ref ODynArrMgr, ati : ^SDqTypeInfo, new_length : uint)
func DynArrSetCapacity(arr : ref ODynArrMgr, ati : ^SDqTypeInfo, new_capacity : uint)
func DynArrCompact(arr : ref ODynArrMgr)
func DynArrClear(arr : ref ODynArrMgr, free_storage : bool = false)

func DynArrAppend(arr : ref ODynArrMgr, ati : ^SDqTypeInfo, asrc : pointer, acount : int)
func DynArrInsert(arr : ref ODynArrMgr, ati : ^SDqTypeInfo, index : int, asrc : pointer, acount : int)
func DynArrDelete(arr : ref ODynArrMgr, index : int, acount : int = 1)
func DynArrClone(dstarr : ref ODynArrMgr, ati : ^SDqTypeInfo, srcarr : ODynArrMgr)
func DynArrPop(arr : ref ODynArrMgr, outptr : pointer)
func DynArrPopFirst(arr : ref ODynArrMgr, outptr : pointer)

func DynArrGetFullSlice(arr : ref ODynArrMgr, desc : refout SArraySliceDesc)
func DynArrGetSlice(arr : ref ODynArrMgr, desc : refout SArraySliceDesc, startpos : int, endposex : int)

implementation

use rtl/mem
#ifdef DYNSTRINGS
use rtl/strfunc
#endif

func libc_memset(dest : pointer, value : int, size : uint) -> pointer [[external('memset')]]

func DynArrRuntimeError(emsg : ^char):
    RuntimeError(emsg)
endfunc

func DynArrCalcByteSize(elemcount : uint, elemsize : uint) -> uint:
    if elemcount == 0:
        return 0
    endif
    if elemsize == 0:
        DynArrRuntimeError('DynArray element size is zero')
        return 0
    endif

    result = elemcount * elemsize
    if result div elemcount <> elemsize:
        DynArrRuntimeError('DynArray capacity overflow')
        return 0
    endif
endfunc

func DynArrAddLength(length : uint, acount : int) -> uint:
    if acount < 1:
        return length
    endif

    var add_count : uint = acount
    result = length + add_count
    if result < length:
        DynArrRuntimeError('DynArray length overflow')
        return length
    endif
endfunc

func DynArrGrowCapacity(current_capacity : uint, min_capacity : uint) -> uint:
    result = current_capacity
    if result < 1:
        result = 1
    endif

    while result < min_capacity:
        var doubled : uint = result * 2
        if doubled <= result:
            result = min_capacity
            return
        endif
        result = doubled
    endwhile
endfunc

func DynArrClampIndex(index : int, length : uint) -> uint:
    if index <= 0:
        return 0
    elif index >= length:
        return length
    else:
        return index
    endif
endfunc

func DynArrOwnDataPtrOffset(dataptr : pointer, src : pointer, length : uint, elemsize : uint) -> int:
    if dataptr == nil  or  src == nil  or  length == 0:
        return -1
    endif

    var used_bytes : uint = DynArrCalcByteSize(length, elemsize)
    if used_bytes == 0:
        return -1
    endif

    var baseaddr : uint = uint(dataptr)
    var srcaddr  : uint = uint(src)
    if srcaddr < baseaddr  or  srcaddr >= baseaddr + used_bytes:
        return -1
    endif

    result = (srcaddr - baseaddr) div elemsize
endfunc

func ODynArrMgr.*Create(atypeinfo : ^SDqTypeInfo):
    refcount = 0
    length = 0
    capacity = 0
    dataptr = nil

    typeinfo = atypeinfo
    elemsize = typeinfo.storagesize
    flags    = typeinfo.flags
    typekind = typeinfo.kind
    subtype  = typeinfo.subtype
endfunc

func DynArrIncRefElements(dataptr : pointer, length : uint, typeinfo : ^SDqTypeInfo):
    if typeinfo == nil  or  length == 0:
        return
    endif

    if typeinfo.kind == DQTK_DYN_ARRAY:
        var elemsize : uint = typeinfo.storagesize
        var i : uint = 0
        while i < length:
            var mgrptr : pointer = ^byte(dataptr)[i * elemsize]
            var mgr : ODynArrMgr = ODynArrMgr( ^pointer(mgrptr)^ )
            if mgr <> nil:
                DynArrIncRef(mgr)
            endif
            i += 1
        endwhile

#ifdef DYNSTRINGS
    elif typeinfo.kind == DQTK_DYNSTR:
        var elemsize : uint = typeinfo.storagesize
        var i : uint = 0
        while i < length:
            var mgrptr : pointer = ^byte(dataptr)[i * elemsize]
            var mgr : ODynStrMgr = ODynStrMgr( ^pointer(mgrptr)^ )
            if mgr <> nil:
                DynStrIncRef(mgr)
            endif
            i += 1
        endwhile
#endif

    elif typeinfo.copy_func <> nil:
        typeinfo.copy_func(dataptr, dataptr, length)
        // custom copy_func handles refcounting or deep copying
        // However, since we just MemCopied, this is mostly for deep copying if it existed,
        // but in DQ bitwise moves are safe, so we don't have a copy_func standard yet.
    endif
endfunc

func DynArrDecRefElements(dataptr : pointer, length : uint, typeinfo : ^SDqTypeInfo):
    if typeinfo == nil  or  length == 0:
        return
    endif

    if typeinfo.kind == DQTK_DYN_ARRAY:
        var elemsize : uint = typeinfo.storagesize
        var i : uint = 0
        while i < length:
            var mgrptr : pointer = ^byte(dataptr)[i * elemsize]
            var mgr : ODynArrMgr = ODynArrMgr( ^pointer(mgrptr)^ )
            if mgr <> nil:
                DynArrDecRef(mgr)
            endif
            i += 1
        endwhile

#ifdef DYNSTRINGS
    elif typeinfo.kind == DQTK_DYNSTR:
        var elemsize : uint = typeinfo.storagesize
        var i : uint = 0
        while i < length:
            var mgrptr : pointer = ^byte(dataptr)[i * elemsize]
            var mgr : ODynStrMgr = ODynStrMgr( ^pointer(mgrptr)^ )
            if mgr <> nil:
                DynStrDecRef(mgr)
            endif
            i += 1
        endwhile
#endif

    elif typeinfo.destroy_func <> nil:
        typeinfo.destroy_func(dataptr, length)

    endif

endfunc

func ODynArrMgr.*Destroy():
    use . , mem
    DynArrDecRefElements(dataptr, length, typeinfo)
    if dataptr <> nil:
        MemFree(dataptr)
        dataptr = nil
    endif
    length = 0
    capacity = 0
endfunc

func ODynArrMgr.SetCapacity(new_capacity : uint):
    use . , mem
    if new_capacity == capacity:
        return
    endif

    if new_capacity == 0:
        if dataptr <> nil:
            MemFree(dataptr)
            dataptr = nil
        endif
        capacity = 0
        length = 0
        return
    endif

    var new_bytes : uint = DynArrCalcByteSize(new_capacity, elemsize)
    if new_bytes == 0:
        return
    endif

    var new_dataptr : pointer = nil
    if dataptr == nil:
        new_dataptr = MemAlloc(new_bytes)
    else:
        new_dataptr = MemRealloc(dataptr, new_bytes)
    endif

    if new_dataptr == nil:
        DynArrRuntimeError('DynArray allocation failed')
        return
    endif

    dataptr = new_dataptr
    capacity = new_capacity
    if length > new_capacity:
        length = new_capacity
    endif
endfunc

func ODynArrMgr.Reserve(min_capacity : uint):
    if min_capacity <= capacity:
        return
    endif
    SetCapacity(@..DynArrGrowCapacity(capacity, min_capacity))
endfunc

func ODynArrMgr.SetLength(new_length : uint):
    use .
    if new_length < length:
        DynArrDecRefElements(^byte(dataptr)[new_length * elemsize], length - new_length, typeinfo)
        length = new_length
        return
    endif

    if new_length == length:
        return
    endif

    var old_length : uint = length
    Reserve(new_length)
    if capacity < new_length:
        return
    endif

    var zero_count : uint = new_length - old_length
    var zero_bytes : uint = DynArrCalcByteSize(zero_count, elemsize)
    if zero_bytes == 0:
        return
    endif

    libc_memset(^byte(dataptr)[old_length * elemsize], 0, zero_bytes)
    length = new_length
endfunc

func ODynArrMgr.Compact():
    if capacity > length:
        SetCapacity(length)
    endif
endfunc

func ODynArrMgr.Clear(free_storage : bool = false):
    @..DynArrDecRefElements(dataptr, length, typeinfo)
    length = 0
    if free_storage:
        SetCapacity(0)
    endif
endfunc

func ODynArrMgr.Append(asrc : pointer, acount : int):
    use . , mem
    if acount < 1:
        return
    endif

    var old_length : uint = length
    var new_length : uint = DynArrAddLength(length, acount)
    if new_length <= length:
        return
    endif

    var owndata_src_index : int = DynArrOwnDataPtrOffset(dataptr, asrc, old_length, elemsize)
    if new_length > capacity:
        Reserve(new_length)
        if capacity < new_length:
            return
        endif
    endif

    var srcptr : pointer = asrc
    if owndata_src_index >= 0:
        srcptr = ^byte(dataptr)[uint(owndata_src_index) * elemsize]
    endif

    MemCopy(^byte(dataptr)[old_length * elemsize], srcptr, DynArrCalcByteSize(uint(acount), elemsize))
    DynArrIncRefElements(^byte(dataptr)[old_length * elemsize], uint(acount), typeinfo)

    length = new_length
endfunc

func ODynArrMgr.Insert(index : int, src : pointer, acount : int):
    use . , mem
    if acount < 1:
        return
    endif

    var old_length : uint = length
    var insertpos : uint = DynArrClampIndex(index, old_length)
    var new_length : uint = DynArrAddLength(old_length, acount)
    if new_length <= old_length:
        return
    endif

    var add_count : uint = acount
    var owndata_src_index : int = DynArrOwnDataPtrOffset(dataptr, src, old_length, elemsize)

    if new_length > capacity:
        Reserve(new_length)
        if capacity < new_length:
            return
        endif
    endif

    var tail_count : uint = old_length - insertpos
    if tail_count > 0:
        MemCopy(^byte(dataptr)[(insertpos + add_count) * elemsize],
                ^byte(dataptr)[insertpos * elemsize],
                DynArrCalcByteSize(tail_count, elemsize))
    endif

    var dstptr : pointer = ^byte(dataptr)[insertpos * elemsize]
    var copy_bytes : uint = DynArrCalcByteSize(add_count, elemsize)

    if owndata_src_index < 0:
        MemCopy(dstptr, src, copy_bytes)
    else:
        // the src data is from this array !
        var sidx : uint = owndata_src_index
        if sidx + add_count <= insertpos:
            MemCopy(dstptr, ^byte(dataptr)[sidx * elemsize], copy_bytes)
        elif sidx >= insertpos:
            MemCopy(dstptr, ^byte(dataptr)[(sidx + add_count) * elemsize], copy_bytes)
        else:
            // split copy required for the case similar to this:
            //   var a : [*]int = [1, 2, 3, 4]
            //   a.Insert(2, a[1:3])  // expected: [1, 2, 2, 3, 3, 4]
            //                                             ^  ^
            var left_count : uint = insertpos - sidx
            var right_count : uint = add_count - left_count
            MemCopy(dstptr,
                    ^byte(dataptr)[sidx * elemsize],
                    DynArrCalcByteSize(left_count, elemsize))
            MemCopy(^byte(dstptr)[left_count * elemsize],
                    ^byte(dataptr)[(insertpos + add_count) * elemsize],
                    DynArrCalcByteSize(right_count, elemsize))
        endif
    endif

    DynArrIncRefElements(dstptr, add_count, typeinfo)

    length = new_length
endfunc

func ODynArrMgr.Prepend(src : pointer, acount : int):
    Insert(0, src, acount)
endfunc

func ODynArrMgr.Delete(index : int, acount : int):
    use . , mem
    if acount < 1  or  length == 0:
        return
    endif

    var deletepos : uint = DynArrClampIndex(index, length)
    if deletepos >= length:
        return
    endif

    var delcount : uint = acount
    if delcount > length - deletepos:
        delcount = length - deletepos
    endif

    var movecount : uint = length - deletepos - delcount
    DynArrDecRefElements(^byte(dataptr)[deletepos * elemsize], delcount, typeinfo)
    if movecount > 0:
        MemCopy(^byte(dataptr)[deletepos * elemsize],
                ^byte(dataptr)[(deletepos + delcount) * elemsize],
                DynArrCalcByteSize(movecount, elemsize))
    endif

    length -= delcount
endfunc

func ODynArrMgr.Pop(outptr : pointer):
    use . , mem
    if length == 0:
        DynArrRuntimeError('DynArray pop from empty array')
        return
    endif

    var lastidx : uint = length - 1
    // copy the element data to the outptr
    MemCopy(outptr, ^byte(dataptr)[lastidx * elemsize], elemsize)
    length = lastidx
endfunc

func ODynArrMgr.PopFirst(outptr : pointer):
    use . , mem
    if length == 0:
        DynArrRuntimeError('DynArray pop from empty array')
        return
    endif

    // copy the element data to the outptr
    MemCopy(outptr, dataptr, elemsize)
    var movecount : uint = length - 1
    if movecount > 0:
        MemCopy(dataptr, ^byte(dataptr)[elemsize], DynArrCalcByteSize(movecount, elemsize))
    endif
    length -= 1
endfunc

//----------------------------------------------------------------------------------------------

// DQ RTL DynArray Handler Functions

func DynArrCreate(arr : ref ODynArrMgr, ati : ^SDqTypeInfo):
    arr = new ODynArrMgr(ati)
    arr.refcount = 1
endfunc

func DynArrIncRef(arr : ref ODynArrMgr):
    if arr == nil:
        return
    endif

    // TODO: add thread safety
    arr.refcount += 1
endfunc

func DynArrDecRef(arr : ref ODynArrMgr):
    if arr == nil:
        return
    endif

    // TODO: add thread safety
    arr.refcount -= 1
    if arr.refcount <= 0:
        delete arr = nil
    endif
endfunc

func DynArrAssignOther(arr : ref ODynArrMgr, srcarr : ODynArrMgr):
    if srcarr <> nil:
        DynArrIncRef(srcarr)
    endif
    DynArrDecRef(arr)
    arr = srcarr
endfunc

func DynArrAssignData(arr : ref ODynArrMgr, ati : ^SDqTypeInfo, asrc : pointer, acount : int):
    if acount < 1:
        DynArrDecRef(arr)
        arr = nil
        return
    endif

    var newarr : ODynArrMgr = nil
    DynArrCreate(newarr, ati)
    newarr.SetCapacity(acount)
    if newarr.capacity < acount:  // on storage allocation error
        delete newarr = nil
        return
    endif
    newarr.Append(asrc, acount)

    DynArrDecRef(arr)
    arr = newarr
endfunc

func DynArrGetElemPtr(arr : ref ODynArrMgr, index : int) -> pointer:
    if arr == nil  or  index < 0  or  index >= arr.length:
        DynArrRuntimeError('DynArray access out of bounds')
        return nil
    endif
    return ^byte(arr.dataptr)[uint(index) * arr.elemsize]
endfunc

func DynArrGetLength(arr : ref ODynArrMgr) -> uint:
    if arr == nil:
        return 0
    endif
    return arr.length
endfunc

func DynArrGetCapacity(arr : ref ODynArrMgr) -> uint:
    if arr == nil:
        return 0
    endif
    return arr.capacity
endfunc

func DynArrGetRefCount(arr : ref ODynArrMgr) -> int:
    if arr == nil:
        return 0
    endif
    return arr.refcount
endfunc

func DynArrReserve(arr : ref ODynArrMgr, ati : ^SDqTypeInfo, min_capacity : uint):
    if min_capacity == 0:
        return
    endif
    if arr == nil:
        DynArrCreate(arr, ati)
    endif
    arr.Reserve(min_capacity)
endfunc

func DynArrSetLength(arr : ref ODynArrMgr, ati : ^SDqTypeInfo, new_length : uint):
    if new_length == 0:
        if arr <> nil:
            arr.length = 0
        endif
    else:
        if arr == nil:
            DynArrCreate(arr, ati)
        endif
        arr.SetLength(new_length)
    endif
endfunc

func DynArrSetCapacity(arr : ref ODynArrMgr, ati : ^SDqTypeInfo, new_capacity : uint):
    if new_capacity == 0:
        if arr <> nil:
            arr.SetCapacity(0)
            delete arr = nil
        endif
    else:
        if arr == nil:
            DynArrCreate(arr, ati)
        endif
        arr.SetCapacity(new_capacity)
    endif
endfunc

func DynArrCompact(arr : ref ODynArrMgr):
    if arr <> nil:
        arr.Compact()
    endif
endfunc

func DynArrClear(arr : ref ODynArrMgr, free_storage : bool = false):
    if arr <> nil:
        arr.Clear(free_storage)
        if free_storage:
            delete arr = nil
        endif
    endif
endfunc

func DynArrAppend(arr : ref ODynArrMgr, ati : ^SDqTypeInfo, asrc : pointer, acount : int):
    if acount < 1:
        return
    endif
    if arr == nil:
        DynArrCreate(arr, ati)
    endif
    arr.Append(asrc, acount)
endfunc

func DynArrInsert(arr : ref ODynArrMgr, ati : ^SDqTypeInfo, index : int, asrc : pointer, acount : int):
    if acount < 1:
        return
    endif
    if arr == nil:
        DynArrCreate(arr, ati)
    endif
    arr.Insert(index, asrc, acount)
endfunc

func DynArrDelete(arr : ref ODynArrMgr, index : int, acount : int = 1):
    if arr <> nil:
        arr.Delete(index, acount)
    endif
endfunc

func DynArrClone(dstarr : ref ODynArrMgr, ati : ^SDqTypeInfo, srcarr : ODynArrMgr):
    if srcarr == nil:
        DynArrDecRef(dstarr)
        dstarr = nil
        return
    endif
    if srcarr.length == 0:
        DynArrDecRef(dstarr)
        dstarr = nil
        return
    endif

    var newarr : ODynArrMgr = nil
    DynArrCreate(newarr, ati)
    newarr.SetCapacity(srcarr.length)
    if newarr.capacity < srcarr.length:
        delete newarr = nil
        return
    endif
    newarr.Append(srcarr.dataptr, srcarr.length)

    DynArrDecRef(dstarr)
    dstarr = newarr
endfunc

func DynArrPop(arr : ref ODynArrMgr, outptr : pointer):
    if arr == nil:
        DynArrRuntimeError('DynArray pop from empty array')
        return
    endif
    arr.Pop(outptr)
endfunc

func DynArrPopFirst(arr : ref ODynArrMgr, outptr : pointer):
    if arr == nil:
        DynArrRuntimeError('DynArray pop from empty array')
        return
    endif
    arr.PopFirst(outptr)
endfunc

func DynArrGetFullSlice(arr : ref ODynArrMgr, desc : refout SArraySliceDesc):
    if arr == nil:
        desc.dataptr = nil
        desc.length = 0
    else:
        desc.dataptr = arr.dataptr
        desc.length = arr.length
    endif
endfunc

func DynArrGetSlice(arr : ref ODynArrMgr, desc : refout SArraySliceDesc, startpos : int, endposex : int):
    if arr == nil:
        desc.dataptr = nil
        desc.length = 0
        return
    endif

    var arrlen : uint = arr.length

    var b : int = startpos
    if b < 0:
        b = 0
    elif b >= arrlen:
        b = arrlen
    endif
    var e : int = endposex
    if e < 0:
        e = 0
    elif e >= arrlen:
        e = arrlen
    endif
    if e < b:
        e = b
    endif

    desc.length = e - b
    if desc.length == 0:
        desc.dataptr = nil
    else:
        desc.dataptr = ^byte(arr.dataptr)[b * arr.elemsize]
    endif
endfunc
