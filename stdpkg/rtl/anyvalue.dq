use rtl/rtlint

/*

var av : anyvalue

av.SetNull(true)
av.IsNull()

*/

const DQSUBT_INT_SIGNED : byte = 1

struct SDqAnyValue:
    data     : [16]byte  // The SDqTextInfo must fit into this, must be padded with zeroes
    kind     : byte      // one of the DQTK_xxx values
    subtype  : byte
    datasize : byte
    _pad     : [@def.PTRSIZE - 1]byte
endstruct

// Special "null" value for database handling, not same as "nil" pointer !
func AnyValIsNull(v : ref SDqAnyValue) -> bool
func AnyValSetNull(v : ref SDqAnyValue)

func AnyValIsNumber(v : ref SDqAnyValue) -> bool

func AnyValIsInt(v : ref SDqAnyValue) -> bool
func AnyValIsSInt(v : ref SDqAnyValue) -> bool
func AnyValIsUint(v : ref SDqAnyValue) -> bool
func AnyValAsInt(v : ref SDqAnyValue, defval : int) -> int
func AnyValAsUint(v : ref SDqAnyValue, defval : uint) -> uint
func AnyValSetInt(v : ref SDqAnyValue, value : int)
func AnyValSetUInt(v : ref SDqAnyValue, value : uint)

func AnyValIsBool(v : ref SDqAnyValue) -> bool
func AnyValAsBool(v : ref SDqAnyValue, defval : bool) -> bool
func AnyValSetBool(v : ref SDqAnyValue, value : bool)

func AnyValIsPointer(v : ref SDqAnyValue) -> bool
func AnyValAsPointer(v : ref SDqAnyValue, defval : pointer) -> pointer
func AnyValSetPointer(v : ref SDqAnyValue, defval : pointer)

func AnyValIsFloat(v : ref SDqAnyValue) -> bool
func AnyValIsFloat32(v : ref SDqAnyValue) -> bool
func AnyValIsFloat64(v : ref SDqAnyValue) -> bool
func AnyValAsFloat(v : ref SDqAnyValue, defval : float) -> float
func AnyValAsFloat32(v : ref SDqAnyValue, defval : float32) -> float32
func AnyValAsFloat64(v : ref SDqAnyValue, defval : float64) -> float64
func AnyValSetFloat(v : ref SDqAnyValue, value : float)
func AnyValSetFloat32(v : ref SDqAnyValue, value : float32)
func AnyValSetFloat64(v : ref SDqAnyValue, value : float64)

func AnyValIsText(v : ref SDqAnyValue) -> bool
func AnyValAsText(v : ref SDqAnyValue, defval : refin SDqTextInfo, rv : refout SDqTextInfo)
func AnyValSetText(v : ref SDqAnyValue, ati : refin SDqTextInfo)
func AnyValSetCString(v : ref SDqAnyValue, ati : refin SDqTextInfo)

#ifdef DYNSTRINGS
func AnyValIsStr(v : ref SDqAnyValue) -> bool   // true only when it is a dynamic string
func AnyValAsStr(v : ref SDqAnyValue, defval : refin SDqTextInfo) -> str
func AnyValSetStr(v : ref SDqAnyValue, value : str)
func AnyValSetStrText(v : ref SDqAnyValue, ati : ref SDqTextInfo)
#endif

func AnyValDestroy(v : ref SDqAnyValue)
func AnyValCopy(dst : ref SDqAnyValue, src : ref SDqAnyValue)
func AnyValMove(dst : ref SDqAnyValue, src : ref SDqAnyValue)


//func AnyValTryAsInt(v : ref SDqAnyValue, rv : refout int) -> bool
//func AnyValTryAsUint(v : ref SDqAnyValue, rv : refout uint) -> bool
//func AnyValTryAsBool(v : ref SDqAnyValue, rv : refout bool) -> bool
//func AnyValTryAsFloat(v : ref SDqAnyValue, rv : refout float64) -> bool
//func AnyValTryAsStr(v : ref SDqAnyValue, rv : refout str) -> bool

implementation

use rtl/strfunc

#ifdef DYNSTRINGS
func AnyValDynStrRef(v : ref SDqAnyValue) -> ^ODynStrMgr:
    return ^ODynStrMgr(%v.data[0])
endfunc
#endif

func AnyValSetKind(v : ref SDqAnyValue, akind : byte):
#ifdef DYNSTRINGS
    if v.kind == DQTK_DYNSTR:
        if akind == DQTK_DYNSTR:
            return
        endif
        DynStrDecRef(AnyValDynStrRef(v)^)
    endif
#endif
    v.kind = akind
    v.subtype = 0
    v.datasize = 0
#ifdef DYNSTRINGS
    if akind == DQTK_DYNSTR:
        ^pointer(%v.data[0])^ = nil  // nil manager object = empty string
    endif
#endif
endfunc

func AnyValDestroy(v : ref SDqAnyValue):
    AnyValSetKind(v, DQTK_VOID)
    v.data[0] = 0
endfunc

func AnyValCopy(dst : ref SDqAnyValue, src : ref SDqAnyValue):
    if %dst == %src:
        return
    endif
    AnyValDestroy(dst)
    dst = src
#ifdef DYNSTRINGS
    if dst.kind == DQTK_DYNSTR:
        DynStrIncRef(AnyValDynStrRef(dst)^)
    endif
#endif
endfunc

func AnyValMove(dst : ref SDqAnyValue, src : ref SDqAnyValue):
    if %dst == %src:
        return
    endif
    AnyValDestroy(dst)
    dst = src
    src.kind = DQTK_VOID
    src.subtype = 0
    src.datasize = 0
    ^pointer(%src.data[0])^ = nil
endfunc

// DB Null Handling

func AnyValIsNull(v : ref SDqAnyValue) -> bool:
    if v.kind == DQTK_VOID:
        return true
    else:
        return false
    endif
endfunc

func AnyValSetNull(v : ref SDqAnyValue):
    AnyValSetKind(v, DQTK_VOID)
    v.data[0] = 1
endfunc

// Multiple

func AnyValIsNumber(v : ref SDqAnyValue) -> bool:
    return v.kind == DQTK_INT  or  v.kind == DQTK_FLOAT
endfunc


// Integer

func AnyValIsInt(v : ref SDqAnyValue) -> bool:
    return v.kind == DQTK_INT
endfunc

func AnyValIsSInt(v : ref SDqAnyValue) -> bool:
    return v.kind == DQTK_INT and v.subtype == DQSUBT_INT_SIGNED
endfunc

func AnyValIsUint(v : ref SDqAnyValue) -> bool:
    return v.kind == DQTK_INT and v.subtype <> DQSUBT_INT_SIGNED
endfunc

func AnyValAsInt(v : ref SDqAnyValue, defval : int) -> int:
    if v.kind == DQTK_INT:
        return ^int(%v.data[0])^
    elif v.kind == DQTK_FLOAT:
        if v.datasize == 8:
            return Round(^float64(%v.data[0])^)
        else:
            return Round(^float32(%v.data[0])^)
        endif
    else:
        return defval
    endif
endfunc

func AnyValAsUint(v : ref SDqAnyValue, defval : uint) -> uint:
    if v.kind == DQTK_INT:
        return ^uint(%v.data[0])^
    elif v.kind == DQTK_FLOAT:
        if v.datasize == 8:
            return Round(^float64(%v.data[0])^)
        else:
            return Round(^float32(%v.data[0])^)
        endif
    else:
        return defval
    endif
endfunc

func AnyValSetInt(v : ref SDqAnyValue, value : int):
    AnyValSetKind(v, DQTK_INT)
    v.subtype = DQSUBT_INT_SIGNED
    ^int(%v.data[0])^ = value
endfunc

func AnyValSetUInt(v : ref SDqAnyValue, value : uint):
    AnyValSetKind(v, DQTK_INT)
    v.subtype = 0
    ^uint(%v.data[0])^ = value
endfunc

// Boolean

func AnyValIsBool(v : ref SDqAnyValue) -> bool:
    return v.kind == DQTK_BOOL
endfunc

func AnyValAsBool(v : ref SDqAnyValue, defval : bool) -> bool:
    if v.kind == DQTK_BOOL:
        return iif(v.data[0] <> 0, true, false)
    else:
        return defval
    endif
endfunc

func AnyValSetBool(v : ref SDqAnyValue, value : bool):
    AnyValSetKind(v, DQTK_BOOL)
    v.data[0] = iif(value, 1, 0)
endfunc

// Pointer

func AnyValIsPointer(v : ref SDqAnyValue) -> bool:
    return v.kind == DQTK_POINTER
endfunc

func AnyValAsPointer(v : ref SDqAnyValue, defval : pointer) -> pointer:
    if v.kind == DQTK_POINTER:
        return ^pointer(%v.data[0])^
    else:
        return defval
    endif
endfunc

func AnyValSetPointer(v : ref SDqAnyValue, value : pointer):
    AnyValSetKind(v, DQTK_POINTER)
    ^pointer(%v.data[0])^ = value
endfunc

// Floating Point

func AnyValIsFloat(v : ref SDqAnyValue) -> bool:
    return v.kind == DQTK_FLOAT
endfunc

func AnyValIsFloat32(v : ref SDqAnyValue) -> bool:
    return v.kind == DQTK_FLOAT  and  v.datasize == 4
endfunc

func AnyValIsFloat64(v : ref SDqAnyValue) -> bool:
    return v.kind == DQTK_FLOAT  and  v.datasize == 8
endfunc

func AnyValAsFloat(v : ref SDqAnyValue, defval : float) -> float:
    if v.kind == DQTK_FLOAT:
        if v.datasize == 8:
            return ^float64(%v.data[0])^
        else:
            return ^float32(%v.data[0])^
        endif
    elif v.kind == DQTK_INT:
        return ^int(%v.data[0])^
    else:
        return defval
    endif
endfunc

func AnyValAsFloat32(v : ref SDqAnyValue, defval : float32) -> float32:
    if v.kind == DQTK_FLOAT:
        if v.datasize == 8:
            return ^float64(%v.data[0])^  // converts to float32
        else:
            return ^float32(%v.data[0])^
        endif
    elif v.kind == DQTK_INT:
        return ^int(%v.data[0])^
    else:
        return defval
    endif
endfunc

func AnyValAsFloat64(v : ref SDqAnyValue, defval : float64) -> float64:
    if v.kind == DQTK_FLOAT:
        if v.datasize == 8:
            return ^float64(%v.data[0])^
        else:
            return ^float32(%v.data[0])^ // converts to float64
        endif
    elif v.kind == DQTK_INT:
        return ^int(%v.data[0])^
    else:
        return defval
    endif
endfunc

func AnyValSetFloat(v : ref SDqAnyValue, value : float):
    AnyValSetKind(v, DQTK_FLOAT)
    v.datasize = SizeOf(float)
    ^float(%v.data[0])^ = value
endfunc

func AnyValSetFloat32(v : ref SDqAnyValue, value : float32):
    AnyValSetKind(v, DQTK_FLOAT)
    v.datasize = SizeOf(float32)
    ^float32(%v.data[0])^ = value
endfunc

func AnyValSetFloat64(v : ref SDqAnyValue, value : float64):
    AnyValSetKind(v, DQTK_FLOAT)
    v.datasize = SizeOf(float64)
    ^float64(%v.data[0])^ = value
endfunc


// Text / String

func AnyValIsText(v : ref SDqAnyValue) -> bool:
#ifdef DYNSTRINGS
    return v.kind == DQTK_STRVIEW  or  v.kind == DQTK_DYNSTR  or  v.kind == DQTK_CSTRING
#else
    return v.kind == DQTK_STRVIEW  or  v.kind == DQTK_CSTRING
#endif
endfunc

#ifdef DYNSTRINGS
func AnyValIsStr(v : ref SDqAnyValue) -> bool:
    return v.kind == DQTK_DYNSTR
endfunc

func AnyValAsStr(v : ref SDqAnyValue, defval : refin SDqTextInfo) -> str:
    result = ''
    if v.kind == DQTK_DYNSTR:
        DynStrAssignOther(^ODynStrMgr(%result)^, AnyValDynStrRef(v)^)
    else:
        var dti : SDqTextInfo = defval
        var ti : SDqTextInfo = {}
        AnyValAsText(v, dti, ti)
        DynStrAssignData(^ODynStrMgr(%result)^, ti)
    endif
endfunc

func AnyValSetStr(v : ref SDqAnyValue, value : str):
    AnyValSetKind(v, DQTK_DYNSTR)
    DynStrAssignOther(AnyValDynStrRef(v)^, ^ODynStrMgr(%value)^)
    v.datasize = @def.PTRSIZE
endfunc

func AnyValSetStrText(v : ref SDqAnyValue, ati : ref SDqTextInfo):
    AnyValSetKind(v, DQTK_DYNSTR)
    DynStrAssignData(AnyValDynStrRef(v)^, ati)
    v.datasize = @def.PTRSIZE
endfunc
#endif

func AnyValSetText(v : ref SDqAnyValue, ati : refin SDqTextInfo):
    AnyValSetKind(v, DQTK_STRVIEW)
    ^SDqTextInfo(%v.data[0])^ = ati
    v.datasize = SizeOf(SDqTextInfo)
endfunc

func AnyValSetCString(v : ref SDqAnyValue, ati : refin SDqTextInfo):
    AnyValSetKind(v, DQTK_CSTRING)
    ^SDqTextInfo(%v.data[0])^ = ati
    v.datasize = SizeOf(SDqTextInfo)
endfunc

func AnyValAsText(v : ref SDqAnyValue, defval : refin SDqTextInfo, rv : refout SDqTextInfo):
    if v.kind == DQTK_STRVIEW  or  v.kind == DQTK_CSTRING:
        rv = ^SDqTextInfo(%v.data[0])^
#ifdef DYNSTRINGS
    elif v.kind == DQTK_DYNSTR:
        DynStrGetFullView(AnyValDynStrRef(v)^, rv)
#endif
    else:
        rv = defval
    endif
endfunc
