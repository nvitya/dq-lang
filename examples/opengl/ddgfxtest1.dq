// GLFW version of /workvc/ddgfx/tests/test1/formmain.pas.
// It demonstrates an original shape, three cloned shapes, and three cloned
// groups animated independently within a DdGfx scene.

use print
use math
use ./openglutils
use ./ddgfx

const original_width  : int = 800
const original_height : int = 600

//-----------------------------------------------------------------------------

object OTestScene(ODdScene):
public
    time : float64 = 0

    original_shape : OShape
    original_group : ODrawGroup
    group_clones   : [*]OClonedGroup

    func *Create(window : pointer)
    func *Destroy()

    func Step(width : int, height : int)

protected
    triangle : [3]SDdVertex

endobject

func OTestScene.*Create(window : pointer):
    inherited Create(window)

    use *
    background = {0.4, 0.3, 0.2, 1.0}

    triangle[0].x = 0
    triangle[0].y = 0
    triangle[1].x = 1
    triangle[1].y = 0
    triangle[2].x = 1
    triangle[2].y = 1

    original_shape = new OShape(nil)
    original_shape.AddPrimitive(GL_TRIANGLES, triangle)
    original_shape.scalex = 100
    original_shape.scaley = 100
    original_shape.alpha = 0.5
    original_shape.color = {1.0, 0.0, 0.0, 1.0}

    original_group = new ODrawGroup(nil)
    original_group.CloneShape(original_shape)

    var clone_shape : OClonedShape
    clone_shape = original_group.CloneShape(original_shape)
    clone_shape.x += 50
    clone_shape.rotation = 20
    clone_shape.color = {0.0, 1.0, 0.0, 0.4}

    clone_shape = original_group.CloneShape(original_shape)
    clone_shape.x += 70
    clone_shape.rotation = 30
    clone_shape.color = {0.0, 0.0, 1.0, 0.4}

    var clone_group : OClonedGroup
    clone_group = root.CloneGroup(original_group)
    clone_group.x = 100
    clone_group.y = 100
    group_clones.Append(clone_group)

    clone_group = root.CloneGroup(original_group)
    clone_group.x = 200
    clone_group.y = 150
    clone_group.alpha = 0.5
    group_clones.Append(clone_group)

    clone_group = root.CloneGroup(original_group)
    clone_group.x = 300
    clone_group.y = 170
    clone_group.alpha = 0.3
    group_clones.Append(clone_group)
endfunc

func OTestScene.*Destroy():
    delete original_group
    delete original_shape
    inherited Destroy()
endfunc

func OTestScene.Step(width : int, height : int):
    use *
    time += 1.0

    for index : int = 0 count group_clones.length:
        var clone :? = group_clones[index]
        clone.alpha = 1 - index * 0.2 + 0.5 * Sin(index * time / 50)
        clone.scalex = Sin((index + 1) * time / 100)
    endfor

    root.x = 100 + 50 * Sin(time / 20)
    root.y =  50 + 50 * Cos(time / 20)
    root.scalex = width  / original_width
    root.scaley = height / original_height
endfunc

//-----------------------------------------------------------------------------

var g_scene : OTestScene

func *Main():
    PrintLn('DdGfx for DQ Test 1')

    if GlfwInit() == GLFW_FALSE:
        PrintLn('Could not initialize GLFW')
        Exit(1)
    endif

    // DdGfx uses shaders, vertex-array objects, and vertex buffers.  A
    // compatibility profile keeps the legacy GL_ALPHA text texture format.
    GlfwWindowHint(GLFW_CONTEXT_VERSION_MAJOR, 3)
    GlfwWindowHint(GLFW_CONTEXT_VERSION_MINOR, 3)
    GlfwWindowHint(GLFW_OPENGL_PROFILE, GLFW_OPENGL_COMPAT_PROFILE)

    var window : pointer = GlfwCreateWindow(original_width, original_height, 'DdGfx test 1 for DQ', nil, nil)
    if window == nil:
        PrintLn('Could not create the OpenGL window')
        GlfwTerminate()
        Exit(1)
    endif

    GlfwMakeContextCurrent(window)
    GlfwSwapInterval(1)

    g_scene = new OTestScene(window)

    while GlfwWindowShouldClose(window) == GLFW_FALSE:
        var width  : int32 = 0
        var height : int32 = 0
        GlfwGetFramebufferSize(window, %width, %height)

        g_scene.Step(width, height)

        g_scene.BeginFrame(width, height)
        g_scene.EndFrame()
        GlfwPollEvents()
    endwhile

    delete g_scene = nil
    GlfwDestroyWindow(window)
    GlfwTerminate()
endfunc
