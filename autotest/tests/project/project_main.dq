//?notest

use ./project_child

func *Main():
    if @def.PROJECT_DEFINE <> 42:
        exit_code = 2
        return
    endif
    if not (@def.PROJECT_BOOL):
        exit_code = 3
        return
    endif
    if project_child_define() <> 42:
        exit_code = 4
        return
    endif
    #ifdef EXPECT_OVERRIDE
        if @def.PROJECT_OVERRIDE <> 2:
            exit_code = 1
            return
        endif
    #else
        if @def.PROJECT_OVERRIDE <> 1:
            exit_code = 1
            return
        endif
    #endif
endfunc
