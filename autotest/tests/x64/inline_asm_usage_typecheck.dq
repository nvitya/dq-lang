type UnaryCallback = func(value : int) -> int

func *ModuleInit() [[inline, asm]]: //?error(AsmInlineUsage)
    nop
endfunc

func Immediate(value : int, amount : int) -> int [[inline, asm]]:
    add $value, $amount
    [[immediate(amount), clobber(flags)]]
endfunc

func OverloadedImmediate(value : int, amount : int) -> int [[overload, inline, asm]]:
    add $value, $amount
    [[immediate(amount), clobber(flags)]]
endfunc

func OverloadedRegister(value : int) -> int [[overload, inline, asm]]:
    mov $result, $value
endfunc

var bad_callback : UnaryCallback = Immediate //?error(AsmFuncRef)
var bad_overload_callback : UnaryCallback = OverloadedRegister //?error(AsmFuncRef)

func MissingBody(value : int) [[inline, asm]] //?error(AsmFuncBody)

func ExternalInline(value : int) [[inline, asm, external]] //?error(AttrConflict)

func NoInlineInline(value : int) [[inline, asm, noinline]]: //?error(AsmInlineUsage)
    nop
endfunc

func WeakInline(value : int) [[inline, asm, weak]]: //?error(AsmInlineUsage)
    nop
endfunc

func ExportedInline(value : int) [[inline, asm, cexport]]: //?error(AsmInlineUsage)
    nop
endfunc

func SectionedInline(value : int) [[inline, asm, section(".text.inline")]]: //?error(AsmInlineUsage)
    nop
endfunc

struct InlineAsmOwner:
    func Method(value : int) [[inline, asm]]: //?error(AsmInlineUsage)
        nop
    endfunc
endstruct

func *Main() -> int:
    var dynamic_amount : int = 2
    Immediate(40, dynamic_amount) //?error(AsmImmediateConst)
    OverloadedImmediate(40, dynamic_amount) //?error(AsmImmediateConst)
    %Immediate //?error(AsmFuncRef)
    return 0
endfunc
