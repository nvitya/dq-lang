//?exitcode(0)

use dqautotest

var run <- OTestRun()

function *Main() -> int:
    var binary : str = TempPath('.elf')
    run.RunCompiler([
        '-o', binary, SourcePath('../project/arm_no_exceptions.dqproj')
    ])
    run.ExpectExitCode(0)

    if run.exitcode == 0:
        run.RunTool(['nm', '--undefined-only', binary])
        run.ExpectExitCode(0)
        run.ExpectOutputNotContains('__aeabi_unwind')
        run.ExpectOutputNotContains('_Unwind_')
        run.ExpectOutputNotContains('__gnu_Unwind')
    endif

    RemoveTemp(binary)
    return TestResult()
endfunc
