//?notest
// Compile-only diagnostics for disabled dynamic strings.

#ifdef TEST_STR
func TestStr():
    var text : str = "text"
endfunc
#endif

#ifdef TEST_CONCAT
func TestConcat():
    var left : strslice = "left"
    var right : strslice = "right"
    var text = left + right
endfunc
#endif

#ifdef TEST_ANYVALUE
func TestAnyValue():
    var value : anyvalue
    value.SetStr("text")
endfunc
#endif
