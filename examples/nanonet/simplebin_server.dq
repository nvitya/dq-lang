implementation

use print
use nanonet/nano_sockets

object OSConnectionSimple(OSConnection):
    inbuf  : str
    indata : str

    func *Create(aserver : ONanoServer)
    func *Destroy()

    func HandleInput(aobj : Object)  [[override]]
    func ProcessInData()
endobject

func OSConnectionSimple.*Create(aserver : ONanoServer):
    inherited Create(aserver)
    indata = ''
    inbuf.SetLength(4096, char(0))

    @.PrintLn('OSConnectionSimple.Create')
endfunc

func OSConnectionSimple.*Destroy():
    @.PrintLn('Connection destroy.')
    indata = ''
    inbuf = ''
    inherited Destroy()
endfunc

func OSConnectionSimple.HandleInput(aobj : Object)  [[override]]:
    var r : int = sock.Recv(%inbuf[0], inbuf.length)
    if r > 0:
        indata = inbuf[0:r]
        ProcessInData()
    elif r == 0:
        // the socket is closed !
        server.CloseConnection(self)  // this connection is scheduled for removal, safe freeing in other context
    else:
        // ignore errors
    endif
endfunc

func OSConnectionSimple.ProcessInData():
    // the overridden func should do something more useful with the indata...
    @.PrintLn('<- "{}"', [indata])
endfunc

//--------------------------------------------------------------------------------------------------

var svr : ONanoServer

func *Main() -> int:
    PrintLn('DQ NanoNet - SimpleBin Server')

    svr = new ONanoServer(OSConnectionSimple, 4444)
    svr.InitListener()

    PrintLn('Server listening at port {}', [svr.listen_port])

    PrintLn('Entering main loop...')

    while true:
        svr.WaitForEvents(1000)

        // you can do something else here
        Print('.')
        PrintFlush()
    endwhile

    return 0
endfunc
