func main(argc : int, argv : ^^char) -> int  [[cexport]] ..

implementation

use rtl/rtlint
use rtl/mem
#ifdef EXCEPTIONS
use rtl/exception
#endif
use rtl/prgargs
use libc/stdio

// These functions created by the DQ compiler:
func dq_main()         [[external('dq_main')]] ..
func dq_module_init()  [[external('dq_module_init')]] ..

#ifdef EXCEPTIONS

// SIGSEGV Signal handling, converting SIGSEGV to Exception

object ESegFault(Exception):
endobject

const DQ_SIGNAL_BACKTRACE_MAX : int = 32

type FSignalHandler = func(signum : int)

func libc_signal(signum : int, handler : FSignalHandler) -> FSignalHandler [[external('signal')]] ..
func libc_raise(signum : int) -> int [[external('raise')]] ..
func libc_backtrace(buffer : pointer, size : int) -> int [[external('backtrace')]] ..
func libc_sigemptyset(mask : pointer) -> int [[external('sigemptyset')]] ..
func libc_sigaddset(mask : pointer, signum : int) -> int [[external('sigaddset')]] ..
func libc_sigprocmask(how : int, mask : pointer, oldmask : pointer) -> int [[external('sigprocmask')]] ..

const SIG_DFL  : FSignalHandler = nil
const SIGSEGV  : int = 11

var dq_sigsegv_backtrace : [DQ_SIGNAL_BACKTRACE_MAX] pointer

var dq_sigsegv_guard_active : int = 0
var dq_sigsegv_signal : int = 0
var dq_sigsegv_backtrace_count : int = 0
var dq_sigsegv_handling : bool = false

#ifdef ARM
type FSignalContextHandler = func(signum : int, info : pointer, context : pointer)

// glibc's ARM sigaction, and the prefix of ucontext_t through arm_pc.
struct SArmSigAction:
    handler  : FSignalContextHandler
    mask     : [32] uint32
    flags    : int32
    restorer : pointer
endstruct

struct SArmSignalContext:
    flags         : uint32
    link          : pointer
    stack_pointer : pointer
    stack_flags   : int32
    stack_size    : uint32
    trap_no       : uint32
    error_code    : uint32
    oldmask       : uint32
    registers     : [16] uint32
endstruct

func libc_sigaction(signum : int, action : ^SArmSigAction, oldaction : pointer) -> int [[external('sigaction')]] ..
#endif

func RaiseSignalException() ..

func OsRtErrorHandler(emsg : ^char):
    DqExcRaise(new Exception(emsg), true)
endfunc

#ifdef ARM
func DqSigSegvHandler(signum : int, info : pointer, raw_context : pointer):
#else
func DqSigSegvHandler(signum : int):
#endif
    if dq_sigsegv_handling:
        libc_signal(signum, SIG_DFL)
        libc_raise(signum)
        return
    endif
    dq_sigsegv_handling = true
    dq_sigsegv_signal = signum
    dq_sigsegv_backtrace_count = libc_backtrace(%dq_sigsegv_backtrace, DQ_SIGNAL_BACKTRACE_MAX)

    if dq_sigsegv_guard_active <> 0:
      #ifdef ARM
        // ARM EHABI looks up the instruction before the saved PC, as for
        // a call's return address. A signal saves the faulting PC instead.
        // Advancing by a halfword keeps that lookup inside the faulting
        // ARM or Thumb instruction, even at an exception range's start.
        var context : ^SArmSignalContext = ^SArmSignalContext(raw_context)
        context.registers[15] += 2
      #endif
        // Native unwinding preserves the faulting scopes and their cleanups.
        // The kernel blocked SIGSEGV on entry; restore it before leaving the
        // handler by exception so that a later fault can also be caught.
        var mask : [16] uint64
        libc_sigemptyset(%mask)
        libc_sigaddset(%mask, signum)
        libc_sigprocmask(1, %mask, nil) // SIG_UNBLOCK
        RaiseSignalException()
    endif

    libc_signal(signum, SIG_DFL)  // set back the default signal handler
    libc_raise(signum)
endfunc

func SigSegvMessage() -> ^char:
    if dq_sigsegv_signal == SIGSEGV:
        return "Segmentation fault"
    endif
    return "fatal signal"
endfunc

func RaiseSignalException():
    var e = new ESegFault(SigSegvMessage())
    dq_sigsegv_handling = false
    DqExcRaiseWithBacktrace(e, true,
                                        %dq_sigsegv_backtrace, dq_sigsegv_backtrace_count)
endfunc

func PrintException(e : Exception) -> int:
    printf("\nUNCAUGHT EXCEPTION: ")
    printf("%s", TypeName(e))
    printf(": ")
    e.PrintMessage()
    printf("\n")
    e.PrintBacktrace()
    return -1
endfunc

func PrintUncaughtException() -> int:
    result = PrintException(DqExcCurrent())
    DqExcClear()
endfunc

//-----------------------------------------------------------------------------

func RunHostedMain() -> int:
    result = 0
    dq_sigsegv_guard_active = 1

    try:
        dq_module_init()
    except Exception as e:
        dq_sigsegv_guard_active = 0
        return PrintException(e)
    endtry

    if DqExcActive():
        dq_sigsegv_guard_active = 0
        return PrintUncaughtException()
    endif

    try:
        dq_main()
        result = exit_code
    except Exception as e:
        dq_sigsegv_guard_active = 0
        result = PrintException(e)
    endtry

    dq_sigsegv_guard_active = 0
    if DqExcActive():
        result = PrintUncaughtException()
    endif
endfunc

// libc entry point 'main()'

func main(argc : int, argv : ^^char) -> int  [[cexport]]:

    rterror_handler = OsRtErrorHandler

  #ifdef ARM
    var action : SArmSigAction = {}
    action.handler = DqSigSegvHandler
    libc_sigemptyset(%action.mask)
    action.flags = 4 // SA_SIGINFO
    libc_sigaction(SIGSEGV, %action, nil)
  #else
    libc_signal(SIGSEGV, DqSigSegvHandler)
  #endif

    @prgargs.__sys_init_params(argc, argv)

    result = RunHostedMain()

    // no finalize for modules

endfunc

#else

func libc_exit(status : int) [[external('exit')]] ..

func OsRtErrorHandler(emsg : ^char):
    printf("RUNTIME ERROR: %s\n", emsg)
    libc_exit(-1)
endfunc

func main(argc : int, argv : ^^char) -> int  [[cexport]]:
    rterror_handler = OsRtErrorHandler
    @prgargs.__sys_init_params(argc, argv)
    dq_module_init()
    dq_main()
    result = exit_code
endfunc

#endif
