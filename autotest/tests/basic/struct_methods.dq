// struct methods, struct inheritance, and implicit self

func printf(fmt : ^char, ...) -> int [[external]]

struct SBase:
    id : int
    tag : cstring(8)

    func SetId(v : int):
        self.id = v
    endfunc

    func BaseValue() -> int:
        return id + 1
    endfunc
endstruct

struct SChild(SBase):
    extra : int
    names : [2]cstring(8)

    func SetAll(aid : int, aextra : int):
        self.SetId(aid)
        extra = aextra
    endfunc

    func Sum() -> int:
        return self.BaseValue() + extra
    endfunc
endstruct

func SChild.Mul(factor : int) -> int:
    return self.Sum() * factor
endfunc

func *Main() -> int:
    var s : SChild = {}
    s.SetAll(5, 7)
    s.tag = "ok"
    s.names[0] = "aa"
    s.names[1] = "bb"

    printf("struct self sum=%d\n", s.Sum()) //?check("struct self sum", 13)
    printf("struct qualified mul=%d\n", s.Mul(3)) //?check("struct qualified mul", 39)
    printf("struct inherited field=%d\n", s.id) //?check("struct inherited field", 5)

    return 0
endfunc
