object EFileError(Exception):
endobject

object OFile:
    m_filename : str
    m_fmode    : embstr(8)
    m_fhandle  : pointer  // internal libc type

    func *Create() ..
    func *Destroy() ..
    func Open(afname : rostr, afmode : rostr) ..
    func Close() ..
    func Opened() -> bool ..
    func Size() -> int64 ..

    func Seek(apos : int64) ..
    func CurPos() -> int64 ..

    func Read(adest : pointer, asize : int64) -> int64 ..
    func ReadText() -> str ..
    func ReadBytes() -> [*]byte ..

    func Write(asrc : pointer, asize : int64) ..
    func WriteText(atxt : strslice) ..
    func WriteBytes(abytes : []byte) ..

    property name     : str    read m_filename
    property opened   : bool   read Opened
    property position : int64  read CurPos  write Seek
    property size     : int64  read Size
endobject


func FileRead(afname : rostr, dataptr : pointer, maxlen : int64) -> int64 ..
func FileReadText(afname : rostr) -> str ..
func FileReadBytes(afname : rostr) -> [*]byte ..

func FileWrite(afname : rostr, dataptr : pointer, datalen : int64) ..
func FileWriteText(afname : rostr, adata : strslice) ..
func FileWriteBytes(afname : rostr, adata : []byte) ..

func FileExists(afname : rostr) -> bool ..
func FileModifiedTime(afname : rostr) -> int64 ..  // Unix timestamp, or -1 on error
func FileRemove(afname : rostr) ..

func DirExists(adir : rostr) -> bool ..
func DirCreate(adir : rostr, aforce : bool = false) ..
func DirRemove(adir : rostr) ..

func PathSlashSeparators(apath : strslice) -> str ..
func PathPlatformSeparators(apath : strslice) -> str ..
func PathToAbsolute(apath : rostr) -> str ..

func PathDirName(apath : strslice) -> str ..
func PathFileName(apath : strslice) -> str ..
func PathFileExt(apath : strslice) -> str ..

func GetCurrentPath() -> str ..
func SetCurrentPath(apath : rostr) ..


implementation


func libc_fopen(filename : ^char, mode : ^char) -> pointer          [[external('fopen')]] ..
func libc_fclose(stream : pointer) -> int                             [[external('fclose')]] ..
func libc_fseek(stream : pointer, offset : int, origin : int) -> int  [[external('fseek')]] ..
func libc_ftell(stream : pointer) -> int                              [[external('ftell')]] ..
func libc_fread(ptr : pointer, size : uint, count : uint, stream : pointer) -> uint   [[external('fread')]] ..
func libc_fwrite(ptr : pointer, size : uint, count : uint, stream : pointer) -> uint  [[external('fwrite')]] ..
func libc_access(pathname : ^char, mode : int) -> int                [[external('access')]] ..
func libc_remove(pathname : ^char) -> int                            [[external('remove')]] ..
func libc_mkdir(pathname : ^char, mode : uint) -> int                [[external('mkdir')]] ..
func libc_rmdir(pathname : ^char) -> int                             [[external('rmdir')]] ..
func libc_opendir(name : ^char) -> pointer                           [[external('opendir')]] ..
func libc_closedir(dirp : pointer) -> int                             [[external('closedir')]] ..

#ifdef WINDOWS
struct SWin32FileAttributeData:
    file_attributes       : uint32
    creation_time_low     : uint32
    creation_time_high    : uint32
    last_access_time_low  : uint32
    last_access_time_high : uint32
    last_write_time_low   : uint32
    last_write_time_high  : uint32
    file_size_high        : uint32
    file_size_low         : uint32
endstruct

func win_GetFileAttributesExA(filename : ^char, infolevel : int32, info : ^SWin32FileAttributeData) -> int32 [[external('GetFileAttributesExA')]] ..
func win_GetCurrentDirectoryA(size : uint32, buffer : ^char) -> uint32 [[external('GetCurrentDirectoryA')]] ..
func win_SetCurrentDirectoryA(path : ^char) -> int32 [[external('SetCurrentDirectoryA')]] ..
func win_GetFullPathNameA(path : ^char, size : uint32, buffer : ^char, filepart : ^^char) -> uint32 [[external('GetFullPathNameA')]] ..
#else
struct SFileTimespec:
    tv_sec  : int64
    tv_nsec : int64
endstruct

struct SFileStat:
    st_dev     : uint64
    st_ino     : uint64
    st_nlink   : uint64
    st_mode    : uint32
    st_uid     : uint32
    st_gid     : uint32
    __pad0     : int32
    st_rdev    : uint64
    st_size    : int64
    st_blksize : int64
    st_blocks  : int64
    st_atim    : SFileTimespec
    st_mtim    : SFileTimespec
    st_ctim    : SFileTimespec
    __glibc_reserved : [3]int64
endstruct

func libc_stat(pathname : ^char, statbuf : ^SFileStat) -> int [[external('stat')]] ..
func libc_getcwd(buffer : ^char, size : uint) -> ^char [[external('getcwd')]] ..
func libc_chdir(path : ^char) -> int [[external('chdir')]] ..
#endif

//--------------------------------------------------------------------------

const DIR_MODE      : uint = 511
const ACCESS_EXISTS : int = 0
#ifndef WINDOWS
const ERANGE        : int32 = 34
#endif

func FileExists(afname : rostr) -> bool:
    if afname == '':
        return false
    endif
    if DirExists(afname):
        return false
    endif
    return libc_access(afname, ACCESS_EXISTS) == 0
endfunc

func FileModifiedTime(afname : rostr) -> int64:
    if afname == '':
        return -1
    endif
  #ifdef WINDOWS
    var data : SWin32FileAttributeData = {}
    if win_GetFileAttributesExA(afname, 0, %data) == 0:
        return -1
    endif
    var filetime : int64 = int64(data.last_write_time_high) * 4294967296
                            + int64(data.last_write_time_low)
    return filetime div 10000000 - 11644473600
  #else
    var statbuf : SFileStat = {}
    if libc_stat(afname, %statbuf) <> 0:
        return -1
    endif
    return statbuf.st_mtim.tv_sec
  #endif
endfunc

func FileRemove(afname : rostr):
    if afname == '':
        raise EFileError('FileRemove: empty file name')
    endif
    if not FileExists(afname):
        raise EFileError('FileRemove: file does not exist: {}', [afname])
    endif
    if libc_remove(afname) <> 0:
        if FileExists(afname):
            raise EFileError('File remove error: {}', [afname])
        endif
    endif
endfunc

func DirExists(adir : rostr) -> bool:
    if adir == '':
        return false
    endif
    var dir : pointer = libc_opendir(adir)
    if dir == nil:
        return false
    endif
    libc_closedir(dir)
    return true
endfunc

func CreateOneDir(adir : rostr):
    if adir == '':
        return
    endif
    if DirExists(adir):
        return
    endif
    if libc_mkdir(adir, DIR_MODE) <> 0:
        if not DirExists(adir):
            raise EFileError('Directory create error: {}', [adir])
        endif
    endif
endfunc

func DirCreate(adir : rostr, aforce : bool = false):
    if adir == '':
        raise EFileError('DirCreate: empty directory name')
    endif
    if not aforce:
        if DirExists(adir):
            raise EFileError('DirCreate: directory already exists: {}', [adir])
        endif
        if libc_mkdir(adir, DIR_MODE) <> 0:
            if not DirExists(adir):
                raise EFileError('Directory create error: {}', [adir])
            endif
        endif
        return
    endif
    for i : int = 0 count adir.length:
        if adir[i] == '/':
            if i > 0:
                var prefix : str = adir[:i]
                CreateOneDir(prefix)
            endif
        endif
    endfor
    CreateOneDir(adir)
endfunc

func DirRemove(adir : rostr):
    if adir == '':
        raise EFileError('DirRemove: empty directory name')
    endif
    if not DirExists(adir):
        raise EFileError('DirRemove: directory does not exist: {}', [adir])
    endif
    if libc_rmdir(adir) <> 0:
        if DirExists(adir):
            raise EFileError('Directory remove error: {}', [adir])
        endif
    endif
endfunc

//--------------------------------------------------------------------------

func PathSlashSeparators(apath : strslice) -> str:
    result = apath
    for i : int = 0 count result.length:
        if result[i] == char(92):
            result[i] = '/'
        endif
    endfor
endfunc

func PathPlatformSeparators(apath : strslice) -> str:
    result = apath
    for i : int = 0 count result.length:
      #ifdef WINDOWS
        if result[i] == '/':
            result[i] = char(92)
        endif
      #else
        if result[i] == char(92):
            result[i] = '/'
        endif
      #endif
    endfor
endfunc

const PATH_CURRENT_INITIAL_BUFFER_SIZE : uint32 = 256
const PATH_CURRENT_MAX_ATTEMPTS        : int    = 16

func PathCleanAbsolute(apath : strslice) -> str:
    result = '/'
    var pos : int = 0
    while pos < apath.length:
        while pos < apath.length and apath[pos] == '/':
            ++pos
        endwhile

        var start : int = pos
        while pos < apath.length and apath[pos] <> '/':
            ++pos
        endwhile

        if start == pos:
            continue
        endif

        var segment : strslice = apath[start:pos]
        if segment.length == 1 and segment[0] == '.':
            continue
        endif

        if segment.length == 2 and segment[0] == '.' and segment[1] == '.':
            if result.length > 1:
                for endpos : int = int(result.length) - 1 downto 0:
                    if result[endpos] == '/':
                        result.Truncate(endpos)
                        if result == '':
                            result = '/'
                        endif
                        break
                    endif
                endfor
            endif
            continue
        endif

        if result.length > 1:
            result.Append('/')
        endif
        result.Append(segment)
    endwhile
endfunc

func PathToAbsolute(apath : rostr) -> str:
    if apath == '':
        return GetCurrentPath()
    endif

  #ifdef WINDOWS
    result = ''
    var bufsize : uint32 = PATH_CURRENT_INITIAL_BUFFER_SIZE
    for attempt : int = 0 count PATH_CURRENT_MAX_ATTEMPTS:
        result.SetLength(bufsize, char(0))
        var pathlen : uint32 = win_GetFullPathNameA(apath, bufsize, result.pchar, nil)
        if pathlen == 0:
            raise EFileError('Cannot make path absolute: {}', [apath])
        endif
        if pathlen < bufsize:
            result.SetLength(pathlen, char(0))
            result = PathSlashSeparators(result)
            return
        endif
        // The returned size includes the terminator when the buffer is too small.
        bufsize = pathlen + 1
    endfor
    raise EFileError('Absolute path is too long: {}', [apath])
  #else
    result = PathSlashSeparators(apath)
    if result[0] == '/':
        result = PathCleanAbsolute(result)
        return
    endif
    result = GetCurrentPath() + '/' + result
    result = PathCleanAbsolute(result)
  #endif
endfunc

func GetCurrentPath() -> str:
    result = ''
    var bufsize : uint32 = PATH_CURRENT_INITIAL_BUFFER_SIZE
    for attempt : int = 0 count PATH_CURRENT_MAX_ATTEMPTS:
        result.SetLength(bufsize, char(0))
      #ifdef WINDOWS
        var pathlen : uint32 = win_GetCurrentDirectoryA(bufsize, result.pchar)
        if pathlen == 0:
            raise EFileError('Cannot get current directory')
        endif
        if pathlen < bufsize:
            result.SetLength(pathlen, char(0))
            result = PathSlashSeparators(result)
            return
        endif
        // The returned size includes the terminator when the buffer is too small.
        bufsize = pathlen + 1
      #else
        if libc_getcwd(result.pchar, bufsize) <> nil:
            for pathlen : int = 0 count result.length:
                if result[pathlen] == char(0):
                    result.SetLength(pathlen, char(0))
                    return
                endif
            endfor
        endif
        if Errno() <> ERANGE:
            raise EFileError('Cannot get current directory')
        endif
        bufsize *= 2
      #endif
    endfor
    raise EFileError('Current directory path is too long')
endfunc

func SetCurrentPath(apath : rostr):
    if apath == '':
        raise EFileError('SetCurrentPath: empty path')
    endif
  #ifdef WINDOWS
    if win_SetCurrentDirectoryA(apath) == 0:
  #else
    if libc_chdir(apath) <> 0:
  #endif
        raise EFileError('Cannot set current directory: {}', [apath])
    endif
endfunc

func PathLastSeparator(apath : str) -> int:
    for i : int = int(apath.length) - 1 downto 0:
        if apath[i] == '/':
            return i
        endif
    endfor
    return -1
endfunc

func PathDirName(apath : strslice) -> str:
    var path : str = PathSlashSeparators(apath)
    var sep : int = PathLastSeparator(path)
    if sep < 0:
        return ''
    endif
    if sep == 0:
        return '/'
    endif
    return path[:sep]
endfunc

func PathFileName(apath : strslice) -> str:
    var path : str = PathSlashSeparators(apath)
    var sep : int = PathLastSeparator(path)
    if sep < 0:
        return path
    endif
    return path[sep + 1:]
endfunc

func PathFileExt(apath : strslice) -> str:
    var fname : str = PathFileName(apath)
    for i : int = int(fname.length) - 1 downto 1:
        if fname[i] == '.':
            return fname[i:]
        endif
    endfor
    return ''
endfunc

//--------------------------------------------------------------------------

func OFile.*Create():
endfunc

func OFile.*Destroy():
    if Opened():
        Close()
    endif
endfunc

func OFile.Open(afname : rostr, afmode : rostr):
    if Opened():
        Close()
    endif
    m_filename =  afname
    m_fmode.Set(afmode)
    if afname == '':
        raise EFileError('OFile.Open: empty file name')
    endif
    m_fhandle = @..libc_fopen(afname, afmode)
    if m_fhandle == nil:
        raise EFileError('File open error')  // todo: get the error code
    endif
endfunc

func OFile.Close():
    if m_fhandle <> nil:
        @..libc_fclose(m_fhandle)
        m_fhandle = nil
    endif
endfunc

func OFile.Opened() -> bool:
    return m_fhandle <> nil
endfunc

const SEEK_SET : int = 0
const SEEK_CUR : int = 1
const SEEK_END : int = 2

func OFile.Seek(apos : int64):
    if not Opened():
        raise EFileError('OFile.Seek: file is not open')
    endif
    if @..libc_fseek(m_fhandle, apos, @..SEEK_SET) <> 0:
        raise EFileError('OFile.Seek error')
    endif
endfunc

func OFile.CurPos() -> int64:
    if not Opened():
        raise EFileError('OFile.CurPos: file is not open')
    endif
    result = @..libc_ftell(m_fhandle)
    if result < 0:
        raise EFileError('OFile.CurPos error')
    endif
endfunc

func OFile.Size() -> int64:
    if not Opened():
        raise EFileError('OFile.Size: file is not open')
    endif
    var oldpos : int64 = @..libc_ftell(m_fhandle)
    if oldpos < 0:
        raise EFileError('OFile.Size: ftell failed')
    endif
    if @..libc_fseek(m_fhandle, 0, @..SEEK_END) <> 0:
        raise EFileError('OFile.Size: fseek end failed')
    endif
    var endpos : int64 = @..libc_ftell(m_fhandle)
    if endpos < 0:
        raise EFileError('OFile.Size: ftell end failed')
    endif
    if @..libc_fseek(m_fhandle, oldpos, @..SEEK_SET) <> 0:
        raise EFileError('OFile.Size: fseek restore failed')
    endif
    return endpos
endfunc

func OFile.Read(adest : pointer, asize : int64) -> int64:
    if not Opened():
        raise EFileError('OFile.Read: file is not open')
    endif
    if asize < 0:
        raise EFileError('Invalid read size: {}', [asize])
    endif
    result = @..libc_fread(adest, 1, asize, m_fhandle)
    if result < 0:
        raise EFileError('File read error')
    endif
endfunc

func OFile.ReadText() -> str:
    if not Opened():
        raise EFileError('OFile.ReadText: file is not open')
    endif
    var flen : int64 = Size()
    if flen <= 0:
        return ''
    endif
    result = ''  // to avoid uninitialized variable access
    result.SetLength(flen, char(0))
    var r : int64 = Read(%result[0], flen)
    if r <> flen:
        result.SetLength(r, char(0))
    endif
endfunc

func OFile.ReadBytes() -> [*]byte:
    if not Opened():
        raise EFileError('OFile.ReadBytes: file is not open')
    endif
    var flen : int64 = Size()
    if flen <= 0:
        return []
    endif
    result = []  // to avoid uninitialized variable access
    result.SetLength(flen)
    var r : int64 = Read(%result[0], flen)
    if r <> flen:
        result.SetLength(r)
    endif
endfunc


func OFile.Write(asrc : pointer, asize : int64):
    if not Opened():
        raise EFileError('OFile.Write: file is not open')
    endif
    if asize < 0:
        raise EFileError('Invalid write size: {}', [asize])
    endif
    var r : int64 = @..libc_fwrite(asrc, 1, asize, m_fhandle)
    if r <> asize:
        raise EFileError('File write error: {} <> {}', [r, asize])
    endif
endfunc

func OFile.WriteText(atxt : strslice):
    if not Opened():
        raise EFileError('OFile.WriteText: file is not open')
    endif
    if atxt.length <= 0:
        return
    endif
    Write(%atxt[0], atxt.length)
endfunc

func OFile.WriteBytes(abytes : []byte):
    if not Opened():
        raise EFileError('OFile.WriteBytes: file is not open')
    endif
    if abytes.length <= 0:
        return
    endif
    Write(%abytes[0], abytes.length)
endfunc

//--------------------------------------------------------------------------

func FileRead(afname : rostr, dataptr : pointer, maxlen : int64) -> int64:
    var f <- OFile()
    f.Open(afname, 'rb')
    result = f.Read(dataptr, maxlen)
    f.Close()
endfunc

func FileReadText(afname : rostr) -> str:
    var f <- OFile()
    f.Open(afname, 'r')
    result = f.ReadText()
    f.Close()
endfunc

func FileReadBytes(afname : rostr) -> [*]byte:
    var f <- OFile()
    f.Open(afname, 'rb')
    result = f.ReadBytes()
    f.Close()
endfunc

func FileWrite(afname : rostr, dataptr : pointer, datalen : int64):
    var f <- OFile()
    f.Open(afname, 'wb')
    f.Write(dataptr, datalen)
    f.Close()
endfunc

func FileWriteText(afname : rostr, adata : strslice):
    var f <- OFile()
    f.Open(afname, 'w')
    f.WriteText(adata)
    f.Close()
endfunc

func FileWriteBytes(afname : rostr, adata : []byte):
    var f <- OFile()
    f.Open(afname, 'w')
    f.WriteBytes(adata)
    f.Close()
endfunc
