use ./inline_asm_public;
use libc/stdio;

function *Main() -> int:
    printf("inline_asm.module.register = %li\n", PublicAdd(20, 22));
    //?check("inline_asm.module.register", 42)
    printf("inline_asm.module.immediate = %li\n", PublicMulImmediate(6, 7));
    //?check("inline_asm.module.immediate", 42)
    return 0;
endfunc
