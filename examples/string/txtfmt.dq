use print, rtl/textformat, strutils

var cs : embstr(256)
var ds : str

func PrintCs():
    PrintLn('cs="{}"', [cs])
endfunc

func TestEmbStr():
    PrintLn('Testing embstr.AddFmt()')
    cs.Append("functest: ")
    EmbStrAddFmt(cs, ", {}, {}, {}", [1, 3.14, 'qqcs'])
    PrintCs()
    cs.Clear()
    //TODO: implement this
    cs.Add("method: ")  // Add() == Append()
    cs.AddFmt(", {}, {}, {}", [1, 3.14, 'qqcs'])
    PrintCs()
endfunc

func PrintDs():
    PrintLn('ds="{}"', [ds])
endfunc

func TestStr():
    PrintLn('Testing str.AddFmt()')

    ds.Append("functest: ")
    DynStrAddFmt(%ds, ", {}, {}, {}", [5, 2.75, 'hi'])
    PrintDs()

    ds.Clear()
    //TODO: implement this
    ds.Add("method: ")  // Add() == Append()
    ds.AddFmt(", {}, {}, {}", [5, 2.75, 'hi'])
    PrintDs()
endfunc

func *Main():
    TestEmbStr()
    TestStr()

    PrintLn(Format('Format: {}, {}, {}', [42, 'hello', 1.8]))

    PrintLn()
endfunc