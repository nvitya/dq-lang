//?notest

object OModObject:
public
    value : int = 0

    func *Create(v : int):
        value = v
    endfunc
endobject

func ExportObject(o : OModObject) -> Object:
    return o
endfunc

func ImportedObjectSet(o : Object) -> int:
    if o == nil:
        return 0
    endif
    return 1
endfunc
