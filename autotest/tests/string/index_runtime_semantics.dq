// These expressions are specified as runtime bounds errors when executed.
// The test keeps them uncalled so the compiler must accept them as runtime checks.

use libc/stdio

func ReadBeforeStart() -> char:
    var s : str = "abc"
    result = s[-1]
endfunc

func ReadAtEnd() -> char:
    var s : str = "abc"
    result = s[3]
endfunc

func ReadAtEndContext() -> char:
    var s : str = "abc"
    result = s[$end]
endfunc

func ReadEmptyLast() -> char:
    var s : str = ""
    result = s[$last]
endfunc

func WriteBeforeStart():
    var s : str = "abc"
    s[-1] = 'X'
endfunc

func WriteAtEnd():
    var s : str = "abc"
    s[s.length] = 'X'
endfunc

func EmptyPop() -> char:
    var s : str = ""
    result = s.Pop()
endfunc

func EmptyPopFirst() -> char:
    var s : str = ""
    result = s.PopFirst()
endfunc

//func EmptyPadFill() -> str:
//  var s : str = "abc";
//  result = s.LPad(5, "");
//endfunc

func *Main() -> int:
    printf("string_index_runtime_semantics = compiled\n") //?check("string_index_runtime_semantics", "compiled")
    return 0
endfunc
