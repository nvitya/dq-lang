//?notest
object OChild:
    value : int

    func *Create():
        value = 21
    endfunc
endobject

object OGlobal:
    child <- OChild()
    value : int

    func *Create():
        value = 42
    endfunc
endobject

var g_object <- OGlobal()

func dq_module_init() [[external('dq_module_init')]]

func _start() [[cexport]]:
    dq_module_init()
endfunc
