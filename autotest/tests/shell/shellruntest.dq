//?exitcode(0)

use shell
use print

var runner <- OShellRunner()

func *Main() -> int:
    PrintLn('ShellRunner test')

    var envname : str = 'DQ_SHELLRUNNER_TEST_39A8E1'
    if GetEnv(envname, 'missing') <> 'missing':
        PrintLn('GetEnv default value failed')
        return 1
    endif
    SetEnv(envname, 'first value')
    if GetEnv(envname, '') <> 'first value':
        PrintLn('SetEnv initial value failed')
        return 1
    endif
    SetEnv(envname, 'replacement value')
    if GetEnv(envname, '') <> 'replacement value':
        PrintLn('SetEnv replacement value failed')
        return 1
    endif

    var caught : bool = false
    try:
        runner.Run('printf failing-out; printf failing-err >&2; exit 17')
    except EShellResult as e:
        caught = e.code == 17
    endtry
    if not caught:
        PrintLn('Run exception failed')
        return 1
    endif
    if runner.exitcode <> 17 or runner.out <> 'failing-out' or
       runner.err <> 'failing-err':
        PrintLn('Run exception capture failed')
        return 1
    endif

    caught = false
    try:
        runner.RunWithInput(['/bin/sh', '-c', 'cat >/dev/nil; exit 23'], 'input')
    except EShellResult as e:
        caught = e.code == 23 and runner.exitcode == 23
    endtry
    if not caught:
        PrintLn('RunWithInput exception failed')
        return 1
    endif

    var suppressed_exit : int = runner.Run('exit 29', false)
    if suppressed_exit <> 29 or runner.exitcode <> 29:
        PrintLn('Run exception suppression failed')
        return 1
    endif

    suppressed_exit = runner.RunWithInput('exit 31', '', false)
    if suppressed_exit <> 31 or runner.exitcode <> 31:
        PrintLn('RunWithInput exception suppression failed')
        return 1
    endif

    var r : int = runner.Run('printf stdout; printf stderr >&2; exit 7', false)
    if r <> 7 or runner.exitcode <> 7 or not runner.finished:
        PrintLn('unexpected exit state: result={}, exitcode={}, finished={}',
                [r, runner.exitcode, runner.finished])
        return 1
    endif
    if runner.out <> 'stdout' or runner.err <> 'stderr' or runner.output <> 'stdoutstderr':
        PrintLn('unexpected capture: out="{}", err="{}", output="{}"',
                [runner.out, runner.err, runner.output])
        return 1
    endif

    r = runner.Run(['/bin/printf', 'argument output'])
    if r <> 0 or runner.out <> 'argument output' or
       runner.err <> '' or runner.output <> 'argument output':
        PrintLn('argument Run failed')
        return 1
    endif

    // This is larger than a typical pipe buffer, exercising concurrent input
    // feeding and output draining in the foreground monitor.
    var input : str = ''
    input.SetLength(200000, 'x')
    r = runner.RunWithInput(['cat'], input)
    if r <> 0  or not runner.finished  or runner.out <> input 
       or runner.err <> ''  or runner.output <> input
    :
        PrintLn('RunWithInput failed: result={}, outlen={}, errlen={}, outputlen={}',
                [r, runner.out.length, runner.err.length, runner.output.length])
        return 1
    endif

    r = runner.StartBg('printf bgout; printf bgerr >&2')
    if r <> 0 or not runner.WaitFinishMs(2000):
        PrintLn('background command did not finish')
        return 1
    endif
    if runner.exitcode <> 0 or runner.out <> 'bgout' or
       runner.err <> 'bgerr' or runner.output <> 'bgoutbgerr':
        PrintLn('unexpected background capture')
        return 1
    endif

    r = runner.StartBg(['/bin/printf', 'background arguments'])
    if r <> 0 or not runner.WaitFinishMs(2000) or
       runner.out <> 'background arguments' or
       runner.err <> '' or runner.output <> 'background arguments':
        PrintLn('argument StartBg failed')
        return 1
    endif

    r = runner.StartBgWithInput(['cat'], input)
    if r <> 0 or not runner.WaitFinishMs(2000) or
       runner.out <> input or runner.err <> '' or runner.output <> input:
        PrintLn('background input capture failed')
        return 1
    endif

    r = runner.StartBg('sleep 5')
    if r <> 0 or runner.WaitFinishMs(20):
        PrintLn('background timeout handling failed')
        return 1
    endif
    runner.Kill()
    if not runner.Finished() or runner.exitcode <> -1:
        PrintLn('background kill handling failed')
        return 1
    endif

    PrintLn('shell runner tests passed')
    return 0
endfunc
