// DQ object contructor overloading

use print

#define USE_MOD = true

#if @def.USE_MOD
    use ./ctor_overload_mod
#else

object OTest:
    name  : str
    m_str : str

    func *Create(aname : str, astr : str) [[overload]]:
        name  = aname
        m_str = astr
    endfunc

    func *Create(aname : str, afmt : str, avalues : []anyvalue) [[overload]]:
        name  = aname
        m_str.AddFmt(afmt, avalues)
    endfunc

    func Print():
        @.PrintLn('{}: {}', [name, m_str])
    endfunc
endobject

#endif

func *Main() -> int:
    PrintLn('DQ object constructor overload test')
    var o <- OTest('test1', 'Message1')
    o.Print()

    var o2 <- OTest('test2', 'Message2 = {}, {}, {}', [1, 'abc', 3.14])
    o2.Print()

    raise Exception('Formatted exception msg = {}, {}', [1, 3.14])

    return 0
endfunc
