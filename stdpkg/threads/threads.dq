// Minimal POSIX thread wrapper for hosted DQ programs.
//
// Threads share the process address space.  Synchronization of shared data and
// output is deliberately left to the caller.

#linklib('pthread')

//use rtl/mem

type FThreadFunc = function(arg : pointer) -> pointer
type FThreadMethod = function(arg : pointer) -> pointer of object

object OThread:
protected
    running   : bool = false
public
    m_method  : FThreadMethod  // these must be public to use it from outside
    m_arg     : pointer

    thread_id : uint
    retval    : pointer

    function StartFunc(afunc : FThreadFunc, aarg : pointer) -> bool
    function StartMethod(amethod : FThreadMethod, aarg : pointer) -> bool
    function StartSelf(aarg : pointer) -> bool  // starts the Run()

    function Join()                  // waits until the thread stops
    function IsRunning() -> bool     // polls for running state, joins

    function Run(aarg : pointer) -> pointer [[virtual]]  // override this for StartSelf()
endobj

implementation

// pthread_t is unsigned long on the supported POSIX targets, which is the
// native-width unsigned integer represented by DQ's uint type.
function pthread_create(thread : ^uint, attr : pointer, start_func : FThreadFunc, arg : pointer) -> int  [[external]]
function pthread_join(thread : uint, return_value : ^pointer) -> int  [[external]]
function pthread_tryjoin_np(thread : uint, return_value : ^pointer) -> int  [[external]]  // Linux specific !

const PTHREAD_EBUSY : int = 16

function OThread.StartFunc(afunc : FThreadFunc, aarg : pointer) -> bool:
    if running:
        return false
    endif
    retval = nil
    var r : int = @.pthread_create(%thread_id, nil, afunc, aarg)
    if r <> 0:
        return false
    endif
    running = true
    return true
endfunc

function OThread.Join():
    if not running:
        return
    endif
    if @.pthread_join(thread_id, %retval) <> 0:
        // should we set running = false here ?
        return
    endif
    running = false
endfunc

function OThread.IsRunning() -> bool:
    if not running:
        return false
    endif

    // A successful try-join reaps the thread, just like Join().  Preserve its
    // return value in retval so callers can inspect it after polling finishes.
    var r : int = @.pthread_tryjoin_np(thread_id, %retval)
    if r == @.PTHREAD_EBUSY:
        return true  // surely still running
    endif
    // some other error or zero
    running = false
    return false
endfunc

function StartMethodThreadFunc(aarg : pointer) -> pointer:
    var thr : OThread = OThread(aarg)
    return thr.m_method(thr.m_arg)
endfunc

function OThread.StartMethod(amethod : FThreadMethod, aarg : pointer) -> bool:
    if running:
        return false
    endif
    retval = nil
    m_method = amethod
    m_arg = aarg
    var r : int = @.pthread_create(%thread_id, nil, @.StartMethodThreadFunc, pointer(self))
    if r <> 0:
        return false
    endif
    running = true
    return true
endfunc

function StartSelfThreadFunc(aarg : pointer) -> pointer:
    var thr : OThread = OThread(aarg)
    return thr.Run(thr.m_arg)
endfunc

function OThread.StartSelf(aarg : pointer) -> bool: // starts the Run()
    if running:
        return false
    endif
    retval = nil
    m_arg = aarg
    var r : int = @.pthread_create(%thread_id, nil, @.StartSelfThreadFunc, pointer(self))
    if r <> 0:
        return false
    endif
    running = true
    return true
endfunc

function OThread.Run(aarg : pointer) -> pointer [[virtual]]:  // empty
    return nil
endfunc
