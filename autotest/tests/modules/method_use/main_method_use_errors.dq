use ./mod_method_use as onlym only(ONLY_A, imp_func)
use ./mod_method_use as exclm exclude(HIDDEN_A, hidden_func)

const OUTER_A : int = 5

object OMethodUseErrors:
public
    func BranchScope():
        if true:
            use .
        endif
        var v : int = OUTER_A  //?error(ObjVsInModuleNs)
    endfunc

    func DotDoesNotImport():
        use .
        var v : int = ONLY_A  //?error(ObjVsInModuleNs, 'Use "@exclm.ONLY_A"')
    endfunc

    func OnlyDoesNotIncludeHidden():
        use onlym
        var v : int = HIDDEN_A  //?error(VsUnknown)
    endfunc

    func LocalNamespaceDoesNotImport():
        var v : int = @..ONLY_A  //?error(NsVsUnknown)
    endfunc

    func UnknownAlias():
        use missing_alias  //?error(MethodUseInvalid)
    endfunc

    func StarWithAlias():
        use *, onlym  //?error(MethodUseInvalid)
    endfunc

    func StarWithDot():
        use *, .  //?error(MethodUseInvalid)
    endfunc

    func ModifierSyntax():
        use only  //?error(MethodUseInvalid)
    endfunc
endobject

func NormalFunctionUse():
    use .  //?error(MethodUseInvalid)
endfunc
