// Proposed private compiler/RTL ABI. All pointers borrow storage for the call.
// The descriptor starts with a byte count followed by one tag byte per element.
// Bits 1–7 hold the kind. Bit 0 is set for two words and clear for one word.
//
// Logical kind       Words                     Payload
// SINT, UINT         1, or 2 for a wide int    sign/zero extended to slot width
// FLOAT32, FLOAT64   ceil(float bytes / word)  original float bytes at slot start
// BOOL, CHAR, WCHAR  1                         0/1 or unsigned character value
// STRVIEW            2                         byte pointer, known byte length
// PCHAR              1                         zero-terminated text pointer
// POINTER            1                         pointer, including nil
//
// On M0, [int, float64, strslice, ^char] has tags 0x02, 0x09, 0x11, 0x12
// at word offsets 0, 1, 3, 5. The payload is word-aligned and has no padding.
// Wide scalars use native byte order.

const(byte):
    DQVA_SINT    = ( 1 << 1)
    DQVA_UINT    = ( 2 << 1)
    DQVA_FLOAT32 = ( 3 << 1)
    DQVA_FLOAT64 = ( 4 << 1)
    DQVA_BOOL    = ( 5 << 1)
    DQVA_CHAR    = ( 6 << 1)
    DQVA_WCHAR   = ( 7 << 1)
    DQVA_STRVIEW = ( 8 << 1)
    DQVA_PCHAR   = ( 9 << 1)
    DQVA_POINTER = (10 << 1)
endconst

const DQVA_TWO_WORDS : byte = 0x01
const DQVA_KIND_MASK : byte = 0xFE

struct SVarArgs:
    data : ^uint
    desc : ^byte
endstruct

// Each reader borrows the original two ABI components and has its own position.
object OVarArgReader:
private
    m_descriptor : ^byte
    m_payload    : ^uint
    m_data       : ^uint // actual data, nil when there is no current element
    m_length     : byte
    m_index      : byte

    m_tag        : byte
    m_kind       : byte
    m_wordcount  : byte  // 0 when there is no current element

    func SetInvalid() ..

  #if @def.PTRSIZE == 4
    func CopyWide(words : ^uint32) [[inline]]:  // used only on 32-bit architectures, the payload needs only four-byte alignment
        words[0]^ = m_data[0]^
        words[1]^ = m_data[1]^
    endfunc
  #endif

public

    func *Create(payload : ^uint, descriptor : ^byte) [[overload]] ..
    func *Create(args : varargs) [[overload]] ..

    func Next() -> bool ..               // Move past the current element. False means there is no next element.
    func Seek(aindex : uint) -> bool ..  // Seek from the start of the pack. On failure, leave the position intact.

    func TrySint(rvalue : refout int) -> bool ..
    func TryUint(rvalue : refout uint) -> bool ..
    func TrySint64(rvalue : refout int64) -> bool ..
    func TryUint64(rvalue : refout uint64) -> bool ..
    func TryFloat32(rvalue : refout float32) -> bool ..
    func TryFloat64(rvalue : refout float64) -> bool ..
    func TryBool(rvalue : refout bool) -> bool ..
    func TryChar(rvalue : refout char) -> bool ..
    func TryWchar(rvalue : refout wchar) -> bool ..
    func TryText(rvalue : refout strslice) -> bool ..
    func TryPointer(rvalue : refout pointer) -> bool ..

    property length    : byte   read m_length
    property index     : byte   read m_index
    property kind      : byte   read m_kind
    property wordcount : byte   read m_wordcount
    property data      : ^uint  read m_data  // nil if no more data present
endobject

implementation

use rtl/strfunc

func OVarArgReader.*Create(args : varargs) [[overload]]:
    Create(args.data, args.desc)
endfunc

func OVarArgReader.*Create(payload : ^uint, descriptor : ^byte) [[overload]]:
    use .
    m_descriptor = descriptor
    m_payload    = payload

    m_length = m_descriptor[0]^
    if m_length > 0:
        m_index = 0
        m_tag = m_descriptor[1]^
        m_kind = m_tag & DQVA_KIND_MASK
        m_wordcount = 1 + (m_tag & DQVA_TWO_WORDS)
        m_data = m_payload
    else:
        SetInvalid()
    endif
endfunc

// Move past the current element. False means there is no next element.
func OVarArgReader.Next() -> bool:
    use .
    if m_data == nil or m_index + 1 >= m_length:
        SetInvalid()
        return false
    endif
    ++m_index
    m_data = m_data + m_wordcount
    m_tag = m_descriptor[m_index + 1]^
    m_kind = m_tag & DQVA_KIND_MASK
    m_wordcount = 1 + (m_tag & DQVA_TWO_WORDS)
    return true
endfunc

// Seek from the start of the pack. On failure, leave the position intact.
func OVarArgReader.Seek(aindex : uint) -> bool:
    use .
    if aindex >= m_length:
        return false
    endif
    m_index = 0
    m_data = m_payload
    var pkind : ^byte = m_descriptor[1]
    while m_index < aindex:
        m_data += 1 + (pkind^ & DQVA_TWO_WORDS)
        ++pkind
        ++m_index
    endwhile
    m_tag = pkind^
    m_kind = m_tag & DQVA_KIND_MASK
    m_wordcount = 1 + (m_tag & DQVA_TWO_WORDS)
    return true
endfunc

func OVarArgReader.SetInvalid():
    m_index = 255
    m_tag = 0
    m_kind = 0
    m_wordcount = 0
    m_data = nil
endfunc

func OVarArgReader.TrySint(rvalue : refout int) -> bool:
    if m_kind <> @.DQVA_SINT  or m_wordcount <> 1:
        return false
    endif
    rvalue = ^int(m_data)^
    return true
endfunc

func OVarArgReader.TryUint(rvalue : refout uint) -> bool:
    if m_kind <> @.DQVA_UINT  or m_wordcount <> 1:
        return false
    endif
    rvalue = ^uint(m_data)^
    return true
endfunc

func OVarArgReader.TrySint64(rvalue : refout int64) -> bool:
    if m_kind <> @.DQVA_SINT:
        return false
    endif
  #if @def.PTRSIZE > 4
    rvalue = ^int64(m_data)^
  #else
    if m_wordcount == 1:
        rvalue = ^int(m_data)^
    else:
        rvalue = 0
        CopyWide(^uint32(%rvalue))
    endif
  #endif
    return true
endfunc

func OVarArgReader.TryUint64(rvalue : refout uint64) -> bool:
    if m_kind <> @.DQVA_UINT:
        return false
    endif
  #if @def.PTRSIZE > 4
    rvalue = ^uint64(m_data)^
  #else
    if m_wordcount == 1:
        rvalue = ^uint(m_data)^
    else:
        rvalue = 0
        CopyWide(^uint32(%rvalue))
    endif
  #endif
    return true
endfunc

func OVarArgReader.TryFloat32(rvalue : refout float32) -> bool:
    if m_kind <> @.DQVA_FLOAT32:
        return false
    endif
    rvalue = ^float32(m_data)^
    return true
endfunc

func OVarArgReader.TryFloat64(rvalue : refout float64) -> bool:
    if m_kind <> @.DQVA_FLOAT64:
        return false
    endif
  #if @def.PTRSIZE > 4
    rvalue = ^float64(m_data)^
  #else
    rvalue = 0
    CopyWide(^uint32(%rvalue))  // for wide platform LLVM compatibility
  #endif
    return true
endfunc

func OVarArgReader.TryBool(rvalue : refout bool) -> bool:
    if m_kind <> @.DQVA_BOOL:
        return false
    endif
    rvalue = m_data^ <> 0
    return true
endfunc

func OVarArgReader.TryChar(rvalue : refout char) -> bool:
    if m_kind <> @.DQVA_CHAR:
        return false
    endif
    rvalue = char(m_data^)
    return true
endfunc

func OVarArgReader.TryWchar(rvalue : refout wchar) -> bool:
    if m_kind <> @.DQVA_WCHAR:
        return false
    endif
    rvalue = wchar(m_data^)
    return true
endfunc

func OVarArgReader.TryText(rvalue : refout strslice) -> bool:
    use *
    if m_kind == DQVA_STRVIEW:
        rvalue = StrSlice(^^char(m_data)^, m_data[1]^)
        return true
    elif m_kind == DQVA_PCHAR:
        // Conversion to strslice resolves the zero-terminated length here.
        rvalue = ^^char(m_data)^
        return true
    endif
    return false
endfunc

func OVarArgReader.TryPointer(rvalue : refout pointer) -> bool:
    if m_kind <> @.DQVA_POINTER:
        return false
    endif
    rvalue = ^pointer(m_data)^
    return true
endfunc
