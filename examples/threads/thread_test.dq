use print
use libc/stdio
use time

use threads

function putchar(c : char) -> int [[external]]

var thr1 <- OThread()
var thr2 <- OThread()
var thr3 <- OThread()

object OTest1:
    counter : int = 5
    name    : str = "?"

    function *Create(aname : str):
        name = aname
    endfunc

    function ThreadFunc(aarg : pointer) -> pointer:
        use *
        PrintLn('Obj({}) started, counter = {}', [name, counter])
        SleepMillis(1500)
        PrintLn('Obj({}) finished', [name])
        return nil
    endfunc
endobj

var ot1 <- OTest1('ot1')


object OWorker(OThread):
    name    : str = "?"

    function *Create(aname : str):
        name = aname
    endfunc

    function Run(aarg : pointer) -> pointer [[override]]:
        use *
        PrintLn('OWorker({}) started', [name])
        SleepMillis(2300)
        PrintLn('OWorker({}) finished', [name])
        return nil
    endfunc
endobj

var wrk <- OWorker('wrk1')

function ThreadFunc1(arg : pointer) -> pointer:
    printf('ThreadFunc1 started\n')
    SleepMillis(2300)
    printf('ThreadFunc1 finished\n')
    return nil
endfunc

function ThreadFunc2(arg : pointer) -> pointer:
    printf('ThreadFunc2 started\n')
    SleepMillis(3600)
    printf('ThreadFunc2 finished\n')
    return nil
endfunc

function *Main() -> int:
    PrintLn('DQ Threading Test')
    PrintLn('Starting threads...')

    if not thr1.StartFunc(ThreadFunc1, nil):
        PrintLn('Unable to start thread 1.')
        return 1
    endif
    if not thr2.StartFunc(ThreadFunc2, nil):
        PrintLn('Unable to start thread 2.')
        thr1.Join()
        return 1
    endif

    //thr3.StartMethod(ot1.ThreadFunc, nil)
    wrk.StartSelf(nil)

    PrintLn('main: waiting threads to finish...')
    while thr1.IsRunning() or thr2.IsRunning() or thr3.IsRunning() or wrk.IsRunning():
        PrintLn(".")
        SleepMillis(500)
    endwhile
    //thr1.Join()
    //thr2.Join()

    PrintLn('Exiting main.')
    PrintLn()
    return 0
endfunc
