// A raw pointer borrowed as rostr must not inherit SDqTextInfo's 24-bit scan limit.
use libc/stdio
use rtl/rtlint
use rtl/strfunc

func *Main() -> int:
    var source : str
    source.SetLength(0x1000002, 'x')
    var raw : ^char = source.pchar
    var borrowed : rostr = raw
    var view : strview = borrowed
    var desc : ^SDqRoStrInfo = ^SDqRoStrInfo(%borrowed)
    printf("large = %li:%li:%u:%i\n", source.length, view.length, desc.charlen, borrowed[$last] == 'x') //?check("large", "16777218:16777218:16777218:1")
    var known : rostr = source
    printf("large_known = %li\n", known.length) //?check("large_known", 16777218)
    return 0
endfunc
