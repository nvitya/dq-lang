//?notest

use libc/stdio

object OModBase:
protected
    value : int = 0
public
    func *Create(a : int):
        value = a
    endfunc

    func Get() -> int [[virtual]]:
        return value
    endfunc

    func *Destroy():
    endfunc
endobject

object OModChild(OModBase):
private
    extra : int = 0
public
    func *Create(a : int):
        inherited Create(a)
        extra = a + 1
    endfunc

    func Get() -> int [[override]]:
        return inherited Get() + extra
    endfunc

    func PrintProt():
        @.printf("Protected_value = %d\n", value)
    endfunc

    func *Destroy():
        inherited Destroy()
    endfunc
endobject
