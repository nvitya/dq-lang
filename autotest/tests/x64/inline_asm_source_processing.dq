use libc/stdio

func ConditionalAdd(value : int, value2 : int) -> int [[inline, asm]]:
    // [[immediate(value)]] and endfunc in a line comment are inert.
    #ifdef INLINE_ASM_BRANCH_THAT_IS_NOT_DEFINED
        endfunc
        [[clobber(not_a_register)]]
        mov rax, #1
        /* The #2 below is also inactive assembly, not a directive. */
        add rax, #2
    #else
        /* Assembly-looking text in this comment must disappear:
           mov $result, 999
           [[clobber(unknown_register)]]
           endfunc
        */
        lea /* separator */ $result, [$value + $value2] // trailing DQ comment
    #endif
endfunc

func *Main() -> int:
    printf("inline_asm.source_processing = %li\n", ConditionalAdd(19, 23))
    //?check("inline_asm.source_processing", 42)
    return 0
endfunc
