use libc/stdio

object OTextSink:
    func Write(atext : strview) [[virtual, abstract]]
    func WriteChar(ch : char)   [[virtual, abstract]]
endobject

object OTextSinkStdOut(OTextSink):
    pstdout : pointer

    func *Create()
    func Write(atext : strview) [[override]]
    func WriteChar(ch : char)   [[override]]
endobject

implementation

var libc_stdout : pointer [[external('stdout')]]

func libc_fwrite(ptr : pointer, size : uint, count : uint, stream : pointer) -> uint  [[external('fwrite')]]
func libc_fputc(ch : int, stream : pointer) -> int  [[external("fputc")]]

func OTextSinkStdOut.*Create():
    pstdout = @.libc_stdout
endfunc

func OTextSinkStdOut.Write(atext : strview) [[override]]:
    @.libc_fwrite(%atext[0], 1, atext.length, pstdout)
endfunc

func OTextSinkStdOut.WriteChar(ch : char) [[override]]:
    @.libc_fputc(ch, pstdout)
endfunc


func *Main() -> int:
    printf('DQ no constructor test\n')

    var cout <- OTextSinkStdOut()

    cout.Write('OTextSinkStdOut.Write()\n')

    return 0
endfunc