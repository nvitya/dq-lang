// linked library test

func printf(fmt : ^char, ...) -> int [[external]]

var fake_zlib_ver : cstring(20) = "v0.0.1-fake"

func zlibVersion_fake() -> ^char:
    result = %fake_zlib_ver[0]
endfunc

#linklib('z')

func zlibVersion() -> ^char [[external]]
func *Main() -> int:
    printf('Linked library test\n') //?ignore('Linked library test')

    printf('fake_zLibVersion = %s\n', zlibVersion_fake()) //?check('fake_zLibVersion', 'v0.0.1-fake')
    printf('zLibVersion = %s\n', zlibVersion()) //?ignore('zLibVersion')
    return 0
endfunc
