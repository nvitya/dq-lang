// Embedded String test

// new type: "char": 8-bit char, same as "char" in C
// embstr(N): N bytes of storage, including the terminating zero byte

var dq_embstr  : embstr(256) = "DQ String Test\n"
var dq_embstr2 : embstr(40)  = 'Using signle quotes\n'

// These functions come from LIBC, so the program must be linked with the libc.
func putchar(c : char) -> int  [[external]]
func puts(c : ^char) -> int    [[external]]

func dq_writepc(s : ^char):
    var pc : ^char = s
    while pc^ <> char(0):
        putchar(pc^)
        pc += 1
    endwhile
endfunc

func dq_writestr(s : embstr):
    var pc : ^char = %s[0]
    while pc^ <> char(0):
        putchar(pc^)
        pc += 1
    endwhile
endfunc

func embstr_add(dst : embstr, src : embstr):  // later this will be a DQ library func
    var ps     : ^char = %src[0]
    var psend  : ^char = ps + src.storage_size
    var pd     : ^char = %dst[0]
    var pdend  : ^char = pd + dst.storage_size - 1 // leave one char for the terminating
    pd += Len(dst)
    var pdstart : ^char = pd

    while pd < pdend  and ps < psend  and ps^ <> char(0):
        pd^ = ps^
        pd += 1
        ps += 1
    endwhile

    if pd <> pdstart:
        pd^ = char(0) // terminate
    endif
endfunc

func dq_str_append(a : embstr, b : embstr):

    // Len(embstr): length of the actual contents
    // storage_size: storage size of the aliased argument variable

    if Len(a) + Len(b) > a.storage_size - 1:  // append to the a only when the whole will fit.
        return
    endif
    embstr_add(a, b)
endfunc
func *Main():
    dq_writepc('dq_embstr = ')
    dq_writestr(dq_embstr)  //?check('dq_embstr', 'DQ String Test')

    var s : embstr(128) = ""

    var warn_s1 : embstr(5) //?warning(EmbStrStorageSize)
    var warn_s2 : [[nowarn]] embstr(5)

    var hello : embstr(16) = "Hello"
    var world : embstr(16) = " World!\n"
    embstr_add(s, hello)
    embstr_add(s, world)

    dq_writepc('s = ')
    dq_writestr(s)
                             //?check('s', 'Hello World!')

    // string length checking test
    var s2 : [[nowarn]] embstr(9)
    s2 = "abc"
    var def : embstr(4) = "def"
    var too_long : embstr(16) = "ghijklmnopqr"
    dq_str_append(s2, def)
    dq_str_append(s2, too_long)

    dq_writepc('s2 = "')
    dq_writestr(s2)
    dq_writepc('"\n')     //?check(s2, '"abcdef"')

    var s3 : embstr(4) = ""
    var s4 : embstr(8) = "abcdef"
    s3 = s4
    dq_writepc('s3 = "')
    dq_writestr(s3)
    dq_writepc('"\n')     //?check(s3, '"abc"')

    var s5 : embstr(8) = ""
    s5 = s3
    dq_writepc('s5 = "')
    dq_writestr(s5)
    dq_writepc('"\n')     //?check(s5, '"abc"')

    var pc : ^char = "asdf"
    var cs : embstr(32)
    cs = pc
    dq_writepc('cs = "')
    dq_writestr(cs)
    dq_writepc('"\n')     //?check(cs, '"asdf"')

endfunc
