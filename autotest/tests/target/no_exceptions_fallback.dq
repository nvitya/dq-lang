//?notest
// Core RTL errors use RuntimeError and safe values when its handler returns.

use rtl/strfunc

enum NState : uint8 = (idle = 7, running = 9)

var error_count : int = 0

func CaptureRuntimeError(emsg : ^char):
    error_count += 1
endfunc

func *Main():
    rterror_handler = CaptureRuntimeError

    var bad_char : char = IntToChar(-1)
    var bad_wchar : wchar = IntToWchar(0xD800)
    var bad_state : NState = NState.FromOrd(8)

    if error_count <> 3:
        exit_code = 1
        return
    endif
    if Ord(bad_char) <> 0 or Ord(bad_wchar) <> 0 or bad_state <> idle:
        exit_code = 2
        return
    endif

    var invalid_number : rostr = "bad"
    var bad_int : int = invalid_number.ToInt()
    var bad_float : float = invalid_number.ToFloat()
    if error_count <> 5 or bad_int <> 0 or bad_float <> 0:
        exit_code = 4
        return
    endif
    if StrToInt("bad", 7) <> 7 or StrToFloat("bad", 8) <> 8:
        exit_code = 5
        return
    endif
    var text : embstr(16) = "bad"
    if text.ToInt(9) <> 9 or text.ToFloat(10) <> 10 or error_count <> 5:
        exit_code = 6
        return
    endif

    var arr : [*]int32
    arr.Append(7)
    var past_end : ^int32 = %arr[1]
    var negative : int32 = -1
    var before_start : ^int32 = %arr[negative]
    arr.Clear()
    var empty : ^int32 = %arr[0]
    arr.Clear(true)
    var unallocated : ^int32 = %arr[0]
    if error_count <> 9 or past_end <> nil or before_start <> nil or empty <> nil or unallocated <> nil:
        exit_code = 3
        return
    endif
endfunc
