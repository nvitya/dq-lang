// some very basic helpers for the WasmPascal environment

func Print(text : strview)
func PrintLn() [[overload]]
func PrintLn(text : strview) [[overload]]
func PrintLn(text : strview, args : []anyvalue) [[overload]]

implementation

func wp_console_str(address : ^char, byte_length : uint32, field_width : int32)  [[external('console_str', 'wasmpascal_env')]]

func Print(text : strview):
    wp_console_str(%text[0], text.length, 0)
endfunc

func PrintLn() [[overload]]:
    Print("\n")
endfunc

func PrintLn(text : strview) [[overload]]:
    Print(text)
    Print("\n")
endfunc

func PrintLn(text : strview, args : []anyvalue) [[overload]]:
    var fmtstr : cstring(255) = ''
    fmtstr.AddFmt(text, args)
    Print(fmtstr)
    Print("\n")
endfunc

func wasmpas_main()    [[external('wasmpas_main')]]
func dq_module_init()  [[external('dq_module_init')]]

func wasmpascal_init() [[export('wasmpascal_init'), used]]:
    dq_module_init()
    wasmpas_main()
endfunc
