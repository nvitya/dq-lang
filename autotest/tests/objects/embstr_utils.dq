//?notest

func embstr_set(dst : embstr, src : embstr):  // later this will be a DQ library func
    var ps     : ^char = %src[0]
    var psend  : ^char = ps + src.storage_size
    var pd     : ^char = %dst[0]
    var pdend  : ^char = pd + dst.storage_size - 1 // leave one char for the terminating
    var pdstart : ^char = pd

    while pd < pdend  and ps < psend  and ps^ <> char(0):
        pd^ = ps^
        pd += 1
        ps += 1
    endwhile

    pd^ = char(0) // terminate
endfunc

func embstr_add(dst : embstr, src : embstr):  // later this will be a DQ library func
    var ps     : ^char = %src[0]
    var psend  : ^char = ps + src.storage_size
    var pd     : ^char = %dst[0]
    var pdend  : ^char = pd + dst.storage_size - 1 // leave one char for the terminating
    pd += Len(dst)
    var pdstart : ^char = pd

    while pd < pdend  and ps < psend  and ps^ <> char(0):
        pd^ = ps^
        pd += 1
        ps += 1
    endwhile

    pd^ = char(0) // terminate
endfunc
