// Linux and Windows faults unwind through local handlers and owned scopes.
// Use -O0 for reliable cleanup coverage; LLVM 21's optimized leaf cleanup
// limitation is documented in docs/contributing/exceptions-and-backtraces.md.

use libc/stdio

var destroyed : int = 0

object OMarker:
    func *Destroy():
        ++@.destroyed
    endfunc
endobject

func FaultWithLocals(p : ^int) [[noinline]]:
    var outer <- OMarker()
    if true:
        var inner <- OMarker()
        p^ = 1234
    endif
endfunc

func FaultWithoutLocals(p : ^int) [[noinline]]:
    p^ = 1
endfunc

func ReturnFromTry() -> int:
    try:
        return 42
    finally:
        printf("sigsegv.return.finally = ran\n") //?check("sigsegv.return.finally", "ran")
    endtry
    return 0
endfunc

#ifdef WINDOWS
func VirtualAlloc(address : pointer, size : uint, allocation_type : uint32, protection : uint32) -> pointer [[external]] ..
func VirtualFree(address : pointer, size : uint, free_type : uint32) -> int32 [[external]] ..
#else
func mmap(address : pointer, length : uint, prot : int32, flags : int32, fd : int32, offset : int) -> pointer [[external]] ..
func munmap(address : pointer, length : uint) -> int32 [[external]] ..
#endif

struct SMemory:
    byte_value : uint8
    word_value : uint16
    dword_value : uint32
    qword_value : uint64
    single_value : float32
    double_value : float64
    bool_value : bool
    pointer_value : pointer
endstruct

func CheckMemory(p : ^SMemory) [[noinline]]:
    p.byte_value = 0xAB
    p.word_value = 0xABCD
    p.dword_value = 0xABCDEF12
    p.qword_value = 0x123456789ABCDEF0
    p.single_value = 1.5
    p.double_value = 2.5
    p.bool_value = true
    p.pointer_value = p
    var copy : SMemory = p^
    p^ = copy
    var ok : bool = (p.byte_value == 0xAB and p.word_value == 0xABCD
        and p.dword_value == 0xABCDEF12 and p.qword_value == 0x123456789ABCDEF0
        and p.single_value == 1.5 and p.double_value == 2.5
        and p.bool_value and p.pointer_value == p)
    printf("sigsegv.memory = %d\n", ok) //?check("sigsegv.memory", 1)
endfunc

func *Main():
    var memory : SMemory = {}
    CheckMemory(%memory)
    var p : ^int = nil
    var changed : int = 0
    try:
        changed = 7
        p^ = 1234
        changed = 99
    except Exception as e:
        printf("sigsegv.write = %s %d\n", TypeName(e), changed) //?check("sigsegv.write", "ESegFault 7")
    finally:
        printf("sigsegv.finally = ran\n") //?check("sigsegv.finally", "ran")
    endtry
    printf("sigsegv.after = 1\n") //?check("sigsegv.after", 1)

    try:
        var fp : ^float64 = nil
        fp^ = 3.5
    except Exception as e:
        printf("sigsegv.float = %s\n", TypeName(e)) //?check("sigsegv.float", "ESegFault")
    endtry

    try:
        var n : int = p^
        printf("unreachable = %d\n", n)
    except Exception as e:
        printf("sigsegv.read = %s\n", TypeName(e)) //?check("sigsegv.read", "ESegFault")
    endtry

    try:
        FaultWithLocals(p)
    except Exception:
        printf("sigsegv.cleanup = %d\n", destroyed) //?check("sigsegv.cleanup", 2)
    endtry

    try:
        FaultWithoutLocals(p)
    except Exception as e:
        printf("sigsegv.callee = %s\n", TypeName(e)) //?check("sigsegv.callee", "ESegFault")
    endtry

    try:
        try:
            p^ = 1
        except EStrError:
            printf("unreachable.handler = 1\n")
        finally:
            printf("sigsegv.nested.finally = ran\n") //?check("sigsegv.nested.finally", "ran")
        endtry
    except Exception as e:
        printf("sigsegv.nested = %s\n", TypeName(e)) //?check("sigsegv.nested", "ESegFault")
    endtry

    // A mapped inaccessible page proves that this handles actual faults,
    // including non-nil addresses, rather than checking pointers for nil.
  #ifdef WINDOWS
    var page : pointer = VirtualAlloc(nil, 4096, 0x3000, 1) // MEM_RESERVE | MEM_COMMIT, PAGE_NOACCESS
  #else
    var page : pointer = mmap(nil, 4096, 0, 0x22, -1, 0)
  #endif
    if page == nil or page == pointer(-1):
        raise Exception("Could not allocate protected page")
    endif
    try:
        ^int(page)^ = 5
    except Exception as e:
        printf("sigsegv.protected = %s\n", TypeName(e)) //?check("sigsegv.protected", "ESegFault")
    endtry
  #ifdef WINDOWS
    VirtualFree(page, 0, 0x8000) // MEM_RELEASE
  #else
    munmap(page, 4096)
  #endif

    var value : int = ReturnFromTry()
    printf("sigsegv.return = %d\n", value) //?check("sigsegv.return", 42)
    try:
        p^ = 6
    except Exception:
        printf("sigsegv.after.return = caught\n") //?check("sigsegv.after.return", "caught")
    endtry
endfunc
