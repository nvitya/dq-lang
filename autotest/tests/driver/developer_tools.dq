//?exitcode(0)

use dqautotest
use file

var run <- OTestRun()

func CheckTool(name : strslice):
    var tool : str = BinPath(name)
    if not FileExists(tool):
        // Releases keep internal test tools beside the autotest data.
        tool = SourcePath('../../bin/' + name)
    endif
    run.RunTool([tool])
    run.ExpectExitCode(0)
endfunc

func CheckDqRunOptions():
    var dqrun : str = BinPath('dq-run')
    if not FileExists(dqrun):
        dqrun = SourcePath('../../bin/dq-run')
    endif
    var src : str = TempPath('.dq')
    var exe : str = TempPath('.exe')
    var broot : str = TempPath('.buildroot')
    FileWriteText(src, 'func *Main():\n    exit_code = 0\nendfunc\n')
    run.RunTool([dqrun, '--build-root', broot, '--build', 'custom', '-o', exe, src])
    run.ExpectExitCode(0)
    RemoveTemp(src)
    RemoveTemp(exe)
    run.RunTool(['/bin/rm', '-rf', '--', broot])
endfunc

func *Main():
    CheckTool('dq-inline-asm-test')
    CheckTool('dq-projectfile-test')
    CheckDqRunOptions()
    exit_code = TestResult()
endfunc
