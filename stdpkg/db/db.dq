enum NDbFieldType : byte = (
    ftUnknown = 0,
    ftInt,
    ftFloat,
    ftBool,
    ftText,
    ftBlob,
    ftDateTime
)

struct SFieldInfo:  // 72 bytes
    name  : embstr(68)
    index : byte
    ftype : NDbFieldType
    _pad  : [2]byte
endstruct

object ODbDataSource  ..

object EDbField(Exception):
endobject

object EDbRow(Exception):
endobject

object EDbFieldType(Exception):
endobject

object EDbFieldIndex(Exception):
endobject

object EDbConnection(Exception):
endobject

object EDbStatement(Exception):
endobject

type FSqlQuoteStr = func(astr : strslice) -> str

object ODbCursor ..

object ODbConnection:

    quote_str_func : FSqlQuoteStr = nil

    func *Create():
    endfunc

    func Open()            [[virtual, abstract]] ..
    func Close()           [[virtual, abstract]] ..
    func Opened() -> bool  [[virtual, abstract]] ..
    func NativeHandle() -> pointer  [[virtual, abstract]] ..

    func Execute(asql : rostr)             [[virtual, abstract]] ..
    func Query(asql : rostr) -> ODbCursor  [[virtual, abstract]] ..

    func Begin()           [[virtual, abstract]] ..
    func Commit()          [[virtual, abstract]] ..
    func Rollback()        [[virtual, abstract]] ..
    func Changes() -> int  [[virtual, abstract]] ..

    func LastInsertId() -> int64  [[virtual, abstract]] ..
    func ErrorMessage() -> str    [[virtual, abstract]] ..

    func QuoteStr(astr : strslice) -> str  [[inline]]:
        result = quote_str_func(astr)
    endfunc

    property opened         : bool  read Opened
    property changes        : int   read Changes
    property last_insert_id : int64 read LastInsertId
endobject

object ODbCursor:
protected
    m_connection   : ODbConnection

    m_fieldinfo  : [*]SFieldInfo
    m_fieldcount : int
    m_onrow      : bool  // is the current row valid ?

public
    func *Create(aconnection : ODbConnection):
        m_connection = aconnection
    endfunc

    func Next()           [[virtual, abstract]] ..
    func First()          [[virtual, abstract]] ..

    func IsNull(aidx : int) -> bool                       [[overload, virtual, abstract]] ..
    func GetInt(aidx : int, defvalue : int) -> int        [[overload, virtual, abstract]] ..
    func GetFloat(aidx : int, defvalue : float) -> float  [[overload, virtual, abstract]] ..
    func GetBool(aidx : int, defvalue : bool) -> bool     [[overload, virtual, abstract]] ..
    func GetStr(aidx : int, defvalue : strslice) -> str   [[overload, virtual, abstract]] ..
    func GetBlob(aidx : int) -> [*]byte                   [[overload, virtual, abstract]] ..

    func IsNull(aname : rostr) -> bool                       [[overload, inline]] ..
    func GetInt(aname : rostr, defvalue : int) -> int        [[overload, inline]] ..
    func GetFloat(aname : rostr, defvalue : float) -> float  [[overload, inline]] ..
    func GetBool(aname : rostr, defvalue : bool) -> bool     [[overload, inline]] ..
    func GetStr(aname : rostr, defvalue : strslice) -> str   [[overload, inline]] ..
    func GetBlob(aname : rostr) -> [*]byte                   [[overload, inline]] ..

    func OnRow() -> bool ..
    func FieldCount() -> int ..
    func FieldName(aindex : int) -> str ..
    func FieldType(aindex : int) -> NDbFieldType ..
    func FieldIndex(aname : rostr, aexception : bool = false) -> int ..
    func HasField(aname : rostr) -> bool ..

    property onrow      : bool           read m_onrow
    property connection : ODbConnection  read m_connection

endobject

#include "dbrows.dqh"
#srcdep  "dbrows.dqi"

#include "sqluis.dqh"
#srcdep  "sqluis.dqi"


implementation


use strutils

func FieldTypeName(ft : NDbFieldType) -> str:
    if   ft == ftInt:       return 'int'
    elif ft == ftFloat:     return 'float'
    elif ft == ftBool:      return 'bool'
    elif ft == ftText:      return 'text'
    elif ft == ftBlob:      return 'blob'
    elif ft == ftDateTime:  return 'datetime'
    else:
        return 'unknown'
    endif
endfunc

//-----------------------------------------------------------------------------

func ODbCursor.OnRow() -> bool:
    return m_onrow
endfunc

func ODbCursor.FieldCount() -> int:
    return m_fieldcount
endfunc

func ODbCursor.FieldName(aindex : int) -> str:
    if not 0 <= aindex < m_fieldcount:
        raise EDbFieldIndex('Invalid Field index: {}', [aindex])
    endif
    return m_fieldinfo[aindex].name
endfunc

func ODbCursor.FieldType(aindex : int) -> NDbFieldType:
    if not 0 <= aindex < m_fieldcount:
        raise EDbFieldIndex('Invalid Field index: {}', [aindex])
    endif
    return m_fieldinfo[aindex].ftype
endfunc

func ODbCursor.FieldIndex(aname : rostr, aexception : bool = false) -> int:
    for i : int = 0 count m_fieldcount:
        if m_fieldinfo[i].name == aname:
            return i
        endif
    endfor
    if aexception:
        raise EDbField('Invalid field name: "{}"', [aname])
    endif
    return -1
endfunc

func ODbCursor.HasField(aname : rostr) -> bool:
    return FieldIndex(aname) >= 0
endfunc

func ODbCursor.IsNull(aname : rostr) -> bool  [[overload, inline]]:
    return IsNull(FieldIndex(aname, true))
endfunc

func ODbCursor.GetInt(aname : rostr, defvalue : int) -> int        [[overload, inline]]:
    return GetInt(FieldIndex(aname, true), defvalue)
endfunc

func ODbCursor.GetFloat(aname : rostr, defvalue : float) -> float  [[overload, inline]]:
    return GetFloat(FieldIndex(aname, true), defvalue)
endfunc

func ODbCursor.GetBool(aname : rostr, defvalue : bool) -> bool     [[overload, inline]]:
    return GetBool(FieldIndex(aname, true), defvalue)
endfunc

func ODbCursor.GetStr(aname : rostr, defvalue : strslice) -> str   [[overload, inline]]:
    return GetStr(FieldIndex(aname, true), defvalue)
endfunc

func ODbCursor.GetBlob(aname : rostr) -> [*]byte                   [[overload, inline]]:
    return GetBlob(FieldIndex(aname, true))
endfunc

//-----------------------------------------------------------------------------

#include "dbrows.dqi"

#include "sqluis.dqi"

