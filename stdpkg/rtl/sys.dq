use rtl/rtlint     reexport
use rtl/mem        reexport

#ifdef EXCEPTIONS
use rtl/exception  reexport
#endif

#ifndef BARE

use rtl/prgargs    reexport

#endif

func Exit(status : int)

implementation

#ifdef BARE

func Exit(status : int):
    while true:
    endwhile
endfunc

#else

func libc_exit(status : int)  [[external('exit')]]

func Exit(status : int):
    libc_exit(status)
endfunc

#endif
