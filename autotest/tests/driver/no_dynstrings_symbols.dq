//?exitcode(0)

use dqautotest

var run <- OTestRun()

function *Main() -> int:
    var object_path : str = TempPath('.o')
    run.RunCompiler([
        '--target=arm_m7f-bare', '--no-dynstrings', '-c', '-o', object_path,
        SourcePath('../target/no_dynstrings_text.dq')
    ])
    run.ExpectExitCode(0)

    if run.exitcode == 0:
        run.RunTool(['nm', object_path])
        run.ExpectExitCode(0)
        run.ExpectOutputNotContains('DynStr')
        run.ExpectOutputNotContains('ODynStr')
    endif

    RemoveTemp(object_path)
    return TestResult()
endfunc
