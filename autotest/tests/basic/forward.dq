#ifdef ERRORTEST

func mismatch(a : int) -> int

func mismatch(a : float) -> int:  //?error(FuncSigType)
    return 1
endfunc

func mismatch(a : int) -> int:
    return a
endfunc

func duplicate_body(a : int) -> int:
    return a
endfunc

func duplicate_body(a : int) -> int:  //?error(VsAlreadyDecl)
    return a
endfunc

func ov_mismatch(a : ref int) -> int [[overload]]

func ov_mismatch(a : refout int) -> int [[overload]]:  //?error(FuncSigType)
    a = 1
    return a
endfunc

func ov_mismatch(a : ref int) -> int [[overload]]:
    return a
endfunc

#else

func printf(fmt : ^char, ...) -> int [[external]]

type CBOne = func(a : int) -> int

func later_add(a : int, b : int) -> int
func later_default(a : int, b : int = 4) -> int
func later_cb(a : int) -> int
func pick(a : int) -> int [[overload]]
func pick(a : float) -> int [[overload]]

var g_cb : CBOne = later_cb
func *Main() -> int:
    printf("Forward declaration test\n")  //?ignore('Forward declaration test')

    printf("later_add(2, 3) = %li\n", later_add(2, 3))  //?check('later_add(2, 3)', 15)
    printf("later_default(6) = %li\n", later_default(6))  //?check('later_default(6)', 10)
    printf("g_cb(7) = %li\n", g_cb(7))  //?check('g_cb(7)', 21)
    printf("pick(5) = %li\n", pick(5))  //?check('pick(5)', 105)
    printf("pick(2.4) = %li\n", pick(2.4))  //?check('pick(2.4)', 202)

    return 0
endfunc

func later_add(x : int, y : int) -> int:
    return x + y + 10
endfunc

func later_default(x : int, y : int) -> int:
    return x + y
endfunc

func later_cb(x : int) -> int:
    return x * 3
endfunc

func pick(x : int) -> int [[overload]]:
    return x + 100
endfunc

func pick(x : float) -> int [[overload]]:
    return Round(x) + 200
endfunc

#endif
