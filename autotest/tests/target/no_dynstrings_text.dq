//?notest
// Heap-free text operations must remain available when dynamic strings are disabled.

func TextLength(text : strslice) -> int:
    var slice : strslice = text[0:text.length]
    var first : wchar = slice.wchar[0]
    return slice.wclen + Ord(first)
endfunc

func FormatText() -> int:
    var text : embstr(16) = "value="
    text.AddFmt("{}", [42])
    var view : strslice = text
    var value : anyvalue = text
    var copied : strslice = value.AsText("")
    return view.length + copied.length + text.wclen + Ord(text.wchar[$last])
endfunc

func ParseText() -> int64:
    return StrToInt("42")
endfunc

func ParseFloat() -> float:
    return StrToFloat("1.25e2", 0)
endfunc

func CompareText(a : rostr, b : embstr) -> bool:
    var view : strslice = a
    return a < b and b >= view and StrSliceCmp(a, b) <= 0
endfunc

func EmbeddedTextLength(text : embstr) -> int:
    return text.wclen + Ord(text.wchar[$last])
endfunc
