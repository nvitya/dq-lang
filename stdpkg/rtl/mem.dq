func MemAlloc(allocbytes : int, zeromem : bool = false) -> pointer
func MemFree(memptr : pointer)
func MemFreeRef(memptrvar : ref pointer)

func MemRealloc(memptr : pointer, newsize : uint) -> pointer
func MemReallocRef(memptr : ref pointer, newsize : uint)

func MemCopy(dest : pointer, src : pointer, size : uint)
func MemSet(dest : pointer, value : int, size : uint)

implementation

// Memory Allocation

func libc_malloc(size : uint) -> pointer                  [[external('malloc')]]
func libc_calloc(count : uint, size : uint) -> pointer    [[external('calloc')]]
func libc_free(ptr : pointer)                             [[external('free')]]
func libc_realloc(ptr : pointer, size : uint) -> pointer  [[external('realloc')]]

func libc_memcpy(dest : pointer, src : pointer, size : uint) -> pointer   [[external('memcpy')]]
func libc_memmove(dest : pointer, src : pointer, size : uint) -> pointer  [[external('memmove')]]
func libc_memset(dest : pointer, value : int, size : uint) -> pointer     [[external('memset')]]

func MemAlloc(allocbytes : int, zeromem : bool = false) -> pointer:
    if zeromem:
        result = libc_calloc(1, allocbytes)
    else:
        result = libc_malloc(allocbytes)
    endif
endfunc

func MemFree(memptr : pointer):
    libc_free(memptr)
endfunc

func MemFreeRef(memptrvar : ref pointer):
    libc_free(memptrvar)
    memptrvar = nil
endfunc

func MemRealloc(memptr : pointer, newsize : uint) -> pointer:
    result = libc_realloc(memptr, newsize)
endfunc

func MemReallocRef(memptr : ref pointer, newsize : uint):
    memptr = libc_realloc(memptr, newsize)
endfunc

func MemCopy(dest : pointer, src : pointer, size : uint):
    if src >= ^byte(dest) + size  or  ^byte(src) + size < dest:
        libc_memcpy(dest, src, size)
    else:  // src and dest overlap, use memmove
        libc_memmove(dest, src, size)
    endif
endfunc

func MemSet(dest : pointer, value : int, size : uint):
    libc_memset(dest, value, size)
endfunc

