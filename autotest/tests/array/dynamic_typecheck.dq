
// Dynamic-array compile-time rejection cases from the array specification.

func DynamicNullComparisonIsInvalid() -> int:
    var arr : [*]int
    if arr == nil: //?error(TypeMismatchOp)
        result = 1
    endif
    if arr <> nil: //?error(TypeMismatchOp)
        result = 2
    endif
    result = 0
endfunc
