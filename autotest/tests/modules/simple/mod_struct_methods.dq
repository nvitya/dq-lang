//?notest

struct SModBase:
    id : int

    func SetId(v : int):
        id = v
    endfunc
endstruct

struct SModChild(SModBase):
    extra : int

    func SetAll(aid : int, aextra : int):
        self.SetId(aid)
        extra = aextra
    endfunc

    func Total() -> int:
        return id + extra
    endfunc
endstruct

implementation
