// object constructor tests

use libc/stdio

struct SDynData:
    intvalue : int
    name : cstring(64)
endstruct

object OTest:
    ddata : SDynData

    func *Create(a : int):
        //ddata = new SDynData;
        ddata.intvalue = a
        ddata.name = "OTestName"
    endfunc

    func *Destroy():
        //free ddata;
        //ddata = nil;
    endfunc

    func Print():
        @.printf("obj = %s(%d)\n", %ddata.name, ddata.intvalue)
    endfunc
endobject

func *Main() -> int:
    var obj <- OTest(1)
    obj.Print()    //?check('obj', 'OTestName(1)')
    return 0
endfunc
