//?exitcode(0)

use dqautotest
use strutils
use file

var run <- OTestRun()

func ExpectOccurrenceCount(text : strview, needle : strview, expected : int):
    var count : int = 0
    var start : int = 0
    while true:
        var index : int = StrIndexOf(text, needle, start)
        if index < 0:
            break
        endif
        count += 1
        start = index + needle.length
    endwhile
    if count <> expected:
        Fail('unexpected target-list occurrence count')
    endif
endfunc

func CompileTarget(target : strview, define : strview, expected_format : strview,
                       expected_arch : strview):
    var output : str = TempPath('.o')
    var target_arg : str = '--target=' + target
    var define_arg : str = '-D' + define
    run.RunCompiler([
        target_arg, define_arg, '--no-use-sys', '-c', '-o', output,
        SourcePath('../target/multiple_target_defines.dq')
    ])
    run.ExpectExitCode(0)
    if run.exitcode == 0:
        run.RunTool(['llvm-readobj', '--file-headers', output])
        run.ExpectExitCode(0)
        run.ExpectOutputContains(expected_format)
        run.ExpectOutputContains(expected_arch)
    endif
    RemoveTemp(output)
endfunc

func *Main() -> int:
    run.RunCompiler(['--targets'])
    run.ExpectExitCode(0)
    run.ExpectOutputContains('TARGET')
    run.ExpectOutputContains('LLVM TRIPLE')
    run.ExpectOutputContains('EXCEPTIONS')
    ExpectOccurrenceCount(run.output, 'wasm32_wasi', 1)
    ExpectOccurrenceCount(run.output, 'wasm32_bare', 1)
    ExpectOccurrenceCount(run.output, 'rv32imac_bare', 1)
    run.ExpectOutputNotContains('x64-linux')

    CompileTarget('wasm32_wasi', 'EXPECT_WASI', 'Format: WASM', 'AddressSize: 32bit')
    CompileTarget('wasm32_bare', 'EXPECT_WASM_BARE', 'Format: WASM', 'AddressSize: 32bit')
    CompileTarget('rv32imac_bare', 'EXPECT_RISCV', 'Format: elf32-littleriscv', 'Machine: EM_RISCV')

    var wasm_import : str = TempPath('.wasm')
    run.RunCompiler([
        '-o', wasm_import,
        SourcePath('../target/wasm_external_import/wasm_external_import.dqproj')
    ])
    run.ExpectExitCode(0)
    if run.exitcode == 0:
        run.RunTool(['wasm-objdump', '-x', wasm_import])
        run.ExpectExitCode(0)
        run.ExpectOutputContains('wasmpascal_env.console_str')
        run.ExpectOutputContains('env.console_nl')
    endif
    RemoveTemp(wasm_import)

    var rv_object : str = TempPath('.o')
    run.RunCompiler([
        '--target=rv32imac_bare', '--no-use-sys', '-c', '-o', rv_object,
        SourcePath('../target/multiple_target_defines.dq')
    ])
    run.ExpectExitCode(0)
    if run.exitcode == 0:
        run.RunTool(['llvm-readobj', '--arch-specific', rv_object])
        run.ExpectExitCode(0)
        run.ExpectOutputContains('rv32i2p1_m2p0_a2p1_c2p0')
    endif
    RemoveTemp(rv_object)

    run.RunCompiler([
        '--target=wasm32_wasi', '--exceptions', '--no-use-sys', '-c',
        SourcePath('../target/multiple_target_defines.dq')
    ])
    if run.exitcode == 0:
        Fail('WASI unexpectedly accepted exceptions')
    endif
    run.ExpectOutputContains('does not support exceptions')

    run.RunCompiler([
        SourcePath('../target/wasi_exceptions_true.dqproj')
    ])
    if run.exitcode == 0:
        Fail('WASI project unexpectedly accepted exceptions')
    endif
    run.ExpectOutputContains('does not support exceptions')

    run.RunCompiler([
        '--target=wasm32_wasi', '--exceptions', '--no-exceptions', '--no-use-sys', '-c',
        SourcePath('../target/multiple_target_defines.dq')
    ])
    run.ExpectExitCode(0)

    var wasm_base : str = TempPath()
    var wasm_source : str = wasm_base + '.dq'
    var wasm : str = wasm_base + '.wasm'
    FileWriteText(wasm_source, 'func *Main() -> int:\n    return 0\nendfunc\n')
    run.RunCompiler([
        '--target=wasm32_wasi', wasm_source
    ])
    run.ExpectExitCode(0)
    if run.exitcode == 0:
        run.RunTool(['llvm-readobj', '--file-headers', wasm])
        run.ExpectExitCode(0)
        run.ExpectOutputContains('Format: WASM')

        run.RunTool(['/bin/sh', '-c', 'command -v wasmtime'])
        if run.exitcode == 0:
            run.RunTool(['wasmtime', wasm])
            run.ExpectExitCode(0)
        endif
    endif
    RemoveTemp(wasm_source)
    RemoveTemp(wasm)

    return TestResult()
endfunc
