// Owned locals are cleaned up when control leaves a block by exception,
// break, or continue.

use libc/stdio



object OMarker:
    id : int

    func *Create(aid : int):
        id = aid
        @.printf("cleanup.create.%d = 1\n", id)
    endfunc

    func *Destroy():
        @.printf("cleanup.destroy.%d = 1\n", id)
    endfunc
endobject

func ThrowWithLocals():
    var outer <- OMarker(1)
    if 1 == 1:
        var inner <- OMarker(2)
        raise Exception("cleanup")
    endif
endfunc

func BreakWithLocals():
    while 1 == 1:
        if 1 == 1:
            var marker <- OMarker(3)
            break
        endif
    endwhile
    printf("cleanup.break.done = 1\n")
endfunc

func ContinueWithLocals():
    var count : int = 0
    while count < 1:
        count += 1
        if 1 == 1:
            var marker <- OMarker(4)
            continue
        endif
    endwhile
    printf("cleanup.continue.done = %d\n", count)
endfunc

object OThrowCreate:
    func *Create():
        raise Exception("ctor_fail")
    endfunc

    func *Destroy():
        @.printf("cleanup.bad_ctor_destroy = 1\n")
    endfunc
endobject

object OThrowDestroy:
    id : int

    func *Create(aid : int):
        id = aid
    endfunc

    func *Destroy():
        @.printf("cleanup.throw_destroy.%d = 1\n", id)
        raise Exception("dtor_fail")
    endfunc
endobject

func ThrowDuringSecondLocalCreate():
    var first <- OMarker(5)
    var failing <- OThrowCreate()
endfunc

func *Main():
    try:
        ThrowWithLocals()       //?check("cleanup.create.1", 1)
                                //?check("cleanup.create.2", 1)
                                //?check("cleanup.destroy.2", 1)
                                //?check("cleanup.destroy.1", 1)
    except Exception as e:
        printf("cleanup.exception = ")
        e.PrintMessage()
        printf("\n")            //?check("cleanup.exception", "cleanup")
    endtry

    BreakWithLocals()         //?check("cleanup.create.3", 1)
                              //?check("cleanup.destroy.3", 1)
                              //?check("cleanup.break.done", 1)

    ContinueWithLocals()      //?check("cleanup.create.4", 1)
                              //?check("cleanup.destroy.4", 1)
                              //?check("cleanup.continue.done", 1)

    try:
        ThrowDuringSecondLocalCreate() //?check("cleanup.create.5", 1)
                                       //?check("cleanup.destroy.5", 1)
    except Exception as e:
        printf("cleanup.ctor_exc = ")
        e.PrintMessage()
        printf("\n")                   //?check("cleanup.ctor_exc", "ctor_fail")
    endtry

    try:
        var del_item : OThrowDestroy = new OThrowDestroy(6)
        delete del_item                //?check("cleanup.throw_destroy.6", 1)
    except Exception as e:
        printf("cleanup.del_exc = ")
        e.PrintMessage()
        printf("\n")                   //?check("cleanup.del_exc", "dtor_fail")
    endtry

    try:
        if 1 == 1:
            var af_item : autofree OThrowDestroy = new OThrowDestroy(7)
        endif                          //?check("cleanup.throw_destroy.7", 1)
    except Exception as e:
        printf("cleanup.af_exc = ")
        e.PrintMessage()
        printf("\n")                   //?check("cleanup.af_exc", "dtor_fail")
    endtry

endfunc
