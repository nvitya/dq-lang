// dqatrun supplies driver-test context without changing program arguments.
//?exitcode(0)

func libc_getenv(name : ^char) -> ^char [[external('getenv')]]

func *Main() -> int:
    if libc_getenv('DQ_AUTOTEST_COMPILER') == nil:
        return 1
    endif
    if libc_getenv('DQ_AUTOTEST_BINDIR') == nil:
        return 2
    endif
    if libc_getenv('DQ_AUTOTEST_TEST_ROOT') == nil:
        return 3
    endif
    if libc_getenv('DQ_AUTOTEST_TEST_FILE') == nil:
        return 4
    endif
    if libc_getenv('DQ_AUTOTEST_TEST_DIR') == nil:
        return 5
    endif
    if libc_getenv('DQ_AUTOTEST_HOSTARCH') == nil:
        return 6
    endif
    if ArgCount() <> 1:
        return 7
    endif
    return 0
endfunc
