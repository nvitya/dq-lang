use print

const EMBSTR_CONST : embstr = 'constant embstr'

func *Main():
    PrintLn('inline_const = "{}"', ['abc'])     //?check('inline_const', '"abc"')
    PrintLn('EMBSTR_CONST = "{}"', [EMBSTR_CONST])  //?check('EMBSTR_CONST', '"constant embstr"')
    PrintLn('EMBSTR_CONST.length = {}', [EMBSTR_CONST.length])  //?check('EMBSTR_CONST.length', '15')
    PrintLn('Len(EMBSTR_CONST) = {}', [Len(EMBSTR_CONST)])      //?check('Len(EMBSTR_CONST)', '15')
endfunc
