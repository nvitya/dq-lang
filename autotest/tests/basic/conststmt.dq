// local const statement parsing and codegen tests

const rootval : int = 22
const address_ptr : ^byte = ^byte(0x7F001000)
const address_ptr_alias : ^byte = address_ptr

const(uint32):
    FLASH_BASE      = 0x08000000
    FLASH_BANK1_END = FLASH_BASE + 0x7FFF
    SRAM_BASE       = 0x20000000
    PERIPH_BASE     = 0x40000000
endconst

func dq_local_const_basic() -> int:
    const base : int = 3
    result = base + 4
endfunc

func dq_local_const_shadow_root() -> int:
    const rootval : int = 11
    result = rootval
endfunc

func dq_local_const_group() -> uint32:
    const(uint32):
        first = FLASH_BANK1_END
        second = first + 1
    endconst
    result = second
endfunc

func dq_pointer_address_const() -> uint:
    result = uint(address_ptr_alias)
endfunc

func dq_local_const_in_if(a : int) -> int:
    if a > 0:
        const inc : int = 5
        result = inc
    else:
        result = rootval
    endif
endfunc

func dq_local_const_nonconst_expr(a : int) -> int:
    const bad : int = a + 1  //?error(ConstExprInvalid), error(ConstExprNonConstVs)
    result = 0
endfunc
