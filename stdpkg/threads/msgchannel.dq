use threads/atomic
use threads/waitevent

// the Channel message is a fixed 16-byte struct

struct SChMsg:
    msg : uint32

    union par:
        bytes : [4]byte
        i16   : [2]int16
        u16   : [2]uint16
        i32   : int32
        u32   : uint32
        f32   : float32
    endunion

    union data:
        bytes : [8]byte
        i16   : [4]int16
        u16   : [4]uint16
        i32   : [2]int32
        u32   : [2]uint32
        f32   : [2]float32
        i64   : int64
        u64   : uint64
        f64   : float64
        ptr   : pointer
    endunion
endstruct

object OMsgChannel:
protected
    m_len   : uint32
    msgs    : [*]SChMsg
    idx_put : [[volatile]] uint32
    idx_get : [[volatile]] uint32
    m_lock  <- OAtomicUint32(0)
    put_event <- OThreadEvent()
    get_event <- OThreadEvent()

    func Lock()    [[inline]] ..
    func Unlock()  [[inline]] ..
    func WaitDeadline(atimeoutms : int) -> int64 ..
public
    // Configure these flags before sharing the channel between threads.
    locking            : bool = true

    func *Create(alength : uint32):
        m_len   = alength
        msgs.SetLength(m_len)
        idx_put = 0
        idx_get = 0
    endfunc

    func Put(amsg : SChMsg) -> bool  ..
    func Get(rmsg : refout SChMsg) -> bool  ..

    // Zero tries once; negative waits indefinitely; positive waits up to the timeout.
    func PutWaitMillis(amsg : SChMsg, atimeoutms : int) -> bool  ..
    func GetWaitMillis(rmsg : refout SChMsg, atimeoutms : int) -> bool ..
endobject


implementation

use time
use threads

func OMsgChannel.Lock()  [[inline]]:
    if locking:
        while m_lock.Exchange(1) <> 0:
            // Read while contended instead of repeatedly invalidating the lock's cache line.
            while m_lock.Load() <> 0:
                @.SchedYield()
            endwhile
        endwhile
    endif
endfunc

func OMsgChannel.Unlock()  [[inline]]:
    if locking:
        m_lock.Store(0)
    endif
endfunc

func OMsgChannel.Put(amsg : SChMsg) -> bool
:
    Lock()
    result = false
    var newidx : uint32 = (idx_put + 1) rem m_len
    if newidx <> idx_get: // queue is not full ?
        msgs[idx_put] = amsg
        idx_put = newidx
        result = true
    endif
    Unlock()
    if result:
        get_event.Signal()
    endif
endfunc

func OMsgChannel.Get(rmsg : refout SChMsg) -> bool
:
    Lock()
    result = false
    if idx_get <> idx_put:  // queue is not empty ?
        rmsg = msgs[idx_get]
        idx_get = (idx_get + 1) rem m_len
        result = true
    endif
    Unlock()
    if result:
        put_event.Signal()
    endif
endfunc

func OMsgChannel.PutWaitMillis(amsg : SChMsg, atimeoutms : int) -> bool
:
    if atimeoutms == 0:
        return Put(amsg)
    endif
    var deadline : int64 = WaitDeadline(atimeoutms)
    result = false
    while true:
        // Snapshot before testing the queue, so a concurrent Get cannot be missed.
        var sequence : uint32 = put_event.Snapshot()
        if Put(amsg):
            return true
        endif
        if not put_event.WaitUntilNanos(sequence, deadline):
            return false
        endif
    endwhile
endfunc

func OMsgChannel.GetWaitMillis(rmsg : refout SChMsg, atimeoutms : int) -> bool
:
    if atimeoutms == 0:
        return Get(rmsg)
    endif
    var deadline : int64 = WaitDeadline(atimeoutms)
    result = false
    while true:
        var sequence : uint32 = get_event.Snapshot()
        if Get(rmsg):
            return true
        endif
        if not get_event.WaitUntilNanos(sequence, deadline):
            return false
        endif
    endwhile
endfunc

func OMsgChannel.WaitDeadline(atimeoutms : int) -> int64:
    if atimeoutms < 0:
        return -1
    endif
    var now : int64 = @time.NanoTime()
    var timeout_ms : int64 = atimeoutms
    // Saturate very large timeouts rather than overflowing the absolute deadline.
    if timeout_ms > (0x7FFFFFFFFFFFFFFF - now) div 1000000:
        return 0x7FFFFFFFFFFFFFFF
    endif
    return now + timeout_ms * 1000000
endfunc

