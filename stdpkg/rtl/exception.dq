use rtl/rtlint
use rtl/mem
use rtl/anyvalue

const DQ_EXCEPTION_BACKTRACE_MAX : int = 32
const DQ_EXCEPTION_TYPENAME_MAX  : int = 63
const DQ_EXCEPTION_MSG_MAX       : int = 127

object Exception:
    refcount        : int = 1
    message         : cstring(DQ_EXCEPTION_MSG_MAX)
    backtrace_count : int = 0
    backtrace       : [DQ_EXCEPTION_BACKTRACE_MAX] pointer

    func *Create(amsg : strview) [[overload]]
    func *Create(afmt : strview, avalues : []anyvalue) [[overload]]
    func *Destroy()

    func GetMessage() -> cstring [[virtual]]
    func CaptureBacktrace()
    func PrintMessage()
    func PrintBacktrace()
endobject

// DQ Internal exceptions

object EStrError(Exception):
endobject

func DqExcRaise(e : Exception, owned_ref : bool)
func DqExcRethrow()
func DqExcActive() -> bool
func DqExcCurrent() -> Exception
func DqExcClear()
func DqExcBeginCatch()
func DqExcEndCatch()
func DqExcPrintTypeName()

func DqExcRaiseWithBacktrace(e : Exception, owned_ref : bool, bt : pointer, bt_count : int)

implementation

use rtl/backtrace

#ifndef BARE
    use libc/stdio
#endif

func DqExcAddRef(e : Exception)
func DqExcRelease(e : Exception)

//-------------------------------------------------------------------------------------------------

func Exception.*Create(amsg : strview) [[overload]]:
    message.Set(amsg)
endfunc

func Exception.*Create(afmt : strview, avalues : []anyvalue) [[overload]]:
    message.AddFmt(afmt, avalues)
endfunc

func Exception.*Destroy():
endfunc

func Exception.GetMessage() -> cstring:
    return message
endfunc


func Exception.CaptureBacktrace():
    backtrace_count = @.DqCaptureBacktrace(%backtrace[0], @.DQ_EXCEPTION_BACKTRACE_MAX)
endfunc

func Exception.PrintMessage():
  #ifndef BARE
    var view : strview = message
    var i : uint32 = 0
    while i < uint32(view.length):
        @.printf("%c", Ord(view[i]))
        i += 1
    endwhile
  #endif    
endfunc

func Exception.PrintBacktrace():
    @backtrace.DqPrintBacktrace(%backtrace[0], backtrace_count)
endfunc

//-------------------------------------------------------------------------------------------------

func DqExcAddRef(e : Exception):
    if e <> nil:
        e.refcount += 1
    endif
endfunc

func DqExcRelease(e : Exception):
    if e == nil:
        return
    endif
    e.refcount -= 1
    if e.refcount <= 0:
        delete e
    endif
endfunc

func DqPrepareExceptionRef(e : Exception, owned_ref : bool) -> bool:
    if e == nil:
        RuntimeError("raise nil exception")
        return false
    endif

    if not owned_ref:
        DqExcAddRef(e)
    endif

    return true
endfunc


func DqExcNativeThrow(e : Exception) [[external]]

var active_exception  : Exception = nil
var handled_exception : Exception = nil

func DqSetActiveException(e : Exception):
    if active_exception <> nil:
        DqExcRelease(active_exception)
    endif
    active_exception = e
endfunc

func DqExcRaise(e : Exception, owned_ref : bool):
    if not DqPrepareExceptionRef(e, owned_ref):
        return
    endif

    e.CaptureBacktrace()
    DqExcNativeThrow(e)
endfunc

func DqExcRaiseWithBacktrace(e : Exception, owned_ref : bool, bt : pointer, bt_count : int):
    if not DqPrepareExceptionRef(e, owned_ref):
        return
    endif

    e.backtrace_count = bt_count - DQ_BACKTRACE_INTERNAL_SKIP
    if e.backtrace_count < 0:
        e.backtrace_count = 0
    elif e.backtrace_count > DQ_EXCEPTION_BACKTRACE_MAX:
        e.backtrace_count = DQ_EXCEPTION_BACKTRACE_MAX
    endif

    var i : int = 0
    while i < e.backtrace_count:
        e.backtrace[i] = ^pointer(bt)[i + DQ_BACKTRACE_INTERNAL_SKIP]^
        i += 1
    endwhile

    DqExcNativeThrow(e)
endfunc

func DqExcRethrow():
    if handled_exception == nil:
        RuntimeError("re-raise without active exception")
        return
    endif
    DqExcNativeThrow(handled_exception)
endfunc

func DqExcActive() -> bool:
    return active_exception <> nil
endfunc

func DqExcCurrent() -> Exception:
    return active_exception
endfunc

func DqExcClear():
    if active_exception <> nil:
        DqExcRelease(active_exception)
    endif
    active_exception = nil
endfunc

func DqExcBeginCatch():
    if handled_exception <> nil:
        DqExcRelease(handled_exception)
    endif
    handled_exception = active_exception
    active_exception = nil
endfunc

func DqExcEndCatch():
    if handled_exception <> nil:
        DqExcRelease(handled_exception)
    endif
    handled_exception = nil
endfunc


func DqExcPrintTypeName():
  #ifndef BARE
    if active_exception <> nil:
        printf("%s", TypeName(active_exception))
    else:
        printf("Exception")
    endif
  #endif
endfunc
