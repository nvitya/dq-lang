// Compile time configuration

#ifndef TEXTFORMAT_INT64
    #if PTRSIZE > 4  or not Defined(BARE)
        #define TEXTFORMAT_INT64
    #endif
#endif

#ifndef TEXTFORMAT_FLOAT32
    #if Defined(HARDFLOAT32)  or not Defined(BARE)
        #define TEXTFORMAT_FLOAT32
    #endif
#endif

#ifndef TEXTFORMAT_FLOAT64
    #if Defined(HARDFLOAT64)  or not Defined(BARE)
        #define TEXTFORMAT_FLOAT64
    #endif
#endif

#if Defined(TEXTFORMAT_INT64) or Defined(TEXTFORMAT_FLOAT64)
    type TFmtInt  = int64
    type TFmtUInt = uint64
#else
    type TFmtInt  = int
    type TFmtUInt = uint
#endif

#if Defined(TEXTFORMAT_FLOAT64)
    type TFmtFloat = float64
#elif Defined(TEXTFORMAT_FLOAT32)
    type TFmtFloat = float32
#endif

// Design goals:
//   * one heap-free formatter core
//   * stack-allocated formatter object
//   * lightweight polymorphic text sinks
//   * embstr sink: bounded, no heap usage
//   * str sink: dynamic, heap/realloc allowed by the sink only
//   * file/stdout sink: direct streaming, no intermediate string
//
// This file intentionally keeps the format language small at first:
//   {}       next argument, default formatting
//   {{       literal '{'
//   }}       literal '}'
//   {:d}     signed decimal integer
//   {:u}     unsigned decimal integer
//   {:x}     lowercase hexadecimal integer/pointer
//   {:X}     uppercase hexadecimal integer/pointer
//   {:p}     pointer style hexadecimal
//   {:s}     string-like value
//   {:?}     debug/default value
//   {:<30}   left align within a minimum width
//   {:>30}   right align within a minimum width
//   {:^30}   center within a minimum width

// -----------------------------------------------------------------------------
// Result flags
// -----------------------------------------------------------------------------

const DQFMT_OK          : uint = 0x00000000
const DQFMT_TRUNCATED   : uint = 0x00000001
const DQFMT_FMT_ERROR   : uint = 0x00000002
const DQFMT_ARG_ERROR   : uint = 0x00000004
const DQFMT_SINK_ERROR  : uint = 0x00000008

const DQFMT_KIND_DEFAULT : char = '?'
const DQFMT_KIND_SIGNED  : char = 'd'
const DQFMT_KIND_UNSIGNED: char = 'u'
const DQFMT_KIND_HEXLOW  : char = 'x'
const DQFMT_KIND_HEXUP   : char = 'X'
const DQFMT_KIND_STRING  : char = 's'
const DQFMT_KIND_POINTER : char = 'p'
const DQFMT_KIND_BOOL    : char = 'b'
const DQFMT_KIND_FLOAT   : char = 'f'

object OTextSink:
    func *Create():
    endfunc

    func Write(atext : strslice) [[virtual]]:
    endfunc

    func WriteChar(ch : char)   [[virtual]]:
    endfunc
endobject

#ifndef BARE

object OTextSinkStdOut(OTextSink):
    pstdout : pointer

    func *Create() ..
    func Write(atext : strslice) [[override]] ..
    func WriteChar(ch : char)   [[override]] ..
endobject

#endif

object OTextSinkEmbStr(OTextSink):
    dest : embstr

    func *Create(adest : embstr) ..
    func Write(atext : strslice) [[override]] ..
    func WriteChar(ch : char)   [[override]] ..
endobject

#ifdef DYNSTRINGS
object OTextSinkStr(OTextSink):
    dest : ^str

    func *Create(adest : ^str) ..
    func Write(atext : strslice) [[override]] ..
    func WriteChar(ch : char)   [[override]] ..
endobject
#endif

struct STextFmtSpec:
    width      : int   // minimum Unicode scalar count; -1 means unspecified
    precision  : int   // -1 means unspecified
    kind       : char  // d/u/x/X/s/p/f/?
    fill       : char  // normally ' ' or '0'
    align      : char  // <, >, or ^
    sign       : char  // +, -, space, or zero when unspecified
    upper      : bool
endstruct

object OTextFormatter:
public
    sink      : OTextSink
    flags     : uint32 = 0
    arg_index : uint32 = 0

    fmtspec   : STextFmtSpec

    func *Create(asink : OTextSink) ..
    func Reset() ..
    func Format(afmt : strslice, aargs : varargs) ..

protected
    curpos : int32 = 0
    endpos : int32 = 0

    lcsbuf : embstr(48)

    func ParseSpec(afmt : strslice) ..
    func ArgError(message : strslice) ..
    func PositiveSign() -> char ..
    func FormatWChar(wc : wchar) ..

    func WritePad(acount : int, ch : char) ..
    func WriteFieldPad(alength : int, aafter : bool) ..
    func WriteFormattedText(atext : strslice) ..
    func UIntDigitChar(adigit : uint, aupper : bool) -> char ..
    func BuildUIntDigits(v : TFmtUInt, abase : uint, aupper : bool) -> int ..
    func WriteReversedDigits(acount : int) ..
    func WriteFormattedNumber(asign : char, aint_digit_count : int, afrac : TFmtUInt, aprecision : int, ascale : TFmtUInt) ..

    func FormatInteger(value : TFmtUInt, signed_value : bool, wordcount : byte) ..
  #if Defined(TEXTFORMAT_FLOAT32) or Defined(TEXTFORMAT_FLOAT64)
    func FormatFloat(v : TFmtFloat) ..
    func TruncateMagnitude(v : TFmtFloat) -> TFmtUInt ..
  #endif

endobject

func EmbStrAddFmt(adest : embstr, afmt : strslice, aargs : varargs) ..
#ifdef DYNSTRINGS
func DynStrAddFmt(astr : ^str, afmt : strslice, aargs : varargs) ..
#endif

implementation

use rtl/strfunc
use rtl/varargs

#ifndef BARE
  use libc/stdio
#endif

// -----------------------------------------------------------------------------
// Low-level conversion hooks
// -----------------------------------------------------------------------------
// These helpers are deliberately separated from the formatter object so the
// integer/float conversion code can later live in a small, reusable RTL module.
// The formatter itself must not allocate heap memory.

func DqTextFmtIsDigit(ch : char) -> bool  [[inline]]:
    return '0' <= ch <= '9'
endfunc

func DqTextFmtDigitValue(ch : char) -> int  [[inline]]:
    return Ord(ch) - Ord('0')
endfunc

//-------------------------------------------------------------------------------------------------

#ifndef BARE

func libc_fwrite(ptr : pointer, size : uint, count : uint, stream : pointer) -> uint  [[external('fwrite')]] ..
func libc_fputc(ch : int, stream : pointer) -> int  [[external("fputc")]] ..
func libc_fflush(stream : pointer) -> int  [[external('fflush')]] ..

func OTextSinkStdOut.*Create():
    inherited Create()
    pstdout = @stdio.StdOut()
endfunc

func OTextSinkStdOut.Write(atext : strslice) [[override]]:
    @.libc_fwrite(%atext[0], 1, atext.length, pstdout)
endfunc

func OTextSinkStdOut.WriteChar(ch : char) [[override]]:
    @.libc_fputc(Ord(ch), pstdout)
endfunc

#endif

func OTextSinkEmbStr.*Create(adest : embstr):
    inherited Create()
    dest = adest
endfunc

func OTextSinkEmbStr.Write(atext : strslice) [[override]]:
    dest.Append(atext)
endfunc

func OTextSinkEmbStr.WriteChar(ch : char) [[override]]:
    dest.AppendChar(ch)
endfunc

#ifdef DYNSTRINGS
func OTextSinkStr.*Create(adest : ^str):
    inherited Create()
    dest = adest
endfunc

func OTextSinkStr.Write(atext : strslice) [[override]]:
    dest^.Append(atext)
endfunc

func OTextSinkStr.WriteChar(ch : char) [[override]]:
    dest^.AppendChar(ch)
endfunc
#endif

//-------------------------------------------------------------------------------------------------

func OTextFormatter.*Create(asink : OTextSink):
    sink = asink
endfunc

func OTextFormatter.Reset():
    arg_index = 0
    flags = 0
    curpos = 0
endfunc

// use this union to spare stack space
union UScalarValues:
    bv       : bool
    ch       : char
    wc       : wchar
    num_int  : int
    num_uint : uint
  #if @def.PTRSIZE <= 4 and Defined(@def.TEXTFORMAT_INT64)
    num_i64  : int64
    num_u64  : uint64
  #endif
  #if Defined(@def.TEXTFORMAT_FLOAT32)
    num_f32  : float32
  #endif
  #if Defined(@def.TEXTFORMAT_FLOAT64)
    num_f64  : float64
  #endif
    ptr      : pointer
endunion

func OTextFormatter.Format(afmt : strslice, aargs : varargs):
    use ., varargs
    Reset()

    curpos = 0
    endpos = afmt.length

    var ar <- OVarArgReader(aargs)
    var lit_start : uint = 0

    // Keep the reader type out of the formatter's module interface, avoiding circular references
    subfn FormatArgument():
        var spec : char = fmtspec.kind
        var text_format : bool = spec == DQFMT_KIND_DEFAULT or spec == DQFMT_KIND_STRING

        var usv  : UScalarValues  // This union here spares stack space
        var text : strslice       // this cannot be used in unions

        if ar.TryText(text):
            if text_format:
                WriteFormattedText(text)
            else:
                ArgError("<s-f!>")
            endif

        elif ar.TrySint(usv.num_int):
            FormatInteger(TFmtUInt(usv.num_int), true, ar.wordcount)

        elif ar.TryUint(usv.num_uint):
            FormatInteger(usv.num_uint, false, ar.wordcount)

      #if @def.PTRSIZE <= 4 and Defined(@def.TEXTFORMAT_INT64)
        elif ar.TrySint64(usv.num_i64):
            FormatInteger(uint64(usv.num_i64), true, ar.wordcount)

        elif ar.TryUint64(usv.num_u64):
            FormatInteger(usv.num_u64, false, ar.wordcount)
      #endif

      #if Defined(@def.TEXTFORMAT_FLOAT32)
        elif ar.TryFloat32(usv.num_f32):
            if spec == DQFMT_KIND_DEFAULT or spec == DQFMT_KIND_FLOAT:
                FormatFloat(usv.num_f32)
            else:
                ArgError("<f-f!>")
            endif
      #endif

      #if Defined(@def.TEXTFORMAT_FLOAT64)
        elif ar.TryFloat64(usv.num_f64):
            if spec == DQFMT_KIND_DEFAULT or spec == DQFMT_KIND_FLOAT:
                FormatFloat(usv.num_f64)
            else:
                ArgError("<f-f!>")
            endif
      #endif

        elif ar.TryChar(usv.ch):
            if text_format:
                WriteFieldPad(1, false)
                sink.WriteChar(usv.ch)
                WriteFieldPad(1, true)
            else:
                FormatInteger(Ord(usv.ch), false, ar.wordcount)
            endif

        elif ar.TryWchar(usv.wc):
            if text_format:
                FormatWChar(usv.wc)
            else:
                FormatInteger(Ord(usv.wc), false, ar.wordcount)
            endif

        elif ar.TryBool(usv.bv):
            if spec == DQFMT_KIND_DEFAULT:
                if usv.bv:
                    WriteFormattedText('true')
                else:
                    WriteFormattedText('false')
                endif
            else:
                ArgError("<b-f!>")
            endif

        elif ar.TryPointer(usv.ptr):
            if spec == DQFMT_KIND_DEFAULT or spec == DQFMT_KIND_POINTER:
                WriteFormattedNumber('^', BuildUIntDigits(uint(usv.ptr), 16, true), 0, 0, 1)
            else:
                ArgError("<p-f!>")
            endif
        else:
            ArgError("<ar-error>")
        endif
    endsubfn

    while curpos < endpos:
        var ch : char = afmt[curpos]

        if ch == '{':
            if curpos > lit_start:
                sink.Write(afmt[lit_start:curpos])
            endif
            ++curpos
            if curpos < endpos and afmt[curpos] == '{':
                sink.WriteChar('{')
                ++curpos
                lit_start = curpos
                continue
            else:
                ParseSpec(afmt) // updates the curpos

                if arg_index < ar.length:
                    FormatArgument()
                    ar.Next()
                else:
                    WriteFormattedText("null")
                endif
                ++arg_index

                if curpos < endpos  and  afmt[curpos] == '}':
                    ++curpos
                else:
                    flags |= DQFMT_FMT_ERROR
                    sink.Write("<}?>")
                    break
                endif
                lit_start = curpos
            endif

        elif ch == '}':
            if curpos > lit_start:
                sink.Write(afmt[lit_start:curpos])
            endif
            ++curpos
            if curpos < endpos  and  afmt[curpos] == '}':
                sink.WriteChar('}')
                ++curpos
                lit_start = curpos
            else:
                // Unescaped closing brace.
                flags |= DQFMT_FMT_ERROR
                sink.Write("<!}>")
                ++curpos
                lit_start = curpos
            endif
        else:
            ++curpos
        endif
    endwhile

    if lit_start < endpos:
        sink.Write(afmt[lit_start:endpos])
    endif
endfunc

func OTextFormatter.ParseSpec(afmt : strslice):
    var p    : uint = curpos
    var flen : uint = afmt.length

    fmtspec.kind      = @.DQFMT_KIND_DEFAULT
    fmtspec.width     = -1
    fmtspec.precision = -1
    fmtspec.fill      = ' '
    fmtspec.align     = '>'
    fmtspec.sign      = char(0)
    fmtspec.upper     = false

    if p < flen  and  afmt[p] == ':':
        ++p
    endif

    if p < flen and (afmt[p] == '<' or afmt[p] == '>' or afmt[p] == '^'):
        fmtspec.align = afmt[p]
        ++p
    endif

    if p < flen and (afmt[p] == '+' or afmt[p] == '-' or afmt[p] == ' '):
        fmtspec.sign = afmt[p]
        ++p
    endif

    if p < flen and afmt[p] == '0':
        fmtspec.fill = '0'
        ++p
    endif

    if p < flen and @.DqTextFmtIsDigit(afmt[p]):
        fmtspec.width = 0
        while (p < flen) and @.DqTextFmtIsDigit(afmt[p]):
            fmtspec.width = fmtspec.width * 10 + @.DqTextFmtDigitValue(afmt[p])
            ++p
        endwhile
    endif

    if p < flen  and  afmt[p] == '.':
        ++p
        fmtspec.precision = 0
        while (p < flen) and @.DqTextFmtIsDigit(afmt[p]):
            fmtspec.precision = fmtspec.precision * 10 + @.DqTextFmtDigitValue(afmt[p])
            p = p + 1
        endwhile
    endif

    if p < flen:
        var k : char = afmt[p]
        if (k == 'd') or (k == 'u') or (k == 'x') or (k == 'X') or (k == 's') or (k == 'p') or (k == 'f') or (k == '?'):
            fmtspec.kind = k
            fmtspec.upper = (k == 'X')
            ++p
        endif
    endif

    if p < flen and afmt[p] <> '}':
        flags |= @.DQFMT_FMT_ERROR
    endif

    // Skip unsupported specifiers to recover at the next closing brace.
    while p < flen  and  afmt[p] <> '}':
        ++p
    endwhile

    curpos = p
endfunc

func OTextFormatter.ArgError(message : strslice):
    flags |= @.DQFMT_ARG_ERROR
    sink.Write(message)
endfunc

func OTextFormatter.PositiveSign() -> char:
    if fmtspec.sign == '+' or fmtspec.sign == ' ':
        return fmtspec.sign
    endif
    return char(0)
endfunc

func OTextFormatter.FormatWChar(wc : wchar):
    if not @strfunc.IsValidWchar(wc):
        flags |= @.DQFMT_ARG_ERROR
        wc = wchar(0xFFFD)
    endif
    var encoded : [4]char
    var count : int = @strfunc.StrfEncodeUtf8(wc, encoded)
    WriteFormattedText(@strfunc.StrSlice(%encoded[0], count))
endfunc

func OTextFormatter.WriteFieldPad(alength : int, aafter : bool):
    var pad : int = fmtspec.width - alength
    if pad <= 0:
        return
    endif

    if fmtspec.align == '^':
        if aafter:
            pad -= pad div 2
        else:
            pad = pad div 2
        endif
    elif (fmtspec.align == '<') <> aafter:
        return
    endif
    WritePad(pad, ' ')
endfunc

func OTextFormatter.WriteFormattedText(atext : strslice):
    var text_length : int = 0
    if fmtspec.width > 0:
        text_length = atext.wclen
    endif
    WriteFieldPad(text_length, false)
    sink.Write(atext)
    WriteFieldPad(text_length, true)
endfunc

func OTextFormatter.WritePad(acount : int, ch : char):
    while acount > 0:
        sink.WriteChar(ch)
        --acount
    endwhile
endfunc

func OTextFormatter.UIntDigitChar(adigit : uint, aupper : bool) -> char:
    if adigit < 10:
        return char(Ord('0') + int(adigit))
    elif aupper:
        return char(Ord('A') + int(adigit - 10))
    else:
        return char(Ord('a') + int(adigit - 10))
    endif
endfunc

func OTextFormatter.BuildUIntDigits(v : TFmtUInt, abase : uint, aupper : bool) -> int:
    lcsbuf.Clear()

    if v == 0:
        lcsbuf.AppendChar('0')
        return 1
    endif

    while v > 0:
        lcsbuf.AppendChar(UIntDigitChar(v mod abase, aupper))
        v = v div abase
    endwhile

    return int(lcsbuf.length)
endfunc

func OTextFormatter.WriteReversedDigits(acount : int):
    var i : int = acount - 1
    while i >= 0:
        sink.WriteChar(char(lcsbuf[i]))
        --i
    endwhile
endfunc

func OTextFormatter.WriteFormattedNumber(asign : char, aint_digit_count : int, afrac : TFmtUInt, aprecision : int, ascale : TFmtUInt):
    var total_len : int = aint_digit_count
    if asign <> char(0):
        ++total_len
    endif
    if aprecision > 0:
        total_len += aprecision + 1
    endif

    var zero_pad : bool = fmtspec.align == '>' and fmtspec.fill == '0'
    if not zero_pad:
        WriteFieldPad(total_len, false)
    endif

    if asign <> char(0):
        sink.WriteChar(asign)
    endif

    if zero_pad:
        WritePad(fmtspec.width - total_len, '0')
    endif

    WriteReversedDigits(aint_digit_count)

    if aprecision > 0:
        sink.WriteChar('.')
        var place : TFmtUInt = ascale div 10
        while place > 0:
            var digit : uint = afrac div place
            sink.WriteChar(UIntDigitChar(digit, false))
            afrac = afrac mod place
            place = place div 10
        endwhile
    endif

    WriteFieldPad(total_len, true)
endfunc

func OTextFormatter.FormatInteger(value : TFmtUInt, signed_value : bool, wordcount : byte):
    use .
    var spec : char = fmtspec.kind
    var signch : char = char(0)
    var base : uint = 10

    if spec == DQFMT_KIND_DEFAULT or spec == DQFMT_KIND_SIGNED:
        signch = PositiveSign()
        if signed_value or spec == DQFMT_KIND_SIGNED:
            var signed_number : TFmtInt = TFmtInt(value)
          #if @def.PTRSIZE == 4 and Defined(@def.TEXTFORMAT_INT64)
            if wordcount == 1:
                signed_number = int(value)
            endif
          #endif
            if signed_number < 0:
                signch = '-'
                value = TFmtUInt(-(signed_number + 1)) + 1
            endif
        endif
    elif spec == DQFMT_KIND_UNSIGNED or spec == DQFMT_KIND_HEXLOW or spec == DQFMT_KIND_HEXUP:
        // A negative one-word integer uses its native-width bits for u/x.
      #if @def.PTRSIZE == 4 and Defined(@def.TEXTFORMAT_INT64)
        if wordcount == 1:
            value = uint(value)
        endif
      #endif
        if spec <> DQFMT_KIND_UNSIGNED:
            base = 16
        endif
    else:
        ArgError("<i-f!>")
        return
    endif
    WriteFormattedNumber(signch, BuildUIntDigits(value, base, fmtspec.upper), 0, 0, 1)
endfunc

#if Defined(TEXTFORMAT_FLOAT32) or Defined(TEXTFORMAT_FLOAT64)
func OTextFormatter.TruncateMagnitude(v : TFmtFloat) -> TFmtUInt:
  #if @def.PTRSIZE == 4 and Defined(@def.TEXTFORMAT_FLOAT64)
    // Trunc returns a native int. Split a nonnegative magnitude into words
    // before converting so the fractional scale is usable on 32-bit targets.
    const WORD_BASE : uint64 = 0x100000000
    const HALF_WORD : uint64 = 0x80000000
    var high : uint64 = Trunc(v / WORD_BASE)
    var low : float64 = v - high * WORD_BASE
    if low >= HALF_WORD:
        return high * WORD_BASE + HALF_WORD + Trunc(low - HALF_WORD)
    endif
    return high * WORD_BASE + Trunc(low)
  #else
    return Trunc(v)
  #endif
endfunc

func OTextFormatter.FormatFloat(v : TFmtFloat):
    var signch : char = PositiveSign()
    var work : TFmtFloat = v

    if work < 0:
        signch = '-'
        work = -work
    endif

  #if Defined(TEXTFORMAT_FLOAT64)
    const DEFAULT_PRECISION : int = 15
    const MAX_PRECISION     : int = 18
    const LIMIT             : uint64 = 0x8000000000000000
  #else
    const DEFAULT_PRECISION : int = 6
    const MAX_PRECISION     : int = 9
    const LIMIT             : uint32 = 0x80000000
  #endif

    var precision : int = fmtspec.precision
    if precision < 0:
        precision = DEFAULT_PRECISION
    elif precision > MAX_PRECISION:
        precision = MAX_PRECISION
    endif

    // A conversion outside the signed range of Trunc is undefined.
    if not (work < LIMIT):
        ArgError("<f-f!>")
        return
    endif

    var scale : TFmtUInt = 1
    for i : int = 0 count precision:
        scale *= 10
    endfor

    var intpart : TFmtUInt
    var frac    : TFmtUInt

    if fmtspec.precision >= 0 and (work * scale + 0.5) < LIMIT:
        var scaled : TFmtUInt = TruncateMagnitude(work * scale + 0.5)
        intpart = scaled div scale
        frac = scaled mod scale
    else:
        intpart = TruncateMagnitude(work)
        frac = TruncateMagnitude((work - intpart) * scale + 0.5)

        if frac >= scale:
            ++intpart
            frac -= scale
        endif

        if fmtspec.precision < 0:
            while precision > 0 and (frac mod 10) == 0:
                frac = frac div 10
                scale = scale div 10
                --precision
            endwhile
        endif
    endif

    WriteFormattedNumber(signch, BuildUIntDigits(intpart, 10, false), frac, precision, scale)
endfunc
#endif

//----------------------------------------------------------------------------------------

func EmbStrAddFmt(adest : embstr, afmt : strslice, aargs : varargs):
    var osink <- OTextSinkEmbStr(adest)
    var ofmt  <- OTextFormatter(osink)
    ofmt.Format(afmt, aargs)
endfunc

#ifdef DYNSTRINGS
func DynStrAddFmt(astr : ^str, afmt : strslice, aargs : varargs):
    var osink <- OTextSinkStr(astr)
    var ofmt  <- OTextFormatter(osink)
    ofmt.Format(afmt, aargs)
endfunc
#endif
