// LLVM inlining attribute test

func printf(fmt : ^char, ...) -> int [[external]]

func AddOne(value : int) -> int [[inline]]:
    return value + 1
endfunc

func *Main():
    var value : int = 41
    value = AddOne(value)
    printf("inline attribute = %d\n", value)  //?check("inline attribute", 42)
endfunc
