// A small DdGfx scene containing a fixed number of translucent, animated
// letters.  The letters follow slow independent paths so the scene remains
// calm even with many glyphs on screen.

use print
use math
use strutils
use rtl/strfunc
use ./openglutils
use ./ddgfx
use ./ddgfx_font

const letter_count   : int = 2000
const speed_scale    : float = 200
const rotation_scale : float = 100
const szspeed_scale  : float = 10

const window_width  : int = 1024
const window_height : int = 768
const font_pixels   : int = 2*56  // Render large, then scale the glyphs down.


// rand and srand are provided by the C runtime linked with native DQ programs.
func libc_rand() -> int32 [[external('rand')]]
func libc_srand(seed : uint32) [[external('srand')]]

func RandomUnit() -> float64:
    return libc_rand() / 2147483647.0
endfunc

//-----------------------------------------------------------------------------

object OFlyingLetter(OTextBox):
public
    speed_x        : float32 = 0.0  // pixels per second
    speed_y        : float32 = 0.0
    rotation_speed : float32 = 0.0  // degrees per second
    size_phase     : float64 = 0.0
    size_speed     : float64 = 0.0

    func *Create(parent : ODrawable, font : OFont, text : strview)
    func Step(elapsed : float64, time : float64, scene_width : int, scene_height : int)
endobject

func OFlyingLetter.*Create(parent : ODrawable, font : OFont, text : strview):
    inherited Create(parent, font, text)
    alpha = 0.6
endfunc

func OFlyingLetter.Step(elapsed : float64, time : float64, scene_width : int, scene_height : int):
    use *
    x += speed_x * elapsed
    y += speed_y * elapsed
    rotation += rotation_speed * elapsed

    // The source glyph is 56 pixels high; its displayed size breathes slowly.
    var scale : float64 = 0.45 + 0.22 * (Sin(time * size_speed + size_phase) + 1)
    scalex = scale
    scaley = scale

    // Keep the independent flight vectors circulating through the viewport.
    if x > scene_width:
        x = -width * scalex
    endif
    if x < -width * scalex:
        x = scene_width
    endif
    if y > scene_height:
        y = -height * scaley
    endif
    if y < -height * scaley:
        y = scene_height
    endif
endfunc

//-----------------------------------------------------------------------------

object OFlyingLettersScene(ODdScene):
public
    font_manager : OFontManager = nil
    font         : OFont = nil
    letters      : [*]OFlyingLetter
    time         : float64 = 0
    last_time    : float64 = 0
    ready        : bool = false

    func *Create(window : pointer)
    func *Destroy()
    func Step(width : int, height : int)
endobject

func OFlyingLettersScene.*Create(window : pointer):
    inherited Create(window)

    use *
    libc_srand(uint32(Floor(GlfwGetTime() * 1000000)))
    background = {0.04, 0.06, 0.12, 1.0}
    font_manager = new OFontManager()
    font = font_manager.GetFont('LiberationSerif-Regular.ttf')
    if not font.SetPixelSize(font_pixels):
        return
    endif

    // Use a shared UTF-16 character set so every random glyph is complete,
    // including accented Latin, Greek, and Cyrillic letters.
    var character_set : str = 'ABCDEFGHIJKLMNOPQRSTUVWXYZÁÉÍÓÖŐÚÜŰČĆĞİŁÑØŠŽΑΒΓΔΕΖΗΘΙΚΛΜΝΞΟΠΡΣΤΥΦΧΨΩЖДЙЛПФЯ'
    var characters : [*]char16 = StrfToUtf16(character_set)

    for index : int = 0 count letter_count:
        var character : [2]char16
        character[0] = characters[libc_rand() rem (characters.length - 1)]
        character[1] = char16(0)

        var text : str = StrfFromUtf16(character)
        var letter : OFlyingLetter = new OFlyingLetter(root, font, text)
        letter.color = {
            0.25 + 0.75 * RandomUnit(),
            0.25 + 0.75 * RandomUnit(),
            0.25 + 0.75 * RandomUnit(),
            1.0
        }
        letter.x = window_width * RandomUnit()
        letter.y = window_height * RandomUnit()
        letter.speed_x = speed_scale * (RandomUnit() - 0.5)
        letter.speed_y = speed_scale * (RandomUnit() - 0.5)
        letter.rotation_speed = rotation_scale * (RandomUnit() - 0.5)
        letter.size_phase = 6.2831853 * RandomUnit()
        letter.size_speed = szspeed_scale * (RandomUnit() - 0.5)
        letters.Append(letter)
    endfor

    ready = true
endfunc

func OFlyingLettersScene.*Destroy():
    // Text box destruction only releases their textures, not their font.
    delete font_manager = nil
    inherited Destroy()
endfunc

func OFlyingLettersScene.Step(width : int, height : int):
    use *
    var current_time : float64 = GlfwGetTime()
    var elapsed : float64 = current_time - last_time
    last_time = current_time
    time = current_time
    if elapsed > 0.1:
        elapsed = 0.1
    endif

    for index : int = 0 count letters.length:
        letters[index].Step(elapsed, time, width, height)
    endfor
endfunc

//-----------------------------------------------------------------------------

var g_scene : OFlyingLettersScene

func *Main() -> int:
    PrintLn('Flying letters for DQ')

    if GlfwInit() == GLFW_FALSE:
        PrintLn('Could not initialize GLFW')
        return 1
    endif

    // DdGfx uses shaders and alpha textures, which need a compatibility
    // profile for the legacy GL_ALPHA text texture format.
    GlfwWindowHint(GLFW_CONTEXT_VERSION_MAJOR, 3)
    GlfwWindowHint(GLFW_CONTEXT_VERSION_MINOR, 3)
    GlfwWindowHint(GLFW_OPENGL_PROFILE, GLFW_OPENGL_COMPAT_PROFILE)

    var window : pointer = GlfwCreateWindow(window_width, window_height, 'Flying letters for DQ', nil, nil)
    if window == nil:
        PrintLn('Could not create the OpenGL window')
        GlfwTerminate()
        return 1
    endif

    GlfwMakeContextCurrent(window)
    GlfwSwapInterval(1)

    g_scene = new OFlyingLettersScene(window)
    if not g_scene.ready:
        PrintLn('Could not load LiberationSans-Regular.ttf')
        delete g_scene = nil
        GlfwDestroyWindow(window)
        GlfwTerminate()
        return 1
    endif

    while GlfwWindowShouldClose(window) == GLFW_FALSE:
        var width  : int32 = 0
        var height : int32 = 0
        GlfwGetFramebufferSize(window, %width, %height)

        g_scene.Step(width, height)
        g_scene.BeginFrame(width, height)
        g_scene.EndFrame()
        GlfwPollEvents()
    endwhile

    delete g_scene = nil
    GlfwDestroyWindow(window)
    GlfwTerminate()
    return 0
endfunc
