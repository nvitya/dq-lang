use print, rtl/textformat, strutils

var cs : cstring(255)
var ds : str

func PrintCs():
    PrintLn('cs="{}"', [cs])
endfunc

func TestCStr():
    PrintLn('Testing cstring.AddFmt()')
    cs.Append("functest: ")
    CStrAddFmt(cs, ", {}, {}, {}", [1, 3.14, 'qqcs'])
    PrintCs()
    cs.Clear()
    //TODO: implement this
    cs.Add("method: ")  // Add() == Append()
    cs.AddFmt(", {}, {}, {}", [1, 3.14, 'qqcs'])
    PrintCs()
endfunc

func PrintDs():
    PrintLn('ds="{}"', [ds])
endfunc

func TestStr():
    PrintLn('Testing str.AddFmt()')

    ds.Append("functest: ")
    DynStrAddFmt(%ds, ", {}, {}, {}", [5, 2.75, 'hi'])
    PrintDs()

    ds.Clear()
    //TODO: implement this
    ds.Add("method: ")  // Add() == Append()
    ds.AddFmt(", {}, {}, {}", [5, 2.75, 'hi'])
    PrintDs()
endfunc

func *Main() -> int:
    TestCStr()
    TestStr()
 
  PrintLn(Format('Format: {}, {}, {}', [42, 'hello', 1.8]))

    PrintLn()
    return 0
endfunc