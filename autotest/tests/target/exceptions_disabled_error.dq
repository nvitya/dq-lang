//?notest
// Focused diagnostics for exception statements in exception-free builds.

#ifdef TEST_TRY
func TestTry():
    try:
    except:
    endtry
endfunc
#endif

#ifdef TEST_FINALLY
func TestFinally():
    try:
    finally:
    endtry
endfunc
#endif

#ifdef TEST_VALUE_RAISE
func TestValueRaise():
    raise Exception("disabled")
endfunc
#endif

#ifdef TEST_RERAISE
func TestReraise():
    raise
endfunc
#endif
