// Re-raise and base-catches-derived exception matching.

use rtl/exception

func printf(fmt : ^char, ...) -> int [[external]]

object EDerived(Exception):
public
    func *Create(amsg : strview):
        inherited Create(amsg)
    endfunc
endobject

func ThrowDerived():
    raise EDerived("derived")
endfunc

func Rethrower():
    try:
        raise Exception("again")
    except Exception:
        raise
    endtry
endfunc

func *Main() -> int:
    try:
        ThrowDerived()
    except Exception as e:
        printf("exception.derived = ")  //?check("exception.derived", "derived")
        e.PrintMessage()
        printf("\n")
    endtry

    try:
        Rethrower()
    except Exception as e:
        printf("exception.rethrow = ")  //?check("exception.rethrow", "again")
        e.PrintMessage()
        printf("\n")
    endtry

    return 0
endfunc
