use ./mod_flatten_outer

#ifdef NESTED_REEXPORT_FLAG
const NESTED_REEXPORT_VALUE : int = 47
#else
const NESTED_REEXPORT_VALUE : int = 0
#endif

const NESTED_REEXPORT_DEFINED : bool = Defined(NESTED_REEXPORT_FLAG)

func *Main():
    printf("flatten nested = %d\n", HiddenValue(MakeHidden(43))) //?check('flatten nested', 43)
    printf("flatten nested directive = %d\n", NESTED_REEXPORT_VALUE) //?check('flatten nested directive', 47)
    printf("flatten nested defined = %d\n", NESTED_REEXPORT_DEFINED) //?check('flatten nested defined', 1)
endfunc
