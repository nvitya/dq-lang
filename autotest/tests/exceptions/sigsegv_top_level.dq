// Hosted Linux catches SIGSEGV at the top level and reports it as Exception.
//?exitcode(255)

func printf(fmt : ^char, ...) -> int [[external]]

func CauseSegv():
    var p : ^int = nil
    p^ = 1
endfunc

func *Main() -> int:
    printf("sigsegv.before = 1\n")  //?check("sigsegv.before", 1)
    CauseSegv()
    printf("sigsegv.after = 1\n")
    return 0
endfunc

//?ignore("UNCAUGHT EXCEPTION: ESegFault: Segmentation fault")
//?ignore("Backtrace")
//?ignore("#")
