//?notest
// Compile-only coverage for target-native collection lengths and indexes.

use rtl/sys

func ReadSlice(values : []int, index : int) -> int:
    if values == []:
        return 0
    endif

    var total : int = 0
    var i : int = 0
    while i < values.length:
        total += values[i]
        i += 1
    endwhile

    var tail : []int = values[1:values.length]
    return total + tail[index]
endfunc

func ReadFixed() -> int:
    var values : [4]int = [1, 2, 3, 4]
    var view : []int = values
    return values[0] + ReadSlice(view, 0) + ReadSlice([5, 6], 0)
endfunc

func CopyCollections(source : []int) -> int:
    var from_literal : [*]int = [1, 2, 3]
    var from_slice : [*]int = source
    var fixed : [2]int = [4, 5]
    var from_fixed : [*]int = fixed
    return from_literal.length + from_slice.length + from_fixed.length
endfunc

func CopyCString(source : cstring) -> int:
    var target : cstring(7) = source
    return target.length
endfunc

func SetStringChar(value : str, index : int) -> char:
    value[index] = 'x'
    return value[index]
endfunc

func FormatString(value : ref str):
    value.AddFmt('{}', [1])
endfunc
