func CStrLen(desc : ref SDqTextInfo) -> uint
func CStrMaxLen(desc : ref SDqTextInfo) -> uint
func CStrStorageSize(desc : ref SDqTextInfo) -> uint

func CStrClear(desc : ref SDqTextInfo)
func CStrAssignChar(desc : ref SDqTextInfo, ch : char)
func CStrAssignPtr(desc : ref SDqTextInfo, src : ^char)
func CStrAssignDesc(desc : ref SDqTextInfo, src : ref SDqTextInfo)
func CStrAppendPtr(desc : ref SDqTextInfo, src : ^char)
func CStrAppendDesc(desc : ref SDqTextInfo, src : ref SDqTextInfo)
func CStrAppendChar(desc : ref SDqTextInfo, ch : char)
func CStrPrependPtr(desc : ref SDqTextInfo, src : ^char)
func CStrPrependDesc(desc : ref SDqTextInfo, src : ref SDqTextInfo)
func CStrPrependChar(desc : ref SDqTextInfo, ch : char)
func CStrInsertPtr(desc : ref SDqTextInfo, index : int, src : ^char)
func CStrInsertDesc(desc : ref SDqTextInfo, index : int, src : ref SDqTextInfo)
func CStrInsertChar(desc : ref SDqTextInfo, index : int, ch : char)
func CStrDelete(desc : ref SDqTextInfo, index : int, count : int = 1)