// The un-suffixed C functions use float64, matching C double.
// The 32-suffixed DQ functions use float32 and link to the C "...f" symbols.

#linklib('m')

// float64 variants

// trigonometric functions - float64
func ACos(x : float64) -> float64 [[external('acos')]]
func ASin(x : float64) -> float64 [[external('asin')]]
func ATan(x : float64) -> float64 [[external('atan')]]
func Atan2(y : float64, x : float64) -> float64 [[external('atan2')]]
func Cos(x : float64) -> float64 [[external('cos')]]
func Sin(x : float64) -> float64 [[external('sin')]]
func Tan(x : float64) -> float64 [[external('tan')]]

// hyperbolic functions - float64
func ACosH(x : float64) -> float64 [[external('acosh')]]
func ASinH(x : float64) -> float64 [[external('asinh')]]
func ATanH(x : float64) -> float64 [[external('atanh')]]
func CosH(x : float64) -> float64 [[external('cosh')]]
func SinH(x : float64) -> float64 [[external('sinh')]]
func TanH(x : float64) -> float64 [[external('tanh')]]

// exponential and logarithmic functions - float64
func Exp(x : float64) -> float64 [[external('exp')]]
func Exp2(x : float64) -> float64 [[external('exp2')]]
func Expm1(x : float64) -> float64 [[external('expm1')]]
func Frexp(x : float64, exp : ^int32) -> float64 [[external('frexp')]]
func ILogB(x : float64) -> int32 [[external('ilogb')]]
func LdExp(x : float64, exp : int32) -> float64 [[external('ldexp')]]
func Log(x : float64) -> float64 [[external('log')]]
func Log10(x : float64) -> float64 [[external('log10')]]
func Log1p(x : float64) -> float64 [[external('log1p')]]
func Log2(x : float64) -> float64 [[external('log2')]]
func Logb(x : float64) -> float64 [[external('logb')]]
func Modf(x : float64, intpart : ^float64) -> float64 [[external('modf')]]
func Scalbn(x : float64, n : int32) -> float64 [[external('scalbn')]]
func Scalbln(x : float64, n : int) -> float64 [[external('scalbln')]]

// power and absolute-value functions - float64
func Cbrt(x : float64) -> float64 [[external('cbrt')]]
func FAbs(x : float64) -> float64 [[external('fabs')]]
func Hypot(x : float64, y : float64) -> float64 [[external('hypot')]]
func Pow(x : float64, y : float64) -> float64 [[external('pow')]]
func Sqrt(x : float64) -> float64 [[external('sqrt')]]

// nearest integer, remainder, and manipulation functions - float64
func Ceil(x : float64) -> float64 [[external('ceil')]]
func Floor(x : float64) -> float64 [[external('floor')]]
func NearbyInt(x : float64) -> float64 [[external('nearbyint')]]
func RInt(x : float64) -> float64 [[external('rint')]]
func LrInt(x : float64) -> int [[external('lrint')]]
func LlrInt(x : float64) -> int64 [[external('llrint')]]
func Round(x : float64) -> float64 [[external('round')]]
func LRound(x : float64) -> int [[external('lround')]]
func LlRound(x : float64) -> int64 [[external('llround')]]
func Trunc(x : float64) -> float64 [[external('trunc')]]
func FMod(x : float64, y : float64) -> float64 [[external('fmod')]]
func Remainder(x : float64, y : float64) -> float64 [[external('remainder')]]
func Remquo(x : float64, y : float64, quo : ^int32) -> float64 [[external('remquo')]]

// floating-point manipulation and comparison helpers - float64
func Copysign(x : float64, y : float64) -> float64 [[external('copysign')]]
func Nan(tagp : ^char) -> float64 [[external('nan')]]
func NextAfter(x : float64, y : float64) -> float64 [[external('nextafter')]]
func FDim(x : float64, y : float64) -> float64 [[external('fdim')]]
func FMax(x : float64, y : float64) -> float64 [[external('fmax')]]
func FMin(x : float64, y : float64) -> float64 [[external('fmin')]]
func FMa(x : float64, y : float64, z : float64) -> float64 [[external('fma')]]

//-------------------------------------------------------------------------------------------------
// float32 variants
//-------------------------------------------------------------------------------------------------

// trigonometric functions - float32
func ACos32(x : float32) -> float32 [[external('acosf')]]
func ASin32(x : float32) -> float32 [[external('asinf')]]
func ATan32(x : float32) -> float32 [[external('atanf')]]
func ATan232(y : float32, x : float32) -> float32 [[external('atan2f')]]
func Cos32(x : float32) -> float32 [[external('cosf')]]
func Sin32(x : float32) -> float32 [[external('sinf')]]
func Tan32(x : float32) -> float32 [[external('tanf')]]


// hyperbolic functions - float32
func ACosH32(x : float32) -> float32 [[external('acoshf')]]
func ASinH32(x : float32) -> float32 [[external('asinhf')]]
func ATanH32(x : float32) -> float32 [[external('atanhf')]]
func CosH32(x : float32) -> float32 [[external('coshf')]]
func SinH32(x : float32) -> float32 [[external('sinhf')]]
func TanH32(x : float32) -> float32 [[external('tanhf')]]

// exponential and logarithmic functions - float32
func Exp32(x : float32) -> float32 [[external('expf')]]
func Exp232(x : float32) -> float32 [[external('exp2f')]]
func Expm132(x : float32) -> float32 [[external('expm1f')]]
func Frexp32(x : float32, exp : ^int32) -> float32 [[external('frexpf')]]
func Ilogb32(x : float32) -> int32 [[external('ilogbf')]]
func LdExp32(x : float32, exp : int32) -> float32 [[external('ldexpf')]]
func Log32(x : float32) -> float32 [[external('logf')]]
func Log1032(x : float32) -> float32 [[external('log10f')]]
func Log1p32(x : float32) -> float32 [[external('log1pf')]]
func Log232(x : float32) -> float32 [[external('log2f')]]
func Logb32(x : float32) -> float32 [[external('logbf')]]
func Modf32(x : float32, intpart : ^float32) -> float32 [[external('modff')]]
func Scalbn32(x : float32, n : int32) -> float32 [[external('scalbnf')]]
func Scalbln32(x : float32, n : int) -> float32 [[external('scalblnf')]]

// power and absolute-value functions - float32
func Cbrt32(x : float32) -> float32 [[external('cbrtf')]]
func FAbs32(x : float32) -> float32 [[external('fabsf')]]
func Hypot32(x : float32, y : float32) -> float32 [[external('hypotf')]]
func Pow32(x : float32, y : float32) -> float32 [[external('powf')]]
func Sqrt32(x : float32) -> float32 [[external('sqrtf')]]

// error and gamma functions - float32
func Erf(x : float64) -> float64 [[external('erf')]]
func Erfc(x : float64) -> float64 [[external('erfc')]]
func LGamma(x : float64) -> float64 [[external('lgamma')]]
func TGamma(x : float64) -> float64 [[external('tgamma')]]

// error and gamma functions - float32
func Erf32(x : float32) -> float32 [[external('erff')]]
func Erfc32(x : float32) -> float32 [[external('erfcf')]]
func LGamma32(x : float32) -> float32 [[external('lgammaf')]]
func TGamma32(x : float32) -> float32 [[external('tgammaf')]]

// nearest integer, remainder, and manipulation functions - float32
func Ceil32(x : float32) -> float32 [[external('ceilf')]]
func Floor32(x : float32) -> float32 [[external('floorf')]]
func NearbyInt32(x : float32) -> float32 [[external('nearbyintf')]]
func Rint32(x : float32) -> float32 [[external('rintf')]]
func LrInt32(x : float32) -> int [[external('lrintf')]]
func LlrInt32(x : float32) -> int64 [[external('llrintf')]]
func Round32(x : float32) -> float32 [[external('roundf')]]
func LRound32(x : float32) -> int [[external('lroundf')]]
func LlRound32(x : float32) -> int64 [[external('llroundf')]]
func Trunc32(x : float32) -> float32 [[external('truncf')]]
func Fmod32(x : float32, y : float32) -> float32 [[external('fmodf')]]
func Remainder32(x : float32, y : float32) -> float32 [[external('remainderf')]]
func Remquo32(x : float32, y : float32, quo : ^int32) -> float32 [[external('remquof')]]

// floating-point manipulation and comparison helpers - float32
func CopySign32(x : float32, y : float32) -> float32 [[external('copysignf')]]
func Nan32(tagp : ^char) -> float32 [[external('nanf')]]
func NextAfter32(x : float32, y : float32) -> float32 [[external('nextafterf')]]
func FDim32(x : float32, y : float32) -> float32 [[external('fdimf')]]
func FMax32(x : float32, y : float32) -> float32 [[external('fmaxf')]]
func FMin32(x : float32, y : float32) -> float32 [[external('fminf')]]
func FMa32(x : float32, y : float32, z : float32) -> float32 [[external('fmaf')]]
