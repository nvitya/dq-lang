// object inheritance type checking tests (ERROR test)

object OBase:
private
    secret : int
    func SecretFunc():
    endfunc
protected
    hidden : int
public
    func *Create():
    endfunc

    func Value() -> int [[virtual]]:
        return hidden
    endfunc

    func Done() [[virtual, final]]:
    endfunc
endobject

object OChild(OBase):
public
    func *Create():
        hidden = 1
    endfunc

    func Value() -> int: //?error(ObjFuncOverride)
        return hidden
    endfunc

    func Missing() [[override]]: //?error(ObjFuncOverride)
    endfunc

    func Done() [[override]]: //?error(ObjFuncOverride)
    endfunc
endobject

object OArgBase:
public
    func *Create(v : int):
    endfunc
endobject

object OArgChild(OArgBase):
public
    func *Create():
    endfunc //?error(ObjSpecFuncInvalid)
endobject

object OAccessChild(OBase):
public
    func *Create():
        inherited Create()
    endfunc

    func ReadSecret() -> int:
        result = 0
        result = secret //?error(MemberUnknown)
    endfunc

    func CallSecret():
        inherited SecretFunc() //?error(OverloadNoMatch)
    endfunc
endobject

object OAbstract:
public
    func Read() -> int [[virtual, abstract]]
endobject

object OVirtualDtorCall:
public
    func Ping(a : int) [[virtual, overload]]:
    endfunc

    func Ping(a : float) [[virtual, overload]]:
    endfunc

    func *Destroy():
        Ping(1) //?error(VirtFuncCallInvalid)
    endfunc
endobject

object OMissingBaseChild(OMissingBase): //?error(TypeUnknown), error(TypeExpected)
endobject

func OMissingBaseChild.AfterBadBase(): //?error(TypeUnknown)
endfunc

func MutObjectRef(o : ref OBase):
endfunc

func *Main() -> int:
    result = 0
    var b <- OBase()
    var c <- OChild()
    result = b.hidden  //?error(MemberUnknown)
    MutObjectRef(b) //?error(FuncArgRefBind)
    var a <- OAbstract //?error(NotSupported)
endfunc
