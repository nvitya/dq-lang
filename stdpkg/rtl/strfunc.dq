use rtl/rtlint

#include "cstrings.dqh"
#srcdep  "cstrings.dqi"

#include "textinfo.dqh"
#srcdep  "textinfo.dqi"

#ifdef DYNSTRINGS
#include "dynstr.dqh"
#srcdep  "dynstr.dqi"
#endif


function StrfIsValidWChar(wc : wchar) -> bool
function IntToChar(value : int) -> char [[overload]]
function IntToChar(value : int, defvalue : char) -> char [[overload]]
function IntToWchar(value : int) -> wchar [[overload]]
function IntToWchar(value : int, defvalue : wchar) -> wchar [[overload]]

function StrfIsUtf8(text : strview) -> bool
function StrfWcLen(text : strview) -> int
function StrfWCharAt(text : strview, index : int) -> wchar
function StrfToWchars(text : strview) -> [*]wchar
function StrfWCharSlice(text : strview, startpos : int, endposex : int) -> [*]wchar
#ifdef DYNSTRINGS
function StrfWcStrSlice(text : strview, startpos : int, endposex : int) -> str
function StrfFromWchars(chars : []wchar) -> str
#endif
function StrfToUtf16(text : strview) -> [*]char16
#ifdef DYNSTRINGS
function StrfFromUtf16(chars : []char16) -> str
function StrfFromUtf16Fallback(chars : []char16, fallback_wchar : wchar) -> str
function StrfFromUtf16Ptr(chars : ^char16, count : int) -> str
function StrfFromUtf16PtrFallback(chars : ^char16, count : int, fallback_wchar : wchar) -> str
#endif

implementation

use rtl/mem
#ifdef EXCEPTIONS
use rtl/exception
#endif
//use rtl/cstrings

#include "cstrings.dqi"

#include "textinfo.dqi"

#ifdef DYNSTRINGS
#include "dynstr.dqi"
#endif

function StrfRuntimeError(emsg : ^char):
#ifdef EXCEPTIONS
    raise EStrError(emsg)
#else
    RuntimeError(emsg)
#endif
endfunc


function StrfIsHighSurrogate(code : uint32) -> bool:
    return code >= uint32(0xD800) and code <= uint32(0xDBFF)
endfunc

function StrfIsLowSurrogate(code : uint32) -> bool:
    return code >= uint32(0xDC00) and code <= uint32(0xDFFF)
endfunc

function StrfIsValidWChar(wc : wchar) -> bool:
    var code : uint32 = uint32(Ord(wc))
    return code <= uint32(0x10FFFF) and not (code >= uint32(0xD800) and code <= uint32(0xDFFF))
endfunc

function IntToChar(value : int) -> char [[overload]]:
    if value < 0 or value > 255:
#ifdef EXCEPTIONS
        raise EStrError('char value out of range: {}', [value])
#else
        StrfRuntimeError('char value out of range')
#endif
        return char(0)
    endif
    return char(value)
endfunc

function IntToChar(value : int, defvalue : char) -> char [[overload]]:
    if value < 0 or value > 255:
        return defvalue
    endif
    return char(value)
endfunc

function IntToWchar(value : int) -> wchar [[overload]]:
    result = wchar(value)
    if not StrfIsValidWChar(result):
#ifdef EXCEPTIONS
        raise EStrError('wchar value out of range: {}', [value])
#else
        StrfRuntimeError('wchar value out of range')
#endif
        return wchar(0)
    endif
endfunc

function IntToWchar(value : int, defvalue : wchar) -> wchar [[overload]]:
    result = wchar(value)
    if not StrfIsValidWChar(result):
        return defvalue
    endif
endfunc

function StrfByte(text : strview, index : int) -> uint32:
    return uint32(Ord(text[index])) & uint32(0xFF)
endfunc

function StrfFailUtf8(report_error : bool) -> bool:
    if report_error:
        StrfRuntimeError('Invalid UTF-8')
    endif
    return false
endfunc

function StrfReadCont(text : strview, index : int, outb : refout uint32, report_error : bool) -> bool:
    if index >= text.length:
        return StrfFailUtf8(report_error)
    endif
    outb = StrfByte(text, index)
    if outb & uint32(0xC0) <> uint32(0x80):
        return StrfFailUtf8(report_error)
    endif
    outb = outb & uint32(0x3F)
    return true
endfunc

function StrfDecodeUtf8(text : strview, pos : ref int, wc : refout wchar,
                        report_error : bool = true) -> bool:
    if pos >= text.length:
        return false
    endif

    var b0 : uint32 = StrfByte(text, pos)
    if b0 <= uint32(0x7F):
        wc = wchar(b0)
        pos += 1
        return true
    endif

    var b1 : uint32 = 0
    var b2 : uint32 = 0
    var b3 : uint32 = 0
    var decoded : uint32 = 0
    if b0 >= uint32(0xC2) and b0 <= uint32(0xDF):
        if not StrfReadCont(text, pos + 1, b1, report_error):
            return false
        endif
        decoded = ((b0 & uint32(0x1F)) << 6) | b1
        wc = wchar(decoded)
        pos += 2
        return true
    elif b0 >= uint32(0xE0) and b0 <= uint32(0xEF):
        if not StrfReadCont(text, pos + 1, b1, report_error) or not StrfReadCont(text, pos + 2, b2, report_error):
            return false
        endif
        decoded = ((b0 & uint32(0x0F)) << 12) | (b1 << 6) | b2
        wc = wchar(decoded)
        if decoded < uint32(0x800) or not StrfIsValidWChar(wc):
            return StrfFailUtf8(report_error)
        endif
        pos += 3
        return true
    elif b0 >= uint32(0xF0) and b0 <= uint32(0xF4):
        if not StrfReadCont(text, pos + 1, b1, report_error) or not StrfReadCont(text, pos + 2, b2, report_error) or not StrfReadCont(text, pos + 3, b3, report_error):
            return false
        endif
        decoded = ((b0 & uint32(0x07)) << 18) | (b1 << 12) | (b2 << 6) | b3
        wc = wchar(decoded)
        if decoded < uint32(0x10000) or not StrfIsValidWChar(wc):
            return StrfFailUtf8(report_error)
        endif
        pos += 4
        return true
    endif

    return StrfFailUtf8(report_error)
endfunc

#ifdef DYNSTRINGS
function StrfAppendUtf8(dst : ref str, wc : wchar):
    if not StrfIsValidWChar(wc):
#ifdef EXCEPTIONS
        raise EStrError('Invalid Unicode scalar: {:x}', [wc])
#else
        StrfRuntimeError('Invalid Unicode scalar')
#endif
        return
    endif

    var code : uint32 = uint32(Ord(wc))
    if code <= uint32(0x7F):
        dst.Append(char(int(code)))
    elif code <= uint32(0x7FF):
        dst.Append(char(int(uint32(0xC0) | (code >> 6))))
        dst.Append(char(int(uint32(0x80) | (code & uint32(0x3F)))))
    elif code <= uint32(0xFFFF):
        dst.Append(char(int(uint32(0xE0) | (code >> 12))))
        dst.Append(char(int(uint32(0x80) | ((code >> 6) & uint32(0x3F)))))
        dst.Append(char(int(uint32(0x80) | (code & uint32(0x3F)))))
    else:
        dst.Append(char(int(uint32(0xF0) | (code >> 18))))
        dst.Append(char(int(uint32(0x80) | ((code >> 12) & uint32(0x3F)))))
        dst.Append(char(int(uint32(0x80) | ((code >> 6) & uint32(0x3F)))))
        dst.Append(char(int(uint32(0x80) | (code & uint32(0x3F)))))
    endif
endfunc
#endif

function StrfAppendUtf16(dst : ref [*]char16, wc : wchar):
    if not StrfIsValidWChar(wc):
#ifdef EXCEPTIONS
        raise EStrError('Invalid Unicode scalar: {:x}', [wc])
#else
        StrfRuntimeError('Invalid Unicode scalar')
#endif
        return
    endif

    var code : uint32 = uint32(Ord(wc))
    if code <= uint32(0xFFFF):
        dst.Append(char16(int(code)))
    else:
        code -= uint32(0x10000)
        dst.Append(char16(int(uint32(0xD800) | (code >> 10))))
        dst.Append(char16(int(uint32(0xDC00) | (code & uint32(0x3FF)))))
    endif
endfunc

function StrfIsUtf8(text : strview) -> bool:
    var pos : int = 0
    var wc : wchar = wchar(0)
    while StrfDecodeUtf8(text, pos, wc, false):
    endwhile
    result = pos >= text.length
endfunc

function StrfWcLen(text : strview) -> int:
    var pos : int = 0
    var wc : wchar = wchar(0)
    result = 0
    while StrfDecodeUtf8(text, pos, wc):
        result += 1
    endwhile
endfunc

function StrfWCharAt(text : strview, index : int) -> wchar:
    result = wchar(0)
    if index < 0:
#ifdef EXCEPTIONS
        raise EStrError('wchar index out of bounds: {}', [index])
#else
        StrfRuntimeError('wchar index out of bounds')
#endif
        return wchar(0)
    endif

    var pos : int = 0
    var wcidx : int = 0
    var wc : wchar = wchar(0)
    while StrfDecodeUtf8(text, pos, wc):
        if wcidx == index:
            return wc
        endif
        wcidx += 1
    endwhile

#ifdef EXCEPTIONS
    raise EStrError('wchar index out of bounds: {}', [index])
#else
    StrfRuntimeError('wchar index out of bounds')
#endif
endfunc

function StrfClampIndex(index : int, length : int) -> int:
    if index <= 0:
        return 0
    elif index >= length:
        return length
    else:
        return index
    endif
endfunc

function StrfWCharSlice(text : strview, startpos : int, endposex : int) -> [*]wchar:
    result = []
    var wclen : int = StrfWcLen(text)
    var b : int = StrfClampIndex(startpos, wclen)
    var e : int = StrfClampIndex(endposex, wclen)
    if e < b:
        e = b
    endif

    var pos : int = 0
    var wcidx : int = 0
    var wc : wchar = wchar(0)
    while StrfDecodeUtf8(text, pos, wc):
        if wcidx >= b and wcidx < e:
            result.Append(wc)
        endif
        wcidx += 1
    endwhile
endfunc

#ifdef DYNSTRINGS
function StrfWcStrSlice(text : strview, startpos : int, endposex : int) -> str:
    var wchars : [*]wchar = StrfWCharSlice(text, startpos, endposex)
    return StrfFromWchars(wchars[:])
endfunc
#endif

function StrfToWchars(text : strview) -> [*]wchar:
    result = []
    var pos : int = 0
    var wc : wchar = wchar(0)
    while StrfDecodeUtf8(text, pos, wc):
        result.Append(wc)
    endwhile
endfunc

#ifdef DYNSTRINGS
function StrfFromWchars(chars : []wchar) -> str:
    result = ''
    var i : int = 0
    while i < chars.length:
        StrfAppendUtf8(result, chars[i])
        i += 1
    endwhile
endfunc
#endif

function StrfToUtf16(text : strview) -> [*]char16:
    result = []
    var pos : int = 0
    var wc : wchar = wchar(0)
    while StrfDecodeUtf8(text, pos, wc):
        StrfAppendUtf16(result, wc)
    endwhile
    result.Append(char16(0))
endfunc

function StrfDecodeUtf16At(chars : ^char16, count : int, pos : ref int, wc : refout wchar,
                           fallback_wchar : wchar, has_fallback : bool) -> bool:
    if pos >= count:
        return false
    endif

    var u0 : uint32 = uint32(Ord(chars[pos]^))
    pos += 1
    if StrfIsHighSurrogate(u0):
        if pos >= count:
            if has_fallback:
                if fallback_wchar <> wchar(0):
                    wc = fallback_wchar
                    return true
                endif
                return StrfDecodeUtf16At(chars, count, pos, wc, fallback_wchar, has_fallback)
            endif

            StrfRuntimeError('Invalid UTF-16')
            return false
        endif

        var u1 : uint32 = uint32(Ord(chars[pos]^))
        if not StrfIsLowSurrogate(u1):
            if has_fallback:
                if fallback_wchar <> wchar(0):
                    wc = fallback_wchar
                    return true
                endif
                return StrfDecodeUtf16At(chars, count, pos, wc, fallback_wchar, has_fallback)
            endif
            StrfRuntimeError('Invalid UTF-16')
            return false
        endif

        pos += 1
        wc = wchar(int(uint32(0x10000) + ((u0 - uint32(0xD800)) << 10) + (u1 - uint32(0xDC00))))
        return true
    elif StrfIsLowSurrogate(u0):
        if has_fallback:
            if fallback_wchar <> wchar(0):
                wc = fallback_wchar
                return true
            endif
            return StrfDecodeUtf16At(chars, count, pos, wc, fallback_wchar, has_fallback)
        endif
        StrfRuntimeError('Invalid UTF-16')
        return false
    else:
        wc = wchar(int(u0))
        return true
    endif
endfunc

#ifdef DYNSTRINGS
function StrfFromUtf16PtrImpl(chars : ^char16, count : int, fallback_wchar : wchar, has_fallback : bool) -> str:
    result = ''
    if chars == nil or count <= 0:
        return ''
    endif

    var pos : int = 0
    var wc : wchar = wchar(0)
    while StrfDecodeUtf16At(chars, count, pos, wc, fallback_wchar, has_fallback):
        StrfAppendUtf8(result, wc)
    endwhile
endfunc
#endif

function StrfUtf16SliceCount(chars : []char16) -> int:
    result = chars.length
    if result > 0 and chars[result - 1] == char16(0):
        result -= 1
    endif
endfunc

#ifdef DYNSTRINGS
function StrfFromUtf16(chars : []char16) -> str:
    if chars.length == 0:
        return ''
    endif
    return StrfFromUtf16PtrImpl(%chars[0], StrfUtf16SliceCount(chars), wchar(0), false)
endfunc

function StrfFromUtf16Fallback(chars : []char16, fallback_wchar : wchar) -> str:
    if chars.length == 0:
        return ''
    endif
    return StrfFromUtf16PtrImpl(%chars[0], StrfUtf16SliceCount(chars), fallback_wchar, true)
endfunc

function StrfFromUtf16Ptr(chars : ^char16, count : int) -> str:
    return StrfFromUtf16PtrImpl(chars, count, wchar(0), false)
endfunc

function StrfFromUtf16PtrFallback(chars : ^char16, count : int, fallback_wchar : wchar) -> str:
    return StrfFromUtf16PtrImpl(chars, count, fallback_wchar, true)
endfunc
#endif
