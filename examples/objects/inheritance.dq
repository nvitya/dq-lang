use libc/stdio

object OBase:
    cnt1 : int = 0
    cnt2 : int = 10
    name : cstring[32]

    func *Create(aname : cstring):  // constructor
        name = aname
    endfunc

    func *Destroy():
        @.printf("%s destroy\n", %name[0])
    endfunc

    func Count() [[virtual]]:
        cnt1 += 1
    endfunc

    func Print():
        @.printf('%s: cnt1=%d, cnt2=%d\n', %name[0], cnt1, cnt2)
    endfunc
endobject

object OChild(OBase):
    func Count() [[override]]:
        inherited
        cnt2 += 1
    endfunc
endobject

var obase   <- OBase('OBase')     // '<-' = embedded allocation
var ochild  : OChild = nil

func *Main() -> int:
    printf('Object Inheritance Test\n')

    ochild = new OChild('OChild')

    printf('SizeOf(OBase) = %d\n', SizeOf(OBase))

    obase.Count()
    ochild.Count()

    obase.Print()
    ochild.Print()

    delete ochild

    return 0
endfunc