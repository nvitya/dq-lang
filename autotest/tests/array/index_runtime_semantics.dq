// Invalid indices are accepted at compile time. Dynamic arrays check them at
// runtime; fixed arrays and slices omit checks. Leave these accesses uncalled.

use libc/stdio

func StaticOutOfBoundsExpressions() -> int:
    var arr : [?]int = [10, 20, 30, 40, 50]
    var value : int = 0
    value += arr[-1]
    value += arr[5]
    value += arr[$end]
    result = value
endfunc

func DynamicOutOfBoundsExpressions() -> int:
    var arr : [*]int = [10, 20, 30]
    var value : int = 0
    value += arr[-1]
    value += arr[3]
    value += arr[$end]
    result = value
endfunc

func SliceOutOfBoundsExpressions() -> int:
    var base : [?]int = [10, 20, 30]
    var arr : []int = base[1:2]
    var value : int = 0
    value += arr[-1]
    value += arr[1]
    value += arr[$end]
    result = value
endfunc

func *Main():
    printf("array_index_runtime_semantics = compiled\n") //?check("array_index_runtime_semantics", "compiled")
endfunc
