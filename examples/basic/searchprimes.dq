use libc/stdio

var prcnt : int = 1
var prarr : [*]int

func IsPrime(num : int) -> bool:
    var i : int = 2
    while i * i <= num:
        if num mod i == 0:
            return false
        endif
        i += 1
    endwhile
    return true
endfunc

func IsPrimeArr(num : int) -> bool:
    var idx : int = 0
    var i : int
    while idx < Len(prarr):
        i = prarr[idx]
        if num mod prarr[idx] == 0:
            return false
        endif

    if i * i > num:
        return true
    endif
    idx += 1
    endwhile
    return true
endfunc


func *Main() -> int:
    printf('DQ Prime Search\n')

    var limit : int = 100

    printf('Counting primes to %d...\n', limit)

    var num   : int = 3

    prarr.Clear()
    prarr.Append(2)

    while num < limit:
        if IsPrime(num):
            prarr.Append(num)
        endif
        //if num
        num += 2
    endwhile

    printf('Primes:\n')
    for i : int = 0 count Len(prarr):
        printf(' %d', prarr[i])
    endfor
    printf("\n")

    return 0
endfunc