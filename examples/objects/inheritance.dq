use print

object OBase:
    cnt1 : int = 0
    cnt2 : int = 10
    name : cstring(31)

    func *Create(aname : cstring):  // constructor
        name = aname
    endfunc

    func *Destroy():
        @.PrintLn('{} destroy', [name])
    endfunc

    func Count() [[virtual]]:
        cnt1 += 1
    endfunc

    func Print():
        @.PrintLn('{}: cnt1={}, cnt2={}', [name, cnt1, cnt2])
    endfunc
endobject

object OChild(OBase):
    func Count() [[override]]:
        inherited
        cnt2 += 1
    endfunc
endobject

var obase   <- OBase('OBase')     // '<-' = embedded allocation
var ochild  : OChild = nil

func *Main():
    PrintLn('Object Inheritance Test')

    ochild = new OChild('OChild')

    PrintLn('SizeOf(OBase) = {}', [SizeOf(OBase)])

    obase.Count()
    ochild.Count()

    obase.Print()
    ochild.Print()

    delete ochild
endfunc