#ifndef COMPARG_FIRST
var missing_first_compiler_argument : OMissingCompilerArgument
#endif

#ifndef COMPARG_SECOND
var missing_second_compiler_argument : OMissingCompilerArgument
#endif

function BuildOnlyValue() -> int:
    return 42
endfunc
