func UnknownHint(value : int) [[inline, asm]]:
    nop
    [[mystery(value)]] //?error(AsmHintUnknown)
endfunc

func UnknownOperand(value : int) [[inline, asm]]:
    nop
    [[immediate(other)]] //?error(AsmOperandUnknown)
endfunc

func ConflictingOperand(value : int) [[inline, asm]]:
    nop
    [[immediate(value), memread(value)]] //?error(AsmOperandConflict)
endfunc

func DuplicateOperand(value : int) [[inline, asm]]:
    nop
    [[immediate(value, value)]] //?error(AsmOperandConflict)
endfunc

func InvalidClauseArgument(value : int) [[inline, asm]]:
    nop
    [[immediate(1)]] //?error(AsmHintSyntax)
endfunc

func EmptyClause(value : int) [[inline, asm]]:
    nop
    [[clobber()]] //?error(AsmHintSyntax)
endfunc

func EmptyHintList(value : int) [[inline, asm]]:
    nop
    [[]] //?error(AsmHintSyntax)
endfunc

func TrailingHintComma(value : int) [[inline, asm]]:
    nop
    [[immediate(value),]] //?error(AsmHintSyntax)
endfunc

func DuplicateHintList(value : int) [[inline, asm]]:
    nop
    [[immediate(value)]]
    [[clobber(flags)]] //?error(AsmHintSyntax)
endfunc

func TextAfterHints(value : int) [[inline, asm]]:
    nop
    [[immediate(value)]]
    nop //?error(AsmHintSyntax)
endfunc
