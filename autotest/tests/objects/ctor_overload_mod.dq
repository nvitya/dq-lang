//?notest

object OImportedStrCtor:
    text : str
    tag  : int

    func *Create(atext : str) [[overload]]:
        text = atext
        tag = 1
    endfunc

    func *Create(atext : str, atag : int) [[overload]]:
        text = atext
        tag = atag
    endfunc

    func Len() -> int:
        return text.length
    endfunc

    func Tag() -> int:
        return tag
    endfunc
endobject
