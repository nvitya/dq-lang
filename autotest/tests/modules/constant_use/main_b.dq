use hwapi/uart
use libc/stdio
func *Main():
    var uart <- OHwUart()
    printf("selected = %d\n", uart.Value()) //?check('selected', 29)
    printf("reexport = %d\n", PLATFORM_VALUE) //?check('reexport', 29)
endfunc
