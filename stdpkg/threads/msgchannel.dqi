
func OMsgChannel.Put(amsg : SChMsg) -> bool
:
    if locking:
        m_lockvar.Lock()
    endif
    result = false
    var newidx : uint32 = (idx_put + 1) rem m_len
    if newidx <> idx_get: // queue is not full ?
        msgs[idx_put] = amsg
        idx_put = newidx
        result = true
    endif
    if locking:
        m_lockvar.Unlock()
    endif
    if result:
        get_event.Signal()
    endif
endfunc

func OMsgChannel.Get(rmsg : refout SChMsg) -> bool
:
    if locking:
        m_lockvar.Lock()
    endif
    result = false
    if idx_get <> idx_put:  // queue is not empty ?
        rmsg = msgs[idx_get]
        idx_get = (idx_get + 1) rem m_len
        result = true
    endif
    if locking:
        m_lockvar.Unlock()
    endif
    if result:
        put_event.Signal()
    endif
endfunc

func OMsgChannel.PutWaitMillis(amsg : SChMsg, atimeoutms : int) -> bool
:
    if atimeoutms == 0:
        return Put(amsg)
    endif
    var deadline : int64 = WaitDeadline(atimeoutms)
    result = false
    while true:
        // Snapshot before testing the queue, so a concurrent Get cannot be missed.
        var sequence : uint32 = put_event.Snapshot()
        if Put(amsg):
            return true
        endif
        if not put_event.WaitUntilNanos(sequence, deadline):
            return false
        endif
    endwhile
endfunc

func OMsgChannel.GetWaitMillis(rmsg : refout SChMsg, atimeoutms : int) -> bool
:
    if atimeoutms == 0:
        return Get(rmsg)
    endif
    var deadline : int64 = WaitDeadline(atimeoutms)
    result = false
    while true:
        var sequence : uint32 = get_event.Snapshot()
        if Get(rmsg):
            return true
        endif
        if not get_event.WaitUntilNanos(sequence, deadline):
            return false
        endif
    endwhile
endfunc

func OMsgChannel.WaitDeadline(atimeoutms : int) -> int64:
    if atimeoutms < 0:
        return -1
    endif
    var now : int64 = @time.NanoTime()
    var timeout_ms : int64 = atimeoutms
    // Saturate very large timeouts rather than overflowing the absolute deadline.
    if timeout_ms > (0x7FFFFFFFFFFFFFFF - now) div 1000000:
        return 0x7FFFFFFFFFFFFFFF
    endif
    return now + timeout_ms * 1000000
endfunc

