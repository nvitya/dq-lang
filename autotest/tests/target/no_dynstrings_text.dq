//?notest
// Text operations must remain available when dynamic strings are disabled.

func TextLength(text : strslice) -> int:
    var slice : strslice = text[0:text.length]
    var first : wchar = slice.wchar[0]
    return slice.wclen + Ord(first)
endfunc

func FormatText() -> int:
    var text : embstr(16) = "value="
    text.AddFmt("{}", [42])
    var view : strslice = text
    var value : anyvalue = text
    var copied : strslice = value.AsText("")
    return view.length + copied.length + text.wclen + Ord(text.wchar[$last])
endfunc

func ParseText() -> int64:
    var good : rostr = "42"
    var bad : rostr = "bad"
    return good.ToInt() + bad.ToInt(7)
endfunc

func ParseFloat() -> float:
    var good : rostr = "1.25e2"
    var bad : rostr = "bad"
    return good.ToFloat() + bad.ToFloat(7)
endfunc

func CompareText(a : rostr, b : embstr) -> bool:
    var view : strslice = a
    return a < b and b >= view and StrSliceCmp(a, b) <= 0
endfunc

func EmbeddedTextLength(text : embstr) -> int:
    return text.wclen + Ord(text.wchar[$last])
endfunc

func DecodeText(text : embstr) -> int:
    var view : strslice = text
    var readonly : rostr = text
    var fixed : embstr(16) = text
    var from_alias : [*]wchar = text.ToWchars()
    var from_view : [*]wchar = view.ToWchars()
    var from_readonly : [*]wchar = readonly.ToWchars()
    var from_fixed : [*]wchar = fixed.ToWchars()
    return from_alias.length + from_view.length + from_readonly.length + from_fixed.length
endfunc

func ParseBorrowed(a : rostr, b : strslice, c : embstr) -> float:
    var fixed : embstr(16) = "12"
    return a.ToInt() + b.ToInt(3) + c.ToFloat() + fixed.ToFloat(4)
endfunc
