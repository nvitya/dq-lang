use print
use ./langdemo_mod as ldm  only(CONST1)  // only(), exclude() and "--" control global scope merging

#if false

//Contents of the "langdemo_mod.?"

const CONST1 : int = 42
const CONST2 : float = 3.14

#endif

object OBase:
protected
    cnt1 : int = 0
    cnt2 : int = 10

public
    name : embstr(32)

    func *Create(aname : embstr):  // constructor
        name = aname
    endfunc

    func *Destroy():
        @.PrintLn("{} destroy", [name])
    endfunc

    func Count() [[virtual]]:
        ++cnt1
    endfunc

    func Print():
        // The object method value-symbol scope is restricted to object members
        // "@." (or "use *") is required to access the globals:
        @.PrintLn('{}: cnt1={}, cnt2={}', [name, cnt1, cnt2])
    endfunc
endobject

object OChild(OBase):
    func Count() [[override]]:
        inherited
        ++cnt2
    endfunc
endobject

var obase   <- OBase('OBase')     // '<-' = embedded allocation (global data segment here)
                                   // no automatic destructor call for global embedded objects
func ObjTest():
    PrintLn('Object Test Begin')
    var ochild = new autofree OChild('OChild')

    obase.Count()
    ochild.Count()

    obase.Print()
    ochild.Print()

    PrintLn('ochild.name: {}', [iif(ochild == nil, "ochild == nil!", ochild.name)])

    ochild = new OChild('OChild2') // ochild is autofree type, previous object is destroyed !

    PrintLn('ochild.name: {}', [iif(ochild == nil, "ochild == nil!", ochild.name)])

    if true:
        var embobj <- OChild('EmbChild') // allocated on stack
        embobj.Print()
        // destructor will be called automatically
    endif

    if true:
        var heapobj = new autofree OChild('HeapObj') // allocated on stack
        heapobj.Print()
        // heapobj will be freed automatically
    endif

    PrintLn('Object Test End')
    // OChild2 is automatically destroyed here
endfunc

func ExceptionTest():
    var pint : ^int = nil
    try:
        pint^ = 1234 // causes an exception !
        //raise Exception('Forced exception test')
    except Exception as e:
        PrintLn('EXCEPTION: {}', [e.message])
        e.PrintBacktrace()  // print stack trace with line infos
    endtry
endfunc

func *Main():

    var s : embstr(128) = ""  // embstr(n) is a fixed maximal storage string without heap usage
                              // the storage for this string is allocated on the stack (128 bytes)
                              // zero character terminated
    s.Clear()
    s.Add('Hello')
    s.AddFmt(" {} {}, pi={}", ['World', "!", 3.14])
    PrintLn(s)

    if 3 / 2 == 1.5:
        PrintLn('3 / 2 == 1.5')
    else:
        PrintLn('unfriendly division handling!')
    endif

    if uint32(3) - uint32(5) < 0:
        PrintLn('substraction result is always signed')
    else:
        PrintLn('unfiendly unsigned handling!')
    endif

    if 3 div 2 * 10 == 10 * 3 div 2:
        PrintLn('multiplications and divisons have different precedence.')
    else:
        PrintLn('div and * have the same precedence!')
    endif


    var x : int = 0xBEEF;
    x &= ~(0xF0F0)
    PrintLn('Bitwise op result: 0x{:04X}', [x])

    ref xref = x
    xref = 5
    PrintLn('x (by ref) = {}', [x])
    var xp :? = %x  // ? is for type inference
    xp^ = 42
    PrintLn('x (by ptr) = {}', [x])


    PrintLn("@langdemo_mod.CONST1 = {}", [CONST1])
    PrintLn("@langdemo_mod.CONST2 = {:.3f}", [@ldm.CONST2])  // CONST2 is not merged into the main scope,
                                                             // must be accessed with namespace qualification (@ldm.)

    var ds : str = 'This is a'
    ds.Add(' dynamic string.')
    var dpos : int = ds.IndexOf('dynamic')
    PrintLn('ds = "{}", dynamic pos = {}', [ds, dpos])
    ds.Insert(dpos, 'heap allocated ')
    PrintLn('ds = "{}", ds[3:6]="{}", ds[:4]="{}"', [ds, ds[2:6], ds[:4]])
    var ss : strslice = ds[$end - 5:]  // strslice is a borrowed string data pointer with length, without zero terminator
                                       // the user is responsible not to invalidate (free or reallocate) the original
                                       // during its strslice-es are used, recommended for function arguments
    PrintLn('ds[$end-5:] = "{}"', [ ss ])

    ObjTest()

    ExceptionTest()

    PrintLn('for .. to/count: ')
    for i : int = 0 to 5:
        Print(' {}:', [i])
        for j : int = 0  count i  step 2:
            Print(' {}', [j])
        endfor
        PrintLn()
    endfor

    var arr : [?]int = [2, 3, 5, 7, 11]
    Print('for .. while: ')
    for i : int = 0  while i < arr.length:
        Print(' {}', [ arr[i] ])
    endfor
    PrintLn()

    Print('for .. in: ')
    for v :? in arr:
        Print(' {}', [ v ])
    endfor
    PrintLn()

endfunc

/* OUTPUT:

Hello World !, pi=3.14
3 / 2 == 1.5
substraction result is always signed
multiplications and divisons have different precedence.
Bitwise op result: 0x0E0F
x (by ref) = 5
x (by ptr) = 42
@langdemo_mod.CONST1 = 42
@langdemo_mod.CONST2 = 3.140
ds = "This is a dynamic string.", dynamic pos = 10
ds = "This is a heap allocated dynamic string.", ds[3:6]="is i", ds[:4]="This"
ds[$end-5:] = "ring."
Object Test Begin
OBase: cnt1=1, cnt2=10
OChild: cnt1=1, cnt2=11
ochild.name: OChild
OChild destroy
ochild.name: OChild2
EmbChild: cnt1=0, cnt2=10
EmbChild destroy
HeapObj: cnt1=0, cnt2=10
HeapObj destroy
Object Test End
OChild2 destroy
for .. to/count:
 0:
 1: 0
 2: 0 2
 3: 0 2 4
 4: 0 2 4 6
 5: 0 2 4 6 8
for .. while:  2 3 5 7 11
for .. in:  2 3 5 7 11
*/
