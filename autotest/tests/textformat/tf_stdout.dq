use rtl/textformat
use print

func *Main():
    var outs <- OTextSinkStdOut()
    var fmt  <- OTextFormatter(outs)

    fmt.Format('tf-int = {}|{:d}|{:+d}|{:05d}|[{:5d}]|[{:<5d}]\n',
               [42, -17, 17, -17, 17, 17]) //?check('tf-int', '42|-17|+17|-0017|[   17]|[17   ]')

    fmt.Format('tf-uint = {:u}|{:04u}|[{:<4u}]\n',
               [uint(123), uint(7), uint(7)]) //?check('tf-uint', '123|0007|[7   ]')

    fmt.Format('tf-hex = {:x}|{:X}|{:08X}|[{:<6x}]\n',
               [0xC0DE, 0xC0DE, 0x2A, 0x2A]) //?check('tf-hex', 'c0de|C0DE|0000002A|[2a    ]')

    fmt.Format('tf-float = {}|{:.2f}|{:+08.2f}|[{:<8.0f}]\n',
               [3.14, 1.995, 3.5, 3.5]) //?check('tf-float', '3.14|2.00|+0003.50|[4       ]')

    var fa : [4]float = [1, 2, 3, 42]
    fmt.Format('tf-float-default = |{}|{}|{}|{}|\n',
               [fa[0], fa[1], fa[2], fa[3]]) //?check('tf-float-default', '|1|2|3|42|')

    PrintLn('wchar="{}"', [wchar(0x20AC)]) //?check('wchar', '"€"')
    fmt.Format('tf-char = {}|{:s}|{}|{}|{}\n',
               [char(65), char(66), wchar(0xA2), wchar(0x20AC), wchar(0x1F600)]) //?check('tf-char', 'A|B|¢|€|😀')
    fmt.Format('tf-char16 = {}|{:s}\n', [char16(0x20AC), wchar(0x1F600)]) //?check('tf-char16', '€|😀')
    fmt.Format('tf-char-bytes = {}{}\n', [char(0xC3), char(0xA9)]) //?check('tf-char-bytes', 'é')
    fmt.Format('tf-char-numeric = {:d}|{:u}|{:x}|{:X}\n',
               [char(255), wchar(0x20AC), char16(0x20AC), wchar(0x1F600)]) //?check('tf-char-numeric', '255|8364|20ac|1F600')

    var invalid : int = 0x110000
    fmt.Format('tf-invalid-wchar = {}|{}\n', [char16(0xD800), wchar(invalid)]) //?check('tf-invalid-wchar', '�|�')
    PrintLn('tf-invalid-flags = {}', [fmt.flags == DQFMT_ARG_ERROR]) //?check('tf-invalid-flags', 'true')

    var text : embstr(32) = ''
    text.AddFmt('{}|{}|{}', [char(65), wchar(0x20AC), wchar(0x1F600)])
    PrintLn('tf-embstr-char = {}', [text]) //?check('tf-embstr-char', 'A|€|😀')
#ifdef DYNSTRINGS
    var dynamic_text : str = ''
    dynamic_text.AddFmt('{}|{}', [wchar(0x20AC), wchar(0x1F600)])
    PrintLn('tf-str-char = {}', [dynamic_text]) //?check('tf-str-char', '€|😀')
#endif

    text.Clear()
    text.AddFmt('{}{}{}', [char(0), wchar(0), wchar(0x7F)])
    PrintLn('tf-char-zero = {} {} {} {}', [text.length, Ord(text[0]), Ord(text[1]), Ord(text[2])]) //?check('tf-char-zero', '3 0 0 127')
endfunc
