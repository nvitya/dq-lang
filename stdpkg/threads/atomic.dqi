#ifdef WINDOWS
// llvm-mingw supplies these interlocked implementations in libkernel32.
// Full barriers provide at least the requested ordering, including relaxed loads.
func win_exchange_4(p : ^uint32, value : uint32) -> uint32 [[external('_InterlockedExchange')]] ..
func win_compare_4(p : ^uint32, value : uint32, compare : uint32) -> uint32 [[external('_InterlockedCompareExchange')]] ..
func win_add_4(p : ^uint32, value : uint32) -> uint32 [[external('_InterlockedExchangeAdd')]] ..

func atomic_exchange_4(p : ^uint32, value : uint32, order : int32) -> uint32:
    return win_exchange_4(p, value)
endfunc

func atomic_load_4(p : ^uint32, order : int32) -> uint32:
    return win_compare_4(p, 0, 0)
endfunc

func atomic_store_4(p : ^uint32, value : uint32, order : int32):
    win_exchange_4(p, value)
endfunc

func atomic_add_4(p : ^uint32, value : uint32, order : int32) -> uint32:
    return win_add_4(p, value)
endfunc

func win_exchange_8(p : ^uint64, value : uint64) -> uint64 [[external('_InterlockedExchange64')]] ..
func win_compare_8(p : ^uint64, value : uint64, compare : uint64) -> uint64 [[external('_InterlockedCompareExchange64')]] ..
func win_add_8(p : ^uint64, value : uint64) -> uint64 [[external('_InterlockedExchangeAdd64')]] ..

func atomic_exchange_8(p : ^uint64, value : uint64, order : int32) -> uint64:
    return win_exchange_8(p, value)
endfunc

func atomic_load_8(p : ^uint64, order : int32) -> uint64:
    return win_compare_8(p, 0, 0)
endfunc

func atomic_store_8(p : ^uint64, value : uint64, order : int32):
    win_exchange_8(p, value)
endfunc

func atomic_add_8(p : ^uint64, value : uint64, order : int32) -> uint64:
    return win_add_8(p, value)
endfunc

func win_exchange_ptr(p : ^pointer, value : pointer) -> pointer [[external('_InterlockedExchangePointer')]] ..
func win_compare_ptr(p : ^pointer, value : pointer, compare : pointer) -> pointer [[external('_InterlockedCompareExchangePointer')]] ..

func atomic_load_ptr(p : ^pointer, order : int32) -> pointer:
    return win_compare_ptr(p, nil, nil)
endfunc

func atomic_store_ptr(p : ^pointer, value : pointer, order : int32):
    win_exchange_ptr(p, value)
endfunc

func atomic_exchange_ptr(p : ^pointer, value : pointer, order : int32) -> pointer:
    return win_exchange_ptr(p, value)
endfunc

#endif

//-----------------------------------------------------------------------------

func OAtomicUint32.Add(avalue : uint32) -> uint32:
    result = @.atomic_add_4(%m_value, avalue, @.ATOMIC_SEQ_CST)
endfunc

func OAtomicUint32.AddRelaxed(avalue : uint32) -> uint32:
    result = @.atomic_add_4(%m_value, avalue, @.ATOMIC_RELAXED)
endfunc

func OAtomicUint32.Exchange(avalue : uint32) -> uint32:
    result = @.atomic_exchange_4(%m_value, avalue, @.ATOMIC_SEQ_CST)
endfunc

func OAtomicUint32.Load() -> uint32:
    result = @.atomic_load_4(%m_value, @.ATOMIC_SEQ_CST)
endfunc

func OAtomicUint32.LoadRelaxed() -> uint32:
    result = @.atomic_load_4(%m_value, @.ATOMIC_RELAXED)
endfunc

func OAtomicUint32.Store(avalue : uint32):
    @.atomic_store_4(%m_value, avalue, @.ATOMIC_SEQ_CST)
endfunc


func OAtomicUint64.Add(avalue : uint64) -> uint64:
    result = @.atomic_add_8(%m_value, avalue, @.ATOMIC_SEQ_CST)
endfunc

func OAtomicUint64.AddRelaxed(avalue : uint64) -> uint64:
    result = @.atomic_add_8(%m_value, avalue, @.ATOMIC_RELAXED)
endfunc

func OAtomicUint64.Exchange(avalue : uint64) -> uint64:
    result = @.atomic_exchange_8(%m_value, avalue, @.ATOMIC_SEQ_CST)
endfunc

func OAtomicUint64.Load() -> uint64:
    result = @.atomic_load_8(%m_value, @.ATOMIC_SEQ_CST)
endfunc

func OAtomicUint64.LoadRelaxed() -> uint64:
    result = @.atomic_load_8(%m_value, @.ATOMIC_RELAXED)
endfunc

func OAtomicUint64.Store(avalue : uint64):
    @.atomic_store_8(%m_value, avalue, @.ATOMIC_SEQ_CST)
endfunc


func OAtomicPtr.Exchange(avalue : pointer) -> pointer:
    result = @.atomic_exchange_ptr(%m_value, avalue, @.ATOMIC_SEQ_CST)
endfunc

func OAtomicPtr.Load() -> pointer:
    result = @.atomic_load_ptr(%m_value, @.ATOMIC_SEQ_CST)
endfunc

func OAtomicPtr.LoadRelaxed() -> pointer:
    result = @.atomic_load_ptr(%m_value, @.ATOMIC_RELAXED)
endfunc

func OAtomicPtr.Store(avalue : pointer):
    @.atomic_store_ptr(%m_value, avalue, @.ATOMIC_SEQ_CST)
endfunc
