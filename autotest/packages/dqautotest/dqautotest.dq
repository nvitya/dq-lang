// auto-test helper
use shell
use time
use file
use print
use strutils

object OTestRun:
    exitcode : int
    stdout   : str
    stderr   : str
    output   : str

    func RunTool(args : []str) -> int
    func RunCompiler(args : []str) -> int
    func ExpectExitCode(expected : int)
    func PrintRunOutput()
    func ExpectOutputContains(expected : strview)
    func ExpectOutputNotContains(unexpected : strview)

protected
    shrunner <- OShellRunner()
endobject

func CompilerPath() -> str
func BinPath(name : strview) -> str
func SourcePath(name : strview) -> str
func TestRootPath(name : strview) -> str
func TempPath() -> str  [[overload]]
func TempPath(suffix : strview) -> str  [[overload]]
func RemoveTemp(path : strview)

func ExpectContains(text : strview, expected : strview)
func ExpectNotContains(text : strview, unexpected : strview)
func ExpectFileContains(path : strview, expected : strview)
func ExpectFileNotContains(path : strview, unexpected : strview)
func Fail(message : strview)
func TestResult() -> int

implementation

func libc_getpid() -> int32 [[external('getpid')]]
func libc_unlink(path : ^char) -> int32 [[external('unlink')]]

var failure_count : int = 0
var temp_counter : int = 0

func JoinPath(base : strview, name : strview) -> str:
    result = base
    if result <> '' and result[result.length - 1] <> '/':
        result.Append('/')
    endif
    result.Append(name)
endfunc

func OTestRun.RunTool(args : []str) -> int:
    shrunner.Run(args, false)
    exitcode = shrunner.exitcode
    stdout = shrunner.out
    stderr = shrunner.err
    output = shrunner.output
    return exitcode
endfunc

func OTestRun.RunCompiler(args : []str) -> int:
    use *
    var command : [*]str = [CompilerPath()]
    for i : int = 0 count args.length:
        command.Append(args[i])
    endfor
    var buildroot : str = TempPath('.build')
    command.Append('--build-root')
    command.Append(buildroot)
    result = RunTool(command)
    shrunner.Run(['/bin/rm', '-rf', '--', buildroot], false)
endfunc

func OTestRun.ExpectExitCode(expected : int):
    use *
    if exitcode == expected:
        return
    endif
    Fail(Format('exit code {} != expected {}', [exitcode, expected]))
    if stdout <> '':
        PrintLn('stdout:\n{}', [stdout])
    endif
    if stderr <> '':
        PrintLn('stderr:\n{}', [stderr])
    endif
endfunc

func OTestRun.PrintRunOutput():
    use *
    if stdout <> '':
        PrintLn('stdout:\n{}', [stdout])
    endif
    if stderr <> '':
        PrintLn('stderr:\n{}', [stderr])
    endif
endfunc

func OTestRun.ExpectOutputContains(expected : strview):
    use *
    var previous : int = failure_count
    ExpectContains(output, expected)
    if failure_count <> previous:
        PrintRunOutput()
    endif
endfunc

func OTestRun.ExpectOutputNotContains(unexpected : strview):
    use *
    var previous : int = failure_count
    ExpectNotContains(output, unexpected)
    if failure_count <> previous:
        PrintRunOutput()
    endif
endfunc


func CompilerPath() -> str:
    return GetEnv('DQ_AUTOTEST_COMPILER', 'dq-comp')
endfunc

func BinPath(name : strview) -> str:
    return JoinPath(GetEnv('DQ_AUTOTEST_BINDIR', '.'), name)
endfunc

func SourcePath(name : strview) -> str:
    return JoinPath(GetEnv('DQ_AUTOTEST_TEST_DIR', '.'), name)
endfunc

func TestRootPath(name : strview) -> str:
    return JoinPath(GetEnv('DQ_AUTOTEST_TEST_ROOT', '.'), name)
endfunc

func TempPath() -> str  [[overload]]:
    return TempPath('')
endfunc

func TempPath(suffix : strview) -> str  [[overload]]:
    temp_counter += 1
    var tempdir : str = GetEnv('TMPDIR', '/tmp')
    result = JoinPath(tempdir, Format('dq-autotest-{}-{}-{}{}', [libc_getpid(), NanoTime(), temp_counter, suffix]))
endfunc

func RemoveTemp(path : strview):
    if path == '':
        return
    endif
    var cpath : str = path
    libc_unlink(cpath.pchar)
endfunc

func Fail(message : strview):
    failure_count += 1
    PrintLn('FAIL: {}', [message])
endfunc

func ExpectContains(text : strview, expected : strview):
    if StrIndexOf(text, expected) >= 0:
        return
    endif
    Fail(Format('expected text was not found: "{}"', [expected]))
endfunc

func ExpectNotContains(text : strview, unexpected : strview):
    if StrIndexOf(text, unexpected) < 0:
        return
    endif
    Fail(Format('unexpected text was found: "{}"', [unexpected]))
endfunc

func ExpectFileContains(path : strview, expected : strview):
    if not FileExists(path):
        Fail(Format('file does not exist: {}', [path]))
        return
    endif
    ExpectContains(FileReadText(path), expected)
endfunc

func ExpectFileNotContains(path : strview, unexpected : strview):
    if not FileExists(path):
        Fail(Format('file does not exist: {}', [path]))
        return
    endif
    ExpectNotContains(FileReadText(path), unexpected)
endfunc

func TestResult() -> int:
    return iif(failure_count == 0, 0, 1)
endfunc
