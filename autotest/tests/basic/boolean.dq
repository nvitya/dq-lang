// boolean tests

const GVBOOL0  : bool = false
const GVBOOL1  : bool = true
const BOOL_EQ : bool = (true == true) and (false == false) and not (true == false) and not (false == true)
const BOOL_NE : bool = (true <> false) and (false <> true) and not (true <> true) and not (false <> false)
const BOOL_NESTED : bool = (GVBOOL0 == false) == (GVBOOL1 <> false)

type TBool = bool

var g_bool : bool = GVBOOL1 or GVBOOL0

#ifdef ERRORTEST

#else

func printf(fmt : ^char, ...) -> int  [[external]] ..

func printbool(astr : ^char, abool : bool):
    printf("%s = ", astr)
    if abool:
        printf("true")
    else:
        printf("false")
    endif
    printf("\n")
endfunc

var g_short_circuit_hits : int = 0

func CountedTrue() -> bool:
    g_short_circuit_hits += 1
    result = true
endfunc

object OOpenedProbe:
    func Opened() -> bool:
        @.g_short_circuit_hits += 1
        result = true
    endfunc
endobject

func *Main():
    printf("DQ bool test\n")  //?ignore('DQ bool test')

    printbool("GVBOOL0", GVBOOL0)  //?check(GVBOOL0, false)
    printbool("GVBOOL1", GVBOOL1)  //?check(GVBOOL1, true)
    printbool("g_bool", g_bool)    //?check(g_bool, true)

    var b0 : bool = false
    var b1 : bool = true
    var bexpr : bool

    var ready : bool = true
    var same : bool = ready == true
    printbool("ready equality", same) //?check('ready equality', true)
    printbool("constant equality", BOOL_EQ) //?check('constant equality', true)
    printbool("constant inequality", BOOL_NE) //?check('constant inequality', true)
    printbool("nested constant equality", BOOL_NESTED) //?check('nested constant equality', true)
    printf("equality truth table = %d,%d,%d,%d\n", b0 == b0, b0 == b1, b1 == b0, b1 == b1)
    //?check('equality truth table', '1,0,0,1')
    printf("inequality truth table = %d,%d,%d,%d\n", b0 <> b0, b0 <> b1, b1 <> b0, b1 <> b1)
    //?check('inequality truth table', '0,1,1,0')
    var alias_bool : TBool = true
    printbool("bool alias equality", alias_bool == b1) //?check('bool alias equality', true)
    printbool("bool alias not", not alias_bool) //?check('bool alias not', false)
    printbool("bool alias logic", alias_bool and b1 or b0) //?check('bool alias logic', true)
    printbool("not comparison", not b0 == b1) //?check('not comparison', true)
    printbool("double not", not not b1) //?check('double not', true)

    g_short_circuit_hits = 0
    printbool("call equality", CountedTrue() == CountedTrue()) //?check('call equality', true)
    printf("call equality hits = %li\n", g_short_circuit_hits) //?check('call equality hits', 2)

    printbool("not false", not b0)    //?check('not false', true)

    printbool("false or false", b0 or b0)  //?check('false or false', false)
    printbool("true or true", b1 or b1)    //?check('true or true', true)
    printbool("true or false", b1 or b0)   //?check('true or false', true)

    printbool("false or not false", b0 or not b0)  //?check('false or not false', true)
    printbool("false and not false", b0 and not b0)  //?check('false and not false', false)

    bexpr = b0  or b1 and not b1
    printbool("bexpr1", bexpr)  //?check('bexpr1', false)

    g_short_circuit_hits = 0
    printbool("false and CountedTrue", false and CountedTrue())  //?check('false and CountedTrue', false)
    printf("false and CountedTrue hits = %li\n", g_short_circuit_hits)  //?check('false and CountedTrue hits', 0)

    g_short_circuit_hits = 0
    printbool("true or CountedTrue", true or CountedTrue())  //?check('true or CountedTrue', true)
    printf("true or CountedTrue hits = %li\n", g_short_circuit_hits)  //?check('true or CountedTrue hits', 0)

    var probe : OOpenedProbe = nil
    g_short_circuit_hits = 0
    printbool("nil probe and Opened", probe <> nil and probe.Opened())  //?check('nil probe and Opened', false)
    printf("nil probe and Opened hits = %li\n", g_short_circuit_hits)  //?check('nil probe and Opened hits', 0)

endfunc

#endif
