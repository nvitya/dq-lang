// object func reference tests

use libc/stdio

type FObjText = func(msg : cstring) of object
type FObjInt = func(v : int) of object
type FPlainText = func(msg : cstring)

func plain(msg : cstring):
    printf("plain = %s\n", %msg[0])
endfunc

object OCallback:
    name : cstring(32)

    func *Create(aname : cstring):
        name = aname
    endfunc

    func Print(msg : cstring):
        @.printf("%s = %s\n", %name, %msg[0])
    endfunc

    func Pick(msg : cstring) [[overload]]:
        @.printf("%s.picked = %s\n", %name, %msg[0])
    endfunc

    func Pick(v : int) [[overload]]:
        @.printf("%s.picked = %d\n", %name, v)
    endfunc
endobject

func *Main() -> int:
    var first <- OCallback("first")
    var second <- OCallback("second")
    var cb : FObjText = nil
    var icb : FObjInt = nil
    var plaincb : FPlainText = plain

    if cb == nil:
        printf("cb = nil\n")  //?check('cb', 'nil')
    endif

    cb = first.Print
    if cb <> nil:
        cb("a")  //?check('first', 'a')
    endif

    cb = second.Print
    cb("b")  //?check('second', 'b')

    cb = first.Pick
    cb("c")  //?check('first.picked', 'c')

    icb = second.Pick
    icb(5)  //?check('second.picked', 5)

    plaincb("ok")  //?check('plain', 'ok')
    return 0
endfunc
