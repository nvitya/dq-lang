use libc/stdio

type FObjAction = func() of object

object CBase:
    func HandleInput() [[virtual]]:
        @.printf("CBase.HandleInput = ok\n")
    endfunc
endobject

object CDeriv(CBase):
    func HandleInput() [[override]]:
        @.printf("CDeriv.HandleInput = ok\n")
    endfunc
endobject

func Invoke(cb : FObjAction):
    cb()
endfunc

func *Main() -> int:
    var obj : CBase = new CDeriv()
    var cb : FObjAction = obj.HandleInput
    Invoke(cb)  //?check('CDeriv.HandleInput', 'ok')
    return 0
endfunc
