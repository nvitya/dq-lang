#linklib('dbghelp')

function DqCaptureBacktraceImpl(backtrace : pointer, max_frames : int) -> int
function DqPrintBacktraceFrameImpl(index : int, pc : pointer, hide_internal : bool, stop_printing : ^bool) -> bool
function DqPrepareBacktraceImpl()

implementation

use rtl/rtlint
use libc/stdio

function DqCstrContains(text : ^char, needle : ^char) -> bool
function DqCstrSegmentEq(text : ^char, name : ^char) -> bool
function DqBacktraceNameIsInternal(name : ^char) -> bool
function DqIsMainFunction(name : ^char) -> bool

const DQ_BT_SYMBOL_INFO_SIZE : uint32 = 88
const DQ_BT_LINE_INFO_SIZE   : uint32 = 40
const DQ_BT_SYMBOL_NAME_MAX  : uint32 = 256
const DQ_BT_EXE_PATH_MAX     : int = 1024
const DQ_COFF_SYMBOL_SIZE    : uint = 18
const DQ_COFF_TYPE_FUNCTION  : uint16 = 0x20
const SYMOPT_UNDNAME         : uint32 = 0x00000002
const SYMOPT_DEFERRED_LOADS  : uint32 = 0x00000004
const SYMOPT_LOAD_LINES      : uint32 = 0x00000010
const SEEK_END               : int = 2
const SEEK_SET               : int = 0

const DW_LNS_COPY              : uint8 = 1
const DW_LNS_ADVANCE_PC        : uint8 = 2
const DW_LNS_ADVANCE_LINE      : uint8 = 3
const DW_LNS_SET_FILE          : uint8 = 4
const DW_LNS_SET_COLUMN        : uint8 = 5
const DW_LNS_NEGATE_STMT       : uint8 = 6
const DW_LNS_SET_BASIC_BLOCK   : uint8 = 7
const DW_LNS_CONST_ADD_PC      : uint8 = 8
const DW_LNS_FIXED_ADVANCE_PC  : uint8 = 9
const DW_LNS_SET_PROLOGUE_END  : uint8 = 10
const DW_LNS_SET_EPILOGUE_BEGIN : uint8 = 11
const DW_LNS_SET_ISA           : uint8 = 12

const DW_LNE_END_SEQUENCE : uint8 = 1
const DW_LNE_SET_ADDRESS  : uint8 = 2
const DW_LNE_DEFINE_FILE  : uint8 = 3

struct SDqWinSymbolInfo:
    SizeOfStruct : uint32
    TypeIndex    : uint32
    Reserved     : [2]uint64
    Index        : uint32
    Size         : uint32
    ModBase      : uint64
    Flags        : uint32
    Value        : uint64
    Address      : uint64
    Register     : uint32
    Scope        : uint32
    Tag          : uint32
    NameLen      : uint32
    MaxNameLen   : uint32
    Name         : [DQ_BT_SYMBOL_NAME_MAX]char
endstruct

struct SDqWinLineInfo:
    SizeOfStruct : uint32
    Key          : pointer
    LineNumber   : uint32
    FileName     : ^char
    Address      : uint64
endstruct

struct SDqWinDwarfInfo:
    loaded       : bool
    image_base   : uint64
    runtime_base : uint64
    data         : pointer
    data_size    : uint
    debug_line   : ^byte
    debug_size   : uint
    sections      : ^byte
    section_count : int
    symbols       : ^byte
    symbol_count  : uint
    string_table  : ^byte
    string_size   : uint
endstruct

function win_RtlCaptureStackBackTrace(frames_to_skip : uint32, frames_to_capture : uint32,
                                      backtrace : pointer, backtrace_hash : ^uint32) -> uint16 [[external('RtlCaptureStackBackTrace')]]
function win_GetCurrentProcess() -> pointer [[external('GetCurrentProcess')]]
function win_GetCurrentModule(module_name : ^char) -> pointer [[external('GetModuleHandleA')]]
function win_GetModuleFileName(module : pointer, filename : ^char, size : uint32) -> uint32 [[external('GetModuleFileNameA')]]
function win_SymSetOptions(options : uint32) -> uint32 [[external('SymSetOptions')]]
function win_SymInitialize(process : pointer, search_path : ^char, invade_process : int32) -> int32 [[external('SymInitialize')]]
function win_SymFromAddr(process : pointer, address : uint64, displacement : ^uint64, symbol : ^SDqWinSymbolInfo) -> int32 [[external('SymFromAddr')]]
function win_SymGetLineFromAddr64(process : pointer, address : uint64, displacement : ^uint32, line : ^SDqWinLineInfo) -> int32 [[external('SymGetLineFromAddr64')]]

function libc_fopen(filename : ^char, mode : ^char) -> pointer [[external('fopen')]]
function libc_fclose(stream : pointer) -> int [[external('fclose')]]
function libc_fseek(stream : pointer, offset : int, origin : int) -> int [[external('fseek')]]
function libc_ftell(stream : pointer) -> int [[external('ftell')]]
function libc_fread(ptr : pointer, size : uint, count : uint, stream : pointer) -> uint [[external('fread')]]
function libc_malloc(size : uint) -> pointer [[external('malloc')]]

function DqWinBacktraceProcess() -> pointer
function DqWinDwarfLineForPc(pc : pointer, file_name : refout ^char, line_no : refout uint32) -> bool
function DqWinDwarfLoad() -> bool
function DqWinCoffSymbolForPc(pc : pointer, name : ^char, name_size : uint,
                              displacement : refout uint64) -> bool

//-------------------------------------------------------------------------------------------------

function DqCaptureBacktraceImpl(backtrace : pointer, max_frames : int) -> int:
    result = int(win_RtlCaptureStackBackTrace(0, uint32(max_frames), backtrace, nil))
endfunc

function DqPrepareBacktraceImpl():
    // File loading and DbgHelp initialization are unsafe to defer until the
    // vectored exception handler is already processing an access violation.
    DqWinBacktraceProcess()
    DqWinDwarfLoad()
endfunc

function DqCstrContains(text : ^char, needle : ^char) -> bool:
    if text == nil or needle == nil:
        return false
    endif

    var p : ^char = text
    while p^ <> char(0):
        var t : ^char = p
        var n : ^char = needle
        while n^ <> char(0) and t^ == n^:
            t += 1
            n += 1
        endwhile
        if n^ == char(0):
            return true
        endif
        p += 1
    endwhile

    return false
endfunc

function DqBacktraceNameIsInternal(name : ^char) -> bool:
    return    DqCstrContains(name, "CaptureBacktrace")
           or DqCstrContains(name, "DqExcRaise")
           or DqCstrContains(name, "DqWinFaultHandler")
           or DqCstrContains(name, "libc_backtrace")
           or DqCstrContains(name, "RtlCaptureStackBackTrace")
endfunc

function DqIsMainFunction(name : ^char) -> bool:
    if name == nil:
        return false
    endif
    return    DqCstrSegmentEq(name, "Main")
           or DqCstrSegmentEq(name, "main")
           or DqCstrSegmentEq(name, "RunHostedMain")
endfunc

function DqCstrSegmentEq(text : ^char, name : ^char) -> bool:
    var t : ^char = text
    var n : ^char = name
    while n^ <> char(0):
        if t^ <> n^:
            return false
        endif
        t += 1
        n += 1
    endwhile
    return t^ == char(0)  or  t^ == char(124)
endfunc

var win_backtrace_process : pointer = nil
var win_backtrace_ready : bool = false
var win_dwarf : SDqWinDwarfInfo = {}

function DqWinBacktraceProcess() -> pointer:
    if win_backtrace_process == nil:
        win_backtrace_process = win_GetCurrentProcess()
        win_SymSetOptions(SYMOPT_UNDNAME | SYMOPT_DEFERRED_LOADS | SYMOPT_LOAD_LINES)
        win_backtrace_ready = (win_SymInitialize(win_backtrace_process, nil, 1) <> 0)
    endif
    return win_backtrace_process
endfunc

function DqReadU16(p : ^byte) -> uint16:
    return ^uint16(p)^
endfunc

function DqReadU32(p : ^byte) -> uint32:
    return ^uint32(p)^
endfunc

function DqReadU64(p : ^byte) -> uint64:
    return ^uint64(p)^
endfunc

function DqReadUleb(p : ref ^byte, pend : ^byte) -> uint64:
    result = 0
    var shift : uint = 0
    while p < pend:
        var b : uint8 = p^
        p += 1
        result |= (uint64(b & 0x7F) << shift)
        if b & 0x80 == 0:
            return
        endif
        shift += 7
    endwhile
endfunc

function DqReadSleb(p : ref ^byte, pend : ^byte) -> int:
    result = 0
    var shift : uint = 0
    var b     : uint8 = 0
    while p < pend:
        b = p^
        p += 1
        result |= (int(b & 0x7F) << shift)
        shift += 7
        if b & 0x80 == 0:
            if shift < 64  and  b & 0x40 <> 0:
                result |= (-(int(1) << shift))
            endif
            return
        endif
    endwhile
endfunc

function DqSkipCstr(p : ^byte, pend : ^byte) -> ^byte:
    while p < pend  and  p^ <> 0:
        p += 1
    endwhile
    if p < pend:
        p += 1
    endif
    return p
endfunc

function DqCstrEq(text : ^char, name : ^char) -> bool:
    var p : ^char = text
    var n : ^char = name
    while p^ <> char(0)  or  n^ <> char(0):
        if p^ <> n^:
            return false
        endif
        p += 1
        n += 1
    endwhile
    return true
endfunc

function DqSectionNameEq(name : ^byte, string_table : ^byte, text : ^char) -> bool:
    if name[0]^ == 47  and  string_table <> nil:  // '/' + decimal string-table offset
        var offset : uint = 0
        var i : int = 1
        while i < 8  and  name[i]^ >= 48  and  name[i]^ <= 57:
            offset = offset * 10 + name[i]^ - 48
            i += 1
        endwhile
        return DqCstrEq(^char(string_table + offset), text)
    endif

    var i : int = 0
    while i < 8:
        if text[i]^ == char(0):
            return name[i]^ == 0
        endif
        if name[i]^ <> Ord(text[i]^):
            return false
        endif
        i += 1
    endwhile
    return text[i]^ == char(0)
endfunc

function DqWinCopyCoffSymbolName(symbol : ^byte, name : ^char, name_size : uint) -> bool:
    if name == nil or name_size == 0:
        return false
    endif

    var source     : ^byte = symbol
    var source_end : ^byte = symbol + 8
    if DqReadU32(symbol) == 0:
        var offset : uint = DqReadU32(symbol + 4)
        if win_dwarf.string_table == nil or offset < 4 or offset >= win_dwarf.string_size:
            return false
        endif
        source = win_dwarf.string_table + offset
        source_end = win_dwarf.string_table + win_dwarf.string_size
    endif

    var i : uint = 0
    while i + 1 < name_size and source < source_end and source^ <> 0:
        name[i]^ = char(source^)
        i += 1
        source += 1
    endwhile
    name[i]^ = char(0)
    return i <> 0
endfunc

function DqDwarfFileName(file_table : ^byte, pend : ^byte, file_index : uint64) -> ^char:
    var p     : ^byte = file_table
    var index : uint64 = 1
    while p < pend  and  p^ <> 0:
        var name : ^char = ^char(p)
        p = DqSkipCstr(p, pend)
        DqReadUleb(p, pend)  // directory index
        DqReadUleb(p, pend)  // modification time
        DqReadUleb(p, pend)  // file length
        if index == file_index:
            return name
        endif
        index += 1
    endwhile
    return nil
endfunc

function DqDwarfEmitRow(target : uint64, address : uint64, file : uint64, line : int,
                        file_table : ^byte, pend : ^byte,
                        matched : ref bool, last_file : ref uint64, last_line : ref int,
                        out_file : refout ^char, out_line : refout uint32) -> bool:
    if address > target:
        if matched:
            out_file = DqDwarfFileName(file_table, pend, last_file)
            out_line = uint32(last_line)
            return out_file <> nil and out_line <> uint32(0)
        endif
        return false
    endif

    if line > 0:
        matched = true
        last_file = file
        last_line = line
    endif
    return false
endfunc

function DqDwarfScanLineProgram(program : ^byte, unit_end : ^byte, file_table : ^byte,
                                min_inst_len : uint8, line_base : int,
                                line_range : uint8, opcode_base : uint8,
                                std_lengths : ^byte, target : uint64,
                                out_file : refout ^char, out_line : refout uint32) -> bool:

    if line_range == 0:
        return false
    endif

    var p         : ^byte = program
    var address   : uint64 = 0
    var file      : uint64 = 1
    var line      : int = 1
    var matched   : bool = false
    var last_file : uint64 = 0
    var last_line : int = 0

    while p < unit_end:
        var op : uint8 = p^
        p += 1

        if op == 0:
            var ext_len : uint64 = DqReadUleb(p, unit_end)
            var ext_end : ^byte = p + uint(ext_len)
            if ext_end > unit_end or p >= unit_end:
                return false
            endif
            var subop : uint8 = p^
            p += 1
            if subop == DW_LNE_END_SEQUENCE:
                if DqDwarfEmitRow(target, address, file, line, file_table, unit_end,
                                matched, last_file, last_line, out_file, out_line):
                    return true
                endif
                address = 0
                file = 1
                line = 1
                matched = false
            elif subop == DW_LNE_SET_ADDRESS:
                if p + 8 <= ext_end:
                    address = DqReadU64(p)
                endif
            endif
            p = ext_end
        elif op < opcode_base:
            if op == DW_LNS_COPY:
                if DqDwarfEmitRow(target, address, file, line, file_table, unit_end,
                                matched, last_file, last_line, out_file, out_line):
                    return true
                endif
            elif op == DW_LNS_ADVANCE_PC:
                address += DqReadUleb(p, unit_end) * uint64(min_inst_len)
            elif op == DW_LNS_ADVANCE_LINE:
                line += DqReadSleb(p, unit_end)
            elif op == DW_LNS_SET_FILE:
                file = DqReadUleb(p, unit_end)
            elif op == DW_LNS_SET_COLUMN:
                DqReadUleb(p, unit_end)
            elif op == DW_LNS_NEGATE_STMT or op == DW_LNS_SET_BASIC_BLOCK or op == DW_LNS_SET_PROLOGUE_END or op == DW_LNS_SET_EPILOGUE_BEGIN:
                // state flags not needed for address-to-line lookup
            elif op == DW_LNS_CONST_ADD_PC:
                var adjusted : uint8 = uint8(255) - opcode_base
                address += uint64(adjusted div line_range) * uint64(min_inst_len)
            elif op == DW_LNS_FIXED_ADVANCE_PC:
                if p + 2 <= unit_end:
                    address += uint64(DqReadU16(p))
                    p += 2
                endif
            elif op == DW_LNS_SET_ISA:
                DqReadUleb(p, unit_end)
            else:
                var n : int = 0
                while n < int(std_lengths[op - 1]^):
                    DqReadUleb(p, unit_end)
                    n += 1
                endwhile
            endif
        else:
            var adjusted : uint8 = op - opcode_base
            address += uint64(adjusted div line_range) * uint64(min_inst_len)
            line += line_base + int(adjusted mod line_range)
            if DqDwarfEmitRow(target, address, file, line, file_table, unit_end,
                            matched, last_file, last_line, out_file, out_line):
                return true
            endif
        endif
    endwhile

    return false
endfunc

function DqWinDwarfLoad() -> bool:
    if win_dwarf.loaded:
        return win_dwarf.debug_line <> nil
    endif
    win_dwarf.loaded = true

    var path : [DQ_BT_EXE_PATH_MAX]char
    if win_GetModuleFileName(nil, %path[0], uint32(DQ_BT_EXE_PATH_MAX)) == 0:
        return false
    endif

    var fp : pointer = libc_fopen(%path[0], "rb")
    if fp == nil:
        return false
    endif

    if libc_fseek(fp, 0, SEEK_END) <> 0:
        libc_fclose(fp)
        return false
    endif
    var size : int = libc_ftell(fp)
    if size <= 0:
        libc_fclose(fp)
        return false
    endif
    libc_fseek(fp, 0, SEEK_SET)

    win_dwarf.data = libc_malloc(uint(size))
    if win_dwarf.data == nil:
        libc_fclose(fp)
        return false
    endif
    win_dwarf.data_size = uint(size)
    if libc_fread(win_dwarf.data, 1, uint(size), fp) <> uint(size):
        libc_fclose(fp)
        return false
    endif
    libc_fclose(fp)

    var data : ^byte = ^byte(win_dwarf.data)
    var data_end : ^byte = data + win_dwarf.data_size
    if data + 0x40 >= data_end  or  DqReadU16(data) <> 0x5A4D:
        return false
    endif
    var peoff : uint = uint(DqReadU32(data + 0x3C))
    if data + peoff + 0x18 >= data_end  or  DqReadU32(data + peoff) <> 0x00004550:
        return false
    endif

    var coff          : ^byte = data[peoff + 4]
    var section_count : int = DqReadU16(coff + 2)
    var opt_size      : uint = DqReadU16(coff + 16)
    var opt           : ^byte = coff[20]
    var sections      : ^byte = opt[opt_size]

    if sections[section_count * 40] > data_end:
        return false
    endif

    var string_table : ^byte = nil
    var sym_ptr      : uint = DqReadU32(coff + 8)
    var sym_count    : uint = DqReadU32(coff + 12)
    if sym_ptr <> 0 and sym_ptr <= win_dwarf.data_size
       and sym_count <= (win_dwarf.data_size - sym_ptr) div DQ_COFF_SYMBOL_SIZE
    :
        win_dwarf.symbols = data + sym_ptr
        win_dwarf.symbol_count = sym_count
        var string_ptr : uint = sym_ptr + sym_count * DQ_COFF_SYMBOL_SIZE
        if string_ptr + 4 <= win_dwarf.data_size:
            var string_size : uint = DqReadU32(data + string_ptr)
            if string_size >= 4 and string_size <= win_dwarf.data_size - string_ptr:
                string_table = data + string_ptr
                win_dwarf.string_table = string_table
                win_dwarf.string_size = string_size
            endif
        endif
    endif

    if DqReadU16(opt) == 0x20B:
        win_dwarf.image_base = DqReadU64(opt + 24)
    else:
        win_dwarf.image_base = uint64(DqReadU32(opt[28]))
    endif
    win_dwarf.runtime_base = uint64(win_GetCurrentModule(nil))
    win_dwarf.sections = sections
    win_dwarf.section_count = section_count

    var i : int = 0
    while i < section_count:
        var sh : ^byte = sections[i * 40]
        if DqSectionNameEq(sh, string_table, ".debug_line"):
            var raw_size : uint = DqReadU32(sh + 16)
            var raw_ptr  : uint = DqReadU32(sh + 20)
            if raw_ptr + raw_size <= win_dwarf.data_size:
                win_dwarf.debug_line = data + raw_ptr
                win_dwarf.debug_size = raw_size
                return true
            endif
            return false
        endif
        i += 1
    endwhile

    return false
endfunc

function DqWinCoffSymbolForPc(pc : pointer, name : ^char, name_size : uint,
                              displacement : refout uint64) -> bool:
    // DbgHelp on Windows does not reliably load the DWARF/COFF symbols emitted by
    // LLVM-MinGW, so resolve functions from the executable's COFF table ourselves.
    DqWinDwarfLoad()
    if win_dwarf.symbols == nil or win_dwarf.sections == nil or win_dwarf.runtime_base == 0:
        return false
    endif

    var address : uint64 = uint64(pc)
    if address < win_dwarf.runtime_base:
        return false
    endif
    var target_rva  : uint64 = address - win_dwarf.runtime_base
    var best_rva    : uint64 = 0
    var best_symbol : ^byte = nil
    var i : uint = 0
    while i < win_dwarf.symbol_count:
        var symbol      : ^byte = win_dwarf.symbols + i * DQ_COFF_SYMBOL_SIZE
        var section_no  : int = ^int16(symbol + 12)^
        var symbol_type : uint16 = DqReadU16(symbol + 14)
        if section_no > 0 and section_no <= win_dwarf.section_count
           and symbol_type & DQ_COFF_TYPE_FUNCTION <> 0:
            var section      : ^byte = win_dwarf.sections + (section_no - 1) * 40
            var section_rva  : uint64 = DqReadU32(section + 12)
            var section_size : uint64 = DqReadU32(section + 8)
            var raw_size     : uint64 = DqReadU32(section + 16)
            if raw_size > section_size:
                section_size = raw_size
            endif
            if target_rva >= section_rva and target_rva < section_rva + section_size:
                var symbol_rva : uint64 = section_rva + uint64(DqReadU32(symbol + 8))
                if symbol_rva <= target_rva and (best_symbol == nil or symbol_rva > best_rva):
                    best_rva = symbol_rva
                    best_symbol = symbol
                endif
            endif
        endif
        i += 1 + uint(symbol[17]^)
    endwhile

    if best_symbol == nil:
        return false
    endif
    if not DqWinCopyCoffSymbolName(best_symbol, name, name_size):
        return false
    endif
    displacement = target_rva - best_rva
    return true
endfunc

function DqWinDwarfLineForPc(pc : pointer, file_name : refout ^char, line_no : refout uint32) -> bool:
    file_name = nil
    line_no = 0
    if not DqWinDwarfLoad():
        return false
    endif

    var target : uint64 = uint64(pc)
    if win_dwarf.runtime_base <> uint64(0)  and  win_dwarf.image_base <> uint64(0):
        target = target - win_dwarf.runtime_base + win_dwarf.image_base
    endif

    var unit : ^byte = win_dwarf.debug_line
    var debug_end : ^byte = win_dwarf.debug_line[win_dwarf.debug_size]
    while unit[10] < debug_end:
        var unit_len : uint32 = DqReadU32(unit)
        if unit_len == 0  or  unit_len == 0xFFFFFFFF:
            return false
        endif
        var unit_end : ^byte = unit[4 + unit_len]
        if unit_end > debug_end:
            return false
        endif

        var p : ^byte = unit[4]
        var version : uint16 = DqReadU16(p)
        p += 2
        if version == 4:
            var header_len : uint = DqReadU32(p)
            p += 4
            var header_end : ^byte = p[header_len]
            if header_end <= unit_end:
                var min_inst_len : uint8 = p^
                p += 1
                p += 1  // max_ops_per_inst
                p += 1  // default_is_stmt
                var line_base : int = ^int8(p)^
                p += 1
                var line_range : uint8 = p^
                p += 1
                var opcode_base : uint8 = p^
                p += 1
                var std_lengths : ^byte = p
                p += uint(opcode_base - uint8(1))

                while p < header_end  and  p^ <> 0:
                    p = DqSkipCstr(p, header_end)
                endwhile
                if p < header_end:
                    p += 1
                endif
                var file_table : ^byte = p

                if DqDwarfScanLineProgram(header_end, unit_end, file_table, min_inst_len, line_base,
                                        line_range, opcode_base, std_lengths, target, file_name, line_no):
                    return true
                endif
            endif
        endif

        unit = unit_end
    endwhile

    return false
endfunc

function DqPrintBacktraceFrameImpl(index : int, pc : pointer, hide_internal : bool, stop_printing : ^bool) -> bool:
    var process : pointer = DqWinBacktraceProcess()
    var symbol : SDqWinSymbolInfo = {}
    var coff_name : [DQ_BT_SYMBOL_NAME_MAX]char
    var symbol_name : ^char = nil
    var displacement64 : uint64 = 0

    symbol.SizeOfStruct = DQ_BT_SYMBOL_INFO_SIZE
    symbol.MaxNameLen = DQ_BT_SYMBOL_NAME_MAX - uint32(1)

    if DqWinCoffSymbolForPc(pc, %coff_name[0], uint(DQ_BT_SYMBOL_NAME_MAX), displacement64):
        symbol_name = %coff_name[0]
    elif win_backtrace_ready and win_SymFromAddr(process, uint64(pc), %displacement64, %symbol) <> 0:
        symbol_name = %symbol.Name[0]
    endif

    if symbol_name <> nil:
        if hide_internal and DqBacktraceNameIsInternal(symbol_name):
            return false
        endif

        if stop_printing <> nil and DqIsMainFunction(symbol_name):
            stop_printing^ = true
        endif

        var line : SDqWinLineInfo = {}
        var line_displacement : uint32 = 0
        line.SizeOfStruct = DQ_BT_LINE_INFO_SIZE
        if win_SymGetLineFromAddr64(process, uint64(pc), %line_displacement, %line) <> 0 and line.FileName <> nil:
            printf("  #%d %s @ %s:%lu\n", index, symbol_name, line.FileName, uint(line.LineNumber))
        else:
            var dwarf_file : ^char = nil
            var dwarf_line : uint32 = 0
            if DqWinDwarfLineForPc(pc, dwarf_file, dwarf_line):
                printf("  #%d %s @ ./%s:%lu\n", index, symbol_name, dwarf_file, uint(dwarf_line))
            else:
                printf("  #%d %s + 0x%llx\n", index, symbol_name, displacement64)
            endif
        endif
        return true
    endif

    // An unresolved frame is not necessarily an internal frame. Printing it also
    // prevents one failed lookup from keeping hide_internal set for the full trace.
    printf("  #%d 0x%llx\n", index, uint64(pc))
    return true
endfunc
