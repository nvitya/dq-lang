//?exitcode(0)

use dqautotest
use file

var run <- OTestRun()

func *Main() -> int:
    var object_path : str = TempPath('.o')
    var project_path : str = TempPath('.dqproj')
    var executable_path : str = TempPath('.exe')

    run.RunTool([
        'c++', '-c', SourcePath('../../../compiler/test/project_linkobject.cpp'),
        '-o', object_path
    ])
    run.ExpectExitCode(0)

    var project : str
    project.AddFmt("main = '{}'\n", [SourcePath('../project/linkobject_main.dq')])
    project.AddFmt('link = {}\n', [true])
    project.AddFmt("linkoption = '{}'\n", ['--no-undefined'])
    project.AddFmt("linkobject = '{}'\n", [object_path])
    FileWriteText(project_path, project)

    run.RunCompiler(['-o', executable_path, project_path])
    run.ExpectExitCode(0)

    if FileExists(executable_path):
        run.RunTool([executable_path])
        run.ExpectExitCode(0)
    else:
        Fail('linkobject project did not produce an executable')
    endif

    RemoveTemp(executable_path)
    RemoveTemp(project_path)
    RemoveTemp(object_path)
    return TestResult()
endfunc
