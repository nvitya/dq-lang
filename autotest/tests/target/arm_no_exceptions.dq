//?notest
// Exception-free bare linking must not require a C++ unwinder or personality.

func NoUnwindExternal() [[external]]

object OMarker:
    value : int

    func *Create():
        value = 1
    endfunc

    func *Destroy():
        value = 0
    endfunc
endobject

func OwnedScope():
    var marker <- OMarker()
endfunc

func _start() [[cexport]]:
    NoUnwindExternal()
    OwnedScope()
    while true:
    endwhile
endfunc
