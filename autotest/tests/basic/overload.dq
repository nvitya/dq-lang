object OOverloadErr:
    id : int
    func fwd(a : int) -> int
endobject

func OOverloadErr.fwd(a : float) -> int:  //?error(FuncSigType)
    return 0
endfunc

func OOverloadErr.fwd(a : int) -> int:
    return a
endfunc

func OOverloadErr.dupe() -> int:
    return 1
endfunc

func OOverloadErr.dupe() -> int:  //?error(VsAlreadyDecl)
    return 2
endfunc

func OOverloadErr.id() -> int:  //?error(VsAlreadyDecl)
