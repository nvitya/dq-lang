  file:     http_simple_server.dq
  brief:    Very simple http server with dynamically generated content
            and demonstrating some get arguments processing
*/

use print
use time
use strutils
use nanonet/nano_http

const DBG_TRACES : bool = false

const HTTP_LISTEN_PORT : uint16 = 8080

func GetTs() -> str:
  result = FormatTime1('yyyy-mm-dd hh:nn:ss', Time());
endfunc

object OSConnHttpApp(OSConnectionHttp):
    func ProcessRequest() -> bool [[override]] ..
endobject

func OSConnHttpApp.ProcessRequest() -> bool [[override]]:
    use *
    try:

        #if DBG_TRACES
            PrintLn('Request: uri={}', [uri])
            for i : int = 0 count ucheaders.length:
                PrintLn('  header-{}: {} = {}', [i, ucheaders.key[i], ucheaders.value[i]])
            endfor
        #endif

        if uri == "/"  or uri == '/index.html':
            response.Clear()  // this keeps the preallocated storage
            response.AddFmt("""This is my plain text http response.\r
                uri="{}"\r
                getstr="{}"\r
                """
                , [uri, getstr]
            )

            var k : str
            var v : str

            for i : int = 0 count qsvars.length:
                k = qsvars.key[i]
                v = qsvars.value[i]
                response.AddFmt('GetVar: "{}" = "{}"\r\n', [k, v])
            endfor

            v = QsVarStr('a', '', 32)  // limit the variable length to defend against SQL injections
            if v <> '':
                response.AddFmt('Get var "a" is set to "{}"\r\n', [v])
            endif

            v = QsVarStr('c', '', 32)
            if v <> '':
                response.AddFmt('Get var "c" is set to "{}"\r\n', [v])
            else:
                response.Add('Get var "c" is not set.\r\n')
            endif

            var pb : ^byte = nil
            //Writeln('this causes an exception:' , pb^);

            return true

        elif "/bigdata" == uri:
            response.Clear()
            for i : int = 1 to 10000:
                response.AddFmt('Long response line - {}\n', [i])
            endfor
            return true

        else:
            return false
        endif

    except Exception as e:
        // catch all other exceptions here to allow the server running further
        PrintLn()
        PrintLn('{}: ERROR', [GetTs()])
        e.PrintMessage()
        PrintLn('Backtrace:')
        e.PrintBacktrace()  // print stack trace with line infos
    endtry

    return false
endfunc

func *Main():
    PrintLn('NanoNet - Simple Http Server')

    var svr <- ONanoHttpServer(OSConnHttpApp, HTTP_LISTEN_PORT)
    svr.InitListener()  // may raise an exception when the listener port is not available

    PrintLn('Server listening at port {}', [svr.listen_port])
    PrintLn('Entering main loop...')

    while true:
        try:
            svr.WaitForEvents(1000)

            // you can do something else here

        except Exception as e:
            // catch all other exceptions here to allow the server running further
            PrintLn()
            PrintLn('{}: ERROR', [GetTs()])
            e.PrintMessage()
            PrintLn('Backtrace:')
            e.PrintBacktrace()  // print stack trace with line infos
        endtry
    endwhile
endfunc
