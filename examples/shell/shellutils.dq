
object EShellResult(Exception):
    code : int
    function *Create(acode : int, amsg : strview)                        [[overload]]
    function *Create(acode : int, afmt : strview, avalues : []anyvalue)  [[overload]]
endobj

function Shell(args : []str) -> int  [[overload]]
function Shell(cmdstr : strview) -> int  [[overload]]

function ShellOut(args : []str, rexitcode : refnull int) -> str  [[overload]]
function ShellOut(cmdstr : strview, rexitcode : refnull int) -> str  [[overload]]

function ShellInOut(args : []str, instr : strview, rexitcode : refnull int) -> str  [[overload]]
function ShellInOut(cmdstr : strview, instr : strview, rexitcode : refnull int) -> str  [[overload]]

function GetEnv(name : strview, default_value : strview) -> str
function SetEnv(name : strview, value : strview)

/*
object OShellProcess:
    pid : int
    function Start(args : []str)
    function Wait() -> int
    function Kill()
    function Running() -> bool
endobj
*/

implementation

function libc_pipe(pipefd : ^int32) -> int32                         [[external('pipe')]]
function libc_fork() -> int32                                        [[external('fork')]]
function libc_dup2(oldfd : int32, newfd : int32) -> int32            [[external('dup2')]]
function libc_close(fd : int32) -> int32                             [[external('close')]]
function libc_read(fd : int32, buf : pointer, count : uint) -> int64 [[external('read')]]
function libc_write(fd : int32, buf : pointer, count : uint) -> int64 [[external('write')]]
function libc_waitpid(pid : int32, status : ^int32, options : int32) -> int32 [[external('waitpid')]]
function libc_execvp(file : ^char, argv : ^^char) -> int32            [[external('execvp')]]
function libc__exit(status : int32)                                  [[external('_exit')]]
function libc___errno_location() -> ^int32                           [[external('__errno_location')]]
function libc_fflush(stream : pointer) -> int32                      [[external('fflush')]]
function libc_signal(signum : int32, handler : pointer) -> pointer   [[external('signal')]]
function libc_getenv(name : ^char) -> ^char                          [[external('getenv')]]
function libc_setenv(name : ^char, value : ^char, overwrite : int32) -> int32 [[external('setenv')]]


const STDIN_FILENO  : int32 = 0
const STDOUT_FILENO : int32 = 1
const EINTR         : int32 = 4
const EPIPE         : int32 = 32
const SIGPIPE       : int32 = 13

function EShellResult.*Create(acode : int, amsg : strview)  [[overload]]:
    inherited Create(amsg)
    code = acode
endfunc

function EShellResult.*Create(acode : int, afmt : strview, avalues : []anyvalue)  [[overload]]:
    inherited Create(afmt, avalues)
    code = acode
endfunc

//--------------------------------------------------------------------

function Shell(cmdstr : strview) -> int  [[overload]]:
    var command : str = cmdstr
    return Shell(['/bin/sh', '-c', command])
endfunc

function Shell(args : []str) -> int  [[overload]]:
    result = 0

    if args.length == 0:
        raise EShellResult(-1, 'Shell: empty argument list')
    endif

    var argv : [*]^char
    argv.SetLength(args.length + 1)
    for i : int = 0 count args.length:
        argv[i] = args[i].pchar
    endfor
    argv[args.length] = null

    // The child inherits all standard streams. Flush buffered caller output first
    // so that its output cannot overtake text printed before this call.
    libc_fflush(null)
    var pid : int32 = libc_fork()
    if pid < 0:
        raise EShellResult(-1, 'Shell: could not create the child process')
    endif

    if pid == 0:
        libc_execvp(argv[0], %argv[0])
        libc__exit(127)
    endif

    var status : int32 = 0
    var wait_result : int32 = -1
    while wait_result < 0:
        wait_result = libc_waitpid(pid, %status, 0)
        if wait_result < 0  and libc___errno_location()^ <> EINTR:
            raise EShellResult(-1, 'Shell: could not wait for the child process')
        endif
    endwhile

    if (status & int32(0x7F)) == 0:
        result = int((status >> 8) & int32(0xFF))
    else:
        result = 128 + int(status & int32(0x7F))
    endif
endfunc

function ShellOut(args : []str, rexitcode : refnull int) -> str  [[overload]]:
    return ShellInOut(args, '', rexitcode)
endfunc

function ShellOut(cmdstr : strview, rexitcode : refnull int) -> str  [[overload]]:
    var command : str = cmdstr
    return ShellOut(['/bin/sh', '-c', command], rexitcode)
endfunc

function ShellInOut(args : []str, instr : strview, rexitcode : refnull int) -> str  [[overload]]:
    result = ''

    if args.length == 0:
        raise EShellResult(-1, 'ShellInOut: empty argument list')
    endif

    var argv : [*]^char
    argv.SetLength(args.length + 1)
    for i : int = 0 count args.length:
        argv[i] = args[i].pchar
    endfor
    argv[args.length] = null

    // Keep these borrowed input values stable across the feeder fork.
    var input_ptr : ^char = instr.pchar
    var input_len : uint = instr.length

    var inpipe  : [2]int32
    var outpipe : [2]int32
    if libc_pipe(%inpipe[0]) <> 0:
        raise EShellResult(-1, 'ShellInOut: could not create the stdin pipe')
    endif
    if libc_pipe(%outpipe[0]) <> 0:
        libc_close(inpipe[0])
        libc_close(inpipe[1])
        raise EShellResult(-1, 'ShellInOut: could not create the stdout pipe')
    endif

    var pid : int32 = libc_fork()
    if pid < 0:
        libc_close(inpipe[0])
        libc_close(inpipe[1])
        libc_close(outpipe[0])
        libc_close(outpipe[1])
        raise EShellResult(-1, 'ShellInOut: could not create the child process')
    endif

    if pid == 0:
        libc_close(inpipe[1])
        libc_close(outpipe[0])
        if libc_dup2(inpipe[0], STDIN_FILENO) < 0  or libc_dup2(outpipe[1], STDOUT_FILENO) < 0:
            libc__exit(127)
        endif
        libc_close(inpipe[0])
        libc_close(outpipe[1])
        libc_execvp(argv[0], %argv[0])
        libc__exit(127)
    endif

    // Feed stdin in a separate process while this process drains stdout. This
    // avoids the pipe-buffer deadlock caused by writing all input first.
    var feeder_pid : int32 = 0
    var feeder_fork_error : bool = false
    if input_len > 0:
        feeder_pid = libc_fork()
        if feeder_pid == 0:
            libc_close(inpipe[0])
            libc_close(outpipe[0])
            libc_close(outpipe[1])
            libc_signal(SIGPIPE, pointer(1)) // turn a closed child stdin into EPIPE

            var written : uint = 0
            while written < input_len:
                var writelen : int64 = libc_write(inpipe[1], input_ptr + written, input_len - written)
                if writelen > 0:
                    written += uint(writelen)
                elif writelen < 0  and libc___errno_location()^ == EINTR:
                    continue
                elif writelen < 0  and libc___errno_location()^ == EPIPE:
                    libc_close(inpipe[1])
                    libc__exit(0)
                else:
                    libc_close(inpipe[1])
                    libc__exit(1)
                endif
            endwhile
            libc_close(inpipe[1])
            libc__exit(0)
        elif feeder_pid < 0:
            feeder_fork_error = true
        endif
    endif

    libc_close(inpipe[0])
    libc_close(inpipe[1])
    libc_close(outpipe[1])

    var read_error : int32 = 0
    while true:
        var oldlen : int = result.length
        result.SetLength(oldlen + 4096, char(0))
        var readlen : int64 = libc_read(outpipe[0], %result[oldlen], 4096)
        var read_errno : int32 = 0
        if readlen < 0:
            read_errno = libc___errno_location()^
        endif
        if readlen > 0:
            result.SetLength(oldlen + int(readlen), char(0))
        else:
            result.SetLength(oldlen, char(0))
            if readlen < 0  and read_errno == EINTR:
                continue
            endif
            if readlen < 0:
                read_error = read_errno
            endif
            break
        endif
    endwhile
    libc_close(outpipe[0])

    var status : int32 = 0
    var wait_result : int32 = -1
    while wait_result < 0:
        wait_result = libc_waitpid(pid, %status, 0)
        if wait_result < 0  and libc___errno_location()^ <> EINTR:
            break
        endif
    endwhile

    var feeder_error : bool = feeder_fork_error
    if feeder_pid > 0:
        var feeder_status : int32 = 0
        var feeder_wait : int32 = -1
        while feeder_wait < 0:
            feeder_wait = libc_waitpid(feeder_pid, %feeder_status, 0)
            if feeder_wait < 0  and libc___errno_location()^ <> EINTR:
                feeder_error = true
                break
            endif
        endwhile
        if feeder_wait >= 0  and feeder_status <> 0:
            feeder_error = true
        endif
    endif

    if wait_result < 0:
        raise EShellResult(-1, 'ShellInOut: could not wait for the child process')
    endif
    if read_error <> 0:
        raise EShellResult(-1, 'ShellInOut: could not read the child output')
    endif
    if feeder_error:
        raise EShellResult(-1, 'ShellInOut: could not write the child input')
    endif

    var exitcode : int = 0
    if (status & int32(0x7F)) == 0:
        exitcode = int((status >> 8) & int32(0xFF))
    else:
        exitcode = 128 + int(status & int32(0x7F))
    endif

    if %rexitcode <> null:
        rexitcode = exitcode
    elif exitcode <> 0:
        raise EShellResult(exitcode, 'ShellInOut: process exited with code {}', [exitcode])
    endif
endfunc

function ShellInOut(cmdstr : strview, instr : strview, rexitcode : refnull int) -> str  [[overload]]:
    var command : str = cmdstr
    return ShellInOut(['/bin/sh', '-c', command], instr, rexitcode)
endfunc

//-----------------------------------------------------------------------------

function GetEnv(name : strview, default_value : strview) -> str:
    var cname : str = name
    var value : ^char = libc_getenv(cname.pchar)
    if value == null:
        return default_value
    else:
        return value
    endif
endfunc

function SetEnv(name : strview, value : strview):
    var cname : str = name
    var cvalue : str = value

    if libc_setenv(cname.pchar, cvalue.pchar, 1) <> 0:
        var errorcode : int = libc___errno_location()^
        raise EShellResult(errorcode, 'SetEnv failed (errno {})', [errorcode])
    endif
endfunc
