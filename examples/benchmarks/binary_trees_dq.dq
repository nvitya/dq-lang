use print, strutils

object ONode:
    left  : ONode
    right : ONode

    func *Create(aleft : ONode, aright : ONode)
    func *Destroy()
    func NodeCount() -> int
endobject

func ONode.*Create(aleft : ONode, aright : ONode):
    left  = aleft
    right = aright
endfunc

func ONode.*Destroy():
    if left <> nil:
        delete left
    endif
    if right <> nil:
        delete right
    endif
endfunc

func ONode.NodeCount() -> int:
    result = 1
    if left <> nil:
        result += left.NodeCount()
    endif
    if right <> nil:
        result += right.NodeCount()
    endif
endfunc

func BuildTree(depth : int) -> ONode:
    if depth == 0:
        return new ONode(nil, nil)
    endif
    return new ONode( BuildTree(depth - 1), BuildTree(depth - 1) )
endfunc

func CountDepth(depth : int) -> int:
    var lnode : ONode = BuildTree(depth)
    result = lnode.NodeCount()
    delete lnode  
endfunc

func StrechToDepth(depth : int):
    PrintLn('stretch tree of depth {}\t check: {}', [depth, CountDepth(depth)])
endfunc

func *Main() -> int:
    PrintLn("DQ")
    var n : int = 10
    if ArgCount() > 1:
        n = StrToInt(ArgStr(1), n)
    endif
    var min_depth : int = 4
    var max_depth : int = iif(min_depth + 2 > n, min_depth + 2, n)
    var stretch_depth : int = max_depth + 1
    StrechToDepth(stretch_depth)
    var long_lived : ONode = BuildTree(max_depth)
    for depth : int = min_depth  while depth <= max_depth  step 2:
        var iterations : int = 1 << (max_depth - depth + min_depth)
        var sum : int = 0
        for i : int = 0 count iterations:
            sum += CountDepth(depth)
        endfor
        PrintLn("{}\t trees of depth {}\t check: {}", [iterations, depth, sum])
    endfor
    PrintLn('long lived tree of depth {}\t check: {}', [max_depth, long_lived.NodeCount()])
    delete long_lived
    return 0
endfunc
