//?notest

object OBase:
public
    v : int = 0
    func *Create(av : int):
        v = av
    endfunc
    func id() -> int [[virtual]]:
        return 1
    endfunc
endobject

object OFirst(OBase):
public
    func *Create(av : int):
        inherited Create(av)
    endfunc
endobject

object OSecond(OBase):
public
    func *Create(av : int):
        inherited Create(av)
    endfunc
endobject

func CreateFirst() -> OBase:
    return new OFirst(1)
endfunc

func CreateSecond() -> OBase:
    return new OSecond(2)
endfunc
