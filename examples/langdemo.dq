use print
use ./langdemo_mod as ldm  only(CONST1)  // only(), exclude() and "--" control global scope merging

#if false

//Contents of the "langdemo_mod.?"

const CONST1 : int = 42
const CONST2 : float = 3.14

#endif

object OBase:
    cnt1 : int = 0
    cnt2 : int = 10
    name : cstring(31)

    function *Create(aname : cstring):  // constructor
        name = aname
    endfunc

    function *Destroy():
        @.PrintLn("{} destroy", [name])
    endfunc

    function Count() [[virtual]]:
        cnt1 += 1
    endfunc

    function Print():
        @.PrintLn('{}: cnt1={}, cnt2={}', [name, cnt1, cnt2])
    endfunc
endobj

object OChild(OBase):
    function Count() [[override]]:
        inherited
        cnt2 += 1
    endfunc
endobj

var obase   <- OBase('OBase')     // '<-' = embedded allocation (global data segment here)
                                   // no automatic destructor call for global embedded objects
var ochild  : OChild = null

function ObjTest():
    ochild = new OChild('OChild')

    obase.Count()
    ochild.Count()

    obase.Print()
    ochild.Print()

    PrintLn('ochild.name: {}', [iif(ochild == null, "OChild is null!", ochild.name)])

    delete ochild
endfunc

function cstr_add(dst : cstring, src : cstring):
    var ps     : ^char = %src[0]
    var psend  : ^char = ps[SizeOf(src)]  // [] does not dereference
    var pd     : ^char = %dst[0]
    var pdend  : ^char = pd + SizeOf(dst) - 1 // leave one char for the terminating
    pd += Len(dst)
    var pdstart : ^char = pd

    while pd < pdend  and ps < psend  and ps^ <> char(0):
        pd^ = ps^
        pd += 1
        ps += 1
    endwhile

    if pd <> pdstart:
        pd^ = char(0) // terminate
    endif
endfunc

function putchar(c : char) -> int  [[external]] // from libc

function WriteStr(s : cstring):
    var pc : ^char = s.pchar
    if pc == null:
        return
    endif
    while pc^ <> char(0):
        putchar(pc^)
        pc += 1
    endwhile
endfunc

function *Main() -> int:

    var s : cstring(127) = ""
    cstr_add(s, "Hello")
    cstr_add(s, " World!\n")
    WriteStr(s)

    if 3 / 2 * 10 == 10 * 3 / 2:
        PrintLn('The language is friendly.')
    else:
        PrintLn('The language is evil (like C).')
    endif

    if 3 div 2 * 10 == 10 * 3 div 2:
        PrintLn('The language is very friendly.')
    else:
        PrintLn('The language is not very friendly (like Pascal).')
    endif

    var x : int = 0xBEEF;
    x &= ~(0xF0F0)
    PrintLn('Bitwise op result: 0x{:04X}', [x])

    PrintLn("@langdemo_mod.CONST1 = {}", [CONST1])
    PrintLn("@langdemo_mod.CONST2 = {:.3f}", [@ldm.CONST2])

    PrintLn("ochild.name: {}", [iif(ochild == null, "OChild is null!", ochild.name)])

    ObjTest()

    for i : int = 0 to 5:
        Print(' {}:', [i])
        for j : int = 0  count i  step 2:
            Print(' {}', [j])
        endfor
        PrintLn()
    endfor

    var arr : [5]int = [2, 3, 5, 7, 11]
    Print('primes:')
    for i : int = 0  while i < Len(arr):
        Print(' {}', [ arr[i] ])
    endfor
    PrintLn()

    return 0
endfunc

/* OUTPUT:

Hello World!
The language is friendly.
Bitwise op result: 0x0E0F
@langdemo_mod.CONST1 = 42
@langdemo_mod.CONST2 = 3.140
ochild.name: OChild is null!
OBase: cnt1=1, cnt2=10
OChild: cnt1=1, cnt2=11
ochild.name: OChild
OChild destroy
 0:
 1: 0
 2: 0 2
 3: 0 2 4
 4: 0 2 4 6
 5: 0 2 4 6 8
primes: 2 3 5 7 11

*/
