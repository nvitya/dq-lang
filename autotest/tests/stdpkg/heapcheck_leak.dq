//?compargs('-DHEAPCHECK')
//?build_suffix('heapcheck')
// The HEAPCHECK counter reports outstanding small allocations.

use print

func *Main():
    var baseline : int64 = heap_allocated_size
    var memory : ^byte = ^byte(MemAlloc(16))
    memory^ = 0

    if heap_allocated_size <> baseline:
        PrintLn('heapcheck.leak = detected')  //?check('heapcheck.leak', detected)
    else:
        PrintLn('heapcheck.leak = not detected')
    endif
endfunc
