use file
use print

func *Main():
    var test_file : str = 'dq-autotest-file-remove.tmp'
    FileWriteText(test_file, 'temporary file')
    PrintLn('exists before remove = {}', [FileExists(test_file)])  //?check('exists before remove', 'true')

    FileRemove(test_file)
    PrintLn('exists after remove = {}', [FileExists(test_file)])   //?check('exists after remove', 'false')
endfunc
