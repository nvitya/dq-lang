func BadRegister(value : str) [[inline, asm]]: //?error(AsmOperandType)
    nop
endfunc

func BadImmediate(value : float64) [[inline, asm]]: //?error(AsmOperandType)
    nop
    [[immediate(value)]]
endfunc

func BadMemory(value : int) [[inline, asm]]: //?error(AsmOperandType)
    nop
    [[memread(value)]]
endfunc

func BadReadMode(value : refout int) [[inline, asm]]: //?error(AsmOperandType)
    nop
    [[memread(value)]]
endfunc

func BadWriteMode(value : refin int) [[inline, asm]]: //?error(AsmOperandType)
    nop
    [[memwrite(value)]]
endfunc

func BadReadWriteMode(value : refout int) [[inline, asm]]: //?error(AsmOperandType)
    nop
    [[memreadwrite(value)]]
endfunc

func BadClobber() [[inline, asm]]: //?error(AsmOperandType)
    nop
    [[clobber(not_a_register)]]
endfunc

func UnknownSymbol(value : int) [[inline, asm]]:
    mov $missing, $value
endfunc //?error(AsmSymbolUnknown)
